+--- /dev/null
++++ b/canonical/runtime/bound_capabilities/finance_quantitative_algebra_v1.py
+@@ -0,0 +1,75 @@
++"""Deterministic quantitative financial algebra adapter (stdlib only).
++Wraps the verified kernel in canonical/runtime/finance_quantitative_algebra_v1.py.
++"""
++from __future__ import annotations
++import json
++import pathlib
++from typing import Any, Mapping
++from canonical.runtime import finance_quantitative_algebra_v1 as _alg
++
++SCHEMA = "PROJECT_BRAIN_FINANCE_QUANTITATIVE_ALGEBRA_V1"
++
++
++def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
++    base = pathlib.Path(root).resolve()
++    op = str(args.get("operation") or args.get("formula") or "").strip().lower()
++
++    input_path = args.get("input_path")
++    params = dict(args)
++    if input_path:
++        p = (base / str(input_path)).resolve()
++        if p.is_file():
++            loaded = json.loads(p.read_text(encoding="utf-8"))
++            if isinstance(loaded, dict):
++                params.update(loaded)
++                if not op and ("operation" in loaded or "formula" in loaded):
++                    op = str(loaded.get("operation") or loaded.get("formula") or "").strip().lower()
++
++    res_val = None
++    if op == "cagr":
++        end_val = params.get("end_value")
++        start_val = params.get("start_value")
++        periods = int(params.get("periods", 1))
++        res_val = str(_alg.cagr(end_val, start_val, periods))
++    elif op in {"ebitda", "ebitda_from_operating_income"}:
++        op_inc = params.get("operating_income")
++        da = params.get("total_depreciation_and_amortization") or params.get("depreciation_and_amortization")
++        res_val = str(_alg.ebitda_from_operating_income(op_inc, da))
++    elif op in {"dcf", "dcf_enterprise_value"}:
++        fcfs = params.get("projected_fcfs", [])
++        dr = params.get("discount_rate_percent") or params.get("discount_rate")
++        tv = params.get("terminal_value")
++        res_val = str(_alg.dcf_enterprise_value(fcfs, dr, tv))
++    elif op == "debt_to_equity":
++        d = params.get("total_debt")
++        e = params.get("total_equity")
++        res_val = str(_alg.debt_to_equity(d, e))
++    elif op in {"margin", "ebitda_margin"}:
++        eb = params.get("ebitda")
++        rev = params.get("revenue")
++        res_val = str(_alg.ebitda_margin(eb, rev))
++    elif op == "ratio":
++        num = params.get("numerator")
++        den = params.get("denominator")
++        res_val = str(_alg.ratio(num, den))
++    elif op == "percent_change":
++        curr = params.get("current_value")
++        prior = params.get("prior_value")
++        res_val = str(_alg.percent_change(curr, prior))
++    else:
++        raise ValueError(f"UNSUPPORTED_FINANCE_OPERATION: {op}")
++
++    out = {
++        "schema": SCHEMA,
++        "status": "PASS",
++        "operation": op,
++        "value": res_val,
++        "pass": True,
++    }
++    output_path = args.get("output_path")
++    if output_path:
++        out_file = (base / str(output_path).lstrip("/\\")).resolve()
++        out_file.parent.mkdir(parents=True, exist_ok=True)
++        out_file.write_text(json.dumps(out, indent=2, sort_keys=True), encoding="utf-8")
++        out["output_path"] = str(output_path)
++    return out
