++
++SCHEMA = "PROJECT_BRAIN_SUPERVISOR_SAME_IDENTITY_LEASE_V1"
++
++
++def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
++    base = pathlib.Path(root).resolve()
++    instance = args.get("instance")
++    input_path = args.get("input_path")
++    if input_path:
++        p = (base / str(input_path)).resolve()
++        if p.is_file():
++            instance = json.loads(p.read_text(encoding="utf-8"))
++    if not isinstance(instance, dict):
++        raise ValueError("INSTANCE_OBJECT_REQUIRED")
++    res = _sup.solve_instance(instance)
++    res["schema"] = SCHEMA
++    res["pass"] = res.get("status") in {"OK", "SUCCESS", "COMPLETE"} or "state" in res or "events" in res
++    output_path = args.get("output_path")
++    if output_path:
++        out_file = (base / str(output_path).lstrip("/\\")).resolve()
++        out_file.parent.mkdir(parents=True, exist_ok=True)
++        out_file.write_text(json.dumps(res, indent=2, sort_keys=True), encoding="utf-8")
++        res["output_path"] = str(output_path)
++    return res
