+"""Adapter for canonical.runtime.retrieval_adversarial_recall_benchmark_v1 (stdlib only)."""
+from __future__ import annotations
+from typing import Any, Mapping
+from canonical.runtime import retrieval_adversarial_recall_benchmark_v1 as _mod
+
+SCHEMA = "PROJECT_BRAIN_RETRIEVAL_ADVERSARIAL_RECALL_BENCHMARK_V1_ADAPTER_V1"
+
+def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
+    try:
+        res = _mod.run(args)
+    except TypeError:
+        try:
+            res = _mod.run()
+        except Exception as e:
+            return {"pass": False, "status": "FAIL_CLOSED", "error": str(e)}
+    if isinstance(res, dict):
