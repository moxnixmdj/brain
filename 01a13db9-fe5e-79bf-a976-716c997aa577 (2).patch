@@ -0,0 +1,21 @@
+"""Deterministic HLE exact-answer retrieval question classifier adapter (stdlib only).
+Wraps canonical/runtime/hle_exact_retrieval_extract_v1.py.
+"""
+from __future__ import annotations
+from typing import Any, Mapping
+from canonical.runtime import hle_exact_retrieval_extract_v1 as _hle
+
+SCHEMA = "PROJECT_BRAIN_HLE_EXACT_RETRIEVAL_CLASSIFY_ADAPTER_V1"
+
+def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
+    question = str(args.get("question") or args.get("prompt") or args.get("text") or "").strip()
+    if not question:
+        raise ValueError("QUESTION_REQUIRED")
+    form = _hle.classify(question)
+    return {
+        "schema": SCHEMA,
+        "question": question,
+        "form": form,
+        "supported": form is not None,
+        "pass": form is not None,
+    }
