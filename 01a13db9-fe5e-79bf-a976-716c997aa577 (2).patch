+"""Atomic DOCX multi-span transactional replacement capability adapter (stdlib only).
+Wraps the verified kernel in canonical/runtime/docx_text_edit_transaction.py.
+"""
+from __future__ import annotations
+import json
+import pathlib
+from typing import Any, Mapping
+from canonical.runtime import docx_text_edit_transaction as _txn
+
+SCHEMA = "PROJECT_BRAIN_DOCX_TEXT_EDIT_TRANSACTION_V1"
+
+
+def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
+    base = pathlib.Path(root).resolve()
+    src = (base / str(args.get("path") or args.get("docx_path") or "")).resolve()
+    dst = (base / str(args.get("output_path") or "")).resolve()
+    raw_edits = args.get("edits")
+    if isinstance(raw_edits, str):
+        try:
+            raw_edits = json.loads(raw_edits)
+        except Exception:
+            raw_edits = []
+    if not isinstance(raw_edits, list):
+        raise ValueError("EDITS_LIST_REQUIRED")
+    edits = [_txn.TextEdit(old=str(e.get("old", "")), new=str(e.get("new", ""))) for e in raw_edits]
+    if not src.is_file():
+        raise FileNotFoundError(f"SOURCE_DOCX_MISSING: {src}")
+    dst.parent.mkdir(parents=True, exist_ok=True)
+    res = _txn.apply_text_edit_transaction(src, dst, edits=edits)
+    res["schema"] = SCHEMA
+    res["output_path"] = str(args.get("output_path"))
+    res["pass"] = res.get("status") == "PASS"
+    return res
