+"""Adapter for canonical.runtime.scope_equivalent_proof_gate (stdlib only)."""
+from __future__ import annotations
+from typing import Any, Mapping
+from canonical.runtime import scope_equivalent_proof_gate as _mod
+
+SCHEMA = "PROJECT_BRAIN_SCOPE_EQUIVALENT_PROOF_GATE_ADAPTER_V1"
+
+def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
+    try:
+        res = _mod.evaluate(args)
+    except TypeError:
+        try:
+            res = _mod.evaluate()
+        except Exception as e:
+            return {"pass": False, "status": "FAIL_CLOSED", "error": str(e)}
+    if isinstance(res, dict):
+        res_dict = dict(res)
+        if "pass" not in res_dict:
+            st = str(res_dict.get("status", ""))
+            res_dict["pass"] = ("PASS" in st or "OK" in st or "ROUTE" in st or "ACCEPT" in st)
+        return res_dict
+    return {"pass": bool(res), "result": res}
