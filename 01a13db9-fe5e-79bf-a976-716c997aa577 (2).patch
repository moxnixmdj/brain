+      status.textContent = data.pass ? "Execution complete (Pass)" : "Execution finished (Fail-closed)";
+      out.textContent = JSON.stringify(data, null, 2);
+    } catch (e) {
+      status.textContent = "Error";
+      out.textContent = "Network or execution error: " + e;
