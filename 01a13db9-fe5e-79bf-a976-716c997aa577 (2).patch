++"""Deterministic donor-free DNA storage codec capability adapter (stdlib only).
++Wraps canonical/runtime/dna_storage_codec_v1.py.
++"""
++from __future__ import annotations
++import pathlib
++from typing import Any, Mapping
++from canonical.runtime import dna_storage_codec_v1 as _codec
++
++SCHEMA = "PROJECT_BRAIN_DNA_STORAGE_CODEC_ADAPTER_V1"
++
++
++def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
++    base = pathlib.Path(root).resolve()
++    op = str(args.get("operation") or args.get("mode") or "encode").strip().lower()
++    src = (base / str(args.get("input_path") or args.get("path") or "")).resolve()
++    dst = (base / str(args.get("output_path") or "")).resolve()
++
++    if not src.is_file():
++        raise FileNotFoundError(f"INPUT_FILE_MISSING: {src}")
++    dst.parent.mkdir(parents=True, exist_ok=True)
++
++    if op in {"encode", "dna_encode"}:
++        res = _codec.encode_file(src, dst)
++        res["pass"] = res.get("status") == "PASS__DNA_STORAGE_ENCODED"
++    elif op in {"decode", "dna_decode"}:
++        res = _codec.decode_file(src, dst)
++        res["pass"] = res.get("status") == "PASS__DNA_STORAGE_DECODED"
++    else:
++        raise ValueError(f"UNSUPPORTED_DNA_CODEC_OPERATION: {op}")
++
++    res["output_path"] = str(args.get("output_path"))
++    return res
