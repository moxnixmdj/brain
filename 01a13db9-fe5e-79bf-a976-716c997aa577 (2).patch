@@ -0,0 +1,36 @@
+"""Deterministic engineering dimension callout parser adapter (stdlib only).
+Wraps canonical/runtime/engineering_callout_parser.py.
+"""
+from __future__ import annotations
+import json
+import pathlib
+from typing import Any, Mapping
+from canonical.runtime import engineering_callout_parser as _parser
+
+SCHEMA = "PROJECT_BRAIN_ENGINEERING_CALLOUT_PARSER_V1"
+
+
+def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
+    base = pathlib.Path(root).resolve()
+    text = str(args.get("text") or args.get("callout") or "")
+    input_path = args.get("input_path") or args.get("path")
+    if input_path:
+        p = (base / str(input_path)).resolve()
+        if p.is_file():
+            loaded = json.loads(p.read_text(encoding="utf-8"))
+            if isinstance(loaded, dict):
+                text = str(loaded.get("text") or loaded.get("callout") or text)
+            elif isinstance(loaded, str):
+                text = loaded
+    if not text.strip():
+        raise ValueError("CALLOUT_TEXT_REQUIRED")
+
+    res = _parser.parse_callout(text)
+    res["pass"] = res.get("status") == "PARSED"
+    output_path = args.get("output_path")
+    if output_path:
+        out_file = (base / str(output_path).lstrip("/\\")).resolve()
+        out_file.parent.mkdir(parents=True, exist_ok=True)
+        out_file.write_text(json.dumps(res, indent=2, sort_keys=True), encoding="utf-8")
+        res["output_path"] = str(output_path)
+    return res
