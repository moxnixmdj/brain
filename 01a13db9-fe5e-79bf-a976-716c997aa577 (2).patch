@@ -0,0 +1,26 @@
+"""Declarative engineering notation catalog and token resolver adapter (stdlib only).
+Wraps canonical/runtime/declarative_engineering_notation.py.
+"""
+from __future__ import annotations
+from typing import Any, Mapping, Sequence
+from canonical.runtime import declarative_engineering_notation as _den
+
+SCHEMA = "PROJECT_BRAIN_DECLARATIVE_ENGINEERING_NOTATION_ADAPTER_V1"
+
+def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
+    text = str(args.get("text") or args.get("content") or "").strip()
+    catalog = args.get("catalog")
+    rows = args.get("rows") or args.get("symbols")
+    if not catalog and rows:
+        catalog = _den.compile_catalog(rows)
+    if not isinstance(catalog, Mapping):
+        raise ValueError("CATALOG_OR_ROWS_REQUIRED")
+
+    op = str(args.get("operation") or "resolve").strip().lower()
+    if op in {"compile", "compile_catalog"}:
+        catalog["pass"] = catalog.get("status") == "COMPILED"
+        return catalog
+
+    res = _den.resolve_tokens(text, catalog)
+    res["pass"] = res.get("status") == "RESOLVED"
+    return res
