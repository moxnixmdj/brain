+"""Deterministic SEC fact selector adapter (stdlib only).
+Wraps the verified selector in canonical/runtime/finance_sec_fact_selector_v1.py.
+"""
+from __future__ import annotations
+import json
+import pathlib
+from typing import Any, Mapping
+from canonical.runtime import finance_sec_fact_selector_v1 as _sel
+
+SCHEMA = "PROJECT_BRAIN_FINANCE_SEC_FACT_SELECTOR_V1"
+
+
+def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
+    base = pathlib.Path(root).resolve()
+    doc = args.get("doc")
+    input_path = args.get("path") or args.get("input_path") or args.get("json_path")
+    if input_path:
+        p = (base / str(input_path)).resolve()
+        if p.is_file():
+            doc = json.loads(p.read_text(encoding="utf-8"))
+    if not isinstance(doc, dict):
+        raise ValueError("SEC_DOC_REQUIRED")
+
+    fy = args.get("fiscal_year")
+    if fy is not None:
+        try:
+            fy = int(fy)
+        except Exception:
+            fy = None
+    period_end = args.get("period_end")
+    period_start = args.get("period_start")
+    forms = args.get("forms")
+    if isinstance(forms, str):
+        forms = [f.strip() for f in forms.split(",")]
+    unit = args.get("unit")
+    pk = args.get("period_kind")
+    latest = bool(args.get("prefer_latest_filing", True))
+
+    res = _sel.select_fact(
+        doc,
+        fiscal_year=fy,
+        period_end=period_end,
+        period_start=period_start,
+        forms=forms,
+        unit=unit,
+        period_kind=pk,
+        prefer_latest_filing=latest,
+    )
+    res["pass"] = res.get("status") == "PASS"
+    output_path = args.get("output_path")
+    if output_path:
+        out_file = (base / str(output_path).lstrip("/\\")).resolve()
+        out_file.parent.mkdir(parents=True, exist_ok=True)
+        out_file.write_text(json.dumps(res, indent=2, sort_keys=True), encoding="utf-8")
+        res["output_path"] = str(output_path)
+    return res
