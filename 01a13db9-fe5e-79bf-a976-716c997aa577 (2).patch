+from typing import Any, Mapping
+from canonical.runtime import mission_carrier_factorization_v1 as _mod
+
+SCHEMA = "PROJECT_BRAIN_MISSION_CARRIER_FACTORIZATION_V1_ADAPTER_V1"
+
+def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
+    try:
+        res = _mod.evaluate(args)
+    except TypeError:
+        try:
+            res = _mod.evaluate()
+        except Exception as e:
+            return {"pass": False, "status": "FAIL_CLOSED", "error": str(e)}
