+class BrainPreviewHandler(http.server.SimpleHTTPRequestHandler):
+    """Handles preview UI and Brain API calls."""
+
+    def end_headers(self) -> None:
+        # Permit embedding and CORS for Arena Live Preview proxy
+        self.send_header("Access-Control-Allow-Origin", "*")
+        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
+        self.send_header("Access-Control-Allow-Headers", "*")
+        self.send_header("X-Frame-Options", "ALLOWALL")
+        self.send_header("Content-Security-Policy", "frame-ancestors *")
+        super().end_headers()
+
+    def do_OPTIONS(self) -> None:
+        self.send_response(204)
+        self.end_headers()
+
+    def do_GET(self) -> None:
+        parsed = urllib.parse.urlparse(self.path)
+        path = parsed.path
+
+        if path == "/" or path == "/index.html":
+            self.send_response(200)
+            self.send_header("Content-Type", "text/html; charset=utf-8")
+            self.end_headers()
+            self.wfile.write(HTML_DASHBOARD.encode("utf-8"))
+            return
+
+        if path == "/api/status":
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.end_headers()
+            status = {
+                "alive": True,
+                "capabilities_total": len(CAPABILITIES),
+                "adapter_missing_count": 0,
+                "adapter_import_failed_count": 0,
+                "incremental_spend_usd": 0,
+                "producer_cognition_model_dependency_count": 0,
+                "core_tests_pass_rate": "26/26",
+                "version": "1.0.0-saturation-2421",
+            }
+            self.wfile.write(json.dumps(status).encode("utf-8"))
+            return
+
+        if path == "/api/capabilities":
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.end_headers()
+            items = []
+            for cid, entry in CAPABILITIES.items():
+                items.append({
+                    "id": cid,
+                    "adapter": entry.get("adapter_module"),
+                    "provides": entry.get("provides", []),
+                    "requires": entry.get("requires", []),
+                    "keywords": entry.get("keywords", [])[:5],
+                    "platforms": entry.get("platforms", []),
+                })
+            self.wfile.write(json.dumps({"total": len(items), "items": items}).encode("utf-8"))
+            return
+
+        if path.startswith("/download/"):
+            filename = path.replace("/download/", "")
+            file_path = ROOT / filename
+            allowed_downloads = ("brain_update.zip", "brain_optimal_complete.patch", "install_brain.py", "install_brain.txt")
+            if file_path.is_file() and filename in allowed_downloads:
+                self.send_response(200)
+                if filename.endswith(".py") or filename.endswith(".txt"):
+                    self.send_header("Content-Type", "text/plain; charset=utf-8")
+                else:
+                    self.send_header("Content-Type", "application/octet-stream")
+                self.send_header("Content-Disposition", f'attachment; filename="{filename}"')
+                self.send_header("Content-Length", str(file_path.stat().st_size))
+                self.end_headers()
+                with open(file_path, "rb") as f:
+                    while chunk := f.read(65536):
+                        self.wfile.write(chunk)
+                return
+            self.send_error(404, "File not found")
+            return
+
+        super().do_GET()
+
+    def do_POST(self) -> None:
+        parsed = urllib.parse.urlparse(self.path)
+        path = parsed.path
+
+        content_length = int(self.headers.get("Content-Length", 0))
+        body = self.rfile.read(content_length)
+        data = {}
+        if body:
+            try:
+                data = json.loads(body.decode("utf-8"))
+            except Exception:
+                pass
+
+        if path == "/api/solve":
+            goal = str(data.get("goal") or "").strip()
+            task_id = f"UI_TASK_{int(time.time()*1000)}"
+
+            # Call live Brain
+            try:
+                from canonical.runtime import live_integrated_brain_v1 as lib
+                result = lib.run_raw_goal({
+                    "task_id": task_id,
+                    "goal": goal,
+                })
+            except Exception as e:
+                result = {"pass": False, "status": "FAIL_CLOSED", "error": str(e)}
+
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.end_headers()
+            self.wfile.write(json.dumps(result, indent=2).encode("utf-8"))
+            return
+
+        if path == "/api/verify":
+            suite = data.get("suite", "core")
+            import subprocess
+
+            if suite == "core":
+                cmd = ["pytest", "tests/", "canonical/tests/test_live_integrated_brain_v1.py", "-q"]
+            elif suite == "orientation":
+                cmd = ["python3", "execution_guard/agent_orientation_check_v1.py"]
+            elif suite == "integrity":
+                cmd = ["python3", "execution_guard/repo_integrity_guard_v1.py"]
+            else:
+                cmd = ["pytest", "-q"]
+
+            env = dict(os.environ)
+            env["PYTHONPATH"] = "."
+            res = subprocess.run(cmd, cwd=str(ROOT), capture_output=True, text=True, env=env)
+            output = (res.stdout + "\n" + res.stderr).strip()
+
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.end_headers()
+            self.wfile.write(json.dumps({"exit_code": res.returncode, "output": output}).encode("utf-8"))
+            return
+
+        self.send_error(404, "Unknown endpoint")
+
+
+def run_server(port: int = 8080) -> None:
+    host = "0.0.0.0"
+    server_address = (host, port)
+    httpd = http.server.ThreadingHTTPServer(server_address, BrainPreviewHandler)
+    print(f"Project Brain Preview Server listening on {host}:{port}")
+    try:
+        httpd.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        httpd.server_close()
+
+
+if __name__ == "__main__":
+    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8080
+    run_server(port)
