+from typing import Any, Mapping
+from canonical.runtime import saccr_credit_information_safe_candidate as _mod
+
+SCHEMA = "PROJECT_BRAIN_SACCR_CREDIT_INFORMATION_SAFE_CANDIDATE_ADAPTER_V1"
+
+def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
+    try:
+        res = _mod.solve(args)
+    except TypeError:
+        try:
+            res = _mod.solve()
+        except Exception as e:
+            return {"pass": False, "status": "FAIL_CLOSED", "error": str(e)}
