+"""Capability-first work item ranking adapter (stdlib only).
+Wraps the verified kernel in canonical/runtime/capability_first_scheduler_v1.py.
+"""
+from __future__ import annotations
+import json
+import pathlib
+from typing import Any, Mapping
+from canonical.runtime import capability_first_scheduler_v1 as _sched
+
+SCHEMA = "PROJECT_BRAIN_CAPABILITY_FIRST_RANKING_V1"
+
+
+def run(args: Mapping[str, Any], root: Any = ".") -> dict[str, Any]:
+    base = pathlib.Path(root).resolve()
+    work = args.get("work")
+    input_path = args.get("input_path")
+    if input_path:
+        p = (base / str(input_path)).resolve()
+        if p.is_file():
+            data = json.loads(p.read_text(encoding="utf-8"))
+            work = data.get("work", work)
+    if not isinstance(work, list):
+        raise ValueError("WORK_LIST_REQUIRED")
+    checkpoint_count = args.get("checkpoint_open_obligation_count")
+    if checkpoint_count is not None:
+        try:
+            checkpoint_count = int(checkpoint_count)
+        except Exception:
+            checkpoint_count = None
+    res = _sched.rank_work(work, checkpoint_open_obligation_count=checkpoint_count)
+    res["schema"] = SCHEMA
+    res["pass"] = bool(res.get("ranked") is not None and res.get("status") in {"OK", "CAPABILITY_FIRST_RANKING_WITH_CHECKPOINT_AUDIT"})
+    output_path = args.get("output_path")
+    if output_path:
+        out_file = (base / str(output_path).lstrip("/\\")).resolve()
+        out_file.parent.mkdir(parents=True, exist_ok=True)
+        out_file.write_text(json.dumps(res, indent=2, sort_keys=True), encoding="utf-8")
+        res["output_path"] = str(output_path)
+    return res
