+gen_codec_msgpack_npm = _gen_codec("CODEC_MSGPACK_NPM", "the msgpack npm node library", ".msgpack", msgpack_decode)
+gen_codec_bson = _gen_codec("CODEC_BSON", "the bson modern python library", ".bson", _bson_envelope_decoder)
