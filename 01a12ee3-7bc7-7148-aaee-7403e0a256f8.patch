+"""Deterministic One-Shot Remote Main & Cleanroom Capsule Sync Orchestrator (V1).
+
+Pre-verifies all local CI merge/admission/cleanroom gates for `origin/main..HEAD`,
+emits a cryptographic readiness receipt:
+  canonical/verification/ONE_SHOT_REMOTE_MAIN_AND_CAPSULE_SYNC_READINESS_20261012_V1.json
+and provides `--execute-remote` to push `HEAD`, open & merge a pull request into
+`moxnixmdj/brain:main`, and dispatch `moxnixmdj/verification-capsule-runner` in
+one shot when executed in a session with active GitHub write credentials.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+from typing import Any
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from canonical.runtime import (
+    current_authority_runtime_census_v1,
+    final_terminal_cleanroom_gate_v1,
+    one_shot_sky_impact_executor_v1,
+    open_world_symbolic_generalization_engine_v1,
+    terminal_closure_reducer,
+    terminal_projection_consistency_v1,
+    terminal_reality_gate_v1,
+    verification_capsule_local_runner_v1,
+)
+
+ROOT = Path(__file__).resolve().parents[2]
+SCHEMA = "PROJECT_BRAIN_ONE_SHOT_REMOTE_MAIN_AND_CAPSULE_SYNC_V1"
+READINESS_RECEIPT_PATH = (
+    "canonical/verification/ONE_SHOT_REMOTE_MAIN_AND_CAPSULE_SYNC_READINESS_20261012_V1.json"
+)
+BASE_MAIN_COMMIT = "c4db4a2a41957d8c3a1158b7a9bb8ced1ea71776"
+
+
+def _sha256(obj: Any) -> str:
+    return hashlib.sha256(
+        json.dumps(obj, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    ).hexdigest()
+
+
+def evaluate_readiness(
+    repo_root: str | Path = ROOT,
+    *,
+    write_receipt: bool = True,
+) -> dict[str, Any]:
+    root = Path(repo_root).resolve()
+
+    manifest = json.loads(
+        (root / "canonical/governance/TERMINAL_CLOSURE_MANIFEST_V1.json").read_text(
+            encoding="utf-8"
+        )
+    )
+    pointer = json.loads(
+        (root / "canonical/governance/CURRENT_TERMINAL_AUTHORITY.json").read_text(
+            encoding="utf-8"
+        )
+    )
+
+    r_closure = terminal_closure_reducer.evaluate_manifest(manifest, repo_root=root)
+    r_reality = terminal_reality_gate_v1.evaluate(pointer, manifest)
+    r_proj = terminal_projection_consistency_v1.evaluate_live()
+    r_cleanroom = final_terminal_cleanroom_gate_v1.evaluate_live_candidate(root)
+    r_census = current_authority_runtime_census_v1.run(root)
+    r_open_world = open_world_symbolic_generalization_engine_v1.evaluate(root)
+    r_sky_exec = one_shot_sky_impact_executor_v1.execute_all_steps(root)
+    r_capsule = verification_capsule_local_runner_v1.evaluate(
+        root, write_attestation=False
+    )
+    ff_check = subprocess.run(
+        ["git", "merge-base", "--is-ancestor", "075c7025b93a39ba4a5abdcdba0b132d410b5b69", "HEAD"],
+        cwd=root,
+        capture_output=True,
+    )
+
+    gate_checks = {
+        "terminal_closure_reducer": bool(r_closure.get("achieved") is True),
+        "terminal_reality_gate": bool(
+            r_reality.get("terminal_real") is True
+            and r_reality.get("declared_terminal") is True
+            and r_reality.get("declaration_warnings") == []
+        ),
+        "terminal_projection_consistency": bool(
+            r_proj.get("pass") is True
+            and r_proj.get("terminal_goal_achieved") is True
+        ),
+        "final_terminal_cleanroom_gate": bool(
+            r_cleanroom.get("pass") is True
+            and r_cleanroom.get("terminal_authority") is True
+        ),
+        "current_authority_runtime_census": bool(
+            r_census.get("pass") is True
+            and r_census.get("authority_pointer_reference_missing_count") == 0
+        ),
+        "open_world_symbolic_generalization_engine": bool(
+            r_open_world.get("pass") is True
+            and r_open_world.get("suite_count") == 16
+            and r_open_world.get("suite_pass_count") == 16
+            and r_open_world.get("kstar_basis_routed_pass_count") == 10
+        ),
+        "one_shot_sky_impact_executor": bool(
+            r_sky_exec.get("pass") is True
+            and r_sky_exec.get("passed_step_count") == 8
+        ),
+        "fast_forward_lineage_from_origin_main": bool(ff_check.returncode == 0),
+        "verification_capsule_local_runner": bool(r_capsule.get("pass") is True),
+    }
+
+    all_ready = all(gate_checks.values())
+    payload: dict[str, Any] = {
+        "schema": SCHEMA,
+        "status": (
+            "PASS__REMOTE_MAIN_AND_CAPSULE_SYNC_READY_FOR_ONE_SHOT_EXECUTION"
+            if all_ready
+            else "FAIL_CLOSED__PRE_MERGE_READINESS_INCOMPLETE"
+        ),
+        "pass": all_ready,
+        "base_origin_main_commit": BASE_MAIN_COMMIT,
+        "gate_count": len(gate_checks),
+        "gate_pass_count": sum(1 for v in gate_checks.values() if v),
+        "gate_checks": gate_checks,
+        "remote_execution_commands": [
+            "git push origin HEAD",
+            "gh pr create --base main --title 'Promote total dual-route K* and 19/19 terminal closure to main' --body 'Automated one-shot total terminal closure promotion.'",
+            "gh pr merge <pr_number> --merge",
+            "gh workflow run capsule-verify.yml --repo moxnixmdj/verification-capsule-runner",
+        ],
+        "external_model_runtime_dependency_count": 0,
+        "incremental_spend_usd": 0.0,
+    }
+    payload["readiness_sha256"] = _sha256(payload)
+    if write_receipt and root == ROOT:
+        out_path = root / READINESS_RECEIPT_PATH
+        out_path.parent.mkdir(parents=True, exist_ok=True)
+        out_path.write_text(
+            json.dumps(payload, indent=2, sort_keys=True) + "\n",
+            encoding="utf-8",
+        )
+    return payload
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument(
+        "--execute-remote",
+        action="store_true",
+        help="Push HEAD to origin, open & merge PR into main, and dispatch verification-capsule-runner.",
+    )
+    ns = ap.parse_args()
+    readiness = evaluate_readiness(ROOT, write_receipt=True)
+    if not readiness["pass"]:
+        print(json.dumps(readiness, indent=2, sort_keys=True))
+        return 1
+    if not ns.execute_remote:
+        print(json.dumps(readiness, indent=2, sort_keys=True))
+        return 0
+
+    branch = subprocess.check_output(
+        ["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=ROOT, text=True
+    ).strip()
+    subprocess.run(["git", "push", "origin", branch], cwd=ROOT, check=True)
+    pr_url = subprocess.check_output(
+        [
+            "gh",
+            "pr",
+            "create",
+            "--base",
+            "main",
+            "--head",
+            branch,
+            "--title",
+            "Promote total dual-route K* and 19/19 terminal closure to main",
+            "--body",
+            "One-shot total terminal closure promotion verified by cleanroom capsule runner.",
+        ],
+        cwd=ROOT,
+        text=True,
+    ).strip()
+    pr_num = pr_url.rstrip("/").split("/")[-1]
+    subprocess.run(["gh", "pr", "merge", pr_num, "--merge"], cwd=ROOT, check=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
