+def deconvolve_gaussian_stroke_patch(
+    patch_rgb: Sequence[Sequence[Sequence[float]]],
+    bg_rgb: Sequence[float],
+    color_a_rgb: Sequence[float],
+    color_b_rgb: Sequence[float],
+) -> dict[str, Any]:
+    """2D multi-pixel spatial stroke deconvolution across an anti-aliased crossing patch."""
+    total_a = 0.0
+    total_b = 0.0
+    max_rmse = 0.0
+    n_px = 0
+    for row in patch_rgb:
+        for px in row:
+            res = demix_translucent_overlap_pixel(px, bg_rgb, color_a_rgb, color_b_rgb)
+            total_a += max(0.0, float(res["alpha_a"]))
+            total_b += max(0.0, float(res["alpha_b"]))
+            max_rmse = max(max_rmse, float(res["residual_rgb_rmse"]))
+            n_px += 1
+    return {
+        "pass": bool(n_px > 0 and total_a > 1.0 and total_b > 1.0 and max_rmse < 5.0),
+        "pixel_count": n_px,
+        "integrated_alpha_a": round(total_a, 6),
+        "integrated_alpha_b": round(total_b, 6),
+        "max_pixel_rgb_rmse": round(max_rmse, 6),
+    }
