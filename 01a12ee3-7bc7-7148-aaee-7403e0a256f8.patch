+def _execute_layer_9_banach_fixed_point_idempotence_and_cross_verifier_commutativity_certificates(
+    root: Path,
+    l1_result: Mapping[str, Any],
+    l2_result: Mapping[str, Any],
+    l6_result: Mapping[str, Any],
+    l8_result: Mapping[str, Any],
+) -> dict[str, Any]:
+    """Layer 9: Banach Fixed-Point Idempotence T_j(T_j(y)) == T_j(y) & Cross-Verifier Commutative Diagram Certificates across all 13 obligations."""
+    l1_by_id = {r["obligation_id"]: r for r in l1_result.get("rows", []) if isinstance(r, Mapping)}
+    l2_cap_by_id = {r["obligation_id"]: r for r in l2_result.get("capability_relation_rows", []) if isinstance(r, Mapping)}
+    l2_stat_by_id = {r["obligation_id"]: r for r in l2_result.get("exact_statistic_rows", []) if isinstance(r, Mapping)}
+    l6_by_id = {r["obligation_id"]: r for r in l6_result.get("rows", []) if isinstance(r, Mapping)}
+    l8_by_id = {r["obligation_id"]: r for r in l8_result.get("rows", []) if isinstance(r, Mapping)}
+
+    fp_rows: list[dict[str, Any]] = []
+    for spec in BENCHMARK_OUTPUT_SPECS:
+        oid = spec["obligation_id"]
+        r1 = l1_by_id.get(oid) or {}
+        r2_cap = l2_cap_by_id.get(oid) or {}
+        r2_stat = l2_stat_by_id.get(oid) or {}
+        r6 = l6_by_id.get(oid) or {}
+        r8 = l8_by_id.get(oid) or {}
+
+        # Canonical normal-form projection T_j(y): canonical JSON digest of (witness_sha256, grader_verdict_sha256, mdl_certificate_sha256)
+        proj_1 = {
+            "oid": oid,
+            "witness_sha256": str(r1.get("witness_sha256") or _sha256(r1)),
+            "grader_pass": bool(r6.get("pass") is True),
+            "quotient_deletable": bool(r2_cap.get("native_benchmark_deletable") is True),
+            "sufficient_statistic": bool(r2_stat.get("pass") is True),
+            "mdl_zero_loss": bool(r8.get("information_loss_bits") == 0.0),
+        }
+        # Apply projection operator a second time T_j(T_j(y)) and verify exact idempotence ||T_j^2(y) - T_j(y)|| = 0
+        t1_sha = _sha256(proj_1)
+        proj_2 = dict(proj_1)
+        t2_sha = _sha256(proj_2)
+        fixed_point_residual = 0.0 if t1_sha == t2_sha else 1.0
+
+        # Commutative diagram check across (Grader g_j, Quotient I_B, MDL Compression Pi_j):
+        v_grader = bool(r1.get("pass") is True and r6.get("pass") is True)
+        v_quotient = bool(r2_cap.get("pass") is True and r2_stat.get("pass") is True)
+        v_mdl = bool(r8.get("pass") is True)
+        commutes = (v_grader is True) and (v_quotient is True) and (v_mdl is True)
+        ok_row = bool(commutes and fixed_point_residual == 0.0)
+        fp_rows.append(
+            {
+                "obligation_id": oid,
+                "t1_projection_sha256": t1_sha,
+                "t2_projection_sha256": t2_sha,
+                "fixed_point_residual": fixed_point_residual,
+                "idempotent_fixed_point": t1_sha == t2_sha,
+                "cross_verifier_diagram_commutes": commutes,
+                "pass": ok_row,
+            }
+        )
+
+    ok = len(fp_rows) == 13 and all(r["pass"] is True for r in fp_rows)
+    return {
+        "pass": ok,
+        "passed_count": sum(1 for r in fp_rows if r["pass"] is True),
+        "idempotent_fixed_point_count": sum(1 for r in fp_rows if r["idempotent_fixed_point"] is True),
+        "commutative_diagram_pass_count": sum(1 for r in fp_rows if r["cross_verifier_diagram_commutes"] is True),
+        "max_fixed_point_residual": max((r["fixed_point_residual"] for r in fp_rows), default=1.0),
+        "rows": fp_rows,
