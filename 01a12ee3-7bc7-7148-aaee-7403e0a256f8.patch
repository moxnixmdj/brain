+            "result_sha256": h(result_ch),
+        }
+        nrow["receipt_sha256"] = vil_v2.neighbor_receipt_digest(nrow)
+        return nrow
+
+    return {
+        "episode_id": episode_id,
+        "subject_sha256": subject,
+        "phase_receipts": receipts,
+        "learned_route": route,
+        "neighbor_replays": [
