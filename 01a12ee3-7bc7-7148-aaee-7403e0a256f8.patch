+def synthesize_rational_polynomial(
+    train_pairs: Sequence[tuple[int | str | Fraction, int | str | Fraction]],
+    holdout_pairs: Sequence[tuple[int | str | Fraction, int | str | Fraction]],
+) -> dict[str, Any]:
+    """Synthesize unique minimal-degree polynomial P(x) in Q[x] via exact Lagrange interpolation."""
+    if len(train_pairs) < 2 or len(holdout_pairs) < 1:
+        return {
+            "pass": False,
+            "status": "FAIL_CLOSED__INSUFFICIENT_WITNESS_IDENTIFIABILITY",
+            "reason": "AT_LEAST_2_TRAIN_AND_1_HOLDOUT_WITNESSES_REQUIRED",
+        }
+    xs = [_to_fraction(x) for x, _ in train_pairs]
+    ys = [_to_fraction(y) for _, y in train_pairs]
+    if len(set(xs)) != len(xs):
+        return {
+            "pass": False,
+            "status": "FAIL_CLOSED__DUPLICATE_DOMAIN_NODES",
+        }
+
+    n = len(xs)
+    # Represent polynomial as coefficient list [c_0, c_1, ..., c_{n-1}] where P(x) = sum c_k * x^k
+    coeffs = [Fraction(0, 1) for _ in range(n)]
+    for i in range(n):
+        # Basis polynomial L_i(x) = prod_{j != i} (x - x_j) / (x_i - x_j)
+        num_poly = [Fraction(1, 1)]
+        denom = Fraction(1, 1)
+        for j in range(n):
+            if i == j:
+                continue
+            denom *= xs[i] - xs[j]
+            # Multiply num_poly by (x - xs[j])
+            next_poly = [Fraction(0, 1) for _ in range(len(num_poly) + 1)]
+            for deg, c in enumerate(num_poly):
+                next_poly[deg] -= c * xs[j]
+                next_poly[deg + 1] += c
+            num_poly = next_poly
+        scale = ys[i] / denom
+        for deg, c in enumerate(num_poly):
+            coeffs[deg] += c * scale
+
+    # Trim trailing zero high-degree coefficients
+    while len(coeffs) > 1 and coeffs[-1] == 0:
+        coeffs.pop()
+
+    def eval_poly(x_val: Fraction) -> Fraction:
+        acc = Fraction(0, 1)
+        power = Fraction(1, 1)
+        for c in coeffs:
+            acc += c * power
+            power *= x_val
+        return acc
+
+    for x_h, y_h in holdout_pairs:
+        if eval_poly(_to_fraction(x_h)) != _to_fraction(y_h):
+            return {
+                "pass": False,
+                "status": "FAIL_CLOSED__HOLDOUT_WITNESS_FALSIFIED",
+            }
+
+    return {
+        "pass": True,
+        "status": "PASS__EXACT_RATIONAL_POLYNOMIAL_SYNTHESIZED",
+        "kind": "RATIONAL_POLYNOMIAL_Q_X",
+        "degree": len(coeffs) - 1,
+        "coefficients_exact": [str(c) for c in coeffs],
+        "evaluator": eval_poly,
+    }
+
+
+def synthesize_linear_recurrence(
+    sequence: Sequence[int | str | Fraction],
+    holdout_count: int = 2,
+) -> dict[str, Any]:
+    """Synthesize exact order-2 rational recurrence s[n] = a*s[n-1] + b*s[n-2] + c."""
+    seq = [_to_fraction(v) for v in sequence]
+    if len(seq) < 5 + holdout_count:
+        return {
+            "pass": False,
+            "status": "FAIL_CLOSED__INSUFFICIENT_SEQUENCE_LENGTH",
+        }
+    train = seq[:-holdout_count]
+    # Solve 3x3 exact rational system on n=2,3,4:
+    # a*s[1] + b*s[0] + c = s[2]
+    # a*s[2] + b*s[1] + c = s[3]
+    # a*s[3] + b*s[2] + c = s[4]
+    mat = [
+        [train[1], train[0], Fraction(1, 1), train[2]],
+        [train[2], train[1], Fraction(1, 1), train[3]],
+        [train[3], train[2], Fraction(1, 1), train[4]],
+    ]
+    for col in range(3):
+        pivot = None
+        for r in range(col, 3):
+            if mat[r][col] != 0:
+                pivot = r
+                break
+        if pivot is None:
+            return {
+                "pass": False,
+                "status": "FAIL_CLOSED__SINGULAR_RECURRENCE_HANKEL_SYSTEM",
+            }
+        mat[col], mat[pivot] = mat[pivot], mat[col]
+        piv_val = mat[col][col]
+        for j in range(col, 4):
+            mat[col][j] /= piv_val
+        for r in range(3):
+            if r != col and mat[r][col] != 0:
+                factor = mat[r][col]
+                for j in range(col, 4):
+                    mat[r][j] -= factor * mat[col][j]
+
+    a, b, c = mat[0][3], mat[1][3], mat[2][3]
+    for idx in range(2, len(seq)):
+        pred = a * seq[idx - 1] + b * seq[idx - 2] + c
+        if pred != seq[idx]:
+            return {
+                "pass": False,
+                "status": "FAIL_CLOSED__RECURRENCE_FALSIFIED_ON_WITNESS",
+            }
+    return {
+        "pass": True,
+        "status": "PASS__EXACT_RATIONAL_RECURRENCE_SYNTHESIZED",
+        "kind": "ORDER_2_AFFINE_RECURRENCE_Q",
+        "parameters_exact": {"a": str(a), "b": str(b), "c": str(c)},
+        "next_term_exact": str(a * seq[-1] + b * seq[-2] + c),
+    }
+
+
+def synthesize_observational_equivalence_program(
+    train_examples: Sequence[tuple[Any, Any]],
+    holdout_examples: Sequence[tuple[Any, Any]],
+) -> dict[str, Any]:
+    """Bottom-up observational-equivalence synthesizer over compositional primitives."""
+    if not train_examples or not holdout_examples:
+        return {
+            "pass": False,
+            "status": "FAIL_CLOSED__INSUFFICIENT_WITNESS_IDENTIFIABILITY",
+        }
+
+    primitives: list[tuple[str, int, Callable[[Any], Any]]] = [
+        ("id", 1, lambda x: x),
+        (
+            "str_strip_lower",
+            2,
+            lambda x: x.strip().lower() if isinstance(x, str) else None,
+        ),
+        (
+            "str_normalize_ws",
+            2,
+            lambda x: " ".join(x.split()) if isinstance(x, str) else None,
+        ),
+        (
+            "str_alnum_upper",
+            3,
+            lambda x: "".join(ch for ch in x if ch.isalnum()).upper()
+            if isinstance(x, str)
+            else None,
+        ),
+        (
+            "list_sort_unique",
+            2,
+            lambda x: sorted(set(x))
+            if isinstance(x, list) and all(isinstance(i, (int, str)) for i in x)
+            else None,
+        ),
+        (
+            "list_filter_pos",
+            2,
+            lambda x: [i for i in x if isinstance(i, (int, float)) and i > 0]
+            if isinstance(x, list)
+            else None,
+        ),
+        (
+            "list_sum",
+            2,
+            lambda x: sum(x)
+            if isinstance(x, list) and all(isinstance(i, (int, float, Fraction)) for i in x)
+            else None,
+        ),
+        (
+            "list_square_map",
+            3,
+            lambda x: [i * i for i in x]
+            if isinstance(x, list) and all(isinstance(i, int) for i in x)
+            else None,
+        ),
+        (
+            "table_sum_active_amount",
+            3,
+            lambda x: sum(
+                Fraction(str(r["amount"]))
+                for r in x
+                if isinstance(r, Mapping) and r.get("active") is True and "amount" in r
+            )
+            if isinstance(x, list) and all(isinstance(r, Mapping) for r in x)
+            else None,
+        ),
+    ]
+
+    # Build depth-1 and depth-2 compositions with observational-equivalence deduplication
+    candidates: list[tuple[str, int, Callable[[Any], Any]]] = list(primitives)
+    for name1, cost1, fn1 in primitives:
+        for name2, cost2, fn2 in primitives:
+            if name1 == "id" or name2 == "id":
+                continue
+            comp_name = f"{name2}({name1})"
+            comp_cost = cost1 + cost2
+            candidates.append(
+                (
+                    comp_name,
+                    comp_cost,
+                    lambda x, f1=fn1, f2=fn2: f2(f1(x)),
+                )
+            )
+
+    candidates.sort(key=lambda item: (item[1], item[0]))
+
+    seen_signatures: set[str] = set()
+    admissible_programs: list[tuple[str, int, Callable[[Any], Any]]] = []
+    train_inputs = [inp for inp, _ in train_examples]
+    train_targets = [out for _, out in train_examples]
+
+    for name, cost, fn in candidates:
+        try:
+            outputs = [fn(inp) for inp in train_inputs]
+        except Exception:
+            continue
+        if any(o is None for o in outputs):
+            continue
+        sig = json.dumps([str(o) for o in outputs], sort_keys=True)
+        if sig in seen_signatures:
+            continue
+        seen_signatures.add(sig)
+        if outputs == train_targets:
+            admissible_programs.append((name, cost, fn))
+
+    if not admissible_programs:
+        return {
+            "pass": False,
+            "status": "FAIL_CLOSED__NO_OBSERVATIONALLY_CONSISTENT_PROGRAM_IN_BASIS",
+            "observational_equivalence_classes_explored": len(seen_signatures),
+        }
+
+    best_name, best_cost, best_fn = admissible_programs[0]
+    for h_in, h_out in holdout_examples:
+        try:
+            got = best_fn(h_in)
+        except Exception:
+            got = None
+        if got != h_out:
+            return {
+                "pass": False,
+                "status": "FAIL_CLOSED__HOLDOUT_WITNESS_FALSIFIED",
+                "candidate_program": best_name,
+            }
+
+    return {
+        "pass": True,
+        "status": "PASS__OBSERVATIONAL_EQUIVALENCE_PROGRAM_SYNTHESIZED_AND_VERIFIED",
+        "program_ast": best_name,
+        "kolmogorov_cost": best_cost,
+        "observational_equivalence_classes_explored": len(seen_signatures),
+    }
+
