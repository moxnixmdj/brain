+    # 30. Epipolar Essential Matrix E = [t]_x R Rank-2 Singularity & Stereo Ray Coplanarity x'^T E x = 0
+    # Pure X-baseline translation t = (1, 0, 0), R = I => E = [[0, 0, 0], [0, 0, -1], [0, 1, 0]]
+    # 3D point P = (4, 2, 5) in Cam 1 -> x1 = (4/5, 2/5, 1); in Cam 2 (shifted by -t) -> P2 = (3, 2, 5) -> x2 = (3/5, 2/5, 1)
