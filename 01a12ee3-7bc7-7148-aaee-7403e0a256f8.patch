+            # 36. Cournot Symmetric Oligopoly Nash Equilibrium Output & Clearing Price over Q
+            cournot_spec = task.get("cournot_nash_oligopoly_equilibrium_spec")
+            if isinstance(cournot_spec, Mapping):
