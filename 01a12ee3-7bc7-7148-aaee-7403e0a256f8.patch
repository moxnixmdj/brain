+def compute_polyhedral_outward_offset_and_chamfer_bevel(
+    half_extent: float = 2.0,
+    offset_delta: float = 0.5,
+    chamfer_c: float = 0.4,
+) -> dict[str, Any]:
+    """Compute outward normal offset shelling (n_f . x <= d_f + delta) and 12-edge chamfer/corner
+    truncation on a convex hexahedron [-h, h]^3, verifying Euler-Poincare chi = V - E + F = 2.
+    """
+    h_off = half_extent + offset_delta
+    offset_verts = [
+        (sx * h_off, sy * h_off, sz * h_off)
+        for sx in (-1.0, 1.0)
+        for sy in (-1.0, 1.0)
+        for sz in (-1.0, 1.0)
+    ]
+    offset_vol = (2.0 * h_off) ** 3
+    offset_area = 6.0 * ((2.0 * h_off) ** 2)
+    shell_vol = offset_vol - ((2.0 * half_extent) ** 3)
+
+    # Corner-truncated / beveled hexahedron: |x| <= h, |y| <= h, |z| <= h, |x|+|y|+|z| <= 3h - c
+    h = half_extent
+    c = chamfer_c
+    chamfer_verts: list[tuple[float, float, float]] = []
+    for sx in (-1.0, 1.0):
+        for sy in (-1.0, 1.0):
+            for sz in (-1.0, 1.0):
+                chamfer_verts.append((sx * (h - c), sy * h, sz * h))
+                chamfer_verts.append((sx * h, sy * (h - c), sz * h))
+                chamfer_verts.append((sx * h, sy * h, sz * (h - c)))
+    v_cnt = len(set(chamfer_verts))  # 24 vertices
+    f_cnt = 6 + 8  # 6 octagonal faces + 8 triangular corner bevel faces = 14 faces
+    e_cnt = (6 * 8 + 8 * 3) // 2  # 36 edges
+    chi = v_cnt - e_cnt + f_cnt
+    chamfer_vol = ((2.0 * h) ** 3) - 8.0 * ((c ** 3) / 6.0)
+    return {
+        "offset_vertex_count": len(offset_verts),
+        "offset_volume": offset_vol,
+        "offset_area": offset_area,
+        "shell_volume": shell_vol,
+        "chamfer_V": v_cnt,
+        "chamfer_E": e_cnt,
+        "chamfer_F": f_cnt,
+        "chamfer_euler_characteristic": chi,
+        "chamfer_volume": chamfer_vol,
+    }
+
