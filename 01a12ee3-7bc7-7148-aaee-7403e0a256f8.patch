+    c3_ok = len(peaks) == 3 and max(freq_errors) < 0.25
+    checks["HARMONIC_CHORD_SPECTRAL_PEAK_EXTRACTION"] = {
+        "pass": c3_ok,
+        "extracted_peaks_hz": [p["frequency_hz"] for p in peaks],
+        "max_frequency_error_hz": round(max(freq_errors), 5),
+    }
+
+    # 4. ITU-T Q.23 DTMF sequence synthesis & decoding
+    dtmf_target = "159#0*8A"
+    dtmf_wave = synthesize_dtmf_sequence(dtmf_target, sample_rate=sr)
+    dtmf_decoded = decode_dtmf_sequence(dtmf_wave, sample_rate=sr)
