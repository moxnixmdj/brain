+def render_rotated_truetype_chart_text(
+    image: Any,
+    xy: tuple[int, int],
+    text: str,
+    *,
+    rotation_ccw_deg: int = 90,
+    font_family: str = "DejaVuSans",
+    font_size: int = 15,
+    color: tuple[int, int, int] = (0, 0, 0),
+) -> None:
+    """Render proportional TrueType text rotated by 90/270 degrees (e.g., vertical Y-axis title/unit)."""
+    from PIL import Image
+
+    strip = Image.new("RGB", (max(48, len(str(text)) * int(font_size) + 20), int(font_size) * 2 + 12), (255, 255, 255))
+    render_truetype_chart_text(strip, (6, 4), str(text), font_family=font_family, font_size=font_size, color=color)
+    rot = strip.rotate(int(rotation_ccw_deg) % 360, expand=True)
+    image.paste(rot, (int(xy[0]), int(xy[1])))
+
+
+def decode_rotated_truetype_glyph_strip(
+    image: Any,
+    search_box: tuple[int, int, int, int],
+    *,
+    candidate_rotations_ccw_deg: Sequence[int] = (90, 0, 270),
+    font_size: int = 15,
+) -> dict[str, Any]:
+    """Decode horizontal or 90/270-degree rotated TrueType text strips by un-rotating and maximizing NCC confidence."""
+    crop = image.crop(tuple(int(v) for v in search_box))
+    best_res: dict[str, Any] | None = None
+    best_rot = 0
+    for rot_deg in candidate_rotations_ccw_deg:
+        unrot = crop.rotate((360 - (int(rot_deg) % 360)) % 360, expand=True)
+        try:
+            res = decode_truetype_proportional_glyph_strip(
+                unrot,
+                (0, 0, unrot.size[0], unrot.size[1]),
+                font_size=font_size,
+            )
+        except ChartProfessionalSemanticsV2Error:
+            continue
+        if best_res is None or float(res["mean_confidence"]) > float(best_res["mean_confidence"]):
+            best_res = dict(res)
+            best_rot = int(rot_deg) % 360
+    if best_res is None:
+        raise ChartProfessionalSemanticsV2Error("ROTATED_TRUETYPE_OCR_FAILED")
+    best_res["detected_rotation_ccw_deg"] = best_rot
+    return best_res
+
+
+def solve_faceted_small_multiples_chart(
+    image: Any,
+    *,
+    panel_specs: Sequence[Mapping[str, Any]],
+    target_x_unit: str | None = None,
+    target_y_unit: str | None = None,
+    use_truetype_ocr: bool = True,
+) -> dict[str, Any]:
+    """Solve a multi-panel small-multiples faceted chart grid and compute cross-panel deltas & totals."""
+    if not panel_specs:
+        raise ChartProfessionalSemanticsV2Error("EMPTY_FACETED_PANEL_SPECS")
+    panels_out: list[dict[str, Any]] = []
+    for spec in panel_specs:
+        pid = str(spec["panel_id"])
+        p_res = solve_chart(
+            image,
+            x_tick_boxes=spec["x_tick_boxes"],
+            y_tick_boxes=spec["y_tick_boxes"],
+            x_unit_box=tuple(spec["x_unit_box"]),
+            y_unit_box=tuple(spec["y_unit_box"]),
+            query_pixel_x=float(spec["query_pixel_x"]),
+            query_pixel_y=float(spec["query_pixel_y"]),
+            target_x_unit=target_x_unit,
+            target_y_unit=target_y_unit,
+            use_truetype_ocr=use_truetype_ocr,
+        )
+        panels_out.append({
+            "panel_id": pid,
+            "converted_x": p_res["converted_x"],
+            "converted_y": p_res["converted_y"],
+            "decoded_x_unit": p_res["decoded_x_unit"],
+            "decoded_y_unit": p_res["decoded_y_unit"],
+        })
+    vals_y = [float(p["converted_y"]) for p in panels_out]
+    best_panel = max(panels_out, key=lambda p: float(p["converted_y"]))["panel_id"]
+    return {
+        "pass": True,
+        "panel_count": len(panels_out),
+        "panels": panels_out,
+        "cross_panel_total_y": round(sum(vals_y), 9),
+        "cross_panel_delta_last_minus_first_y": round(vals_y[-1] - vals_y[0], 9),
+        "argmax_panel_id": best_panel,
+    }
+
