+def demix_translucent_overlap_pixel(
+    blended_rgb: Sequence[float],
+    bg_rgb: Sequence[float],
+    color_a_rgb: Sequence[float],
+    color_b_rgb: Sequence[float],
+) -> dict[str, Any]:
+    """Solve linear RGB alpha unmixing (I - Bg) = alpha_a*(Ca - Bg) + alpha_b*(Cb - Bg)."""
+    va = [float(color_a_rgb[i]) - float(bg_rgb[i]) for i in range(3)]
+    vb = [float(color_b_rgb[i]) - float(bg_rgb[i]) for i in range(3)]
+    vy = [float(blended_rgb[i]) - float(bg_rgb[i]) for i in range(3)]
+    aa = sum(x * x for x in va)
+    ab = sum(x * y for x, y in zip(va, vb))
+    bb = sum(y * y for y in vb)
+    ay = sum(x * y for x, y in zip(va, vy))
+    by = sum(x * y for x, y in zip(vb, vy))
+    det = aa * bb - ab * ab
+    if abs(det) <= 1e-9:
+        raise ChartProfessionalSemanticsV2Error("DEGENERATE_COLOR_BASIS_FOR_ALPHA_UNMIXING")
+    alpha_a = (bb * ay - ab * by) / det
+    alpha_b = (aa * by - ab * ay) / det
+    recon = [
+        float(bg_rgb[i]) + alpha_a * va[i] + alpha_b * vb[i]
+        for i in range(3)
+    ]
+    residual = math.sqrt(sum((recon[i] - float(blended_rgb[i])) ** 2 for i in range(3)) / 3.0)
+    return {
+        "alpha_a": round(alpha_a, 6),
+        "alpha_b": round(alpha_b, 6),
+        "residual_rgb_rmse": round(residual, 6),
+        "both_series_present": bool(alpha_a > 0.25 and alpha_b > 0.25 and residual < 5.0),
+    }
+
