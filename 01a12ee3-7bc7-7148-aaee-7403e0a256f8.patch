+        cut_frames_seq.append([[base + float((x + y + t) % 5) for x in range(16)] for y in range(16)])
+    fluxes = []
+    detected_cuts = []
+    for t in range(1, len(cut_frames_seq)):
+        diff = sum(
+            abs(cut_frames_seq[t][y][x] - cut_frames_seq[t - 1][y][x])
+            for y in range(16)
+            for x in range(16)
