+def compute_css_grid_2d_fr_minmax_span_layout(
+    container_width: float = 924.0,
+    container_height: float = 420.0,
+    col_gap: float = 12.0,
+    row_gap: float = 10.0,
+) -> dict[str, Any]:
+    """Resolve 2D CSS Grid tracks (`px`, `minmax(px, fr)`, `fr`) and multi-cell grid spans."""
+    # Columns: [180px, minmax(140px, 1fr), 2fr] -> fixed=180, total_gaps=24, remaining=720 -> 1fr=240, 2fr=480
+    fixed_col_0 = 180.0
+    rem_w = max(0.0, container_width - fixed_col_0 - 2.0 * col_gap)
+    fr_unit_w = rem_w / 3.0
+    col_1 = max(140.0, 1.0 * fr_unit_w)
+    col_2 = 2.0 * fr_unit_w
+    col_widths = [fixed_col_0, col_1, col_2]
+    col_x = [0.0, col_widths[0] + col_gap, col_widths[0] + col_gap + col_widths[1] + col_gap]
+
+    # Rows: [60px, auto (content=100px), 1fr] -> fixed=160, total_gaps=20, remaining=240 -> row_2=240
+    row_heights = [60.0, 100.0, max(0.0, container_height - 160.0 - 2.0 * row_gap)]
+    row_y = [0.0, row_heights[0] + row_gap, row_heights[0] + row_gap + row_heights[1] + row_gap]
+
+    def _span_box(c_start: int, c_end: int, r_start: int, r_end: int) -> dict[str, float]:
+        x = col_x[c_start]
+        y = row_y[r_start]
+        w = sum(col_widths[c_start:c_end]) + max(0, c_end - c_start - 1) * col_gap
+        h = sum(row_heights[r_start:r_end]) + max(0, r_end - r_start - 1) * row_gap
+        return {"x": x, "y": y, "width": w, "height": h}
+
+    items = {
+        "sidebar": _span_box(0, 1, 0, 3),      # grid-column: 1 / 2; grid-row: 1 / 4
+        "header-banner": _span_box(1, 3, 0, 1), # grid-column: 2 / 4; grid-row: 1 / 2
+        "kpi-card": _span_box(1, 2, 1, 2),      # grid-column: 2 / 3; grid-row: 2 / 3
+        "chart-panel": _span_box(2, 3, 1, 3),   # grid-column: 3 / 4; grid-row: 2 / 4
+        "status-Tile": _span_box(1, 2, 2, 3),   # grid-column: 2 / 3; grid-row: 3 / 4
+    }
+
+    # Check pairwise non-overlap of placed grid items
+    item_list = list(items.values())
+    overlaps = 0
+    for i in range(len(item_list)):
+        for j in range(i + 1, len(item_list)):
+            a, b = item_list[i], item_list[j]
+            sep = (
+                a["x"] + a["width"] <= b["x"] + 1e-9
+                or b["x"] + b["width"] <= a["x"] + 1e-9
+                or a["y"] + a["height"] <= b["y"] + 1e-9
+                or b["y"] + b["height"] <= a["y"] + 1e-9
+            )
+            if not sep:
+                overlaps += 1
+
+    return {
+        "col_widths": col_widths,
+        "row_heights": row_heights,
+        "width_conserved": abs(sum(col_widths) + 2.0 * col_gap - container_width) < 1e-9,
+        "height_conserved": abs(sum(row_heights) + 2.0 * row_gap - container_height) < 1e-9,
+        "items": items,
+        "overlap_count": overlaps,
+    }
+
