+def extract_stacked_area_and_candlestick_ohlc(
+    image: Any,
+    *,
+    y_pixel_bottom: float,
+    y_pixel_top: float,
+    y_val_bottom: float,
+    y_val_top: float,
+    sample_xs: Sequence[int] = (),
+    band_colors: Sequence[tuple[int, int, int]] = (),
+    candle_x_ranges: Sequence[tuple[int, int]] = (),
+    bullish_body_color: tuple[int, int, int] = (30, 180, 90),
+    bearish_body_color: tuple[int, int, int] = (220, 50, 50),
+    wick_color: tuple[int, int, int] = (25, 25, 25),
+    color_tol: float = 28.0,
+) -> dict[str, Any]:
+    """Extract stacked-area marginal unstacked series heights across sample_xs and raster candlestick OHLC + wicks across candle_x_ranges."""
+    w, h = image.size
+
+    def _rgb_dist(a: tuple[int, int, int], b: tuple[int, int, int]) -> float:
+        return math.sqrt(sum((int(x) - int(y)) ** 2 for x, y in zip(a[:3], b[:3])))
+
+    def _px_to_val(py: float) -> float:
+        return y_val_bottom + (y_pixel_bottom - py) / (y_pixel_bottom - y_pixel_top) * (y_val_top - y_val_bottom)
+
+    y_lo_px = max(0, int(min(y_pixel_top, y_pixel_bottom)))
+    y_hi_px = min(h - 1, int(max(y_pixel_top, y_pixel_bottom)))
+
+    stacked_columns: list[dict[str, Any]] = []
+    for sx in sample_xs:
+        marginals: list[float] = []
+        cum_totals: list[float] = []
+        prev_top_val = y_val_bottom
+        for b_col in band_colors:
+            ys = [
+                y
+                for y in range(y_lo_px, y_hi_px + 1)
+                if _rgb_dist(image.getpixel((int(sx), y))[:3], b_col) <= color_tol
+            ]
+            if not ys:
+                marginals.append(0.0)
+                cum_totals.append(round(prev_top_val, 6))
+                continue
+            top_py = float(min(ys))
+            # Filled pixel band [top_py .. bot_py] spans one pixel per unit up to top_py
+            cum_val = _px_to_val(top_py)
+            marg_val = max(0.0, cum_val - prev_top_val)
+            marginals.append(round(marg_val, 6))
+            cum_totals.append(round(cum_val, 6))
+            prev_top_val = cum_val
+        stacked_columns.append(
+            {
+                "x_pixel": int(sx),
+                "marginal_values": marginals,
+                "cumulative_values": cum_totals,
+                "total_stacked_value": round(prev_top_val - y_val_bottom, 6),
+            }
+        )
+
+    candles_out: list[dict[str, Any]] = []
+    for cx0, cx1 in candle_x_ranges:
+        xc = (cx0 + cx1) // 2
+        bull_ys: list[int] = []
+        bear_ys: list[int] = []
+        wick_ys: list[int] = []
+        for y in range(y_lo_px, y_hi_px + 1):
+            for x in range(max(0, cx0), min(w, cx1 + 1)):
+                px = image.getpixel((x, y))[:3]
+                if _rgb_dist(px, bullish_body_color) <= color_tol:
+                    bull_ys.append(y)
+                elif _rgb_dist(px, bearish_body_color) <= color_tol:
+                    bear_ys.append(y)
+            px_c = image.getpixel((xc, y))[:3]
+            if _rgb_dist(px_c, wick_color) <= color_tol:
+                wick_ys.append(y)
+        is_bull = len(bull_ys) >= len(bear_ys)
+        body_ys = bull_ys if is_bull else bear_ys
+        if not body_ys:
+            raise ChartProfessionalSemanticsV2Error("CANDLESTICK_BODY_NOT_FOUND")
+        body_top_py = float(min(body_ys))
+        body_bot_py = float(max(body_ys))
+        all_ys = body_ys + wick_ys
+        hi_py = float(min(all_ys))
+        lo_py = float(max(all_ys))
+        v_top = _px_to_val(body_top_py)
+        v_bot = _px_to_val(body_bot_py)
+        v_hi = _px_to_val(hi_py)
+        v_lo = _px_to_val(lo_py)
+        open_v = v_bot if is_bull else v_top
+        close_v = v_top if is_bull else v_bot
+        candles_out.append(
+            {
+                "x_range": [cx0, cx1],
+                "direction": "BULLISH" if is_bull else "BEARISH",
+                "open": round(open_v, 6),
+                "high": round(v_hi, 6),
+                "low": round(v_lo, 6),
+                "close": round(close_v, 6),
+                "body_span": round(abs(close_v - open_v), 6),
+                "upper_wick": round(v_hi - max(open_v, close_v), 6),
+                "lower_wick": round(min(open_v, close_v) - v_lo, 6),
+            }
+        )
+
+    return {
+        "pass": True,
+        "stacked_column_count": len(stacked_columns),
+        "stacked_columns": stacked_columns,
+        "candle_count": len(candles_out),
+        "candles": candles_out,
+    }
+
+
+_TRUETYPE_TEMPLATE_CACHE: dict[tuple[str, int], dict[str, tuple[list[float], float, int, int]]] = {}
+_TRUETYPE_CHARSET = "0123456789.-^kmsVHzCK%"
+
+
+def _resolve_truetype_font_path(font_family: str = "DejaVuSans") -> str:
+    candidates = [
+        pathlib.Path(f"/usr/share/fonts/truetype/dejavu/{font_family}.ttf"),
+        pathlib.Path(f"/home/user/pydeps/venv/lib/python3.11/site-packages/matplotlib/mpl-data/fonts/ttf/{font_family}.ttf"),
+    ]
+    for p in candidates:
+        if p.is_file():
+            return str(p)
+    # Fallback search in /usr/share/fonts
+    for p in pathlib.Path("/usr/share/fonts").rglob(f"{font_family}*.ttf"):
+        return str(p)
+    raise ChartProfessionalSemanticsV2Error(f"TRUETYPE_FONT_NOT_FOUND:{font_family}")
+
+
+def _extract_normalized_patch(
+    image: Any,
+    x0: int,
+    y0: int,
+    x1: int,
+    y1: int,
+    grid_w: int = 12,
+    grid_h: int = 16,
+) -> tuple[list[float], float]:
+    w = max(1, x1 - x0 + 1)
+    h = max(1, y1 - y0 + 1)
+    vec: list[float] = []
+    for gy in range(grid_h):
+        sy0 = y0 + (gy * h) / float(grid_h)
+        sy1 = y0 + ((gy + 1) * h) / float(grid_h)
+        iy0 = int(math.floor(sy0))
+        iy1 = max(iy0, int(math.ceil(sy1) - 1))
+        for gx in range(grid_w):
+            sx0 = x0 + (gx * w) / float(grid_w)
+            sx1 = x0 + ((gx + 1) * w) / float(grid_w)
+            ix0 = int(math.floor(sx0))
+            ix1 = max(ix0, int(math.ceil(sx1) - 1))
+            s_ink = 0.0
+            cnt = 0
+            for py in range(iy0, iy1 + 1):
+                for px in range(ix0, ix1 + 1):
+                    r, g, b = image.getpixel((px, py))[:3]
+                    lum = (float(r) + float(g) + float(b)) / 3.0
+                    s_ink += max(0.0, min(1.0, (255.0 - lum) / 235.0))
+                    cnt += 1
+            vec.append(s_ink / max(1, cnt))
+    norm = math.sqrt(sum(v * v for v in vec))
+    return vec, norm
+
+
+def _get_truetype_templates(
+    font_family: str = "DejaVuSans",
+    font_size: int = 15,
+) -> dict[str, tuple[list[float], float, int, int]]:
+    key = (font_family, int(font_size))
+    if key in _TRUETYPE_TEMPLATE_CACHE:
+        return _TRUETYPE_TEMPLATE_CACHE[key]
+    from PIL import Image, ImageDraw, ImageFont
+
+    ttf_path = _resolve_truetype_font_path(font_family)
+    font = ImageFont.truetype(ttf_path, size=int(font_size))
+    bank: dict[str, tuple[list[float], float, int, int]] = {}
+    for ch in _TRUETYPE_CHARSET:
+        canvas = Image.new("RGB", (40, 40), (255, 255, 255))
+        dr = ImageDraw.Draw(canvas)
+        dr.text((4, 4), ch, fill=(0, 0, 0), font=font)
+        xs: list[int] = []
+        ys: list[int] = []
+        for py in range(40):
+            for px in range(40):
+                r, g, b = canvas.getpixel((px, py))[:3]
+                if (r + g + b) / 3.0 < 235.0:
+                    xs.append(px)
+                    ys.append(py)
+        if not xs or not ys:
+            continue
+        gx0, gx1 = min(xs), max(xs)
+        gy0, gy1 = min(ys), max(ys)
+        vec, norm = _extract_normalized_patch(canvas, gx0, gy0, gx1, gy1)
+        bank[ch] = (vec, norm, gx1 - gx0 + 1, gy1 - gy0 + 1)
+    _TRUETYPE_TEMPLATE_CACHE[key] = bank
+    return bank
+
