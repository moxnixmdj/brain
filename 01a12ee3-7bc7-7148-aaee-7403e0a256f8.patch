--- /dev/null
+++ b/canonical/tests/test_constructive_terminal_residuals_closure_v1.py
@@ -0,0 +1,94 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import unittest
+
+from canonical.runtime import (
+    bytes_exact_symbolic_v82_physical_cut_v1 as bytes_v82,
+    composition_12_component_observational_quotient_closure_v1 as comp12,
+    finance_uncovered_scope_regcap_closure_v1 as fin_regcap,
+    tb_science_koopman_mfg_rational_solver_v1 as koopman,
+    terminal_candidate_six_conjunct_cleanroom_closure_v1 as six_conjunct,
+)
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+class ConstructiveTerminalResidualsClosureV1Tests(unittest.TestCase):
+    def test_bytes_v82_physical_cut_under_256kib_and_12_of_12_tasks(self):
+        res = bytes_v82.evaluate(ROOT)
+        self.assertTrue(res["pass"], res)
+        self.assertEqual(res["passed_tasks"], 12)
+        self.assertEqual(res["total_tasks"], 12)
+        self.assertLessEqual(res["v82_xz_persistent_bytes"], 262_144)
+        self.assertLessEqual(res["v82_raw_python_bytes"], 262_144)
+        self.assertEqual(res["external_donor_dependency_count"], 0)
+        persisted = json.loads(
+            (ROOT / "canonical/governance/BYTES_EXACT_SYMBOLIC_V82_PHYSICAL_CUT_20261012_V1.json").read_text(
+                encoding="utf-8"
+            )
+        )
+        self.assertEqual(persisted["certificate_sha256"], res["certificate_sha256"])
+
+    def test_tb_science_koopman_mfg_rational_solver_zero_duality_gap(self):
+        res = koopman.evaluate(ROOT)
+        self.assertTrue(res["pass"], res)
+        self.assertEqual(res["witness"]["duality_gap_exact"], "0")
+        self.assertTrue(res["witness"]["primal_feasible"])
+        self.assertTrue(res["witness"]["dual_feasible"])
+        self.assertTrue(res["witness"]["minimax_residual_le_1e_15"])
+        persisted = json.loads(
+            (ROOT / "canonical/verification/TB_SCIENCE_KOOPMAN_MFG_RATIONAL_CERTIFICATE_20261012_V1.json").read_text(
+                encoding="utf-8"
+            )
+        )
+        self.assertEqual(persisted["certificate_sha256"], res["certificate_sha256"])
+
+    def test_finance_45_routes_and_4way_regcap_and_2_oracle_leaves(self):
+        res = fin_regcap.evaluate(ROOT)
+        self.assertTrue(res["pass"], res)
+        self.assertTrue(res["finance_45_routes_verified"])
+        self.assertTrue(res["four_way_regcap_partition"]["four_way_bijective_separation"])
+        self.assertTrue(res["direct_oracle_leaves"]["pass"])
+        persisted = json.loads(
+            (ROOT / "canonical/verification/FINANCE_UNCOVERED_SCOPE_REGCAP_CLOSURE_20261012_V1.json").read_text(
+                encoding="utf-8"
+            )
+        )
+        self.assertEqual(persisted["certificate_sha256"], res["certificate_sha256"])
+
+    def test_composition_12_components_and_b0_b2_b4_b7_b9_quotient(self):
+        res = comp12.evaluate(ROOT)
+        self.assertTrue(res["pass"], res)
+        self.assertEqual(res["proved_component_count"], 12)
+        self.assertEqual(res["component_count"], 12)
+        self.assertTrue(res["adaptive_cover_induction"]["pass"])
+        self.assertTrue(res["constructive_U_empty_over_selected_overapproximation"])
+        persisted = json.loads(
+            (
+                ROOT
+                / "canonical/verification/COMPOSITION_12_COMPONENT_OBSERVATIONAL_QUOTIENT_CLOSURE_20261012_V1.json"
+            ).read_text(encoding="utf-8")
+        )
+        self.assertEqual(persisted["certificate_sha256"], res["certificate_sha256"])
+
+    def test_terminal_candidate_six_conjunct_cleanroom_and_universal_cover(self):
+        res = six_conjunct.evaluate(ROOT)
+        self.assertTrue(res["pass"], res)
+        self.assertTrue(res["six_conjunct_cleanroom_gate"]["pass"])
+        self.assertEqual(res["six_conjunct_cleanroom_gate"]["errors"], [])
+        self.assertTrue(res["global_ownership_postconditions"]["pass"])
+        self.assertTrue(res["universal_cover_terminal_closure"]["achieved"])
+        self.assertEqual(res["universal_cover_terminal_closure"]["failed_predicates"], [])
+        persisted = json.loads(
+            (
+                ROOT
+                / "canonical/verification/TERMINAL_CANDIDATE_SIX_CONJUNCT_CLEANROOM_VERIFICATION_20261012_V1.json"
+            ).read_text(encoding="utf-8")
+        )
+        self.assertEqual(persisted["certificate_sha256"], res["certificate_sha256"])
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
