+def extract_boxplot_quartiles_and_dual_axis(
+    image: Any,
+    box_x_ranges: Sequence[tuple[int, int]],
+    *,
+    y_pixel_bottom: float,
+    y_pixel_top: float,
+    y_val_bottom: float,
+    y_val_top: float,
+    box_fill_color: tuple[int, int, int],
+    median_line_color: tuple[int, int, int],
+    whisker_color: tuple[int, int, int],
+    right_y_val_bottom: float | None = None,
+    right_y_val_top: float | None = None,
+    color_tol: float = 28.0,
+) -> dict[str, Any]:
+    """Extract boxplot Q1, median (Q2), Q3, IQR (Q3 - Q1), and lower/upper whisker extremes across primary and optional secondary (dual) Y axes."""
+    w, h = image.size
+
+    def _rgb_dist(a: tuple[int, int, int], b: tuple[int, int, int]) -> float:
+        return math.sqrt(sum((int(x) - int(y)) ** 2 for x, y in zip(a[:3], b[:3])))
+
+    def _px_to_val(py: float, vb: float, vt: float) -> float:
+        return vb + (y_pixel_bottom - py) / (y_pixel_bottom - y_pixel_top) * (vt - vb)
+
+    boxes_out: list[dict[str, Any]] = []
+    for bx0, bx1 in box_x_ranges:
+        xc = (bx0 + bx1) // 2
+        box_ys: list[int] = []
+        med_ys: list[int] = []
+        whisk_ys: list[int] = []
+        for y in range(max(0, int(min(y_pixel_top, y_pixel_bottom))), min(h, int(max(y_pixel_top, y_pixel_bottom)) + 1)):
+            for x in range(max(0, bx0), min(w, bx1 + 1)):
+                px = image.getpixel((x, y))[:3]
+                if _rgb_dist(px, median_line_color) <= color_tol:
+                    med_ys.append(y)
+                elif _rgb_dist(px, box_fill_color) <= color_tol:
+                    box_ys.append(y)
+            px_c = image.getpixel((xc, y))[:3]
+            if _rgb_dist(px_c, whisker_color) <= color_tol:
+                whisk_ys.append(y)
+        all_box_ys = box_ys + med_ys
+        if not all_box_ys or not med_ys:
+            raise ChartProfessionalSemanticsV2Error("BOXPLOT_QUARTILES_NOT_FOUND")
+        py_q3 = float(min(all_box_ys))
+        py_q1 = float(max(all_box_ys))
+        py_med = sum(med_ys) / len(med_ys)
+        all_w_ys = whisk_ys + all_box_ys
+        py_hi = float(min(all_w_ys))
+        py_lo = float(max(all_w_ys))
+
+        q1 = _px_to_val(py_q1, y_val_bottom, y_val_top)
+        q2 = _px_to_val(py_med, y_val_bottom, y_val_top)
+        q3 = _px_to_val(py_q3, y_val_bottom, y_val_top)
+        w_lo = _px_to_val(py_lo, y_val_bottom, y_val_top)
+        w_hi = _px_to_val(py_hi, y_val_bottom, y_val_top)
+        row: dict[str, Any] = {
+            "x_range": [bx0, bx1],
+            "q1": round(q1, 6),
+            "median": round(q2, 6),
+            "q3": round(q3, 6),
+            "iqr": round(q3 - q1, 6),
+            "whisker_low": round(w_lo, 6),
+            "whisker_high": round(w_hi, 6),
+        }
+        if right_y_val_bottom is not None and right_y_val_top is not None:
+            rq1 = _px_to_val(py_q1, right_y_val_bottom, right_y_val_top)
+            rq2 = _px_to_val(py_med, right_y_val_bottom, right_y_val_top)
+            rq3 = _px_to_val(py_q3, right_y_val_bottom, right_y_val_top)
+            row["right_axis_q1"] = round(rq1, 6)
+            row["right_axis_median"] = round(rq2, 6)
+            row["right_axis_q3"] = round(rq3, 6)
+            row["right_axis_iqr"] = round(rq3 - rq1, 6)
+        boxes_out.append(row)
+    return {
+        "pass": True,
+        "box_count": len(boxes_out),
+        "boxes": boxes_out,
+    }
+
