+def _num(p: int, q: int = 1):
+    f = Fraction(int(p), int(q))
+    num, den = f.numerator, f.denominator
+    if den == 1:
+        if num == 0:
+            return ZERO
+        if num == 1:
+            return ONE
+        if num == -1:
+            return NEG_ONE
+        return Integer(num, 1)
+    if num == 1 and den == 2:
+        return HALF
+    return Rational(num, den)
