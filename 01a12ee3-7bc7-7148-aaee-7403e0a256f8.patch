+    c29_ok = max_tk_err < 1e-12
+    checks["TEAGER_KAISER_NONLINEAR_ENERGY_OPERATOR_AM_FM_INSTANTANEOUS_DEMODULATION"] = {
+        "pass": c29_ok,
+        "expected_teager_energy": round(expected_tk, 8),
+        "max_invariance_error": round(max_tk_err, 14),
+    }
