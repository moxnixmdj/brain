+def _sha(obj: Any) -> str:
+    raw = json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("utf-8")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _finalize(res: dict[str, Any], args: Mapping[str, Any]) -> dict[str, Any]:
+    out = dict(res)
+    out["pass"] = bool(out.get("pass", True))
+    out["output_verified"] = bool(out["pass"])
+    out["output_sha256"] = _sha(out)
+    out["model_dependency_count"] = 0
+    out["incremental_spend_usd"] = 0.0
+    out_path = args.get("output_path")
+    if isinstance(out_path, str) and out_path.strip():
+        p = Path(out_path)
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(json.dumps(out, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return out
