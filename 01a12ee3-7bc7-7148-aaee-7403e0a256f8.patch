+def hit_test_svg_canvas_vector_paths_and_dispatch(
+    query_pt: tuple[float, float] = (50.0, 50.0),
+) -> dict[str, Any]:
+    """Compute signed winding numbers and even-odd vs. nonzero fill-rule hit-testing on 2D SVG/Canvas vector paths."""
+    # Shape 1: Self-overlapping / double-loop polygon with interior hole [30,70]x[30,70] wound in SAME direction (+2 winding inside hole)
+    # Under nonzero rule: winding=2 != 0 (INSIDE). Under evenodd rule: 2 % 2 == 0 (OUTSIDE hole).
+    outer_ring = [(10.0, 10.0), (90.0, 10.0), (90.0, 90.0), (10.0, 90.0)]
+    inner_same_dir = [(30.0, 30.0), (70.0, 30.0), (70.0, 70.0), (30.0, 70.0)]
+    inner_opp_dir = [(30.0, 30.0), (30.0, 70.0), (70.0, 70.0), (70.0, 30.0)]
+
+    def _ring_winding_number(pt: tuple[float, float], ring: list[tuple[float, float]]) -> int:
+        px, py = pt
+        wn = 0
+        m = len(ring)
+        for i in range(m):
+            x1, y1 = ring[i]
+            x2, y2 = ring[(i + 1) % m]
+            if y1 <= py:
+                if y2 > py:
+                    cross = (x2 - x1) * (py - y1) - (px - x1) * (y2 - y1)
+                    if cross > 0.0:
+                        wn += 1
+            else:
+                if y2 <= py:
+                    cross = (x2 - x1) * (py - y1) - (px - x1) * (y2 - y1)
+                    if cross < 0.0:
+                        wn -= 1
+        return wn
+
+    w_same = _ring_winding_number(query_pt, outer_ring) + _ring_winding_number(query_pt, inner_same_dir)
+    w_opp = _ring_winding_number(query_pt, outer_ring) + _ring_winding_number(query_pt, inner_opp_dir)
+
+    shapes = [
+        {
+            "id": "svg-donut-evenodd",
+            "z_index": 10,
+            "fill_rule": "evenodd",
+            "rings": [outer_ring, inner_same_dir],
+        },
+        {
+            "id": "canvas-badge-nonzero",
+            "z_index": 20,
+            "fill_rule": "nonzero",
+            "rings": [outer_ring, inner_same_dir],
+        },
+    ]
+    hits: list[str] = []
+    for sh in sorted(shapes, key=lambda s: int(s["z_index"]), reverse=True):
+        total_w = sum(_ring_winding_number(query_pt, r) for r in sh["rings"])  # type: ignore[arg-type]
+        inside = (total_w != 0) if sh["fill_rule"] == "nonzero" else ((abs(total_w) % 2) == 1)
+        if inside:
+            hits.append(str(sh["id"]))
+
+    return {
+        "query_point": query_pt,
+        "same_orientation_winding_number": w_same,
+        "opposite_orientation_winding_number": w_opp,
+        "nonzero_inside_same_orientation": w_same != 0,
+        "evenodd_inside_same_orientation": (abs(w_same) % 2) == 1,
+        "topmost_hit_shape_id": hits[0] if hits else None,
+        "all_hit_shape_ids": hits,
+    }
+
