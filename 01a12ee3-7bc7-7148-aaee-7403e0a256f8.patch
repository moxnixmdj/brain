+    # Expected counts under independence: E_{ij} = (50 * 40)/100 = 20 for row 0, (50 * 60)/100 = 30 for row 1
+    # Chi^2 = (30-20)^2/20 + (10-20)^2/20 + (20-30)^2/30 + (40-30)^2/30 = 5 + 5 + 10/3 + 10/3 = 50/3
+    mosaic_counts = [[30.0, 10.0], [20.0, 40.0]]
+    n_tot_m = sum(sum(r_m) for r_m in mosaic_counts)
+    col_totals_m = [mosaic_counts[0][c_i] + mosaic_counts[1][c_i] for c_i in range(2)]
+    row_totals_m = [sum(mosaic_counts[r_i]) for r_i in range(2)]
+    col_widths_m = [ct / n_tot_m for ct in col_totals_m]
+    cell_areas_m = [
+        [(mosaic_counts[r_i][c_i] / col_totals_m[c_i]) * col_widths_m[c_i] for c_i in range(2)]
+        for r_i in range(2)
+    ]
+    chi2_stat = sum(
+        ((mosaic_counts[r_i][c_i] - (row_totals_m[r_i] * col_totals_m[c_i] / n_tot_m)) ** 2)
+        / (row_totals_m[r_i] * col_totals_m[c_i] / n_tot_m)
+        for r_i in range(2)
+        for c_i in range(2)
+    )
+    checks.append(
+        {
+            "check_id": "MARIMEKKO_MOSAIC_VARIABLE_WIDTH_STACKED_COLUMN_JOINT_PROBABILITY_TABLE",
+            "pass": bool(
+                abs(sum(col_widths_m) - 1.0) < 1e-12
+                and abs(sum(sum(r_a) for r_a in cell_areas_m) - 1.0) < 1e-12
+                and abs(cell_areas_m[0][0] - 0.30) < 1e-12
+                and abs(chi2_stat - (50.0 / 3.0)) < 1e-9
+            ),
+        }
+    )
+
+    # Check 42: Ternary Barycentric 2-Simplex Phase Diagram Coordinate Projection & Exact Inversion
+    # Forward projection: x = 0.5 * (2*b + c), y = (sqrt(3)/2) * c, where a + b + c = 1
+    # Inverse recovery: c = (2/sqrt(3)) * y, b = x - 0.5 * c, a = 1 - b - c
+    ternary_samples = [
+        (0.5, 0.3, 0.2),
+        (1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0),
+        (0.0, 0.65, 0.35),
+    ]
+    max_tern_err = 0.0
+    for a_t, b_t, c_t in ternary_samples:
+        x_cart = 0.5 * (2.0 * b_t + c_t)
+        y_cart = (math.sqrt(3.0) / 2.0) * c_t
+        c_rec = (2.0 / math.sqrt(3.0)) * y_cart
+        b_rec = x_cart - 0.5 * c_rec
+        a_rec = 1.0 - b_rec - c_rec
+        max_tern_err = max(max_tern_err, abs(a_rec - a_t), abs(b_rec - b_t), abs(c_rec - c_t))
+    checks.append(
+        {
+            "check_id": "TERNARY_BARYCENTRIC_SIMPLEX_PHASE_DIAGRAM_COORDINATE_INVERSION",
+            "pass": bool(max_tern_err < 1e-12),
+        }
+    )
+
+    # Check 43: Nelson-Aalen Cumulative Hazard H(t) = sum(d_i / n_i) & Fleming-Harrington Survival Bound exp(-H(t)) >= S_KM(t)
+    na_events = [(20, 2), (18, 3), (15, 3), (12, 4)]  # (at_risk n_i, events d_i)
+    h_cum = 0.0
+    h_var = 0.0
+    s_km = 1.0
+    fh_dominates_km = True
+    for n_i, d_i in na_events:
+        h_cum += float(d_i) / float(n_i)
+        h_var += float(d_i) / float(n_i * n_i)
+        s_km *= (1.0 - float(d_i) / float(n_i))
+        s_fh = math.exp(-h_cum)
+        if s_fh + 1e-12 < s_km:
+            fh_dominates_km = False
+    # Exact H(t_4) = 2/20 + 3/18 + 3/15 + 4/12 = 1/10 + 1/6 + 1/5 + 1/3 = 4/5 = 0.80
+    checks.append(
+        {
+            "check_id": "NELSON_AALEN_CUMULATIVE_HAZARD_AND_FLEMING_HARRINGTON_SURVIVAL_CONSISTENCY",
+            "pass": bool(
+                abs(h_cum - 0.80) < 1e-12
+                and h_var > 0.0
+                and fh_dominates_km is True
+                and abs(s_km - (0.9 * (5.0 / 6.0) * 0.8 * (2.0 / 3.0))) < 1e-12
+            ),
+        }
+    )
