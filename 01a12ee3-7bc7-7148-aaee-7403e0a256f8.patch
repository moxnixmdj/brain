+    bits_in = [1, 0, 1, 1, 0, 0, 1, 0, 1, 1]
+    p0_prob = 0.4
+    low_c, high_c = 0.0, 1.0
+    for b_sym in bits_in:
+        mid_c = low_c + (high_c - low_c) * p0_prob
+        if b_sym == 0:
+            high_c = mid_c
+        else:
+            low_c = mid_c
+    code_tag = 0.5 * (low_c + high_c)
+    bits_out: list[int] = []
+    l_dec, h_dec = 0.0, 1.0
+    for _ in range(len(bits_in)):
+        m_dec = l_dec + (h_dec - l_dec) * p0_prob
+        if code_tag < m_dec:
+            bits_out.append(0)
+            h_dec = m_dec
+        else:
+            bits_out.append(1)
+            l_dec = m_dec
+    c22_ok = (post_jump < pre_jump and bits_out == bits_in)
+    checks["H264_DEBLOCKING_ADAPTIVE_BOUNDARY_STRENGTH_AND_CABAC_ARITHMETIC_CODER"] = {
+        "pass": c22_ok,
+        "pre_deblock_boundary_jump": pre_jump,
+        "post_deblock_boundary_jump": post_jump,
+        "cabac_decoded_bits": bits_out,
+    }
+
+    # 23. STFT Phase Vocoder Time-Stretch & Instantaneous Frequency Principal Phase Unwrapping
+    n_fft_pv = 64
+    hop_a = 16
+    hop_s = 24  # 1.5x time-stretch
+    bin_k = 5
+    delta_f = 0.25  # fractional bin offset -> true frequency is (5 + 0.25) cycles per N_fft
+    omega_k = 2.0 * math.pi * float(bin_k) / float(n_fft_pv)
+    true_omega = 2.0 * math.pi * (float(bin_k) + delta_f) / float(n_fft_pv)
+    phi_m0 = 0.3
+    phi_m1 = (phi_m0 + true_omega * hop_a + math.pi) % (2.0 * math.pi) - math.pi
+    raw_diff = phi_m1 - phi_m0 - omega_k * hop_a
+    princ_diff = (raw_diff + math.pi) % (2.0 * math.pi) - math.pi
+    inst_omega = omega_k + princ_diff / float(hop_a)
+    synth_phase_m1 = phi_m0 + inst_omega * hop_s
+    c23_ok = (
+        abs(inst_omega - true_omega) < 1e-12
+        and abs((synth_phase_m1 - phi_m0) / (phi_m0 + true_omega * hop_a - phi_m0) - 1.5) < 1e-12
+    )
+    checks["STFT_PHASE_VOCODER_TIME_STRETCH_AND_INSTANTANEOUS_FREQUENCY_UNWRAPPING"] = {
+        "pass": c23_ok,
+        "true_angular_frequency": round(true_omega, 8),
+        "recovered_instantaneous_frequency": round(inst_omega, 8),
+        "stretch_ratio": round(hop_s / float(hop_a), 4),
