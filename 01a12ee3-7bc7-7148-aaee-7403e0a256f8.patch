+                out_kelly = str(kelly_spec.get("output") or "wager_amount")
+                val_kelly = f_star if out_kelly == "fraction" else wager_amt
+                pred_kelly = int(val_kelly) if val_kelly.denominator == 1 else round(float(val_kelly), 6)
+                candidate_hypotheses.insert(0, {
