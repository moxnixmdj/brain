+def solve_chart(
+    image: Any,
+    *,
+    x_tick_boxes: Sequence[tuple[float, tuple[int, int, int, int]]],
+    y_tick_boxes: Sequence[tuple[float, tuple[int, int, int, int]]],
+    x_unit_box: tuple[int, int, int, int],
+    y_unit_box: tuple[int, int, int, int],
+    query_pixel_x: float,
+    query_pixel_y: float,
+    target_x_unit: str | None = None,
+    target_y_unit: str | None = None,
+    right_y_tick_boxes: Sequence[tuple[float, tuple[int, int, int, int]]] | None = None,
+    right_y_unit_box: tuple[int, int, int, int] | None = None,
+    target_right_y_unit: str | None = None,
+    stacked_area_and_candlestick_spec: Mapping[str, Any] | None = None,
+    use_truetype_ocr: bool = False,
+) -> dict[str, Any]:
+    """End-to-end raster chart solver integrating anti-aliased NCC glyph strip decoding, proportional TrueType multi-font OCR, auto-detected linear/log10 primary & secondary (dual) axis calibration, and dimensional conversion."""
+    def _decode_box(box: tuple[int, int, int, int]) -> str:
+        if use_truetype_ocr:
+            return str(decode_truetype_proportional_glyph_strip(image, box)["decoded_text"])
+        try:
+            return str(auto_decode_oriented_bitmap_strip(image, box)["decoded_text"])
+        except ChartProfessionalSemanticsV2Error:
+            try:
+                return str(decode_antialiased_merged_glyph_strip(image, box)["decoded_text"])
+            except ChartProfessionalSemanticsV2Error:
+                return str(decode_truetype_proportional_glyph_strip(image, box)["decoded_text"])
+
+    x_anchors = [(float(px), _decode_box(b)) for px, b in x_tick_boxes]
+    y_anchors = [(float(py), _decode_box(b)) for py, b in y_tick_boxes]
+    x_unit = _decode_box(x_unit_box)
+    y_unit = _decode_box(y_unit_box)
+
+    x_cal = calibrate_linear_or_log10_axis(x_anchors, float(query_pixel_x))
+    y_cal = calibrate_linear_or_log10_axis(y_anchors, float(query_pixel_y))
+    x_val = float(x_cal["evaluated_value"])
+    y_val = float(y_cal["evaluated_value"])
+    conv_x = (
+        float(convert_chart_quantity(x_val, x_unit, target_x_unit)["converted_value"])
+        if target_x_unit
+        else x_val
+    )
+    conv_y = (
+        float(convert_chart_quantity(y_val, y_unit, target_y_unit)["converted_value"])
+        if target_y_unit
+        else y_val
+    )
+    out: dict[str, Any] = {
+        "pass": True,
+        "x_axis_scale_law": x_cal["axis_scale_law"],
+        "y_axis_scale_law": y_cal["axis_scale_law"],
+        "decoded_x_unit": x_unit,
+        "decoded_y_unit": y_unit,
+        "evaluated_x": x_val,
+        "evaluated_y": y_val,
+        "converted_x": conv_x,
+        "converted_y": conv_y,
+    }
+    if right_y_tick_boxes and right_y_unit_box is not None:
+        ry_anchors = [(float(py), _decode_box(b)) for py, b in right_y_tick_boxes]
+        ry_unit = _decode_box(right_y_unit_box)
+        ry_cal = calibrate_linear_or_log10_axis(ry_anchors, float(query_pixel_y))
+        ry_val = float(ry_cal["evaluated_value"])
+        conv_ry = (
+            float(convert_chart_quantity(ry_val, ry_unit, target_right_y_unit)["converted_value"])
+            if target_right_y_unit
+            else ry_val
+        )
+        out["right_y_axis_scale_law"] = ry_cal["axis_scale_law"]
+        out["decoded_right_y_unit"] = ry_unit
+        out["evaluated_right_y"] = ry_val
+        out["converted_right_y"] = conv_ry
+    if stacked_area_and_candlestick_spec is not None:
+        spec = dict(stacked_area_and_candlestick_spec)
+        sac_res = extract_stacked_area_and_candlestick_ohlc(
+            image,
+            y_pixel_bottom=float(spec["y_pixel_bottom"]),
+            y_pixel_top=float(spec["y_pixel_top"]),
+            y_val_bottom=float(spec["y_val_bottom"]),
+            y_val_top=float(spec["y_val_top"]),
+            sample_xs=list(spec.get("sample_xs", ())),
+            band_colors=[tuple(c) for c in spec.get("band_colors", ())],
+            candle_x_ranges=[tuple(r) for r in spec.get("candle_x_ranges", ())],
+            bullish_body_color=tuple(spec.get("bullish_body_color", (30, 180, 90))),
+            bearish_body_color=tuple(spec.get("bearish_body_color", (220, 50, 50))),
+            wick_color=tuple(spec.get("wick_color", (25, 25, 25))),
+        )
+        out["stacked_area_and_candlestick"] = sac_res
+    return out
