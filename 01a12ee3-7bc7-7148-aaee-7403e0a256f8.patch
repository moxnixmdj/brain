+                prob_p = Fraction(str(kelly_spec.get("win_probability", "3/5")))
+                prob_q = Fraction(1, 1) - prob_p
+                odds_b = Fraction(str(kelly_spec.get("net_odds", 2)))
+                edge_g = odds_b * prob_p - prob_q
