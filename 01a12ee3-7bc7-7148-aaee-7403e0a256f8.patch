+    c9_ok = detected_cuts == [4]
+    checks["SCENE_CUT_AND_TEMPORAL_CHANGE_DETECTION"] = {
+        "pass": c9_ok,
+        "detected_cut_frames": detected_cuts,
+        "max_frame_flux": max(fluxes),
+    }
