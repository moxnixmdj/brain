+def _parse_scientific_tick_label(label: str) -> float:
+    s = str(label).strip()
+    if "^" in s:
+        base_s, exp_s = s.split("^", 1)
+        return float(base_s) ** float(exp_s)
+    return float(s)
+
+
+def calibrate_linear_or_log10_axis(
+    tick_anchors: Sequence[tuple[float, str | float]],
+    query_pixel: float,
+) -> dict[str, Any]:
+    """Automatically detect linear vs. log10 coordinate law from (pixel, tick_label) anchors and evaluate query_pixel."""
+    if len(tick_anchors) < 3:
+        raise ChartProfessionalSemanticsV2Error("AT_LEAST_3_TICK_ANCHORS_REQUIRED")
+    pts = [(float(px), _parse_scientific_tick_label(val)) for px, val in tick_anchors]
+    p0, v0 = pts[0]
+    p1, v1 = pts[-1]
+    if abs(p1 - p0) < 1e-9:
+        raise ChartProfessionalSemanticsV2Error("DEGENERATE_AXIS_PIXEL_SPAN")
+
+    # 1. Affine Linear hypothesis: v(px) = a_lin * px + b_lin
+    a_lin = (v1 - v0) / (p1 - p0)
+    b_lin = v0 - a_lin * p0
+    lin_res = max(abs((a_lin * px + b_lin) - v) / max(1.0, abs(v)) for px, v in pts)
+
+    # 2. Logarithmic base-10 hypothesis: log10(v(px)) = a_log * px + b_log (valid when all v > 0)
+    log_res = float("inf")
+    a_log = 0.0
+    b_log = 0.0
+    if all(v > 0.0 for _, v in pts):
+        lv0, lv1 = math.log10(v0), math.log10(v1)
+        a_log = (lv1 - lv0) / (p1 - p0)
+        b_log = lv0 - a_log * p0
+        log_res = max(abs((a_log * px + b_log) - math.log10(v)) for px, v in pts)
+
+    if log_res < 1e-6 and log_res < lin_res:
+        val_q = 10.0 ** (a_log * float(query_pixel) + b_log)
+        return {
+            "pass": True,
+            "axis_scale_law": "LOG10",
+            "residual_error": round(log_res, 12),
+            "query_pixel": float(query_pixel),
+            "evaluated_value": val_q,
+        }
+    if lin_res < 1e-6:
+        val_q = a_lin * float(query_pixel) + b_lin
+        return {
+            "pass": True,
+            "axis_scale_law": "LINEAR",
+            "residual_error": round(lin_res, 12),
+            "query_pixel": float(query_pixel),
+            "evaluated_value": val_q,
+        }
+    raise ChartProfessionalSemanticsV2Error("NEITHER_LINEAR_NOR_LOG10_AXIS_LAW_EXACT")
+
+
+def extract_stacked_bar_and_error_bars(
+    image: Any,
+    *,
+    plot_box: tuple[int, int, int, int],
+    bar_center_xs: Sequence[int],
+    series_colors: Sequence[tuple[int, int, int]],
+    y_tick_anchors: Sequence[tuple[float, str | float]],
+    whisker_rgb: tuple[int, int, int] = (20, 20, 20),
+) -> dict[str, Any]:
+    """Extract stacked-bar segment heights and error-bar whisker confidence intervals from a raw RGB raster."""
+    x_min, y_min, x_max, y_max = [int(v) for v in plot_box]
+    bars_out: list[dict[str, Any]] = []
+    for bx in bar_center_xs:
+        cx = int(bx)
+        segments: list[dict[str, Any]] = []
+        top_bar_py = y_max
+        for s_idx, s_rgb in enumerate(series_colors):
+            ys_hit: list[int] = []
+            # Scan 3px away from center column to avoid center error-bar whisker stem
+            sample_x = min(x_max - 1, cx + 4)
+            for py in range(y_min, y_max + 1):
+                r, g, b = image.getpixel((sample_x, py))[:3]
+                if abs(r - s_rgb[0]) <= 15 and abs(g - s_rgb[1]) <= 15 and abs(b - s_rgb[2]) <= 15:
+                    ys_hit.append(py)
+            if not ys_hit:
+                raise ChartProfessionalSemanticsV2Error(f"MISSING_STACKED_BAR_SEGMENT:{s_idx}")
+            seg_top_py = min(ys_hit)
+            seg_bot_py = max(ys_hit) + 1
+            top_bar_py = min(top_bar_py, seg_top_py)
+            v_top = float(calibrate_linear_or_log10_axis(y_tick_anchors, float(seg_top_py))["evaluated_value"])
+            v_bot = float(calibrate_linear_or_log10_axis(y_tick_anchors, float(seg_bot_py))["evaluated_value"])
+            segments.append(
+                {
+                    "series_index": s_idx,
+                    "value_bottom": round(v_bot, 6),
+                    "value_top": round(v_top, 6),
+                    "segment_height": round(v_top - v_bot, 6),
+                }
+            )
+        # Scan center column cx for error-bar whisker stem/caps in whisker_rgb
+        whisker_ys: list[int] = []
+        for py in range(y_min, y_max):
+            r, g, b = image.getpixel((cx, py))[:3]
+            if abs(r - whisker_rgb[0]) <= 20 and abs(g - whisker_rgb[1]) <= 20 and abs(b - whisker_rgb[2]) <= 20:
+                whisker_ys.append(py)
+        if not whisker_ys:
+            raise ChartProfessionalSemanticsV2Error("MISSING_ERROR_BAR_WHISKER")
+        w_hi_py = min(whisker_ys)
+        w_lo_py = max(whisker_ys)
+        v_ci_hi = float(calibrate_linear_or_log10_axis(y_tick_anchors, float(w_hi_py))["evaluated_value"])
+        v_ci_lo = float(calibrate_linear_or_log10_axis(y_tick_anchors, float(w_lo_py))["evaluated_value"])
+        v_total = sum(s["segment_height"] for s in segments)
+        bars_out.append(
+            {
+                "bar_center_x": cx,
+                "segments": segments,
+                "stack_total": round(v_total, 6),
+                "ci_lower": round(v_ci_lo, 6),
+                "ci_upper": round(v_ci_hi, 6),
+                "error_plus": round(v_ci_hi - v_total, 6),
+                "error_minus": round(v_total - v_ci_lo, 6),
+            }
+        )
+    return {
+        "pass": True,
+        "bar_count": len(bars_out),
+        "bars": bars_out,
+    }
+
