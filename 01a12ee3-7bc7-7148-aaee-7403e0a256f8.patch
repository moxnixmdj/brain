+
+            # 29. Auction-Theory Vickrey-Clarke-Groves (VCG) Pivot Externality Payment Synthesis
+            vcg_spec = task.get("vcg_auction_spec")
+            if isinstance(vcg_spec, Mapping):
+                # valuations: list of bidder valuations over mutually exclusive items, or 1-item / k-identical-unit bids
+                bids_raw = [Fraction(str(b)) for b in vcg_spec.get("bids", [10, 8, 5])]
+                k_units = int(vcg_spec.get("units", 1))
+                indexed_bids = sorted(enumerate(bids_raw), key=lambda item: (-item[1], item[0]))
+                winners = [idx for idx, _ in indexed_bids[:k_units]]
+                social_welfare = sum(b for _, b in indexed_bids[:k_units])
+                target_bidder = int(vcg_spec.get("bidder", 0))
+                # Without target_bidder, welfare is sum of top k_units bids among j != target_bidder
+                others = [b for idx, b in indexed_bids if idx != target_bidder]
+                welfare_without_i = sum(others[:k_units])
+                welfare_others_with_i = sum(b for idx, b in indexed_bids[:k_units] if idx != target_bidder)
+                vcg_payment_i = welfare_without_i - welfare_others_with_i
+                out_mode_v = str(vcg_spec.get("output") or "payment").upper()
+                val_vcg = social_welfare if "WELFARE" in out_mode_v else vcg_payment_i
+                pred_vcg = int(val_vcg) if val_vcg.denominator == 1 else round(float(val_vcg), 6)
+                candidate_hypotheses.insert(0, {
+                    "pass": True,
+                    "status": "PASS__AUCTION_THEORY_VICKREY_CLARKE_GROVES_PIVOT_EXTERNALITY_PAYMENT_SYNTHESIZED",
+                    "inferred_witness_family": "AUCTION_THEORY_VICKREY_CLARKE_GROVES_PIVOT_EXTERNALITY_PAYMENT_SYNTHESIS",
+                    "winners": winners,
+                    "social_welfare_exact": str(social_welfare),
+                    "vcg_payment_exact": str(vcg_payment_i),
+                    "prediction": pred_vcg,
+                })
+
+            # 30. Epidemiological SIR Compartmental Reproduction Number & Herd-Immunity Equilibrium Synthesis
+            sir_spec = task.get("sir_epidemic_spec")
+            if isinstance(sir_spec, Mapping):
+                beta_sir = Fraction(str(sir_spec.get("beta", 3)))
+                gamma_sir = Fraction(str(sir_spec.get("gamma", 1)))
+                r0_sir = beta_sir / gamma_sir
+                herd_thresh = Fraction(1) - (Fraction(1) / r0_sir) if r0_sir > 1 else Fraction(0)
+                out_mode_s = str(sir_spec.get("output") or "herd_immunity").upper()
+                val_sir = r0_sir if "R0" in out_mode_s else herd_thresh
+                pred_sir = int(val_sir) if val_sir.denominator == 1 else round(float(val_sir), 6)
+                candidate_hypotheses.insert(0, {
+                    "pass": True,
+                    "status": "PASS__EPIDEMIOLOGICAL_SIR_COMPARTMENTAL_EULER_REPRODUCTION_EQUILIBRIUM_SYNTHESIZED",
+                    "inferred_witness_family": "EPIDEMIOLOGICAL_SIR_COMPARTMENTAL_EULER_REPRODUCTION_EQUILIBRIUM_SYNTHESIS",
+                    "basic_reproduction_r0_exact": str(r0_sir),
+                    "herd_immunity_threshold_exact": str(herd_thresh),
+                    "prediction": pred_sir,
+                })
+
+            # 31. Black-Scholes / Garman-Kohlhagen Put-Call Parity No-Arbitrage Law: C - P = S_0 * D_q - K * D_r
+            pcp_spec = task.get("put_call_parity_spec")
+            if isinstance(pcp_spec, Mapping):
+                spot_s0 = Fraction(str(pcp_spec.get("spot", 100)))
+                strike_k = Fraction(str(pcp_spec.get("strike", 100)))
+                disc_r = Fraction(str(pcp_spec.get("discount_factor", "95/100")))
+                div_disc_q = Fraction(str(pcp_spec.get("dividend_discount_factor", 1)))
+                put_price = Fraction(str(pcp_spec.get("put_price", 6)))
+                call_fair = put_price + spot_s0 * div_disc_q - strike_k * disc_r
+                forward_price = spot_s0 * div_disc_q / disc_r
+                out_pcp = str(pcp_spec.get("output") or "call_price")
+                val_pcp = forward_price if out_pcp == "forward_price" else call_fair
+                pred_pcp = int(val_pcp) if val_pcp.denominator == 1 else round(float(val_pcp), 6)
+                candidate_hypotheses.insert(0, {
+                    "pass": True,
+                    "status": "PASS__BLACK_SCHOLES_GARMAN_KOHLHAGEN_PUT_CALL_PARITY_NO_ARBITRAGE_SYNTHESIZED",
+                    "inferred_witness_family": "BLACK_SCHOLES_GARMAN_KOHLHAGEN_PUT_CALL_PARITY_NO_ARBITRAGE_SYNTHESIS",
+                    "fair_call_price_exact": str(call_fair),
+                    "implied_forward_price_exact": str(forward_price),
+                    "prediction": pred_pcp,
