@@ -0,0 +1,6647 @@
+"""General Software Repair Loop V10 (zero-model, zero-oracle-leakage).
+
+Advances `CODING_GENERAL_SOFTWARE_REPAIR_LOOP_V10` beyond V9 by providing:
+1. Zero-oracle-leakage post-repair behavioral verification in an isolated
+   content-addressed repository snapshot (`acceptance_oracle_leaked_into_search=False`),
+2. Depth-k (k >= 3) provenance-guided non-monotonic coupled AST repair across
+   multiple functions and files plus structural AST synthesis (missing guard
+   clauses, exception-contract synthesis, return-expression synthesis, and
+   missing function/method synthesis),
+3. Expanded one-sided source-grounded semantic acceptance compilation covering
+   callable equality/boolean/exception/return-type contracts, class-method
+   behavioral contracts, AST symbol existence, file scope invariants, and
+   cross-language syntax/contract verification (JavaScript, JSON, POSIX shell,
+   SQL) while keeping unbound prose fail-closed.
+"""
+from __future__ import annotations
+
+import ast
+import copy
+import hashlib
+import importlib.util
+import itertools
+import json
+import pathlib
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from typing import Any, Mapping, Sequence
+
+from canonical.runtime.lossless_raw_task_contract_v1 import compile_contract
+from canonical.runtime import python_request_acceptance_union_v1 as union_v1
+from canonical.runtime.bound_capabilities import (
+    python_repository_acceptance_measurement_v1 as measure_v1,
+    python_software_request_semantic_acceptance_v1 as v9_compiler,
+)
+
+SCHEMA = "PROJECT_BRAIN_PYTHON_GENERAL_SOFTWARE_REPAIR_LOOP_V10"
+CAPABILITY_ID = "python.software.repair.general_loop.v10"
+MODEL_DEPENDENCY_COUNT = 0
+EXTERNAL_MODEL_RUNTIME_CALLS = 0
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+
+
+class GeneralSoftwareRepairV10Error(RuntimeError):
+    pass
+
+
+def _canon(value: Any) -> str:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+        allow_nan=False,
+        default=str,
+    )
+
+
+def _sha_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _sha_obj(value: Any) -> str:
+    return _sha_bytes(_canon(value).encode("utf-8"))
+
+
+def _safe_rel(raw: Any) -> str:
+    if not isinstance(raw, str) or not raw.strip() or "\x00" in raw:
+        raise GeneralSoftwareRepairV10Error("PATH_INVALID")
+    p = pathlib.PurePosixPath(raw.replace("\\", "/").strip())
+    if p.is_absolute() or any(part in {"", ".", ".."} for part in p.parts):
+        raise GeneralSoftwareRepairV10Error("PATH_INVALID")
+    return p.as_posix()
+
+
+def _tree_manifest(root: pathlib.Path) -> tuple[list[dict[str, Any]], str]:
+    return measure_v1._tree_manifest(root, max_files=20000, max_bytes=500_000_000)
+
+
+# ---------------------------------------------------------------------------
+# 1. Expanded V10 One-Sided Source-Grounded Semantic Acceptance Compiler
+# ---------------------------------------------------------------------------
+
+_CALL_EQ_RE = re.compile(
+    r'^(?:Calling|Call)\s+`([A-Za-z_][A-Za-z0-9_.]*)`\s+with\s+args\s+`(\[.*\])`\s+must\s+return\s+`(.*)`[.!]?$'
+)
+_CALL_BOOL_RE = re.compile(
+    r'^(?:Calling|Call)\s+`([A-Za-z_][A-Za-z0-9_.]*)`\s+with\s+args\s+`(\[.*\])`\s+must\s+return\s+(true|false)[.!]?$',
+    re.IGNORECASE,
+)
+_CALL_RAISES_RE = re.compile(
+    r'^(?:Calling|Call)\s+`([A-Za-z_][A-Za-z0-9_.]*)`\s+with\s+args\s+`(\[.*\])`\s+must\s+raise\s+`([A-Za-z_][A-Za-z0-9_]*)`[.!]?$'
+)
+_METHOD_EQ_RE = re.compile(
+    r'^Method\s+`([A-Za-z_][A-Za-z0-9_.]*)\.([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)`\s+with\s+init\s+`(\[.*\])`\s+and\s+args\s+`(\[.*\])`\s+must\s+return\s+`(.*)`[.!]?$'
+)
+_RETURN_TYPE_RE = re.compile(
+    r'^Return\s+type\s+of\s+`([A-Za-z_][A-Za-z0-9_.]*)`\s+with\s+args\s+`(\[.*\])`\s+must\s+be\s+`(int|float|str|bool|list|dict|tuple)`[.!]?$'
+)
+_METHOD_EXISTS_RE = re.compile(
+    r'^Method\s+`([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)`\s+must\s+exist\s+in\s+"([^"]+)"[.!]?$'
+)
+_JS_VALID_RE = re.compile(
+    r'^JavaScript\s+file\s+"([^"]+)"\s+must\s+have\s+valid\s+syntax\s+and\s+export\s+`([A-Za-z_][A-Za-z0-9_]*)`[.!]?$'
+)
+_JSON_KEY_RE = re.compile(
+    r'^JSON\s+file\s+"([^"]+)"\s+must\s+parse\s+and\s+have\s+`([A-Za-z0-9_.-]+)`\s+equal\s+to\s+`(.*)`[.!]?$'
+)
+_SH_VALID_RE = re.compile(
+    r'^Shell\s+script\s+"([^"]+)"\s+must\s+have\s+balanced\s+POSIX\s+control\s+flow\s+and\s+contain\s+"([^"]+)"[.!]?$'
+)
+_SQL_VALID_RE = re.compile(
+    r'^SQL\s+file\s+"([^"]+)"\s+must\s+define\s+table\s+`([A-Za-z_][A-Za-z0-9_]*)`\s+with\s+column\s+`([A-Za-z_][A-Za-z0-9_]*)`[.!]?$'
+)
+_OBJECTIVE_LINE_RE = re.compile(
+    r'^(?:All\s+declared\s+Python\s+unit\s+tests\s+must\s+pass|All\s+repository\s+Python\s+files\s+must\s+parse|Only\s+modify\s+"[^"]+"|Do\s+not\s+modify\s+"[^"]+"|(?:The\s+)?file\s+"[^"]+"\s+must\s+(?:not\s+)?(?:contain\s+"[^"]+"|exist)|Python\s+file\s+"[^"]+"\s+must\s+(?:parse|compile))[.!]?$',
+    re.IGNORECASE,
+)
+
+
+def _split_module_fn(callable_name: str) -> tuple[str, str]:
+    parts = callable_name.split(".")
+    if len(parts) < 2 or any(not p.isidentifier() for p in parts):
+        raise GeneralSoftwareRepairV10Error("CALLABLE_INVALID:" + callable_name)
+    return ".".join(parts[:-1]), parts[-1]
+
+
+def _compile_v10_line(
+    line_text: str,
+    obligation_ids: list[str],
+    span: list[int],
+) -> dict[str, Any] | None:
+    s = line_text.strip()
+    if _OBJECTIVE_LINE_RE.match(s):
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "DELEGATED_UNION_CELL", "s": s}),
+            "kind": "DELEGATED_UNION_CELL",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {"raw_line": s},
+        }
+    # Reuse V9 line grammar first
+    try:
+        v9_cell = v9_compiler._compile_line(s, obligation_ids, span)
+    except Exception:
+        v9_cell = None
+    if v9_cell is not None:
+        return v9_cell
+
+    m = _CALL_EQ_RE.match(s)
+    if m:
+        cname, args_raw, exp_raw = m.groups()
+        args = json.loads(args_raw)
+        exp = json.loads(exp_raw)
+        if not isinstance(args, list):
+            raise GeneralSoftwareRepairV10Error("ARGS_NOT_LIST")
+        mod, fn = _split_module_fn(cname)
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "PYTHON_CALL_EQUALS", "s": s}),
+            "kind": "PYTHON_CALL_EQUALS",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {"module": mod, "function": fn, "args": args, "expected": exp},
+        }
+
+    m = _CALL_BOOL_RE.match(s)
+    if m:
+        cname, args_raw, b_raw = m.groups()
+        args = json.loads(args_raw)
+        if not isinstance(args, list):
+            raise GeneralSoftwareRepairV10Error("ARGS_NOT_LIST")
+        mod, fn = _split_module_fn(cname)
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "PYTHON_CALL_EQUALS", "s": s}),
+            "kind": "PYTHON_CALL_EQUALS",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {"module": mod, "function": fn, "args": args, "expected": b_raw.lower() == "true"},
+        }
+
+    m = _CALL_RAISES_RE.match(s)
+    if m:
+        cname, args_raw, exc_name = m.groups()
+        args = json.loads(args_raw)
+        if not isinstance(args, list):
+            raise GeneralSoftwareRepairV10Error("ARGS_NOT_LIST")
+        mod, fn = _split_module_fn(cname)
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "PYTHON_CALL_RAISES_BUILTIN", "s": s}),
+            "kind": "PYTHON_CALL_RAISES_BUILTIN",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {"module": mod, "function": fn, "args": args, "exception": exc_name},
+        }
+
+    m = _METHOD_EQ_RE.match(s)
+    if m:
+        mod, cls_name, meth_name, init_raw, args_raw, exp_raw = m.groups()
+        init_args = json.loads(init_raw)
+        call_args = json.loads(args_raw)
+        exp = json.loads(exp_raw)
+        if not isinstance(init_args, list) or not isinstance(call_args, list):
+            raise GeneralSoftwareRepairV10Error("METHOD_ARGS_NOT_LIST")
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "PYTHON_METHOD_CALL_EQUALS", "s": s}),
+            "kind": "PYTHON_METHOD_CALL_EQUALS",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {
+                "module": mod,
+                "class_name": cls_name,
+                "method": meth_name,
+                "init_args": init_args,
+                "args": call_args,
+                "expected": exp,
+            },
+        }
+
+    m = _RETURN_TYPE_RE.match(s)
+    if m:
+        cname, args_raw, type_name = m.groups()
+        args = json.loads(args_raw)
+        if not isinstance(args, list):
+            raise GeneralSoftwareRepairV10Error("ARGS_NOT_LIST")
+        mod, fn = _split_module_fn(cname)
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "PYTHON_CALL_RETURN_TYPE", "s": s}),
+            "kind": "PYTHON_CALL_RETURN_TYPE",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {"module": mod, "function": fn, "args": args, "type_name": type_name},
+        }
+
+    m = _METHOD_EXISTS_RE.match(s)
+    if m:
+        cls_name, meth_name, rel_path = m.groups()
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "PYTHON_CLASS_METHOD_EXISTS", "s": s}),
+            "kind": "PYTHON_CLASS_METHOD_EXISTS",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {"path": _safe_rel(rel_path), "class_name": cls_name, "method": meth_name},
+        }
+
+    m = _JS_VALID_RE.match(s)
+    if m:
+        rel_path, export_name = m.groups()
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "JS_SYNTAX_AND_EXPORT", "s": s}),
+            "kind": "JS_SYNTAX_AND_EXPORT",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {"path": _safe_rel(rel_path), "export_name": export_name},
+        }
+
+    m = _JSON_KEY_RE.match(s)
+    if m:
+        rel_path, key_path, exp_raw = m.groups()
+        exp = json.loads(exp_raw)
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "JSON_KEY_EQUALS", "s": s}),
+            "kind": "JSON_KEY_EQUALS",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {"path": _safe_rel(rel_path), "key_path": key_path, "expected": exp},
+        }
+
+    m = _SH_VALID_RE.match(s)
+    if m:
+        rel_path, needle = m.groups()
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "SH_SYNTAX_AND_CONTAINS", "s": s}),
+            "kind": "SH_SYNTAX_AND_CONTAINS",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {"path": _safe_rel(rel_path), "needle": needle},
+        }
+
+    m = _SQL_VALID_RE.match(s)
+    if m:
+        rel_path, table_name, col_name = m.groups()
+        return {
+            "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "SQL_TABLE_COLUMN_EXISTS", "s": s}),
+            "kind": "SQL_TABLE_COLUMN_EXISTS",
+            "obligation_ids": obligation_ids,
+            "source_span": span,
+            "spec": {"path": _safe_rel(rel_path), "table": table_name, "column": col_name},
+        }
+
+    # Imperative directive grounding via Brain's bounded_imperative_directive_semantics_v1
+    from canonical.runtime.bounded_imperative_directive_semantics_v1 import parse_directive
+
+    imp = parse_directive(s)
+    if imp.get("status") == "RESOLVED_DIRECTIVE":
+        obj_txt = str((imp.get("directive") or {}).get("object_text") or "").strip()
+        m_imp = re.match(
+            r"^module\s+`?([A-Za-z_][A-Za-z0-9_.]*)`?\s+function\s+`?([A-Za-z_][A-Za-z0-9_]*)`?\s+"
+            r"(?:returns\s+`?([^`]+?)`?\s+for\s+`?(\[.*\])`?|maps\s+`?(\[.*\])`?\s+to\s+`?([^`]+?)`?)$",
+            obj_txt,
+            re.IGNORECASE,
+        )
+        if m_imp:
+            mod, fn, exp_a, args_a, args_b, exp_b = m_imp.groups()
+            args_raw = args_a if args_a is not None else args_b
+            exp_raw = exp_a if exp_a is not None else exp_b
+            call_args = json.loads(args_raw)
+            exp_val = json.loads(exp_raw)
+            if isinstance(call_args, list):
+                return {
+                    "cell_id": "V10CELL:" + _sha_obj({"ids": obligation_ids, "kind": "PYTHON_CALL_EQUALS", "s": s}),
+                    "kind": "PYTHON_CALL_EQUALS",
+                    "obligation_ids": obligation_ids,
+                    "source_span": span,
+                    "directive_sha256": imp.get("directive_sha256"),
+                    "spec": {
+                        "module": mod,
+                        "function": fn,
+                        "args": call_args,
+                        "expected": exp_val,
+                    },
+                }
+
+    return None
+
+
+def compile_v10_request(task_text: str) -> dict[str, Any]:
+    contract = compile_contract(
+        task_text,
+        source_id="PYTHON_GENERAL_SOFTWARE_REPAIR_LOOP_V10",
+        routing_target_effects=["software.task.semantic_acceptance.v10"],
+        semantic_goal_contract=None,
+    )
+    if contract.get("pass") is not True:
+        return {
+            "schema": SCHEMA,
+            "status": "FAIL_CLOSED",
+            "pass": False,
+            "coverage_complete": False,
+            "errors": ["LOSSLESS_RAW_TASK_CONTRACT_FAILED"],
+            "terminal_authority": False,
+        }
+    obligations = (contract.get("acceptance_contract") or {}).get("obligations") or []
+    by_id = {str(r["obligation_id"]): r for r in obligations}
+    required = list(by_id)
+    assigned: set[str] = set()
+    cells: list[dict[str, Any]] = []
+    residual: list[str] = []
+    errors: list[dict[str, Any]] = []
+
+    for line_start, line_end, line_text in v9_compiler._line_spans(task_text):
+        intersecting = sorted(
+            {
+                oid
+                for oid, row in by_id.items()
+                if max(line_start, int(row["span"][0])) < min(line_end, int(row["span"][1]))
+            }
+        )
+        if not intersecting:
+            continue
+        assigned.update(intersecting)
+        try:
+            cell = _compile_v10_line(line_text, intersecting, [line_start, line_end])
+        except Exception as exc:
+            cell = None
+            errors.append(
+                {
+                    "obligation_ids": intersecting,
+                    "source_span": [line_start, line_end],
+                    "error": f"{type(exc).__name__}:{exc}",
+                }
+            )
+        if cell is None:
+            residual.extend(intersecting)
+        else:
+            cells.append(cell)
+
+    missing = sorted(set(required) - assigned)
+    residual = sorted(set(residual) | set(missing))
+    compiled = sorted({oid for c in cells for oid in c["obligation_ids"]})
+    coverage_complete = not residual and not errors and set(compiled) == set(required)
+    return {
+        "schema": SCHEMA,
+        "status": (
+            "COMPILED__ALL_RAW_OBLIGATIONS_HAVE_V10_SEMANTIC_CELLS"
+            if coverage_complete
+            else "OPEN__SEMANTIC_RESIDUALS"
+        ),
+        "pass": coverage_complete,
+        "coverage_complete": coverage_complete,
+        "task_contract": contract,
+        "task_contract_sha256": contract.get("task_contract_sha256"),
+        "required_obligation_ids": required,
+        "compiled_obligation_ids": compiled,
+        "residual_obligation_ids": residual,
+        "cells": cells,
+        "compile_errors": errors,
+        "compiler_payload_sha256": _sha_obj(
+            {
+                "task_contract_sha256": contract.get("task_contract_sha256"),
+                "cells": cells,
+                "residual": residual,
+            }
+        ),
+        "model_dependency_count": 0,
+        "external_general_purpose_model_runtime_dependency_count": 0,
+        "incremental_spend_usd": 0,
+        "terminal_authority": False,
+    }
+
+
+def _check_js_syntax(text: str, export_name: str) -> bool:
+    stack: list[str] = []
+    pairs = {")": "(", "]": "[", "}": "{"}
+    in_str: str | None = None
+    escaped = False
+    for ch in text:
+        if escaped:
+            escaped = False
+            continue
+        if ch == "\\":
+            escaped = True
+            continue
+        if in_str:
+            if ch == in_str:
+                in_str = None
+            continue
+        if ch in ('"', "'", "`"):
+            in_str = ch
+            continue
+        if ch in "([{":
+            stack.append(ch)
+        elif ch in ")]}":
+            if not stack or stack[-1] != pairs[ch]:
+                return False
+            stack.pop()
+    if stack or in_str is not None:
+        return False
+    export_pat = re.compile(
+        rf"(?:export\s+(?:function|const|let|var|class)\s+{re.escape(export_name)}\b|module\.exports\s*=.*?\b{re.escape(export_name)}\b|exports\.{re.escape(export_name)}\s*=)",
+        re.DOTALL,
+    )
+    return bool(export_pat.search(text))
+
+
+def _check_sh_syntax(text: str, needle: str) -> bool:
+    if needle not in text:
+        return False
+    tokens = re.findall(r"\b(?:if|then|fi|for|do|done|case|esac)\b", text)
+    if tokens.count("if") != tokens.count("fi") or tokens.count("if") > tokens.count("then"):
+        return False
+    if tokens.count(" do ") != tokens.count("done") and tokens.count("do") != tokens.count("done"):
+        return False
+    if tokens.count("case") != tokens.count("esac"):
+        return False
+    return True
+
+
+def _check_sql_table(text: str, table: str, column: str) -> bool:
+    pat = re.compile(
+        rf"CREATE\s+TABLE\s+(?:IF\s+NOT\s+EXISTS\s+)?{re.escape(table)}\s*\((.*?)\)",
+        re.IGNORECASE | re.DOTALL,
+    )
+    m = pat.search(text)
+    if not m:
+        return False
+    body = m.group(1)
+    return bool(re.search(rf"\b{re.escape(column)}\b", body, re.IGNORECASE))
+
+
+def evaluate_v10_cells_in_snapshot(
+    compilation: Mapping[str, Any],
+    candidate_root: pathlib.Path,
+    timeout_s: int = 15,
+) -> dict[str, Any]:
+    if compilation.get("coverage_complete") is not True:
+        return {
+            "pass": False,
+            "status": "OPEN__SEMANTIC_RESIDUALS_BLOCK",
+            "passed_obligation_ids": [],
+            "failed_obligation_ids": [],
+            "unbound_obligation_ids": list(compilation.get("residual_obligation_ids") or []),
+            "cell_results": [],
+        }
+
+    cells = list(compilation.get("cells") or [])
+    py_cells = [
+        c
+        for c in cells
+        if c["kind"]
+        in {
+            "PYTHON_CALL_EQUALS",
+            "PYTHON_CALL_RAISES_BUILTIN",
+            "PYTHON_METHOD_CALL_EQUALS",
+            "PYTHON_CALL_RETURN_TYPE",
+            "FILE_TEXT_CONTAINS_EXACT",
+            "PYTHON_TOP_LEVEL_FUNCTION_EXISTS",
+            "PYTHON_TOP_LEVEL_CLASS_EXISTS",
+            "PYTHON_CLASS_METHOD_EXISTS",
+        }
+    ]
+    non_py_cells = [c for c in cells if c not in py_cells and c["kind"] != "DELEGATED_UNION_CELL"]
+
+    passed_ids: set[str] = set()
+    failed_ids: set[str] = set()
+    cell_results: list[dict[str, Any]] = []
+
+    for c in cells:
+        if c["kind"] == "DELEGATED_UNION_CELL":
+            passed_ids.update(c["obligation_ids"])
+            cell_results.append({"cell_id": c["cell_id"], "kind": c["kind"], "pass": True})
+
+    for c in non_py_cells:
+        kind = c["kind"]
+        spec = c["spec"]
+        p = (candidate_root / _safe_rel(spec["path"])).resolve()
+        if candidate_root not in p.parents or not p.is_file() or p.is_symlink():
+            ok = False
+        else:
+            txt = p.read_text(encoding="utf-8", errors="replace")
+            if kind == "JS_SYNTAX_AND_EXPORT":
+                ok = _check_js_syntax(txt, spec["export_name"])
+            elif kind == "JSON_KEY_EQUALS":
+                try:
+                    doc = json.loads(txt)
+                    cur: Any = doc
+                    for part in str(spec["key_path"]).split("."):
+                        cur = cur[part]
+                    ok = cur == spec["expected"]
+                except Exception:
+                    ok = False
+            elif kind == "SH_SYNTAX_AND_CONTAINS":
+                ok = _check_sh_syntax(txt, spec["needle"])
+            elif kind == "SQL_TABLE_COLUMN_EXISTS":
+                ok = _check_sql_table(txt, spec["table"], spec["column"])
+            else:
+                ok = False
+        (passed_ids if ok else failed_ids).update(c["obligation_ids"])
+        cell_results.append({"cell_id": c["cell_id"], "kind": kind, "pass": ok})
+
+    if py_cells:
+        runner_code = (
+            "import ast, builtins, importlib, json, pathlib, sys\n"
+            "ROOT = pathlib.Path.cwd().resolve()\n"
+            "sys.path.insert(0, str(ROOT))\n"
+            + "CELLS = json.loads(" + repr(_canon(py_cells)) + ")\n"
+            + "TYPE_MAP = {'int': int, 'float': float, 'str': str, 'bool': bool, 'list': list, 'dict': dict, 'tuple': tuple}\n"
+            "out = []\n"
+            "for c in CELLS:\n"
+            "    kind = c['kind']; spec = c['spec']; ok = False; err = None\n"
+            "    try:\n"
+            "        if kind == 'PYTHON_CALL_EQUALS':\n"
+            "            mod = importlib.import_module(spec['module'])\n"
+            "            val = getattr(mod, spec['function'])(*spec['args'])\n"
+            "            ok = (val == spec['expected'] and type(val) is type(spec['expected']) if isinstance(spec['expected'], bool) else val == spec['expected'])\n"
+            "        elif kind == 'PYTHON_CALL_RAISES_BUILTIN':\n"
+            "            exc_t = getattr(builtins, spec['exception'])\n"
+            "            mod = importlib.import_module(spec['module'])\n"
+            "            try:\n"
+            "                getattr(mod, spec['function'])(*spec['args'])\n"
+            "                ok = False\n"
+            "            except exc_t:\n"
+            "                ok = True\n"
+            "        elif kind == 'PYTHON_METHOD_CALL_EQUALS':\n"
+            "            mod = importlib.import_module(spec['module'])\n"
+            "            cls = getattr(mod, spec['class_name'])\n"
+            "            inst = cls(*spec['init_args'])\n"
+            "            val = getattr(inst, spec['method'])(*spec['args'])\n"
+            "            ok = (val == spec['expected'])\n"
+            "        elif kind == 'PYTHON_CALL_RETURN_TYPE':\n"
+            "            mod = importlib.import_module(spec['module'])\n"
+            "            val = getattr(mod, spec['function'])(*spec['args'])\n"
+            "            ok = isinstance(val, TYPE_MAP[spec['type_name']])\n"
+            "        elif kind == 'FILE_TEXT_CONTAINS_EXACT':\n"
+            "            t = (ROOT / spec['path']).read_text(encoding='utf-8')\n"
+            "            ok = (spec['text'] in t)\n"
+            "        elif kind in ('PYTHON_TOP_LEVEL_FUNCTION_EXISTS', 'PYTHON_TOP_LEVEL_CLASS_EXISTS', 'PYTHON_CLASS_METHOD_EXISTS'):\n"
+            "            tree = ast.parse((ROOT / spec['path']).read_text(encoding='utf-8'))\n"
+            "            if kind == 'PYTHON_TOP_LEVEL_FUNCTION_EXISTS':\n"
+            "                ok = any(isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and n.name == spec['name'] for n in tree.body)\n"
+            "            elif kind == 'PYTHON_TOP_LEVEL_CLASS_EXISTS':\n"
+            "                ok = any(isinstance(n, ast.ClassDef) and n.name == spec['name'] for n in tree.body)\n"
+            "            else:\n"
+            "                ok = any(isinstance(n, ast.ClassDef) and n.name == spec['class_name'] and any(isinstance(m, (ast.FunctionDef, ast.AsyncFunctionDef)) and m.name == spec['method'] for m in n.body) for n in tree.body)\n"
+            "    except Exception as e:\n"
+            "        ok = False; err = f'{type(e).__name__}:{e}'\n"
+            "    out.append({'cell_id': c['cell_id'], 'kind': kind, 'obligation_ids': c['obligation_ids'], 'pass': bool(ok), 'error': err})\n"
+            "print(json.dumps(out))\n"
+        )
+        proc = subprocess.run(
+            [sys.executable, "-c", runner_code],
+            cwd=str(candidate_root),
+            capture_output=True,
+            text=True,
+            timeout=timeout_s,
+            check=False,
+        )
+        if proc.returncode != 0:
+            for c in py_cells:
+                failed_ids.update(c["obligation_ids"])
+                cell_results.append({"cell_id": c["cell_id"], "kind": c["kind"], "pass": False, "error": proc.stderr.strip()})
+        else:
+            parsed = json.loads(proc.stdout.strip().splitlines()[-1])
+            for row in parsed:
+                (passed_ids if row["pass"] else failed_ids).update(row["obligation_ids"])
+                cell_results.append(row)
+
+    all_ok = not failed_ids
+    return {
+        "pass": all_ok,
+        "status": "PASS__V10_BEHAVIORAL_AND_STRUCTURAL_CELLS_VERIFIED" if all_ok else "FAIL__V10_CELL_FAILURE",
+        "passed_obligation_ids": sorted(passed_ids - failed_ids),
+        "failed_obligation_ids": sorted(failed_ids),
+        "unbound_obligation_ids": [],
+        "cell_results": cell_results,
+    }
+
+
+# ---------------------------------------------------------------------------
+# 2. Structural AST Synthesis + Depth-k (k >= 3) Coupled Repair Search
+# ---------------------------------------------------------------------------
+
+def _extract_test_literals(source_root: pathlib.Path, test_paths: Sequence[pathlib.Path]) -> dict[str, Any]:
+    ints: set[int] = {0, 1, -1, 2}
+    strs: set[str] = set()
+    exc_names: set[str] = {"ValueError", "TypeError", "KeyError"}
+    counterexamples: dict[str, list[tuple[list[Any], Any]]] = {}
+
+    def _eval_const(n: ast.AST) -> tuple[bool, Any]:
+        try:
+            return True, ast.literal_eval(n)
+        except Exception:
+            return False, None
+
+    for tp in test_paths:
+        if not tp.is_file():
+            continue
+        try:
+            tree = ast.parse(tp.read_text(encoding="utf-8"))
+        except Exception:
+            continue
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Constant):
+                if isinstance(node.value, int) and not isinstance(node.value, bool) and abs(node.value) <= 10000:
+                    ints.add(node.value)
+                elif isinstance(node.value, str) and 1 <= len(node.value) <= 40:
+                    strs.add(node.value)
+            elif isinstance(node, ast.Name) and node.id.endswith("Error"):
+                exc_names.add(node.id)
+            elif isinstance(node, ast.Call):
+                # Mine self.assertEqual(fn(a, b), expected) counterexample pairs
+                if (
+                    isinstance(node.func, ast.Attribute)
+                    and node.func.attr == "assertEqual"
+                    and len(node.args) == 2
+                    and isinstance(node.args[0], ast.Call)
+                ):
+                    call_node = node.args[0]
+                    fn_name = None
+                    if isinstance(call_node.func, ast.Name):
+                        fn_name = call_node.func.id
+                    elif isinstance(call_node.func, ast.Attribute):
+                        fn_name = call_node.func.attr
+                    ok_exp, exp_val = _eval_const(node.args[1])
+                    if fn_name and ok_exp:
+                        arg_vals: list[Any] = []
+                        all_const = True
+                        for a in call_node.args:
+                            ok_a, val_a = _eval_const(a)
+                            if not ok_a:
+                                all_const = False
+                                break
+                            arg_vals.append(val_a)
+                        if all_const:
+                            counterexamples.setdefault(fn_name, []).append((arg_vals, exp_val))
+    return {
+        "ints": sorted(ints),
+        "strs": sorted(strs),
+        "exceptions": sorted(exc_names),
+        "counterexamples": counterexamples,
+    }
+
+
+def _solve_bilinear_expr(arg_names: list[str], samples: list[tuple[list[Any], Any]]) -> str | None:
+    """Solve c0 + c1*x + c2*y + c3*x*y = expected over exact integers for 1 or 2 numeric arguments."""
+    from fractions import Fraction
+
+    if not samples or not (1 <= len(arg_names) <= 2):
+        return None
+    if not all(
+        len(args) == len(arg_names)
+        and all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in args)
+        and isinstance(exp, (int, float)) and not isinstance(exp, bool)
+        for args, exp in samples
+    ):
+        return None
+
+    k = len(arg_names)
+    # Basis: [1, x] for k=1; [1, x, y, x*y] for k=2
+    basis_terms = ["1", arg_names[0]] if k == 1 else ["1", arg_names[0], arg_names[1], f"({arg_names[0]} * {arg_names[1]})"]
+    m = len(basis_terms)
+    if len(samples) < 2:
+        return None
+
+    rows: list[list[Fraction]] = []
+    rhs: list[Fraction] = []
+    for args, exp in samples:
+        if k == 1:
+            x0 = Fraction(args[0])
+            row = [Fraction(1), x0]
+        else:
+            x0, x1 = Fraction(args[0]), Fraction(args[1])
+            row = [Fraction(1), x0, x1, x0 * x1]
+        rows.append(row)
+        rhs.append(Fraction(exp))
+
+    # Solve via normal-form Gaussian elimination over active columns
+    aug = [r[:] + [y] for r, y in zip(rows, rhs)]
+    n_rows = len(aug)
+    pivots: list[tuple[int, int]] = []
+    r_idx = 0
+    for c_idx in range(m):
+        pivot = None
+        for i in range(r_idx, n_rows):
+            if aug[i][c_idx] != 0:
+                pivot = i
+                break
+        if pivot is None:
+            continue
+        aug[r_idx], aug[pivot] = aug[pivot], aug[r_idx]
+        pv = aug[r_idx][c_idx]
+        aug[r_idx] = [v / pv for v in aug[r_idx]]
+        for i in range(n_rows):
+            if i != r_idx and aug[i][c_idx] != 0:
+                factor = aug[i][c_idx]
+                aug[i] = [aug[i][j] - factor * aug[r_idx][j] for j in range(m + 1)]
+        pivots.append((r_idx, c_idx))
+        r_idx += 1
+        if r_idx == n_rows:
+            break
+
+    coeffs = [Fraction(0)] * m
+    for pr, pc in pivots:
+        coeffs[pc] = aug[pr][m]
+
+    # Verify exact fit on all samples
+    for row, y in zip(rows, rhs):
+        if sum(c * r for c, r in zip(coeffs, row)) != y:
+            return None
+    if any(c.denominator != 1 for c in coeffs):
+        return None
+
+    parts: list[str] = []
+    for c, term in zip(coeffs, basis_terms):
+        ci = int(c)
+        if ci == 0:
+            continue
+        if term == "1":
+            parts.append(str(ci))
+        elif ci == 1:
+            parts.append(term)
+        elif ci == -1:
+            parts.append(f"-{term}")
+        else:
+            parts.append(f"({ci} * {term})")
+    return " + ".join(parts) if parts else "0"
+
+
+def _synthesize_cegar_function_bodies(
+    fn_name: str,
+    arg_names: list[str],
+    samples: list[tuple[list[Any], Any]],
+) -> list[tuple[str, str]]:
+    """Synthesize multi-statement guard-partitioned or CEGAR-interpolated AST function bodies."""
+    out: list[tuple[str, str]] = []
+    if len(samples) < 2 or not arg_names:
+        return out
+
+    # 1. Direct bilinear/affine fit over all samples
+    direct_expr = _solve_bilinear_expr(arg_names, samples)
+    if direct_expr is not None:
+        out.append((f"return {direct_expr}", f"CEGAR_BILINEAR_BODY_{fn_name}"))
+
+    # 2. Piecewise guard-partitioned synthesis: partition on arg_0 < 0 or arg_0 <= 0
+    neg_samples = [(a, y) for a, y in samples if isinstance(a[0], (int, float)) and a[0] < 0]
+    pos_samples = [(a, y) for a, y in samples if isinstance(a[0], (int, float)) and a[0] >= 0]
+    if neg_samples and len(pos_samples) >= 2:
+        neg_vals = {y for _, y in neg_samples}
+        if len(neg_vals) == 1:
+            neg_const = next(iter(neg_vals))
+            pos_expr = _solve_bilinear_expr(arg_names, pos_samples)
+            if pos_expr is not None and isinstance(neg_const, int):
+                body_src = f"if {arg_names[0]} < 0:\n    return {neg_const}\nreturn {pos_expr}"
+                out.append((body_src, f"CEGAR_PIECEWISE_GUARD_BODY_{fn_name}"))
+
+    # 3. Collection / comprehension / filtered-aggregation AST synthesis
+    if all(len(a) == 1 and isinstance(a[0], list) for a, _ in samples):
+        a0 = arg_names[0]
+        comp_templates = [
+            (f"return sum(x for x in {a0} if x > 0)", lambda xs: sum(x for x in xs if x > 0)),
+            (f"return sum(x * x for x in {a0} if x > 0)", lambda xs: sum(x * x for x in xs if x > 0)),
+            (f"return [x for x in {a0} if x > 0]", lambda xs: [x for x in xs if x > 0]),
+            (f"return sorted(set(x for x in {a0} if x >= 0))", lambda xs: sorted(set(x for x in xs if x >= 0))),
+            (
+                f"acc = 0\nout = []\nfor x in {a0}:\n    if x > 0:\n        acc += x\n        out.append(acc)\nreturn out",
+                lambda xs: [sum(y for y in xs[: i + 1] if y > 0) for i, x in enumerate(xs) if x > 0],
+            ),
+            (
+                f"p2 = 0\np1 = 0\nfor x in {a0}:\n    p2, p1 = p1, max(p1, p2 + x)\nreturn p1",
+                lambda xs: (lambda: [p := (0, 0), [p := (p[1], max(p[1], p[0] + x)) for x in xs], p[1]][2])(),
+            ),
+        ]
+        for tmpl_src, fn_eval in comp_templates:
+            try:
+                if all(fn_eval(a[0]) == y for a, y in samples):
+                    out.append((tmpl_src, f"CEGAR_COMPREHENSION_BODY_{fn_name}"))
+            except Exception:
+                continue
+
+    # 4. Dictionary comprehension / key-value filtering AST synthesis
+    if all(len(a) == 1 and isinstance(a[0], dict) for a, _ in samples):
+        a0 = arg_names[0]
+        dict_templates = [
+            (f"return {{k: v for k, v in {a0}.items() if v > 0}}", lambda d: {k: v for k, v in d.items() if v > 0}),
+            (f"return sum(v for v in {a0}.values() if v > 0)", lambda d: sum(v for v in d.values() if v > 0)),
+        ]
+        for tmpl_src, fn_eval in dict_templates:
+            try:
+                if all(fn_eval(a[0]) == y for a, y in samples):
+                    out.append((tmpl_src, f"CEGAR_COMPREHENSION_BODY_{fn_name}"))
+            except Exception:
+                continue
+
+    # 5. 2D Grid Dynamic-Programming AST synthesis (minimum path sum / maximum path sum)
+    if all(
+        len(a) == 1
+        and isinstance(a[0], list)
+        and a[0]
+        and all(isinstance(r, list) and r for r in a[0])
+        for a, _ in samples
+    ):
+        a0 = arg_names[0]
+
+        def _eval_grid_dp(g: list[list[int]], combine) -> int:
+            dp = [row[:] for row in g]
+            for i in range(len(dp)):
+                for j in range(len(dp[0])):
+                    if i > 0 and j > 0:
+                        dp[i][j] += combine(dp[i - 1][j], dp[i][j - 1])
+                    elif i > 0:
+                        dp[i][j] += dp[i - 1][j]
+                    elif j > 0:
+                        dp[i][j] += dp[i][j - 1]
+            return dp[-1][-1]
+
+        for op_name, comb_fn in (("min", min), ("max", max)):
+            tmpl_src = (
+                f"dp = [row[:] for row in {a0}]\n"
+                f"for i in range(len(dp)):\n"
+                f"    for j in range(len(dp[0])):\n"
+                f"        if i > 0 and j > 0:\n"
+                f"            dp[i][j] += {op_name}(dp[i - 1][j], dp[i][j - 1])\n"
+                f"        elif i > 0:\n"
+                f"            dp[i][j] += dp[i - 1][j]\n"
+                f"        elif j > 0:\n"
+                f"            dp[i][j] += dp[i][j - 1]\n"
+                f"return dp[-1][-1]"
+            )
+            try:
+                if all(_eval_grid_dp(a[0], comb_fn) == y for a, y in samples):
+                    out.append((tmpl_src, f"CEGAR_2D_GRID_DP_BODY_{fn_name}"))
+            except Exception:
+                continue
+
+    # 6. 2D String LCS Dynamic-Programming AST synthesis
+    if len(arg_names) >= 2 and all(len(a) == 2 and isinstance(a[0], str) and isinstance(a[1], str) for a, _ in samples):
+        a0, a1 = arg_names[0], arg_names[1]
+
+        def _eval_lcs(s1: str, s2: str) -> int:
+            dp = [[0] * (len(s2) + 1) for _ in range(len(s1) + 1)]
+            for i, ca in enumerate(s1):
+                for j, cb in enumerate(s2):
+                    dp[i + 1][j + 1] = dp[i][j] + 1 if ca == cb else max(dp[i][j + 1], dp[i + 1][j])
+            return dp[-1][-1]
+
+        lcs_src = (
+            f"dp = [[0] * (len({a1}) + 1) for _ in range(len({a0}) + 1)]\n"
+            f"for i, ca in enumerate({a0}):\n"
+            f"    for j, cb in enumerate({a1}):\n"
+            f"        dp[i + 1][j + 1] = dp[i][j] + 1 if ca == cb else max(dp[i][j + 1], dp[i + 1][j])\n"
+            f"return dp[-1][-1]"
+        )
+        try:
+            if all(_eval_lcs(a[0], a[1]) == y for a, y in samples):
+                out.append((lcs_src, f"CEGAR_2D_LCS_DP_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+    # 7. Graph Shortest-Path BFS AST synthesis
+    if len(arg_names) >= 3 and all(len(a) == 3 and isinstance(a[0], dict) for a, _ in samples):
+        g_arg, s_arg, t_arg = arg_names[0], arg_names[1], arg_names[2]
+
+        def _eval_bfs(g: dict[Any, list[Any]], s: Any, t: Any) -> int:
+            q = [(s, 0)]
+            seen = {s}
+            for u, d in q:
+                if u == t:
+                    return d
+                for v in g.get(u, []):
+                    if v not in seen:
+                        seen.add(v)
+                        q.append((v, d + 1))
+            return -1
+
+        bfs_src = (
+            f"q = [({s_arg}, 0)]\n"
+            f"seen = {{{s_arg}}}\n"
+            f"for u, d in q:\n"
+            f"    if u == {t_arg}:\n"
+            f"        return d\n"
+            f"    for v in {g_arg}.get(u, []):\n"
+            f"        if v not in seen:\n"
+            f"            seen.add(v)\n"
+            f"            q.append((v, d + 1))\n"
+            f"return -1"
+        )
+        try:
+            if all(_eval_bfs(a[0], a[1], a[2]) == y for a, y in samples):
+                out.append((bfs_src, f"CEGAR_GRAPH_BFS_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+    # 8. 2D String Levenshtein Edit-Distance DP AST synthesis
+    if len(arg_names) >= 2 and all(len(a) == 2 and isinstance(a[0], str) and isinstance(a[1], str) for a, _ in samples):
+        a0, a1 = arg_names[0], arg_names[1]
+
+        def _eval_edit_dist(s1: str, s2: str) -> int:
+            dp = [list(range(len(s2) + 1))] + [[i] + [0] * len(s2) for i in range(1, len(s1) + 1)]
+            for i, ca in enumerate(s1):
+                for j, cb in enumerate(s2):
+                    dp[i + 1][j + 1] = dp[i][j] if ca == cb else 1 + min(dp[i][j], dp[i + 1][j], dp[i][j + 1])
+            return dp[-1][-1]
+
+        ed_src = (
+            f"dp = [list(range(len({a1}) + 1))] + [[i] + [0] * len({a1}) for i in range(1, len({a0}) + 1)]\n"
+            f"for i, ca in enumerate({a0}):\n"
+            f"    for j, cb in enumerate({a1}):\n"
+            f"        dp[i + 1][j + 1] = dp[i][j] if ca == cb else 1 + min(dp[i][j], dp[i + 1][j], dp[i][j + 1])\n"
+            f"return dp[-1][-1]"
+        )
+        try:
+            if all(_eval_edit_dist(a[0], a[1]) == y for a, y in samples):
+                out.append((ed_src, f"CEGAR_2D_EDIT_DISTANCE_DP_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+    # 9. Parametric Binary-Search & Sorted Two-Pointer AST synthesis
+    if len(arg_names) >= 2 and all(
+        len(a) == 2 and isinstance(a[0], list) and isinstance(a[1], (int, float))
+        for a, _ in samples
+    ):
+        arr_arg, tgt_arg = arg_names[0], arg_names[1]
+
+        def _eval_bsearch(arr: list[Any], tgt: Any) -> int:
+            lo, hi = 0, len(arr) - 1
+            while lo <= hi:
+                mid = (lo + hi) // 2
+                if arr[mid] == tgt:
+                    return mid
+                if arr[mid] < tgt:
+                    lo = mid + 1
+                else:
+                    hi = mid - 1
+            return -1
+
+        bs_src = (
+            f"lo, hi = 0, len({arr_arg}) - 1\n"
+            f"while lo <= hi:\n"
+            f"    mid = (lo + hi) // 2\n"
+            f"    if {arr_arg}[mid] == {tgt_arg}:\n"
+            f"        return mid\n"
+            f"    if {arr_arg}[mid] < {tgt_arg}:\n"
+            f"        lo = mid + 1\n"
+            f"    else:\n"
+            f"        hi = mid - 1\n"
+            f"return -1"
+        )
+        try:
+            if all(_eval_bsearch(a[0], a[1]) == y for a, y in samples):
+                out.append((bs_src, f"CEGAR_BINARY_SEARCH_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+        def _eval_two_pointer(arr: list[Any], tgt: Any) -> list[int]:
+            lo, hi = 0, len(arr) - 1
+            while lo < hi:
+                s = arr[lo] + arr[hi]
+                if s == tgt:
+                    return [lo, hi]
+                if s < tgt:
+                    lo += 1
+                else:
+                    hi -= 1
+            return [-1, -1]
+
+        tp_src = (
+            f"lo, hi = 0, len({arr_arg}) - 1\n"
+            f"while lo < hi:\n"
+            f"    s = {arr_arg}[lo] + {arr_arg}[hi]\n"
+            f"    if s == {tgt_arg}:\n"
+            f"        return [lo, hi]\n"
+            f"    if s < {tgt_arg}:\n"
+            f"        lo += 1\n"
+            f"    else:\n"
+            f"        hi -= 1\n"
+            f"return [-1, -1]"
+        )
+        try:
+            if all(_eval_two_pointer(a[0], a[1]) == y for a, y in samples):
+                out.append((tp_src, f"CEGAR_TWO_POINTER_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+    # 8. Family 10: Weighted Shortest-Path / Dijkstra Relaxation (3-arg: graph, start, target)
+    if (
+        len(arg_names) == 3
+        and all(
+            len(a) == 3
+            and isinstance(a[0], dict)
+            and any(isinstance(v, dict) for v in a[0].values())
+            and isinstance(y, int)
+            for a, y in samples
+        )
+    ):
+        g_arg, s_arg, t_arg = arg_names[0], arg_names[1], arg_names[2]
+
+        def _eval_dijkstra(graph: dict[Any, dict[Any, int]], start: Any, target: Any) -> int:
+            dist = {start: 0}
+            visited = set()
+            while len(visited) < len(graph) + 4:
+                cur = None
+                cur_d = None
+                for node, d_val in dist.items():
+                    if node not in visited and (cur_d is None or d_val < cur_d):
+                        cur = node
+                        cur_d = d_val
+                if cur is None:
+                    break
+                if cur == target:
+                    return int(cur_d)
+                visited.add(cur)
+                for nxt, w in (graph.get(cur) or {}).items():
+                    nd = int(cur_d) + int(w)
+                    if nxt not in dist or nd < dist[nxt]:
+                        dist[nxt] = nd
+            return int(dist.get(target, -1))
+
+        dijk_src = (
+            f"dist = {{{s_arg}: 0}}\n"
+            f"visited = set()\n"
+            f"while len(visited) < len({g_arg}) + 4:\n"
+            f"    cur, cur_d = None, None\n"
+            f"    for node, d_val in dist.items():\n"
+            f"        if node not in visited and (cur_d is None or d_val < cur_d):\n"
+            f"            cur, cur_d = node, d_val\n"
+            f"    if cur is None:\n"
+            f"        break\n"
+            f"    if cur == {t_arg}:\n"
+            f"        return cur_d\n"
+            f"    visited.add(cur)\n"
+            f"    for nxt, w in ({g_arg}.get(cur) or {{}}).items():\n"
+            f"        nd = cur_d + w\n"
+            f"        if nxt not in dist or nd < dist[nxt]:\n"
+            f"            dist[nxt] = nd\n"
+            f"return dist.get({t_arg}, -1)"
+        )
+        try:
+            if all(_eval_dijkstra(a[0], a[1], a[2]) == y for a, y in samples):
+                out.append((dijk_src, f"CEGAR_DIJKSTRA_SHORTEST_PATH_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+    # 9. Family 11: Topological Sort over DAG (1-arg: graph mapping node -> list of dependents)
+    if (
+        len(arg_names) == 1
+        and all(
+            len(a) == 1
+            and isinstance(a[0], dict)
+            and isinstance(y, list)
+            for a, y in samples
+        )
+    ):
+        g_arg = arg_names[0]
+
+        def _eval_toposort(graph: dict[Any, list[Any]]) -> list[Any]:
+            nodes = set(graph.keys())
+            for deps in graph.values():
+                for v in deps:
+                    nodes.add(v)
+            indeg = {u: 0 for u in nodes}
+            for u, deps in graph.items():
+                for v in deps:
+                    indeg[v] = indeg.get(v, 0) + 1
+            ready = sorted([u for u, d in indeg.items() if d == 0])
+            order: list[Any] = []
+            while ready:
+                cur = ready.pop(0)
+                order.append(cur)
+                for nxt in sorted(graph.get(cur) or []):
+                    indeg[nxt] -= 1
+                    if indeg[nxt] == 0:
+                        ready.append(nxt)
+                        ready.sort()
+            return order if len(order) == len(nodes) else []
+
+        topo_src = (
+            f"nodes = set({g_arg}.keys())\n"
+            f"for deps in {g_arg}.values():\n"
+            f"    for v in deps:\n"
+            f"        nodes.add(v)\n"
+            f"indeg = {{u: 0 for u in nodes}}\n"
+            f"for u, deps in {g_arg}.items():\n"
+            f"    for v in deps:\n"
+            f"        indeg[v] = indeg.get(v, 0) + 1\n"
+            f"ready = sorted([u for u, d in indeg.items() if d == 0])\n"
+            f"order = []\n"
+            f"while ready:\n"
