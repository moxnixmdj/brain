+def _get_batch_proc() -> subprocess.Popen:
+    global _batch_proc
+    if _batch_proc is None or _batch_proc.poll() is not None:
+        _batch_proc = subprocess.Popen(
+            ["git", "cat-file", "--batch"],
+            cwd=str(ROOT),
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+        )
+    return _batch_proc
