+# ---------------------------------------------------------------------------
+# 2. Dashed / Dotted / Patterned Line Style & Overlapping Curve Disambiguation
+# ---------------------------------------------------------------------------
+
+def classify_line_style(binary_mask_1d: Sequence[int]) -> dict[str, Any]:
+    """Classify a 1D binary stroke sample (`1` = ink, `0` = gap) into SOLID, DASHED, DOTTED, or DASH_DOT."""
+    if not binary_mask_1d:
+        raise ChartProfessionalSemanticsV2Error("EMPTY_STROKE_MASK")
+    runs_ink: list[int] = []
+    runs_gap: list[int] = []
+    cur_val = 1 if binary_mask_1d[0] else 0
+    cur_len = 0
+    for bit in binary_mask_1d:
+        b = 1 if bit else 0
+        if b == cur_val:
+            cur_len += 1
+        else:
+            (runs_ink if cur_val == 1 else runs_gap).append(cur_len)
+            cur_val = b
+            cur_len = 1
+    (runs_ink if cur_val == 1 else runs_gap).append(cur_len)
+
+    total = len(binary_mask_1d)
+    ink_ratio = sum(runs_ink) / max(1, total)
+    if not runs_gap or ink_ratio >= 0.92:
+        style = "SOLID"
+    else:
+        min_ink = min(runs_ink)
+        max_ink = max(runs_ink)
+        avg_ink = sum(runs_ink) / len(runs_ink)
+        if len(runs_ink) >= 4 and max_ink >= 2.2 * min_ink and min_ink <= 3:
+            style = "DASH_DOT"
+        elif avg_ink <= 3.0:
+            style = "DOTTED"
+        else:
+            style = "DASHED"
+
+    return {
+        "pass": True,
+        "style": style,
+        "ink_ratio": round(ink_ratio, 4),
+        "ink_run_count": len(runs_ink),
+        "gap_run_count": len(runs_gap),
+    }
+
+
+def trace_overlapping_curves(
+    incoming_branches: Sequence[Sequence[tuple[float, float]]],
+    outgoing_branches: Sequence[Sequence[tuple[float, float]]],
+    *,
+    min_angle_separation_deg: float = 8.0,
+) -> dict[str, Any]:
+    """Disambiguate two crossing/overlapping curve branches via tangent-vector continuity."""
+    if len(incoming_branches) != 2 or len(outgoing_branches) != 2:
+        raise ChartProfessionalSemanticsV2Error("REQUIRES_TWO_BRANCHES")
+
+    def _unit_tangent(pts: Sequence[tuple[float, float]], from_end: bool) -> tuple[float, float]:
+        if len(pts) < 2:
+            raise ChartProfessionalSemanticsV2Error("BRANCH_TOO_SHORT")
+        (x0, y0), (x1, y1) = (pts[-2], pts[-1]) if from_end else (pts[0], pts[1])
+        dx, dy = x1 - x0, y1 - y0
+        norm = math.hypot(dx, dy)
+        if norm < 1e-9:
+            raise ChartProfessionalSemanticsV2Error("ZERO_TANGENT_VECTOR")
+        return dx / norm, dy / norm
+
+    t_in = [_unit_tangent(b, True) for b in incoming_branches]
+    t_out = [_unit_tangent(b, False) for b in outgoing_branches]
+
+    # Angle between incoming[0] and incoming[1]
+    dot_in = max(-1.0, min(1.0, t_in[0][0] * t_in[1][0] + t_in[0][1] * t_in[1][1]))
+    sep_deg = math.degrees(math.acos(abs(dot_in)))
+    if sep_deg < min_angle_separation_deg:
+        # Attempt 2nd-order Taylor curvature jet disambiguation when >= 3 points exist per branch
+        if all(len(b) >= 3 for b in incoming_branches) and all(len(b) >= 3 for b in outgoing_branches):
+            def _curvature_y_xx(pts: Sequence[tuple[float, float]], from_end: bool) -> float:
+                (xa, ya), (xb, yb), (xc, yc) = pts[-3:] if from_end else pts[:3]
+                dx1 = xb - xa
+                dx2 = xc - xb
+                if abs(dx1) < 1e-9 or abs(dx2) < 1e-9 or abs(xc - xa) < 1e-9:
+                    return 0.0
+                s1 = (yb - ya) / dx1
+                s2 = (yc - yb) / dx2
+                return 2.0 * (s2 - s1) / (xc - xa)
+
+            k_in = [_curvature_y_xx(b, True) for b in incoming_branches]
+            k_out = [_curvature_y_xx(b, False) for b in outgoing_branches]
+            if abs(k_in[0] - k_in[1]) >= 0.1 and abs(k_out[0] - k_out[1]) >= 0.1:
+                err_direct = abs(k_in[0] - k_out[0]) + abs(k_in[1] - k_out[1])
+                err_crossed = abs(k_in[0] - k_out[1]) + abs(k_in[1] - k_out[0])
+                if abs(err_direct - err_crossed) >= 0.1:
+                    mapping = {0: 0, 1: 1} if err_direct < err_crossed else {0: 1, 1: 0}
+                    traced = [
+                        list(incoming_branches[i]) + list(outgoing_branches[mapping[i]])
+                        for i in (0, 1)
+                    ]
+                    return {
+                        "pass": True,
+                        "branch_mapping": mapping,
+                        "angle_separation_deg": round(sep_deg, 3),
+                        "resolved_by": "SECOND_ORDER_CURVATURE_JET",
+                        "curvature_in": [round(k, 4) for k in k_in],
+                        "curvature_out": [round(k, 4) for k in k_out],
+                        "traced_polylines": traced,
+                    }
+        raise ChartProfessionalSemanticsV2Error("TANGENTIAL_OVERLAP_AMBIGUOUS_FAIL_CLOSED")
+
+    # Compare matching (0->0, 1->1) vs (0->1, 1->0)
+    score_direct = (t_in[0][0] * t_out[0][0] + t_in[0][1] * t_out[0][1]) + (
+        t_in[1][0] * t_out[1][0] + t_in[1][1] * t_out[1][1]
+    )
+    score_crossed = (t_in[0][0] * t_out[1][0] + t_in[0][1] * t_out[1][1]) + (
+        t_in[1][0] * t_out[0][0] + t_in[1][1] * t_out[0][1]
+    )
+    if abs(score_direct - score_crossed) < 1e-4:
+        raise ChartProfessionalSemanticsV2Error("CROSSING_CONTINUATION_TIE_FAIL_CLOSED")
+
+    mapping = {0: 0, 1: 1} if score_direct > score_crossed else {0: 1, 1: 0}
+    traced = [
+        list(incoming_branches[i]) + list(outgoing_branches[mapping[i]])
+        for i in (0, 1)
+    ]
+    return {
+        "pass": True,
+        "branch_mapping": mapping,
+        "angle_separation_deg": round(sep_deg, 3),
+        "traced_polylines": traced,
+    }
+
+
+# ---------------------------------------------------------------------------
+# 3. Kaplan-Meier Survival & Percentile Curve Query
+# ---------------------------------------------------------------------------
+
+def query_survival_curve(
+    step_points: Sequence[tuple[float, float]],
+    *,
+    query_time: float,
+    percentile: float = 0.5,
+    censor_times: Sequence[float] = (),
+) -> dict[str, Any]:
+    """Evaluate a right-continuous step survival curve $S(t)$ and percentile survival time $t_p$."""
+    if not step_points:
+        raise ChartProfessionalSemanticsV2Error("SURVIVAL_POINTS_EMPTY")
+    pts = [(float(t), float(s)) for t, s in step_points]
+    # Normalize percentage [0..100] to [0..1] if max > 1.0
+    scale = 100.0 if max(s for _, s in pts) > 1.0001 else 1.0
+    norm_pts = [(t, s / scale) for t, s in pts]
+
+    # Verify non-increasing step monotonicity
+    for (_, s0), (_, s1) in zip(norm_pts[:-1], norm_pts[1:]):
+        if s1 > s0 + 1e-6:
+            raise ChartProfessionalSemanticsV2Error("SURVIVAL_CURVE_NOT_MONOTONIC_FAIL_CLOSED")
+
+    if query_time < norm_pts[0][0] or query_time > norm_pts[-1][0]:
+        raise ChartProfessionalSemanticsV2Error("SURVIVAL_QUERY_TIME_OUT_OF_RANGE")
+
+    # Right-continuous step value at query_time
+    s_at_t = norm_pts[0][1]
+    for t_step, s_step in norm_pts:
+        if t_step <= query_time + 1e-9:
+            s_at_t = s_step
+        else:
+            break
+
+    # Percentile time t_p = inf { t : S(t) <= percentile }
+    target_p = percentile / 100.0 if percentile > 1.0 else percentile
+    t_percentile: float | None = None
+    for t_step, s_step in norm_pts:
+        if s_step <= target_p + 1e-9:
+            t_percentile = t_step
+            break
+
+    return {
+        "pass": True,
+        "survival_at_query_time": round(s_at_t, 6),
+        "percentile": target_p,
+        "percentile_survival_time": t_percentile,
+        "censor_count": len(censor_times),
+    }
+
+
+# ---------------------------------------------------------------------------
+# 4. Bode Magnitude (dB) & Phase (deg) Frequency-Response Query
+# ---------------------------------------------------------------------------
+
+def query_bode_plot(
+    frequencies_hz: Sequence[float],
+    magnitude_db: Sequence[float],
+    phase_deg: Sequence[float],
+) -> dict[str, Any]:
+    """Compute DC gain, -3 dB cutoff frequency, unity-gain crossover, phase crossover, Phase Margin, and Gain Margin."""
+    if not (len(frequencies_hz) == len(magnitude_db) == len(phase_deg)) or len(frequencies_hz) < 3:
+        raise ChartProfessionalSemanticsV2Error("BODE_SERIES_INVALID")
+    if any(f <= 0 for f in frequencies_hz):
+        raise ChartProfessionalSemanticsV2Error("BODE_FREQUENCY_NONPOSITIVE")
+
+    log_f = [math.log10(float(f)) for f in frequencies_hz]
+    mag = [float(m) for m in magnitude_db]
+    phs = [float(p) for p in phase_deg]
+
+    dc_gain_db = mag[0]
+    target_3db = dc_gain_db - 3.0
+
+    def _find_crossing(y_series: Sequence[float], target: float) -> tuple[float | None, float | None]:
+        for i in range(len(y_series) - 1):
+            y0, y1 = y_series[i], y_series[i + 1]
+            if (y0 - target) * (y1 - target) <= 0 and abs(y1 - y0) > 1e-12:
+                frac = (target - y0) / (y1 - y0)
+                lf = log_f[i] + frac * (log_f[i + 1] - log_f[i])
+                return 10.0 ** lf, i + frac
+        return None, None
+
+    def _eval_at_index(series: Sequence[float], idx_frac: float) -> float:
+        i = int(math.floor(idx_frac))
+        i = max(0, min(len(series) - 2, i))
+        frac = idx_frac - i
+        return series[i] + frac * (series[i + 1] - series[i])
+
+    f_bw_3db, _ = _find_crossing(mag, target_3db)
+    f_0db, idx_0db = _find_crossing(mag, 0.0)
+    f_180, idx_180 = _find_crossing(phs, -180.0)
+
+    phase_margin_deg = (180.0 + _eval_at_index(phs, idx_0db)) if idx_0db is not None else None
+    gain_margin_db = (-_eval_at_index(mag, idx_180)) if idx_180 is not None else None
+
+    return {
+        "pass": True,
+        "dc_gain_db": round(dc_gain_db, 4),
+        "bandwidth_minus_3db_hz": round(f_bw_3db, 4) if f_bw_3db is not None else None,
+        "unity_gain_crossover_hz": round(f_0db, 4) if f_0db is not None else None,
+        "phase_crossover_hz": round(f_180, 4) if f_180 is not None else None,
+        "phase_margin_deg": round(phase_margin_deg, 4) if phase_margin_deg is not None else None,
+        "gain_margin_db": round(gain_margin_db, 4) if gain_margin_db is not None else None,
+    }
+
+
+# ---------------------------------------------------------------------------
+# 5. Contour / Isoline Value Query & Sankey Flow Topology Quantification
+# ---------------------------------------------------------------------------
+
+def query_contour_isoline(
+    isolines: Sequence[Mapping[str, Any]],
+    query_point: tuple[float, float],
+) -> dict[str, Any]:
+    """Interpolate scalar field $z(x, y)$ between labeled contour isolines."""
+    if len(isolines) < 2:
+        raise ChartProfessionalSemanticsV2Error("CONTOUR_ISOLINES_INSUFFICIENT")
+    qx, qy = float(query_point[0]), float(query_point[1])
+
+    def _point_to_polyline_dist(pts: Sequence[tuple[float, float]]) -> float:
+        best = float("inf")
+        for (x0, y0), (x1, y1) in zip(pts[:-1], pts[1:]):
+            dx, dy = x1 - x0, y1 - y0
+            seg_len2 = dx * dx + dy * dy
+            if seg_len2 < 1e-12:
+                d = math.hypot(qx - x0, qy - y0)
+            else:
+                t = max(0.0, min(1.0, ((qx - x0) * dx + (qy - y0) * dy) / seg_len2))
+                px, py = x0 + t * dx, y0 + t * dy
+                d = math.hypot(qx - px, qy - py)
+            if d < best:
+                best = d
+        return best
+
+    dists: list[tuple[float, float]] = []
+    for iso in isolines:
+        level = float(iso["level"])
+        pts = [(float(p[0]), float(p[1])) for p in iso["points"]]
+        d = _point_to_polyline_dist(pts)
+        dists.append((d, level))
+
+    dists.sort(key=lambda item: item[0])
+    (d1, z1), (d2, z2) = dists[0], dists[1]
+    if d1 < 1e-9:
+        z_val = z1
+    else:
+        z_val = (z1 / d1 + z2 / d2) / (1.0 / d1 + 1.0 / d2)
+
+    return {
+        "pass": True,
+        "query_point": [qx, qy],
+        "interpolated_value": round(z_val, 6),
+        "nearest_levels": [z1, z2],
+    }
+
+
+def quantify_sankey_flows(
+    edges: Sequence[Mapping[str, Any]],
+    *,
+    scale_per_pixel: float = 1.0,
+    conservation_tolerance: float = 1e-6,
+) -> dict[str, Any]:
+    """Quantify directed Sankey flows from band widths and verify flow conservation at internal nodes."""
+    if not edges:
+        raise ChartProfessionalSemanticsV2Error("SANKEY_EDGES_EMPTY")
+    inflow: dict[str, float] = {}
+    outflow: dict[str, float] = {}
+    quantified_edges: list[dict[str, Any]] = []
+
+    for e in edges:
+        src = str(e["source"])
+        dst = str(e["target"])
+        w = float(e["width_px"])
+        if w <= 0:
+            raise ChartProfessionalSemanticsV2Error("SANKEY_NONPOSITIVE_WIDTH")
+        val = w * scale_per_pixel
+        outflow[src] = outflow.get(src, 0.0) + val
+        inflow[dst] = inflow.get(dst, 0.0) + val
+        quantified_edges.append({"source": src, "target": dst, "flow": round(val, 6)})
+
+    internal_nodes = sorted(set(inflow) & set(outflow))
+    for node in internal_nodes:
+        if abs(inflow[node] - outflow[node]) > conservation_tolerance:
+            raise ChartProfessionalSemanticsV2Error(f"SANKEY_FLOW_CONSERVATION_VIOLATED:{node}")
+
+    for row in quantified_edges:
+        total_src = outflow[row["source"]]
+        row["split_fraction_from_source"] = round(row["flow"] / total_src, 6)
+
+    return {
+        "pass": True,
+        "internal_node_conservation_verified": True,
+        "internal_nodes": internal_nodes,
+        "edges": quantified_edges,
+    }
+
+
+# ---------------------------------------------------------------------------
+# 6. Candlestick Time-Series OHLC Semantics
+# ---------------------------------------------------------------------------
+
+def query_candlestick_ohlc(
+    candles: Sequence[Mapping[str, Any]],
+    *,
+    query_timestamp: str,
+) -> dict[str, Any]:
+    """Extract Open, High, Low, Close (OHLC) values from candlestick wick/body geometry."""
+    if not candles:
+        raise ChartProfessionalSemanticsV2Error("CANDLESTICK_SERIES_EMPTY")
+    decoded: list[dict[str, Any]] = []
+    for c in candles:
+        ts = str(c["timestamp"])
+        body_low = float(c["body_min_price"])
+        body_high = float(c["body_max_price"])
+        wick_low = float(c["wick_min_price"])
+        wick_high = float(c["wick_max_price"])
+        bullish = bool(c["is_bullish"])
+        if wick_low > body_low + 1e-9 or wick_high < body_high - 1e-9 or body_low > body_high + 1e-9:
+            raise ChartProfessionalSemanticsV2Error(f"INVALID_CANDLE_GEOMETRY:{ts}")
+        open_p = body_low if bullish else body_high
+        close_p = body_high if bullish else body_low
+        decoded.append(
+            {
+                "timestamp": ts,
+                "open": open_p,
+                "high": wick_high,
+                "low": wick_low,
+                "close": close_p,
+                "is_bullish": bullish,
+                "range": round(wick_high - wick_low, 6),
+            }
+        )
+
+    matches = [d for d in decoded if d["timestamp"] == query_timestamp]
+    if len(matches) != 1:
+        raise ChartProfessionalSemanticsV2Error(f"CANDLE_TIMESTAMP_NOT_UNIQUE:{query_timestamp}")
+
+    return {
+        "pass": True,
+        "candle": matches[0],
+        "series_high": max(d["high"] for d in decoded),
+        "series_low": min(d["low"] for d in decoded),
+    }
