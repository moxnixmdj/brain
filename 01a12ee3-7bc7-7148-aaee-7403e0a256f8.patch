+        val_sum = 0.0
+        for j in range(max(0, i - 2), min(8, i + 3)):
+            w_s = math.exp(-((float(i - j) ** 2) / (2.0 * (sigma_s ** 2))))
+            w_r = math.exp(-(((noisy_step[i] - noisy_step[j]) ** 2) / (2.0 * (sigma_r ** 2))))
