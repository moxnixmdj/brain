+def extract_spectral_peaks(
+    samples: Sequence[float], sample_rate: int, top_k: int = 3
+) -> list[dict[str, float]]:
+    """Apply a Hann window, compute FFT magnitudes, and refine top-k peaks via parabolic interpolation."""
+    n = len(samples)
+    windowed = [
+        float(samples[i]) * (0.5 - 0.5 * math.cos(2.0 * math.pi * i / float(n - 1)))
+        for i in range(n)
+    ]
+    spec = fft_radix2(windowed, inverse=False)
+    half = n // 2
+    mags = [abs(spec[k]) for k in range(half)]
+    local_peaks: list[tuple[float, float]] = []
+    for k in range(1, half - 1):
+        if mags[k] > mags[k - 1] and mags[k] >= mags[k + 1]:
+            alpha = mags[k - 1]
+            beta = mags[k]
+            gamma = mags[k + 1]
+            denom = alpha - 2.0 * beta + gamma
+            delta = 0.5 * (alpha - gamma) / denom if abs(denom) > 1e-12 else 0.0
+            interp_bin = float(k) + delta
+            freq_hz = interp_bin * float(sample_rate) / float(n)
+            local_peaks.append((beta, freq_hz))
+    local_peaks.sort(key=lambda item: item[0], reverse=True)
+    selected = sorted(local_peaks[:top_k], key=lambda item: item[1])
+    return [{"frequency_hz": round(freq, 4), "magnitude": round(mag, 4)} for mag, freq in selected]
+
+
+def goertzel_power(samples: Sequence[float], target_freq: float, sample_rate: int) -> float:
+    """Compute Goertzel spectral power at an exact target frequency."""
+    n = len(samples)
+    k = target_freq * float(n) / float(sample_rate)
+    omega = 2.0 * math.pi * k / float(n)
+    coeff = 2.0 * math.cos(omega)
+    s_prev = 0.0
+    s_prev2 = 0.0
+    for x in samples:
+        s = float(x) + coeff * s_prev - s_prev2
+        s_prev2 = s_prev
+        s_prev = s
+    return s_prev2 * s_prev2 + s_prev * s_prev - coeff * s_prev * s_prev2
+
+
+def synthesize_dtmf_sequence(
+    digits: str,
+    sample_rate: int = 8000,
+    tone_samples: int = 400,
+    gap_samples: int = 160,
+) -> list[float]:
+    """Synthesize an ITU-T Q.23 DTMF waveform with inter-digit silence gaps."""
+    out: list[float] = []
+    for ch in digits:
+        f_low, f_high = DTMF_REVERSE[ch]
+        for i in range(tone_samples):
+            t = float(i) / float(sample_rate)
+            val = 0.45 * math.sin(2.0 * math.pi * f_low * t) + 0.45 * math.sin(
+                2.0 * math.pi * f_high * t
+            )
+            out.append(val)
+        out.extend([0.0] * gap_samples)
+    return out
+
+
+def decode_dtmf_sequence(
+    samples: Sequence[float],
+    sample_rate: int = 8000,
+    frame_size: int = 200,
+) -> str:
+    """Decode an ITU-T Q.23 DTMF waveform into its digit string via Goertzel filterbank."""
+    decoded_tokens: list[str] = []
+    prev_symbol: str | None = None
+    for start in range(0, len(samples) - frame_size + 1, frame_size):
+        frame = samples[start : start + frame_size]
+        rms = math.sqrt(sum(float(x) * float(x) for x in frame) / float(frame_size))
+        if rms < 0.15:
+            prev_symbol = None
+            continue
+        low_best = max(DTMF_LOW_FREQS, key=lambda f: goertzel_power(frame, f, sample_rate))
+        high_best = max(DTMF_HIGH_FREQS, key=lambda f: goertzel_power(frame, f, sample_rate))
+        sym = DTMF_GRID.get((low_best, high_best))
+        if sym and sym != prev_symbol:
+            decoded_tokens.append(sym)
+            prev_symbol = sym
+    return "".join(decoded_tokens)
+
+
+def compute_mfcc_vector(
+    samples: Sequence[float],
+    sample_rate: int = 8000,
+    num_mel_bins: int = 13,
+    num_cepstra: int = 8,
+) -> list[float]:
+    """Compute Mel-Frequency Cepstral Coefficients (MFCC) using a triangular Mel filterbank + DCT-II."""
+    n = len(samples)
+    spec = fft_radix2(samples, inverse=False)
+    power = [(abs(spec[k]) ** 2) / float(n) for k in range(n // 2 + 1)]
+
+    def hz_to_mel(f: float) -> float:
+        return 2595.0 * math.log10(1.0 + f / 700.0)
+
+    def mel_to_hz(m: float) -> float:
+        return 700.0 * (10.0 ** (m / 2595.0) - 1.0)
+
+    mel_min = hz_to_mel(0.0)
+    mel_max = hz_to_mel(sample_rate / 2.0)
+    mel_points = [
+        mel_min + (mel_max - mel_min) * float(i) / float(num_mel_bins + 1)
+        for i in range(num_mel_bins + 2)
+    ]
+    hz_points = [mel_to_hz(m) for m in mel_points]
+    bin_points = [int(math.floor((n + 1) * h / float(sample_rate))) for h in hz_points]
+
+    log_mel: list[float] = []
+    for m in range(1, num_mel_bins + 1):
+        f_left, f_center, f_right = bin_points[m - 1], bin_points[m], bin_points[m + 1]
+        energy = 0.0
+        for k in range(f_left, f_center):
+            if f_center > f_left and 0 <= k < len(power):
+                energy += power[k] * float(k - f_left) / float(f_center - f_left)
+        for k in range(f_center, f_right + 1):
+            if f_right > f_center and 0 <= k < len(power):
+                energy += power[k] * float(f_right - k) / float(f_right - f_center)
+        log_mel.append(math.log(max(energy, 1e-12)))
+
+    mfcc: list[float] = []
+    for c in range(num_cepstra):
+        val = sum(
+            log_mel[m] * math.cos(math.pi * float(c) * (float(m) + 0.5) / float(num_mel_bins))
+            for m in range(num_mel_bins)
+        )
+        mfcc.append(round(val, 6))
+    return mfcc
+
