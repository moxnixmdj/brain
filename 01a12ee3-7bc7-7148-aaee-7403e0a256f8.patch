+    # 12. Video 3D homography perspective warp & 4-state Kalman filter trajectory smoothing
+    src_quad = [(0.0, 0.0), (10.0, 0.0), (10.0, 10.0), (0.0, 10.0)]
+    dst_quad = [(2.0, 1.0), (14.0, 2.0), (13.0, 15.0), (1.0, 12.0)]
