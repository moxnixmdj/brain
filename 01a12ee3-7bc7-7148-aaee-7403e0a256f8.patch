+        primal_opt = float(r7.get("achieved_rate", 0.0))
+        tau_val = float(r7.get("required_threshold_tau", 1.0))
+        margin_val = float(r7.get("excess_safety_margin", 0.0))
+        dual_bound = round(tau_val + margin_val, 6)
+        duality_gap = abs(round(primal_opt - dual_bound, 12))
+
+        tarski_sound = bool(r1.get("pass") is True and r9.get("cross_verifier_diagram_commutes") is True)
+        quotient_complete = bool(cc_r3_ok and r9.get("idempotent_fixed_point") is True and primal_opt >= tau_val)
+        ok_row = bool(tarski_sound and quotient_complete and duality_gap == 0.0)
+        duality_rows.append(
+            {
+                "obligation_id": oid,
+                "primal_optimum": primal_opt,
+                "dual_certificate_bound": dual_bound,
+                "duality_gap": duality_gap,
+                "tarski_semantic_soundness": tarski_sound,
+                "quotient_admissibility_completeness": quotient_complete,
+                "duality_certificate_sha256": _sha256(
+                    {"oid": oid, "primal": primal_opt, "dual": dual_bound, "gap": duality_gap}
+                ),
+                "pass": ok_row,
+            }
+        )
+
+    ok = len(duality_rows) == 13 and all(r["pass"] is True for r in duality_rows)
+    return {
+        "pass": ok,
+        "passed_count": sum(1 for r in duality_rows if r["pass"] is True),
+        "soundness_verified_count": sum(1 for r in duality_rows if r["tarski_semantic_soundness"] is True),
