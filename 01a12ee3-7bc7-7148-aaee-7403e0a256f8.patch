diff --git a/canonical/tests/test_verification_capsule_local_runner_v1.py b/canonical/tests/test_verification_capsule_local_runner_v1.py
new file mode 100644
index 0000000..fa11c8b
--- /dev/null
+++ b/canonical/tests/test_verification_capsule_local_runner_v1.py
@@ -0,0 +1,117 @@
+"""End-to-end tests for Isolated Cleanroom Capsule Runner & V4 Total Closure."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import unittest
+
+from canonical.runtime import (
+    current_authority_runtime_census_v1,
+    final_terminal_cleanroom_gate_v1,
+    one_shot_reality_closure_v2,
+    one_shot_remote_main_and_capsule_sync_v1,
+    one_shot_verified_closure_v1,
+    open_world_symbolic_generalization_engine_v1,
+    terminal_autopilot_v1,
+    terminal_family_adjudication_reducer_v1,
+    terminal_projection_consistency_v1,
+    terminal_reality_gate_v1,
+    terminal_route_closure_controller,
+    verification_capsule_local_runner_v1,
+)
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+class VerificationCapsuleLocalRunnerV1Tests(unittest.TestCase):
+    def test_cleanroom_capsule_runner_passes_all_11_engines_and_5_solvers(self) -> None:
+        res = verification_capsule_local_runner_v1.evaluate(ROOT, write_attestation=True)
+        self.assertTrue(res["pass"])
+        self.assertEqual(res["engine_count"], 12)
+        self.assertEqual(res["engine_pass_count"], 12)
+        self.assertEqual(res["domain_solver_count"], 6)
+        self.assertEqual(res["domain_solver_pass_count"], 6)
+        self.assertTrue(all(res["engine_checks"].values()))
+        self.assertTrue(all(res["domain_solver_checks"].values()))
+        self.assertTrue(all(res["guard_checks"].values()))
+        att_path = ROOT / verification_capsule_local_runner_v1.ATTESTATION_PATH
+        self.assertTrue(att_path.is_file())
+        on_disk = json.loads(att_path.read_text(encoding="utf-8"))
+        self.assertEqual(on_disk["attestation_sha256"], res["attestation_sha256"])
+
+    def test_open_world_symbolic_generalization_and_remote_sync_readiness(self) -> None:
+        ow = open_world_symbolic_generalization_engine_v1.evaluate(ROOT)
+        self.assertTrue(ow["pass"])
+        self.assertEqual(ow["suite_count"], 16)
+        self.assertEqual(ow["suite_pass_count"], 16)
+        self.assertEqual(ow["kstar_basis_generator_count"], 10)
+        self.assertEqual(ow["kstar_basis_routed_pass_count"], 10)
+
+        census = current_authority_runtime_census_v1.run(ROOT)
+        self.assertTrue(census["pass"])
+        self.assertEqual(census["authority_pointer_reference_missing_count"], 0)
+
+        rc = terminal_route_closure_controller.evaluate(ROOT)
+        self.assertEqual(rc["status"], "PASS")
+        self.assertEqual(rc["open_route_count"], 0)
+        self.assertEqual(rc["closed_route_count"], 12)
+
+        sync = one_shot_remote_main_and_capsule_sync_v1.evaluate_readiness(ROOT, write_receipt=True)
+        self.assertTrue(sync["pass"])
+        self.assertEqual(sync["gate_pass_count"], sync["gate_count"])
+
+    def test_live_terminal_reality_gate_zero_warnings(self) -> None:
+        pointer = json.loads(
+            (ROOT / "canonical/governance/CURRENT_TERMINAL_AUTHORITY.json").read_text(
+                encoding="utf-8"
+            )
+        )
+        manifest = json.loads(
+            (ROOT / "canonical/governance/TERMINAL_CLOSURE_MANIFEST_V1.json").read_text(
+                encoding="utf-8"
+            )
+        )
+        res = terminal_reality_gate_v1.evaluate(pointer, manifest)
+        self.assertTrue(res["terminal_real"])
+        self.assertTrue(res["declared_terminal"])
+        self.assertEqual(res["phase"], "TERMINAL")
+        self.assertEqual(res["declaration_warnings"], [])
+        self.assertEqual(res["blockers"], [])
+
+    def test_live_terminal_projection_consistency_achieved_true(self) -> None:
+        res = terminal_projection_consistency_v1.evaluate_live()
+        self.assertTrue(res["pass"])
+        self.assertTrue(res["terminal_goal_achieved"])
+        self.assertEqual(res["acceptance_closed_families"], 19)
+        self.assertEqual(res["acceptance_open_families"], 0)
+        self.assertEqual(res["atomic_predicates_proved"], 38)
+        self.assertEqual(res["atomic_predicates_unresolved"], 0)
+        self.assertEqual(res["errors"], [])
+
+    def test_live_family_adjudication_and_cleanroom_gate_and_one_shot_closures(self) -> None:
+        fam = terminal_family_adjudication_reducer_v1.evaluate(ROOT)
+        self.assertTrue(fam["pass"])
+        self.assertEqual(fam["errors"], [])
+        self.assertEqual(fam["terminal_family_count"], 19)
+
+        cg = final_terminal_cleanroom_gate_v1.evaluate_live_candidate(ROOT)
+        self.assertTrue(cg["pass"])
+        self.assertTrue(cg["terminal_authority"])
+        self.assertEqual(cg["errors"], [])
+
+        os1 = one_shot_verified_closure_v1.run(repo_root=ROOT)
+        self.assertTrue(os1["pass"])
+        self.assertTrue(os1["fixed_point"])
+
+        os2 = one_shot_reality_closure_v2.run(repo_root=ROOT)
+        self.assertTrue(os2["pass"])
+        self.assertTrue(os2["fixed_point"])
+
+        ap = terminal_autopilot_v1.plan(terminal_autopilot_v1.build_manifest_from_repo(ROOT))
+        self.assertTrue(ap["pass"])
+        self.assertEqual(ap["classification"], "TERMINAL_ALREADY_TRUE")
+        self.assertEqual(ap["open_obligation_count"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
