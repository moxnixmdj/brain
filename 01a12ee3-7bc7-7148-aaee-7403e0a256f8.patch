+    assert c14["pass"] is True
+
+
+def test_chartography_v2_unit_conversion_and_second_order_curvature_disambiguation():
+    out = chart_v2.convert_chart_quantity(250, "ms", "s")
+    assert out["pass"] is True
+    assert out["dimension"] == "TIME"
+    assert out["converted_value"] == 0.25
+    assert out["exact_rational"] == "1/4"
+
+    with pytest.raises(chart_v2.ChartProfessionalSemanticsV2Error, match="DIMENSION_MISMATCH_FAIL_CLOSED"):
+        chart_v2.convert_chart_quantity(250, "ms", "Hz")
+
+    traced = chart_v2.trace_overlapping_curves(
+        incoming_branches=[
+            [(-0.04, 0.0016), (-0.02, 0.0004), (0.0, 0.0)],
+            [(-0.04, -0.0016), (-0.02, -0.0004), (0.0, 0.0)],
+        ],
+        outgoing_branches=[
+            [(0.0, 0.0), (0.02, -0.0004), (0.04, -0.0016)],
+            [(0.0, 0.0), (0.02, 0.0004), (0.04, 0.0016)],
+        ],
+    )
+    assert traced["pass"] is True
+    assert traced["resolved_by"] == "SECOND_ORDER_CURVATURE_JET"
+    assert traced["branch_mapping"] == {0: 1, 1: 0}
+
+
+def test_chartography_v2_bode_survival_sankey_and_candlestick():
+    bode = chart_v2.query_bode_plot(
+        frequencies_hz=[1.0, 10.0, 100.0, 1000.0],
+        magnitude_db=[20.0, 17.0, 0.0, -20.0],
+        phase_deg=[0.0, -45.0, -135.0, -180.0],
+    )
+    assert bode["bandwidth_minus_3db_hz"] == 10.0
+    assert bode["phase_margin_deg"] == 45.0
+    assert bode["gain_margin_db"] == 20.0
+
+    surv = chart_v2.query_survival_curve(
+        [(0.0, 100.0), (5.0, 75.0), (10.0, 50.0), (20.0, 20.0)],
+        query_time=7.0,
+        percentile=50.0,
+    )
+    assert surv["survival_at_query_time"] == 0.75
+    assert surv["percentile_survival_time"] == 10.0
+
+
