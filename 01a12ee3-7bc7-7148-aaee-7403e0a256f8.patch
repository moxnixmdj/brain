+    isp_samples = [0.0, -0.85, 0.85, 0.85, -0.85, 0.0]
+    true_peak_4x = max(
+        abs(
+            sum(
+                isp_samples[k]
+                * (
+                    1.0
+                    if abs((t_sub / 4.0) - k) < 1e-9
+                    else math.sin(math.pi * ((t_sub / 4.0) - k)) / (math.pi * ((t_sub / 4.0) - k))
+                )
+                for k in range(len(isp_samples))
+            )
+        )
+        for t_sub in range(len(isp_samples) * 4)
+    )
+    ceiling_lin = 10.0 ** (-1.0 / 20.0)  # -1.0 dBTP ceiling (~0.89125)
+    limiter_gain = min(1.0, ceiling_lin / true_peak_4x)
