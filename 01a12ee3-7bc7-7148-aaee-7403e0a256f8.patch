+from __future__ import annotations
+
+from fractions import Fraction
+import json
+import unittest
+
+from canonical.runtime.open_world_symbolic_generalization_engine_v1 import (
+    KSTAR_BASIS_GENERATORS,
+    RECEIPT_PATH,
+    ROOT,
+    SCHEMA,
+    evaluate,
+    solve_open_world_task,
+    synthesize_linear_recurrence,
+    synthesize_observational_equivalence_program,
+    synthesize_rational_polynomial,
+)
+
+
+class OpenWorldSymbolicGeneralizationEngineV1Tests(unittest.TestCase):
+    def test_evaluate_verifies_all_ten_suites_and_kstar_basis(self):
+        out = evaluate(ROOT)
+        self.assertTrue(out["pass"], out)
+        self.assertEqual(out["schema"], SCHEMA)
+        self.assertEqual(out["suite_count"], 16)
+        self.assertEqual(out["suite_pass_count"], 16)
+        self.assertEqual(out["kstar_basis_generator_count"], 10)
+        self.assertEqual(out["kstar_basis_routed_pass_count"], 10)
+        self.assertEqual(tuple(out["kstar_basis_generators"]), KSTAR_BASIS_GENERATORS)
+        self.assertEqual(out["model_dependency_count"], 0)
+        self.assertEqual(out["external_model_runtime_dependency_count"], 0)
+        self.assertEqual(out["incremental_spend_usd"], 0.0)
+        persisted = json.loads((ROOT / RECEIPT_PATH).read_text(encoding="utf-8"))
+        self.assertEqual(persisted, out)
+
+    def test_solve_open_world_task_routes_across_kstar_domains(self):
+        poly = solve_open_world_task(
+            {
+                "domain": "RATIONAL_POLYNOMIAL",
+                "train_pairs": [(0, 1), (1, 3), (2, 7)],
+                "holdout_pairs": [(3, 13)],
+            },
+            ROOT,
+        )
+        self.assertTrue(poly["pass"], poly)
+        self.assertEqual(poly["kstar_basis_id"], "B0_EXACT_RATIONAL_SYMBOLIC_ALGEBRA")
+        self.assertEqual(poly["coefficients_exact"], ["1", "1", "1"])
+
+        rec = solve_open_world_task(
+            {
+                "domain": "LINEAR_RECURRENCE",
+                "sequence": [1, 2, 4, 9, 21, 50, 120],
+                "holdout_count": 2,
+            },
+            ROOT,
+        )
+        self.assertTrue(rec["pass"], rec)
+        self.assertEqual(rec["kstar_basis_id"], "B1_KOOPMAN_MFG_EXACT_RATIONAL_SADDLE")
+        self.assertEqual(rec["next_term_exact"], "289")
+
+        prog = solve_open_world_task(
+            {
+                "domain": "PROGRAM_SYNTHESIS",
+                "train_examples": [([3, 1, 2, 3], [1, 2, 3]), ([5, 4, 5], [4, 5])],
+                "holdout_examples": [([9, 2, 9, 1], [1, 2, 9])],
+            },
+            ROOT,
+        )
+        self.assertTrue(prog["pass"], prog)
+        self.assertEqual(prog["kstar_basis_id"], "B3_COMPOSITION_12_QUOTIENT")
+        self.assertEqual(prog["program_ast"], "list_sort_unique")
+
+        unknown = solve_open_world_task({"domain": "NONEXISTENT_DOMAIN"}, ROOT)
+        self.assertFalse(unknown["pass"])
+        self.assertEqual(
+            unknown["status"],
+            "FAIL_CLOSED__UNSUPPORTED_OR_UNDERDETERMINED_OPEN_WORLD_DOMAIN",
+        )
+
+    def test_holdout_falsification_fails_closed(self):
+        falsified_poly = synthesize_rational_polynomial(
+            train_pairs=[(0, 1), (1, 2)],
+            holdout_pairs=[(2, 99)],
+        )
+        self.assertFalse(falsified_poly["pass"])
+        self.assertEqual(
+            falsified_poly["status"],
+            "FAIL_CLOSED__HOLDOUT_WITNESS_FALSIFIED",
+        )
+
+        falsified_rec = synthesize_linear_recurrence(
+            sequence=[1, 2, 4, 9, 21, 50, 999],
+            holdout_count=2,
+        )
+        self.assertFalse(falsified_rec["pass"])
+        self.assertEqual(
+            falsified_rec["status"],
+            "FAIL_CLOSED__RECURRENCE_FALSIFIED_ON_WITNESS",
+        )
+
+        falsified_prog = synthesize_observational_equivalence_program(
+            train_examples=[([1, 2], 3), ([4, 5], 9)],
+            holdout_examples=[([2, 3], 999)],
+        )
+        self.assertFalse(falsified_prog["pass"])
+        self.assertEqual(
+            falsified_prog["status"],
+            "FAIL_CLOSED__HOLDOUT_WITNESS_FALSIFIED",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
