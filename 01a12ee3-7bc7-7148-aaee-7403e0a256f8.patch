+        "target_effect": str(task.get("target_effect") or "OPEN_WORLD_TASK_VERIFIED"),
+    }
+    if "effect" in task:
+        structured_task["effect"] = task["effect"]
+
+    solved = solve(
+        structured_task,
+        effect_root=effect_root,
+        episode_verification_receipt=episode_verification_receipt,
