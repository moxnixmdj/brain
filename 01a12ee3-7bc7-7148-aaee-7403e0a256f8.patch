+    checks.append(
+        {
+            "check_id": "SURVIVAL_STEP_AND_MEDIAN_PERCENTILE_QUERY",
+            "pass": bool(abs(surv["survival_at_query_time"] - 0.8) < 1e-9 and abs(surv["percentile_survival_time"] - 9.0) < 1e-9),
