+  if name =="Mul":
+   res =[Fraction (1 )]
+   for a in args :
+    pa =_dec_poly_asc (a )
+    nxt =[Fraction (0 )]*(len (res )+len (pa )-1 )
+    for i ,u in enumerate (res ):
+     for j ,v in enumerate (pa ):
+      nxt [i +j ]+=u *v 
