+
+            # 32. Optimal Transport Kantorovich-Rubinstein Wasserstein-1 Earth Mover's Distance (EMD)
+            emd_spec = task.get("wasserstein_emd_spec")
+            if isinstance(emd_spec, Mapping):
+                mu_raw = [Fraction(str(v)) for v in (emd_spec.get("mu") or ["1/2", "1/2", "0"])]
+                nu_raw = [Fraction(str(v)) for v in (emd_spec.get("nu") or ["0", "1/2", "1/2"])]
+                step_dx = Fraction(str(emd_spec.get("grid_spacing", 1)))
+                n_bins = min(len(mu_raw), len(nu_raw))
+                cdf_diff_acc = Fraction(0, 1)
+                w1_dist = Fraction(0, 1)
+                for idx_b in range(n_bins):
+                    cdf_diff_acc += (mu_raw[idx_b] - nu_raw[idx_b])
+                    w1_dist += abs(cdf_diff_acc) * step_dx
+                pred_w1 = int(w1_dist) if w1_dist.denominator == 1 else round(float(w1_dist), 6)
+                candidate_hypotheses.insert(0, {
+                    "pass": True,
+                    "status": "PASS__OPTIMAL_TRANSPORT_KANTOROVICH_WASSERSTEIN_1_EARTH_MOVER_DISTANCE_SYNTHESIZED",
+                    "inferred_witness_family": "OPTIMAL_TRANSPORT_KANTOROVICH_WASSERSTEIN_1_EARTH_MOVER_DISTANCE_SYNTHESIS",
+                    "wasserstein_1_distance_exact": str(w1_dist),
+                    "prediction": pred_w1,
+                })
+
+            # 33. Markowitz Two-Asset Minimum-Variance Portfolio Optimal Weight & Variance over Q
+            mv_spec = task.get("markowitz_minimum_variance_portfolio_spec")
+            if isinstance(mv_spec, Mapping):
+                var1 = Fraction(str(mv_spec.get("var_1", 4)))
+                var2 = Fraction(str(mv_spec.get("var_2", 6)))
+                cov12 = Fraction(str(mv_spec.get("cov_12", 1)))
+                denom_mv = var1 + var2 - 2 * cov12
+                w1_opt = (var2 - cov12) / denom_mv if denom_mv != 0 else Fraction(1, 2)
+                w2_opt = Fraction(1, 1) - w1_opt
+                port_var = w1_opt * w1_opt * var1 + w2_opt * w2_opt * var2 + 2 * w1_opt * w2_opt * cov12
+                out_mv = str(mv_spec.get("output") or "portfolio_variance")
+                val_mv = w1_opt if out_mv == "weight_1" else port_var
+                pred_mv = int(val_mv) if val_mv.denominator == 1 else round(float(val_mv), 6)
+                candidate_hypotheses.insert(0, {
