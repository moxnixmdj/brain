+def _compact_ast_identical_bytes(src_bytes: bytes) -> tuple[bytes, bool]:
+    """Apply V79/V80 AST-identity token & indent compaction and verify zero AST drift."""
+    pairs: list[tuple[int, str]] = []
+    depth = 0
+    for tok in tokenize.tokenize(io.BytesIO(src_bytes).readline):
+        s = tok.string
+        if tok.type == tokenize.INDENT:
+            depth += 1
+            s = " " * depth
+        elif tok.type == tokenize.DEDENT:
+            depth = max(0, depth - 1)
+        elif tok.type == tokenize.COMMENT:
+            continue
+        pairs.append((tok.type, s))
+    out = tokenize.untokenize(pairs)
+    if isinstance(out, str):
+        out = out.encode("utf-8")
+    tree_a = ast.parse(src_bytes.decode("utf-8"))
+    tree_b = ast.parse(out.decode("utf-8"))
+    ast_eq = ast.dump(tree_a, include_attributes=False) == ast.dump(tree_b, include_attributes=False)
+    compile(out.decode("utf-8"), "<ast-compact>", "exec")
+    return out, ast_eq
