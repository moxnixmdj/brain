+
+def _norm_unit(u: str) -> str:
+    s = u.strip()
+    if s == "MW":
+        return "mw_mega"
+    return s.lower().replace(" ", "")
+
+
+def convert_chart_quantity(
+    value: float | int | str | Fraction,
+    from_unit: str,
+    to_unit: str,
+) -> dict[str, Any]:
+    """Convert `value` from `from_unit` to `to_unit` using exact rational arithmetic."""
+    q = Fraction(str(value))
+    u_src = _norm_unit(from_unit)
+    u_dst = _norm_unit(to_unit)
+
+    if u_src in _TEMP_UNITS or u_dst in _TEMP_UNITS:
+        if u_src not in _TEMP_UNITS or u_dst not in _TEMP_UNITS:
+            raise ChartProfessionalSemanticsV2Error(
+                f"DIMENSION_MISMATCH_FAIL_CLOSED:{from_unit}->{to_unit}"
+            )
+        # Convert to Kelvin first
+        if u_src in {"c", "degc", "°c"}:
+            kelvin = q + Fraction(27315, 100)
+        elif u_src in {"f", "degf", "°f"}:
+            kelvin = (q - Fraction(32, 1)) * Fraction(5, 9) + Fraction(27315, 100)
+        else:
+            kelvin = q
+        if kelvin < 0:
+            raise ChartProfessionalSemanticsV2Error("BELOW_ABSOLUTE_ZERO_FAIL_CLOSED")
+        if u_dst in {"c", "degc", "°c"}:
+            out_q = kelvin - Fraction(27315, 100)
+        elif u_dst in {"f", "degf", "°f"}:
+            out_q = (kelvin - Fraction(27315, 100)) * Fraction(9, 5) + Fraction(32, 1)
+        else:
+            out_q = kelvin
+        return {
+            "pass": True,
+            "dimension": "TEMPERATURE",
+            "from_unit": from_unit,
+            "to_unit": to_unit,
+            "input_value": float(q),
+            "converted_value": float(out_q),
+            "exact_rational": f"{out_q.numerator}/{out_q.denominator}",
+        }
+
+    if u_src not in _MULTIPLICATIVE_UNITS or u_dst not in _MULTIPLICATIVE_UNITS:
+        raise ChartProfessionalSemanticsV2Error(f"UNSUPPORTED_UNIT_FAIL_CLOSED:{from_unit}->{to_unit}")
+
+    dim_src, scale_src = _MULTIPLICATIVE_UNITS[u_src]
+    dim_dst, scale_dst = _MULTIPLICATIVE_UNITS[u_dst]
+    if dim_src != dim_dst:
+        raise ChartProfessionalSemanticsV2Error(
+            f"DIMENSION_MISMATCH_FAIL_CLOSED:{dim_src}!={dim_dst}"
+        )
+
+    out_q = q * scale_src / scale_dst
+    return {
+        "pass": True,
+        "dimension": dim_src,
+        "from_unit": from_unit,
+        "to_unit": to_unit,
+        "input_value": float(q),
+        "converted_value": float(out_q),
+        "exact_rational": f"{out_q.numerator}/{out_q.denominator}",
+    }
+
+
+def query_curve_with_unit_conversion(
+    curve_points: Sequence[tuple[float, float]],
+    *,
+    x_axis_unit: str,
+    y_axis_unit: str,
+    query_x: float,
+    query_x_unit: str,
+    target_y_unit: str,
+) -> dict[str, Any]:
+    """Convert `query_x` into `x_axis_unit`, interpolate $y(x)$ on `curve_points`, and convert $y$ to `target_y_unit`."""
+    conv_x = convert_chart_quantity(query_x, query_x_unit, x_axis_unit)
+    x_in_axis = conv_x["converted_value"]
+    pts = sorted((float(px), float(py)) for px, py in curve_points)
+    if len(pts) < 2 or x_in_axis < pts[0][0] or x_in_axis > pts[-1][0]:
+        raise ChartProfessionalSemanticsV2Error("QUERY_X_OUT_OF_RANGE_FAIL_CLOSED")
+
+    y_in_axis: float | None = None
+    for (x0, y0), (x1, y1) in zip(pts[:-1], pts[1:]):
+        if x0 <= x_in_axis <= x1:
+            if abs(x1 - x0) < 1e-12:
+                y_in_axis = y0
+            else:
+                t = (x_in_axis - x0) / (x1 - x0)
+                y_in_axis = y0 + t * (y1 - y0)
+            break
+    if y_in_axis is None:
+        raise ChartProfessionalSemanticsV2Error("INTERPOLATION_FAILED")
+
+    conv_y = convert_chart_quantity(y_in_axis, y_axis_unit, target_y_unit)
+    return {
+        "pass": True,
+        "query_x": query_x,
+        "query_x_unit": query_x_unit,
+        "x_in_axis_unit": x_in_axis,
+        "y_in_axis_unit": y_in_axis,
+        "converted_y": conv_y["converted_value"],
+        "target_y_unit": target_y_unit,
+        "dimension_x": conv_x["dimension"],
+        "dimension_y": conv_y["dimension"],
+    }
