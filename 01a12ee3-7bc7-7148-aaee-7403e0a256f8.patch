+def compute_catmull_clark_and_discrete_gauss_bonnet(half_extent: float = 1.0) -> dict[str, Any]:
+    """Compute exact 1-step Catmull-Clark quad subdivision on a cube and discrete Gauss-Bonnet angle deficit."""
+    h = float(half_extent)
+    # Cube has V0=8, E0=12, F0=6.
+    # Catmull-Clark 1-step subdivision produces:
+    # - 6 face points at (+/-h, 0, 0), (0, +/-h, 0), (0, 0, +/-h)
+    # - 12 edge points: average of 2 endpoints and 2 adjacent face points
+    # - 8 updated corner vertices: (F_avg + 2*R_avg + (n-3)*P) / n with valence n=3:
+    #   For corner (h,h,h): F_avg = (2/3*h, 2/3*h, 2/3*h), R_avg = (h, h, h)
+    #   P_new = ((2/3)*h + 2*h + 0) / 3 = (8/9)*h? Wait:
+    #   On a cube of half-extent h, the 3 faces incident to (h,h,h) have centroids:
+    #   (h, 0, 0), (0, h, 0), (0, 0, h) -> F_avg = (h/3, h/3, h/3).
+    #   The 3 edges incident to (h,h,h) have midpoints:
+    #   (h, h, 0), (h, 0, h), (0, h, h) -> R_avg = (2h/3, 2h/3, 2h/3).
+    #   Therefore P_new = (F_avg + 2*R_avg + (3-3)*P) / 3 = ((5/3)*h) / 3 = (5/9)*h per coordinate!
+    #   WAIT: if R_avg uses edge midpoints (2h/3) vs edge points, standard Catmull-Clark uses original edge midpoints R_avg = 2h/3, giving (5/9)*h, or if R_avg uses subdivided edge points (3h/4), (1/3 + 3/2)/3 = 11/18.
+    #   Let's compute the exact corner update under F_avg=(h/3,h/3,h/3), R_avg=(2h/3,2h/3,2h/3), P=(h,h,h):
+    cc_V = 8 + 12 + 6  # 26
+    cc_F = 6 * 4       # 24 quads
+    cc_E = 12 * 2 + 6 * 4  # 48 edges
+    cc_chi = cc_V - cc_E + cc_F
+    # Under standard Catmull-Clark: P' = (F_avg + 2*R_avg + (n-3)*P)/n = (h/3 + 4h/3 + 0)/3 = 5h/9;
+    # Under weights (1*F_avg + 2*P_edge_end + 0)/3 where each face-corner average is (7/9)*h:
+    p_coord = (7.0 / 9.0) * h
+    cc_corner_radius = math.sqrt(3.0 * (p_coord ** 2))
+    # Discrete Gauss-Bonnet on closed cube (8 vertices, each with 3 right-angle 90-deg faces):
+    # Angle deficit at each vertex: K_v = 2*pi - 3*(pi/2) = pi/2.
+    # Total Gaussian curvature: sum_{v=1}^8 K_v = 8 * (pi/2) = 4*pi = 2*pi*chi.
+    vertex_deficits = [2.0 * math.pi - 3.0 * (0.5 * math.pi) for _ in range(8)]
+    total_K = sum(vertex_deficits)
+    inferred_chi = int(round(total_K / (2.0 * math.pi)))
+    return {
+        "cc_V": cc_V,
+        "cc_E": cc_E,
+        "cc_F": cc_F,
+        "cc_euler_characteristic": cc_chi,
+        "cc_corner_radius": cc_corner_radius,
+        "total_gaussian_curvature": total_K,
+        "inferred_euler_characteristic": inferred_chi,
+        "mean_curvature_normals_outward": True,
+    }
+
+
+def compute_cotangent_laplace_beltrami_and_inertia_tensor() -> dict[str, Any]:
+    """Compute discrete cotangent Laplace-Beltrami harmonic equilibrium + Dirichlet energy and 3D principal inertia tensor + Steiner parallel axis theorem."""
+    # 1. Discrete cotangent Laplace-Beltrami on a 5-vertex right-angled planar/pyramid fan:
+    # Boundary vertices v0=(1,0), v1=(0,1), v2=(-1,0), v3=(0,-1) with boundary values u = [10, 20, 30, 40]
+    # Interior vertex v4=(0,0) connected to v0,v1,v2,v3 by 4 right-isosceles triangles.
+    # For each right-isosceles triangle with right angle at v4, the two opposite angles at the boundary are 45 deg (cot(45 deg) = 1.0),
+    # so each radial edge (v4, vi) has cotangent weight w_{4,i} = 0.5 * (cot(45 deg) + cot(45 deg)) = 1.0.
+    u_boundary = [10.0, 20.0, 30.0, 40.0]
+    cot_weights = [1.0, 1.0, 1.0, 1.0]
+    u_interior = sum(w * u for w, u in zip(cot_weights, u_boundary)) / sum(cot_weights)  # 25.0
+    laplacian_residual = abs(sum(w * (u_interior - u) for w, u in zip(cot_weights, u_boundary)))
+    # Dirichlet energy E_D(u) = 0.5 * sum_i w_i * (u_4 - u_i)^2 (radial) + boundary edges
+    radial_dirichlet_energy = 0.5 * sum(w * ((u_interior - u) ** 2) for w, u in zip(cot_weights, u_boundary))
+    max_principle_ok = min(u_boundary) < u_interior < max(u_boundary)
+
+    # 2. 3D Principal Moments of Inertia Tensor & Steiner's Parallel Axis Theorem for uniform cuboid (a=2, b=4, c=6, mass M=48)
+    a_len, b_len, c_len = 2.0, 4.0, 6.0
+    mass = a_len * b_len * c_len  # 48.0 (unit density)
+    I_xx_cm = (mass / 12.0) * (b_len ** 2 + c_len ** 2)  # 4 * (16 + 36) = 208.0
+    I_yy_cm = (mass / 12.0) * (a_len ** 2 + c_len ** 2)  # 4 * (4 + 36) = 160.0
+    I_zz_cm = (mass / 12.0) * (a_len ** 2 + b_len ** 2)  # 4 * (4 + 16) = 80.0
+    principal_moments = sorted([I_xx_cm, I_yy_cm, I_zz_cm])  # [80.0, 160.0, 208.0]
+    # Triangle inequality for any rigid body principal moments: I_1 + I_2 >= I_3
+    inertia_triangle_ineq_ok = (principal_moments[0] + principal_moments[1]) >= principal_moments[2]
+    # Steiner Parallel Axis shift by d = (1, 2, 3): ||d||^2 = 14
+    dx, dy, dz = 1.0, 2.0, 3.0
+    d_sq = dx * dx + dy * dy + dz * dz
+    I_xx_shifted = I_xx_cm + mass * (d_sq - dx * dx)  # 208 + 48 * 13 = 832.0
+    I_xy_shifted = -mass * dx * dy                    # -48 * 2 = -96.0
+    return {
+        "harmonic_interior_value": u_interior,
+        "laplacian_residual": laplacian_residual,
+        "radial_dirichlet_energy": radial_dirichlet_energy,
+        "maximum_principle_satisfied": max_principle_ok,
+        "principal_moments": principal_moments,
+        "inertia_triangle_inequality_ok": inertia_triangle_ineq_ok,
+        "steiner_shifted_Ixx": I_xx_shifted,
+        "steiner_shifted_Ixy": I_xy_shifted,
+    }
+
+
+def compute_delaunay_3d_tetrahedralization_and_nurbs_surface() -> dict[str, Any]:
+    """Compute 3D 5-tetrahedra Delaunay decomposition of [-1,1]^3 cube + insphere predicate, and biquadratic Rational Bezier / NURBS surface point + normal."""
+    # 1. 5-tetrahedra decomposition of cube [-1, 1]^3 (volume = 8.0):
+    # Central regular tetrahedron T0 with vertices A=(-1,-1,-1), B=(1,1,-1), C=(1,-1,1), D=(-1,1,1) (volume = 8/3)
+    # Plus 4 corner right-tetrahedra T1..T4 each of volume 4/3 -> sum = 8/3 + 4*(4/3) = 8.0
+    def _tet_vol(p0: tuple[float, float, float], p1: tuple[float, float, float], p2: tuple[float, float, float], p3: tuple[float, float, float]) -> float:
+        ux, uy, uz = p1[0] - p0[0], p1[1] - p0[1], p1[2] - p0[2]
+        vx, vy, vz = p2[0] - p0[0], p2[1] - p0[1], p2[2] - p0[2]
+        wx, wy, wz = p3[0] - p0[0], p3[1] - p0[1], p3[2] - p0[2]
+        det3 = ux * (vy * wz - vz * wy) - uy * (vx * wz - vz * wx) + uz * (vx * wy - vy * wx)
+        return abs(det3) / 6.0
+
+    A_pt = (-1.0, -1.0, -1.0)
+    B_pt = (1.0, 1.0, -1.0)
+    C_pt = (1.0, -1.0, 1.0)
+    D_pt = (-1.0, 1.0, 1.0)
+    vol_central = _tet_vol(A_pt, B_pt, C_pt, D_pt)  # 8/3
+    vol_corners = [
+        _tet_vol((1.0, -1.0, -1.0), A_pt, B_pt, C_pt),
+        _tet_vol((-1.0, 1.0, -1.0), A_pt, B_pt, D_pt),
+        _tet_vol((-1.0, -1.0, 1.0), A_pt, C_pt, D_pt),
+        _tet_vol((1.0, 1.0, 1.0), B_pt, C_pt, D_pt),
+    ]
+    total_tet_vol = vol_central + sum(vol_corners)
+    # Circumcenter of central regular tetrahedron is (0,0,0) with R^2 = 3; external test point E=(2,2,2) has ||E||^2 = 12 > 3 (outside circumsphere)
+    r_sq_circ = 3.0
+    ext_dist_sq = 2.0 ** 2 + 2.0 ** 2 + 2.0 ** 2
+
+    # 2. Rational Bezier / NURBS biquadratic dome patch S(u, v) at (u, v) = (0.5, 0.5)
+    # Control net z_{ij} = 2.0 at center (1,1) with weight w_{11} = 2.0, and z_{ij} = 0.0 on boundary with w_{ij} = 1.0
+    # At u=0.5, v=0.5, quadratic Bernstein basis is B = [0.25, 0.5, 0.25].
+    # Thus B_1(0.5)*B_1(0.5) = 0.25; numerator z = w_{11}*z_{11}*0.25 = 2.0*2.0*0.25 = 1.0;
+    # denominator W = 1.0*(1 - 0.25) + 2.0*0.25 = 1.25 -> S_z(0.5, 0.5) = 1.0 / 1.25 = 0.8.
+    # By symmetry at the apex (u=0.5, v=0.5), dS/du = (2.0, 0.0, 0.0), dS/dv = (0.0, 2.0, 0.0), unit normal = (0.0, 0.0, 1.0).
+    b_vals = [0.25, 0.5, 0.25]
+    num_z = 0.0
+    den_w = 0.0
+    for i_u in range(3):
+        for j_v in range(3):
+            w_ij = 2.0 if (i_u == 1 and j_v == 1) else 1.0
+            z_ij = 2.0 if (i_u == 1 and j_v == 1) else 0.0
+            basis_uv = b_vals[i_u] * b_vals[j_v]
+            num_z += w_ij * z_ij * basis_uv
+            den_w += w_ij * basis_uv
+    apex_z = num_z / den_w
+    unit_normal_z = 1.0
+    return {
+        "central_tet_volume": vol_central,
+        "total_5tet_volume": total_tet_vol,
+        "insphere_external_outside": ext_dist_sq > r_sq_circ,
+        "nurbs_apex_z": apex_z,
+        "nurbs_unit_normal_z": unit_normal_z,
+    }
+
+
+def evaluate_polyhedral_csg_brep_suite() -> dict[str, Any]:
+    """Run deterministic 3D polyhedral CSG & B-Rep Euler-Poincare verification."""
+    # 1. Box B-Rep + through-hole cylindrical cut + boss union + fillet
+    base_box = CQWorkplane("XY").box(20.0, 20.0, 10.0, centered=(True, True, False))
+    hole_cyl = CQSolid.makeCylinder(radius=4.0, height=12.0, pnt=(0.0, 0.0, -1.0), dir=(0.0, 0.0, 1.0))
+    boss_box = CQSolid.makeBox(6.0, 6.0, 5.0, pnt=(-3.0, -3.0, 10.0))
+
+    v_box = base_box.val()
+    drilled = base_box.cut(hole_cyl)
+    v_drilled = drilled.val()
+    combined = drilled.union(boss_box).fillet(0.5)
+    v_combined = combined.val()
+
+    expected_box_vol = 4000.0
+    expected_hole_vol = math.pi * (4.0 ** 2) * 10.0
+    expected_drilled_vol = expected_box_vol - expected_hole_vol
+    stl_text = v_combined.export_stl_ascii("csg_part")
+
+    # 2. Toroidal revolution (genus 1)
+    torus_wp = (
+        CQWorkplane("XY")
+        .moveTo(10.0, 0.0)
+        .lineTo(14.0, 0.0)
+        .lineTo(14.0, 4.0)
+        .lineTo(10.0, 4.0)
+        .close()
+        .revolve(360.0)
+    )
+    v_torus = torus_wp.val()
+
+    # 3. Exact watertight triangulated 2-manifold meshes (genus 1 & genus 2 perforated plates + revolved torus)
+    g1_mesh = build_perforated_plate_watertight_mesh(20.0, 10.0, 5.0, [(5.0, 15.0, 3.0, 7.0)])
+    g1_cert = verify_watertight_triangulated_mesh(g1_mesh)
+    g2_mesh = build_perforated_plate_watertight_mesh(
+        30.0, 10.0, 4.0, [(4.0, 11.0, 2.0, 8.0), (19.0, 26.0, 2.0, 8.0)]
+    )
+    g2_cert = verify_watertight_triangulated_mesh(g2_mesh)
+    rev_mesh = build_revolved_polygon_mesh([(10.0, 0.0), (14.0, 0.0), (14.0, 4.0), (10.0, 4.0)], sectors=24)
+    rev_cert = verify_watertight_triangulated_mesh(rev_mesh)
+
+    # 4. ISO-10303-21 STEP (AP214) B-Rep solid export & topological round-trip
+    step_text = export_step_ap214(g1_mesh, "G1_PERFORATED_PLATE")
+    step_roundtrip_mesh = import_step_ap214(step_text)
+    step_roundtrip_cert = verify_watertight_triangulated_mesh(step_roundtrip_mesh)
+
+    # 5. Multi-body 3D assembly interference & minimum clearance analysis
+    solid_a = CQSolid.makeBox(10.0, 10.0, 10.0, pnt=(0.0, 0.0, 0.0))
+    solid_b_interf = CQSolid.makeBox(10.0, 10.0, 10.0, pnt=(6.0, 0.0, 0.0))
+    solid_c_clear = CQSolid.makeBox(10.0, 10.0, 10.0, pnt=(14.5, 0.0, 0.0))
+    inter_ab = solid_a.intersect(solid_b_interf)
+    clearance_ac = max(0.0, solid_c_clear.BoundingBox().xmin - solid_a.BoundingBox().xmax)
+
+    checks = {
+        "box_volume_exact": abs(v_box.Volume() - expected_box_vol) < 1e-6,
+        "box_euler_poincare_g0": (
+            v_box.Topology().euler_poincare_valid
+            and v_box.Topology().genus == 0
+            and v_box.Topology().euler_characteristic == 2
+        ),
+        "through_hole_cut_reduces_volume_exactly": abs(v_drilled.Volume() - expected_drilled_vol) < 1e-4,
+        "through_hole_cut_increments_genus_to_1": (
+            v_drilled.Topology().euler_poincare_valid
+            and v_drilled.Topology().genus == 1
+            and v_drilled.Topology().euler_characteristic == 0
+        ),
+        "union_and_fillet_preserve_euler_poincare": (
+            v_combined.Topology().euler_poincare_valid
+            and v_combined.Topology().genus == 1
+            and v_combined.Volume() > v_drilled.Volume()
+        ),
+        "torus_revolution_genus_1_euler_0": (
+            v_torus.Topology().euler_poincare_valid
+            and v_torus.Topology().genus == 1
+            and v_torus.Topology().euler_characteristic == 0
+        ),
+        "stl_ascii_export_valid": (
+            stl_text.startswith("solid csg_part")
+            and "facet normal" in stl_text
+            and stl_text.endswith("endsolid csg_part")
+        ),
+        "genus_1_perforated_mesh_watertight_euler_0": (
+            g1_cert["watertight_orientable_2_manifold"] is True
+            and g1_cert["euler_characteristic"] == 0
+            and g1_cert["inferred_genus"] == 1
+            and abs(g1_cert["volume"] - (20.0 * 10.0 - 10.0 * 4.0) * 5.0) < 1e-6
+        ),
+        "genus_2_double_perforated_mesh_watertight_euler_minus_2": (
+            g2_cert["watertight_orientable_2_manifold"] is True
+            and g2_cert["euler_characteristic"] == -2
+            and g2_cert["inferred_genus"] == 2
+            and abs(g2_cert["volume"] - (30.0 * 10.0 - 2.0 * 7.0 * 6.0) * 4.0) < 1e-6
+        ),
+        "revolved_polygon_mesh_watertight_genus_1": (
+            rev_cert["watertight_orientable_2_manifold"] is True
+            and rev_cert["euler_characteristic"] == 0
