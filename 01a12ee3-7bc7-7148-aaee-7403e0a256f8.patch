+def _synthesize_bottom_up_observational_ast(
+    arg_names: Sequence[str],
+    samples: Sequence[tuple[list[Any], Any]],
+    *,
+    return_depth: bool = False,
+) -> Any:
+    """Bottom-up observational-equivalence AST synthesizer over depth 0..3 expressions."""
+    if not samples or any(len(a) != len(arg_names) for a, _ in samples):
+        return None
+    n_samples = len(samples)
+    targets = tuple(y for _, y in samples)
+
+    # Map observational signature (tuple of values across samples) -> minimal AST string
+    obs_bank: dict[tuple[Any, ...], str] = {}
+
+    def _wrap(expr_s: str, depth: int) -> Any:
+        return (expr_s, depth) if return_depth else expr_s
+
+    def _safe_sig(vals: list[Any]) -> tuple[Any, ...] | None:
+        sig = []
+        for v in vals:
+            if isinstance(v, (int, float, str, bool, tuple)):
+                sig.append((type(v).__name__, v))
+            elif isinstance(v, list) and len(v) <= 32 and all(isinstance(x, (int, float, str, bool)) for x in v):
+                sig.append(("list", tuple(v)))
+            else:
+                return None
+        return tuple(sig)
+
+    def _register(expr_s: str, vals: list[Any], pool: list[tuple[str, list[Any]]]) -> str | None:
+        if tuple(vals) == targets and all(type(v) is type(t) for v, t in zip(vals, targets)):
+            return expr_s
+        sig = _safe_sig(vals)
+        if sig is not None and sig not in obs_bank:
+            obs_bank[sig] = expr_s
+            pool.append((expr_s, vals))
+        return None
+
+    level0: list[tuple[str, list[Any]]] = []
+    for idx, name in enumerate(arg_names):
+        vals = [a[idx] for a, _ in samples]
+        hit = _register(name, vals, level0)
+        if hit is not None:
+            return _wrap(hit, 0)
+    for c_val in (0, 1, 2, 3, -1):
+        vals = [c_val] * n_samples
+        hit = _register(str(c_val), vals, level0)
+        if hit is not None:
+            return _wrap(hit, 0)
+
+    def _expand_layer(inputs: Sequence[tuple[str, list[Any]]]) -> tuple[str | None, list[tuple[str, list[Any]]]]:
+        layer: list[tuple[str, list[Any]]] = []
+        # Unary operations & list comprehensions
+        for expr_s, vals in inputs:
+            if all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in vals):
+                for u_fmt, u_fn in (
+                    (f"(-({expr_s}))", lambda x: -x),
+                    (f"abs({expr_s})", abs),
+                    (f"(({expr_s}) * ({expr_s}))", lambda x: x * x),
+                ):
+                    try:
+                        nvals = [u_fn(v) for v in vals]
+                    except Exception:
+                        continue
+                    hit = _register(u_fmt, nvals, layer)
+                    if hit is not None:
+                        return hit, layer
+            if all(isinstance(v, (list, tuple)) for v in vals):
+                for u_fmt, u_fn in (
+                    (f"len({expr_s})", len),
+                    (f"sum({expr_s})", sum),
+                    (f"max({expr_s})", max),
+                    (f"min({expr_s})", min),
+                    (f"sorted({expr_s})", sorted),
+                    (f"sum(v for v in {expr_s} if v > 0)", lambda xs: sum(v for v in xs if v > 0)),
+                    (f"sum(v * v for v in {expr_s})", lambda xs: sum(v * v for v in xs)),
+                    (f"[v for v in {expr_s} if v > 0]", lambda xs: [v for v in xs if v > 0]),
+                    (f"[v * v for v in {expr_s}]", lambda xs: [v * v for v in xs]),
+                    (f"[v for v in {expr_s} if v % 2 == 0]", lambda xs: [v for v in xs if v % 2 == 0]),
+                    (f"[abs(v) for v in {expr_s}]", lambda xs: [abs(v) for v in xs]),
+                ):
+                    try:
+                        nvals = [u_fn(v) for v in vals]
+                    except Exception:
+                        continue
+                    hit = _register(u_fmt, nvals, layer)
+                    if hit is not None:
+                        return hit, layer
+        # Binary & conditional operations over numeric expressions
+        num_inputs = [
+            (e_s, vs)
+            for e_s, vs in inputs
+            if all(isinstance(v, (int, float)) and not isinstance(v, bool) and abs(v) <= 10 ** 7 for v in vs)
+        ]
+        for i, (e1, v1) in enumerate(num_inputs[:64]):
+            for e2, v2 in num_inputs[i:64]:
+                for b_fmt, b_fn in (
+                    (f"(({e1}) + ({e2}))", lambda x, y: x + y),
+                    (f"(({e1}) - ({e2}))", lambda x, y: x - y),
+                    (f"(({e2}) - ({e1}))", lambda x, y: y - x),
+                    (f"(({e1}) * ({e2}))", lambda x, y: x * y),
+                    (f"(({e1}) // ({e2}))", lambda x, y: x // y if y != 0 else (_ for _ in ()).throw(ZeroDivisionError())),
+                    (f"(({e1}) % ({e2}))", lambda x, y: x % y if y != 0 else (_ for _ in ()).throw(ZeroDivisionError())),
+                    (f"(({e1}) if ({e1}) >= ({e2}) else ({e2}))", lambda x, y: x if x >= y else y),
+                ):
+                    try:
+                        nvals = [b_fn(x, y) for x, y in zip(v1, v2)]
+                    except Exception:
+                        continue
+                    hit = _register(b_fmt, nvals, layer)
+                    if hit is not None:
+                        return hit, layer
+        return None, layer
+
+    hit1, level1 = _expand_layer(level0)
+    if hit1 is not None:
+        return _wrap(hit1, 1)
+    hit2, level2 = _expand_layer(level0 + level1[:32])
+    if hit2 is not None:
+        return _wrap(hit2, 2)
+    hit3, _ = _expand_layer(level0 + level1[:24] + level2[:48])
+    if hit3 is not None:
+        return _wrap(hit3, 3)
+    return None
+
+
+class _AlphaRenameParams(ast.NodeTransformer):
+    """Alpha-rename formal parameter AST identifiers from canonical template names to target function signature names."""
+
+    def __init__(self, param_map: Mapping[str, str]) -> None:
+        self.param_map = dict(param_map)
+
+    def visit_Name(self, node: ast.Name) -> ast.AST:
+        if node.id in self.param_map:
+            node.id = self.param_map[node.id]
+        return node
+
+
+def _alpha_rename_template_body(
+    template_src: str,
+    template_params: Sequence[str],
+    actual_params: Sequence[str],
+) -> str:
+    """Parse a canonical template body, alpha-rename its formal parameters to actual_params, and unparse."""
+    tree = ast.parse(template_src)
+    mapping = {src: dst for src, dst in zip(template_params, actual_params) if src != dst}
+    if mapping:
+        tree = _AlphaRenameParams(mapping).visit(tree)
+        ast.fix_missing_locations(tree)
+    return ast.unparse(tree)
+
+
+class _StepBudgetInjector(ast.NodeTransformer):
+    """Inject a deterministic 4096-step counter check into loops and function entries to prevent infinite loops."""
+
+    def _guard_stmts(self) -> list[ast.stmt]:
+        return list(
+            ast.parse(
+                "_brain_step_budget[0] += 1\n"
+                "if _brain_step_budget[0] > 4096:\n"
+                "    raise RuntimeError('STEP_BUDGET_EXCEEDED')"
+            ).body
+        )
+
+    def visit_FunctionDef(self, node: ast.FunctionDef) -> ast.AST:
+        self.generic_visit(node)
+        node.body = self._guard_stmts() + list(node.body)
+        return node
+
+    def visit_For(self, node: ast.For) -> ast.AST:
+        self.generic_visit(node)
+        node.body = self._guard_stmts() + list(node.body)
+        return node
+
+    def visit_While(self, node: ast.While) -> ast.AST:
+        self.generic_visit(node)
+        node.body = self._guard_stmts() + list(node.body)
+        return node
+
+
+def _in_memory_step_bounded_witness_check(
+    patched_source: str,
+    fn_name: str,
+    samples: Sequence[tuple[list[Any], Any]],
+    *,
+    max_steps: int = 4096,
+) -> bool:
+    """Evaluate a candidate module AST in-memory with a strict step bound against extracted I/O witnesses."""
+    if not samples:
+        return True
+    try:
+        tree = ast.parse(patched_source)
+        guarded_tree = _StepBudgetInjector().visit(tree)
+        ast.fix_missing_locations(guarded_tree)
+        code_obj = compile(guarded_tree, filename="<brain_in_memory_witness>", mode="exec")
+        step_counter = [0]
+        ns: dict[str, Any] = {"_brain_step_budget": step_counter}
+        exec(code_obj, ns)
+        fn = ns.get(fn_name)
+        if not callable(fn):
+            return True
+        for args, expected in samples:
+            step_counter[0] = 0
+            actual = fn(*copy.deepcopy(list(args)))
+            if actual != expected or step_counter[0] > max_steps:
+                return False
+        return True
+    except RuntimeError as exc:
+        if "STEP_BUDGET_EXCEEDED" in str(exc):
+            return False
+        return False
+    except Exception:
+        return False
+
+
+def _generate_file_ast_candidates(
+    rel_path: str,
+    source_text: str,
+    test_literals: Mapping[str, list[Any]],
+) -> list[dict[str, Any]]:
+    """Generate single-site AST mutations AND structural AST synthesis candidates."""
+    try:
+        orig_tree = ast.parse(source_text, filename=rel_path)
+    except SyntaxError:
+        return []
+
+    candidates: list[dict[str, Any]] = []
+    seen_sources: set[str] = {source_text}
+
+    def _add(new_tree: ast.AST, kind: str, symbol: str, lineno: int) -> None:
+        try:
+            ast.fix_missing_locations(new_tree)
+            rendered = ast.unparse(new_tree) + "\n"
+            ast.parse(rendered, filename=rel_path)
+        except Exception:
+            return
+        if rendered in seen_sources:
+            return
+        seen_sources.add(rendered)
+        candidates.append(
+            {
+                "path": rel_path,
+                "kind": kind,
+                "symbol": symbol,
+                "lineno": lineno,
+                "patched_text": rendered,
+                "patch_sha256": _sha_bytes(rendered.encode("utf-8")),
+            }
+        )
+
+    # Index functions/methods and their statements
+    func_records: list[tuple[str, int, list[str]]] = []
+    for idx, node in enumerate(ast.walk(orig_tree)):
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            arg_names = [a.arg for a in node.args.args if a.arg != "self"]
+            func_records.append((node.name, idx, arg_names))
+
+    # A. Expression operator & constant mutations per AST node index
+    op_swaps: list[tuple[type[ast.operator], type[ast.operator], str]] = [
+        (ast.Sub, ast.Add, "BINOP_SUB_TO_ADD"),
+        (ast.Add, ast.Sub, "BINOP_ADD_TO_SUB"),
+        (ast.Mult, ast.Add, "BINOP_MULT_TO_ADD"),
+        (ast.Add, ast.Mult, "BINOP_ADD_TO_MULT"),
+        (ast.FloorDiv, ast.Div, "BINOP_FLOORDIV_TO_DIV"),
+        (ast.Div, ast.FloorDiv, "BINOP_DIV_TO_FLOORDIV"),
+    ]
+    cmp_swaps: list[tuple[type[ast.cmpop], type[ast.cmpop], str]] = [
+        (ast.Lt, ast.LtE, "CMP_LT_TO_LTE"),
+        (ast.LtE, ast.Lt, "CMP_LTE_TO_LT"),
+        (ast.Gt, ast.GtE, "CMP_GT_TO_GTE"),
+        (ast.GtE, ast.Gt, "CMP_GTE_TO_GT"),
+        (ast.Eq, ast.NotEq, "CMP_EQ_TO_NOTEQ"),
+        (ast.NotEq, ast.Eq, "CMP_NOTEQ_TO_EQ"),
+    ]
+
+    all_nodes = list(ast.walk(orig_tree))
+    for target_idx, node in enumerate(all_nodes):
+        lineno = int(getattr(node, "lineno", 1))
+        if isinstance(node, ast.BinOp):
+            for src_t, dst_t, label in op_swaps:
+                if isinstance(node.op, src_t):
+                    cloned = copy.deepcopy(orig_tree)
+                    target = list(ast.walk(cloned))[target_idx]
+                    if isinstance(target, ast.BinOp):
+                        target.op = dst_t()
+                        _add(cloned, label, "expr", lineno)
+        elif isinstance(node, ast.Compare) and len(node.ops) == 1:
+            for src_t, dst_t, label in cmp_swaps:
+                if isinstance(node.ops[0], src_t):
+                    cloned = copy.deepcopy(orig_tree)
+                    target = list(ast.walk(cloned))[target_idx]
+                    if isinstance(target, ast.Compare):
+                        target.ops[0] = dst_t()
+                        _add(cloned, label, "cmp", lineno)
+        elif isinstance(node, ast.Constant) and isinstance(node.value, bool):
+            cloned = copy.deepcopy(orig_tree)
+            target = list(ast.walk(cloned))[target_idx]
+            if isinstance(target, ast.Constant):
+                target.value = not node.value
+                _add(cloned, "BOOL_FLIP", "const", lineno)
+        elif isinstance(node, ast.Constant) and isinstance(node.value, int) and not isinstance(node.value, bool):
+            for cand_int in test_literals.get("ints", [0, 1, -1]):
+                if cand_int == node.value:
+                    continue
+                cloned = copy.deepcopy(orig_tree)
+                target = list(ast.walk(cloned))[target_idx]
+                if isinstance(target, ast.Constant):
+                    target.value = cand_int
+                    _add(cloned, f"INT_CONST_{cand_int}", "const", lineno)
+
+    # B. Structural AST Synthesis: Guard-clause & exception-contract synthesis
+    cegar_map = test_literals.get("counterexamples") or {}
+    for fn_name, fn_walk_idx, arg_names in func_records:
+        for body_src, label in _synthesize_cegar_function_bodies(
+            fn_name, arg_names, list(cegar_map.get(fn_name) or [])
+        ):
+            cloned = copy.deepcopy(orig_tree)
+            target_fn = list(ast.walk(cloned))[fn_walk_idx]
+            if isinstance(target_fn, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                target_fn.body = list(ast.parse(body_src).body)
+                _add(cloned, label, fn_name, int(getattr(target_fn, "lineno", 1)))
+
+        for arg in arg_names[:2]:
+            for exc_name in test_literals.get("exceptions", ["ValueError"]):
+                for guard_src, label in [
+                    (f"if {arg} < 0:\n    raise {exc_name}('negative {arg}')", f"SYNTH_GUARD_NEG_{arg}_{exc_name}"),
+                    (f"if {arg} is None:\n    raise {exc_name}('none {arg}')", f"SYNTH_GUARD_NONE_{arg}_{exc_name}"),
+                    (f"if not {arg}:\n    raise {exc_name}('empty {arg}')", f"SYNTH_GUARD_EMPTY_{arg}_{exc_name}"),
+                ]:
+                    cloned = copy.deepcopy(orig_tree)
+                    target_fn = list(ast.walk(cloned))[fn_walk_idx]
+                    if isinstance(target_fn, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                        guard_stmt = ast.parse(guard_src).body[0]
+                        target_fn.body.insert(0, guard_stmt)
+                        _add(cloned, label, fn_name, int(getattr(target_fn, "lineno", 1)))
+
+    return candidates
+
+
+def _apply_file_edits(base_texts: Mapping[str, str], edits: Sequence[Mapping[str, Any]]) -> dict[str, str]:
+    """Combine edits across one or multiple files (including multiple AST sites in one file)."""
+    by_path: dict[str, list[Mapping[str, Any]]] = {}
+    for e in edits:
+        by_path.setdefault(str(e["path"]), []).append(e)
+    result = dict(base_texts)
+    for path, file_edits in by_path.items():
+        if len(file_edits) == 1:
+            result[path] = str(file_edits[0]["patched_text"])
+        else:
+            # Line-based diff composition for multiple edits within the same file
+            orig_lines = base_texts[path].splitlines(keepends=True)
+            out_lines = list(orig_lines)
+            for fe in file_edits:
+                cand_lines = str(fe["patched_text"]).splitlines(keepends=True)
+                if len(cand_lines) == len(orig_lines):
+                    for i, (o, c) in enumerate(zip(orig_lines, cand_lines)):
+                        if o != c:
+                            out_lines[i] = c
+                else:
+                    out_lines = cand_lines
+            result[path] = "".join(out_lines)
+    return result
+
+
+def _run_test_command(cwd: pathlib.Path, argv: Sequence[str], timeout_s: int) -> tuple[bool, int, str]:
+    cmd = list(argv)
+    if cmd and cmd[0] == sys.executable and "-B" not in cmd:
+        cmd = [cmd[0], "-B", *cmd[1:]]
+    proc = subprocess.run(
+        cmd,
+        cwd=str(cwd),
+        capture_output=True,
+        text=True,
+        timeout=timeout_s,
+        check=False,
+    )
+    combined = (proc.stdout or "") + "\n" + (proc.stderr or "")
+    fail_matches = re.findall(r"FAILED|ERROR:|AssertionError|Exception", combined)
+    return proc.returncode == 0, max(1 if proc.returncode != 0 else 0, len(fail_matches)), combined
+
+
+def search_depth_k_provenance_repair(
+    source_root: pathlib.Path,
+    test_paths: Sequence[pathlib.Path],
+    test_argv: Sequence[str],
+    *,
+    max_edit_depth: int = 3,
+    max_candidates_per_depth: int = 36,
+    timeout_s: int = 20,
+) -> dict[str, Any]:
+    """Search 1-edit, 2-edit, and 3-edit coupled repairs without seeing any semantic acceptance oracle."""
+    baseline_manifest, baseline_sha = _tree_manifest(source_root)
+    py_files = sorted(
+        p
+        for p in source_root.rglob("*.py")
+        if not p.name.startswith("test_") and "tests" not in p.parts
+    )
+    base_texts = {
+        p.relative_to(source_root).as_posix(): p.read_text(encoding="utf-8")
+        for p in py_files
+    }
+    search_input_sha256 = _sha_obj(
+        {
+            "baseline_sha": baseline_sha,
+            "test_argv": list(test_argv),
+            "test_paths": [p.relative_to(source_root).as_posix() for p in test_paths if source_root in p.parents],
+        }
+    )
+
+    with tempfile.TemporaryDirectory(prefix="brain-v10-search-") as td:
+        work_root = pathlib.Path(td) / "work"
+        shutil.copytree(source_root, work_root)
+        base_ok, base_fails, _ = _run_test_command(work_root, test_argv, timeout_s)
+        if base_ok:
+            raise GeneralSoftwareRepairV10Error("BASELINE_ALREADY_PASSES")
+
+        literals = _extract_test_literals(work_root, [work_root / p.relative_to(source_root) for p in test_paths if source_root in p.parents])
+        per_file_candidates: dict[str, list[dict[str, Any]]] = {}
+        all_single_edits: list[dict[str, Any]] = []
+        for rel_path, text in sorted(base_texts.items()):
+            cands = _generate_file_ast_candidates(rel_path, text, literals)
+            per_file_candidates[rel_path] = cands
+            all_single_edits.extend(cands)
+
+        trials = 0
+        in_memory_pruned_count = 0
+        cegar_witnesses = literals.get("counterexamples") or {}
+        # Depth 1..max_edit_depth search
+        for depth in range(1, max(1, min(max_edit_depth, 4)) + 1):
+            if depth == 1:
+                combos: list[tuple[dict[str, Any], ...]] = [(c,) for c in all_single_edits[:max_candidates_per_depth]]
+            elif depth <= len(per_file_candidates) and len(per_file_candidates) >= depth:
+                # Prefer cross-file coupled combinations first, prioritizing verified CEGAR structural bodies
+                cegar_prefixes = (
+                    "CEGAR_COMPREHENSION_",
+                    "CEGAR_2D_",
+                    "CEGAR_GRAPH_",
+                    "CEGAR_BINARY_SEARCH_",
+                    "CEGAR_TWO_POINTER_",
+                    "CEGAR_DIJKSTRA_",
+                    "CEGAR_TOPOLOGICAL_SORT_",
+                    "CEGAR_UNION_FIND_",
+                    "CEGAR_INTERVAL_MERGE_",
+                    "CEGAR_MONOTONIC_STACK_",
+                )
+                file_lists = [
+                    (
+                        [c for c in per_file_candidates[k] if str(c.get("kind", "")).startswith(cegar_prefixes)]
+                        + [c for c in per_file_candidates[k] if not str(c.get("kind", "")).startswith(cegar_prefixes)]
+                    )[:4]
+                    for k in sorted(per_file_candidates)
+                    if per_file_candidates[k]
+                ]
+                cross_combos: list[tuple[dict[str, Any], ...]] = []
+                for group in itertools.combinations(file_lists, depth):
+                    for prod in itertools.product(*group):
+                        cross_combos.append(prod)
+                        if len(cross_combos) >= max_candidates_per_depth:
+                            break
+                    if len(cross_combos) >= max_candidates_per_depth:
+                        break
+                combos = cross_combos
+            else:
+                combos = list(itertools.combinations(all_single_edits[:24], depth))[:max_candidates_per_depth]
+
+            for combo in combos:
+                patched_map = _apply_file_edits(base_texts, combo)
+                # Fast in-memory step-bounded witness pre-filter for modified standalone modules
+                pruned_in_mem = False
+                for rel_p in sorted(patched_map):
+                    if patched_map[rel_p] == base_texts[rel_p]:
+                        continue
+                    try:
+                        p_tree = ast.parse(patched_map[rel_p])
+                        has_imports = any(isinstance(n, (ast.Import, ast.ImportFrom)) for n in p_tree.body)
+                        top_fns = [n.name for n in p_tree.body if isinstance(n, ast.FunctionDef)]
+                    except Exception:
+                        has_imports = True
+                        top_fns = []
+                    if not has_imports and len(top_fns) == 1 and top_fns[0] in cegar_witnesses:
+                        if not _in_memory_step_bounded_witness_check(patched_map[rel_p], top_fns[0], cegar_witnesses[top_fns[0]]):
+                            pruned_in_mem = True
+                            break
+                if pruned_in_mem:
+                    in_memory_pruned_count += 1
+                    continue
+                trials += 1
+                for rel_p, new_txt in patched_map.items():
+                    (work_root / rel_p).write_text(new_txt, encoding="utf-8")
+                ok, _, _ = _run_test_command(work_root, test_argv, timeout_s)
+                # Always restore work_root immediately
+                for rel_p, orig_txt in base_texts.items():
+                    (work_root / rel_p).write_text(orig_txt, encoding="utf-8")
+                if ok:
+                    # Double replay on work_root to confirm determinism
+                    for rel_p, new_txt in patched_map.items():
+                        (work_root / rel_p).write_text(new_txt, encoding="utf-8")
+                    ok2, _, _ = _run_test_command(work_root, test_argv, timeout_s)
+                    for rel_p, orig_txt in base_texts.items():
+                        (work_root / rel_p).write_text(orig_txt, encoding="utf-8")
+                    if ok2:
+                        patches = [
+                            {
+                                "path": rel_p,
+                                "original_sha256": _sha_bytes(base_texts[rel_p].encode("utf-8")),
+                                "patched_sha256": _sha_bytes(patched_map[rel_p].encode("utf-8")),
+                                "patched_text": patched_map[rel_p],
+                                "edit_kinds": [c["kind"] for c in combo if c["path"] == rel_p],
+                            }
+                            for rel_p in sorted(patched_map)
+                            if patched_map[rel_p] != base_texts[rel_p]
+                        ]
+                        after_manifest, after_sha = _tree_manifest(source_root)
+                        return {
+                            "pass": True,
+                            "status": f"PASS__VERIFIED_DEPTH_{depth}_REPAIR_FOUND",
+                            "winner_depth": depth,
+                            "winner_edit_count": len(combo),
+                            "trials_executed": trials,
+                            "in_memory_pruned_count": in_memory_pruned_count,
+                            "patches": patches,
+                            "baseline_snapshot_sha256": baseline_sha,
+                            "source_restored": (baseline_manifest == after_manifest and baseline_sha == after_sha),
+                            "search_input_sha256": search_input_sha256,
+                            "acceptance_oracle_leaked_into_search": False,
+                        }
+
+    after_manifest, after_sha = _tree_manifest(source_root)
+    return {
+        "pass": False,
+        "status": "OPEN__NO_REPAIR_IN_BOUNDED_V10_SEARCH",
+        "winner_depth": None,
+        "winner_edit_count": 0,
+        "trials_executed": trials,
+        "in_memory_pruned_count": in_memory_pruned_count,
+        "patches": [],
+        "baseline_snapshot_sha256": baseline_sha,
+        "source_restored": (baseline_manifest == after_manifest and baseline_sha == after_sha),
+        "search_input_sha256": search_input_sha256,
+        "acceptance_oracle_leaked_into_search": False,
+    }
+
+
+# ---------------------------------------------------------------------------
+# 3. Unified V10 Controller Entrypoint (`run`)
+# ---------------------------------------------------------------------------
+
+def run(args: Mapping[str, Any], root: str | pathlib.Path = ROOT) -> dict[str, Any]:
+    if not isinstance(args, Mapping):
+        raise GeneralSoftwareRepairV10Error("ARGS_NOT_OBJECT")
+    repo = pathlib.Path(root).resolve()
+    source_root = (repo / str(args.get("source_root", "."))).resolve()
+    if not source_root.is_dir() or (source_root != repo and repo not in source_root.parents):
+        raise GeneralSoftwareRepairV10Error("SOURCE_ROOT_INVALID")
+
+    raw_test_paths = args.get("test_paths") or []
+    test_paths = [(repo / str(tp)).resolve() for tp in raw_test_paths]
+    if not test_paths or any(not p.is_file() for p in test_paths):
+        raise GeneralSoftwareRepairV10Error("TEST_PATHS_REQUIRED")
+
+    task_text = str(args.get("task_text") or "").strip()
+    if not task_text:
+        raise GeneralSoftwareRepairV10Error("TASK_TEXT_REQUIRED")
+
+    timeout_s = max(1, min(int(args.get("timeout_s", 20)), 120))
+    max_edit_depth = max(1, min(int(args.get("max_edit_depth", 3)), 4))
+    rel_test_paths = [p.relative_to(source_root).as_posix() for p in test_paths]
+    test_argv = [str(x) for x in (args.get("test_argv") or [sys.executable, "-m", "unittest", *rel_test_paths])]
+
+    baseline_manifest, baseline_sha = _tree_manifest(source_root)
+
+    # Step 1: Search for repair WITHOUT exposing task_text or semantic acceptance cells
+    search_res = search_depth_k_provenance_repair(
+        source_root,
+        test_paths,
+        test_argv,
+        max_edit_depth=max_edit_depth,
+        timeout_s=timeout_s,
+    )
+    after_manifest, after_sha = _tree_manifest(source_root)
+    if not search_res.get("source_restored") or baseline_manifest != after_manifest or baseline_sha != after_sha:
+        raise GeneralSoftwareRepairV10Error("SOURCE_RESTORATION_FAILED")
+
+    if search_res.get("pass") is not True:
+        result: dict[str, Any] = {
+            "schema": SCHEMA,
+            "capability_id": CAPABILITY_ID,
+            "status": "OPEN__NO_VERIFIED_REPAIR_IN_BOUNDED_V10_SEARCH",
+            "pass": False,
+            "repair_pass": False,
+            "acceptance_stop_authorized": False,
+            "baseline_snapshot_sha256": baseline_sha,
+            "source_restored": True,
+            "acceptance_oracle_leaked_into_search": False,
+            "model_dependency_count": 0,
+            "external_general_purpose_model_runtime_dependency_count": 0,
+            "incremental_spend_usd": 0,
+            "terminal_authority": False,
+        }
+    else:
+        # Step 2: Realize candidate in an isolated content-addressed copy and run post-repair semantic acceptance
+        with tempfile.TemporaryDirectory(prefix="brain-v10-verify-") as td:
+            temp_root = pathlib.Path(td)
+            candidate_root = temp_root / "candidate"
+            shutil.copytree(source_root, candidate_root)
+            for patch in search_res["patches"]:
+                target_file = candidate_root / _safe_rel(patch["path"])
+                target_file.write_text(str(patch["patched_text"]), encoding="utf-8")
+
+            measurement = measure_v1.run(
+                {
+                    "source_root": "candidate",
+                    "test_paths": rel_test_paths,
+                    "test_argv": test_argv,
+                    "output_path": "measurement.json",
+                    "timeout_s": timeout_s,
+                },
+                temp_root,
+            )
+            v10_compilation = compile_v10_request(task_text)
+            v10_eval = evaluate_v10_cells_in_snapshot(v10_compilation, candidate_root, timeout_s=timeout_s)
+            union_eval = union_v1.evaluate_union(
+                task_text,
+                measurement_receipt_path="measurement.json",
+                receipt_root=temp_root,
+                baseline_root=source_root,
+                candidate_root=candidate_root,
+                expected_baseline_snapshot_sha256=baseline_sha,
+            )
+
+            # A candidate is accepted iff measurement tests/parse pass AND all raw obligations are discharged
+            # by the union of measured objective routes, V9 semantic cells, and V10 behavioral/cross-language cells.
+            meas_ok = (
+                (measurement.get("measurements") or {}).get("tests_pass") is True
+                and (measurement.get("measurements") or {}).get("python_parse_ok") is True
+            )
+            accepted = bool(meas_ok and (union_eval.get("acceptance_stop_authorized") is True or v10_eval.get("pass") is True))
+            skill_descriptor = None
+            if accepted:
+                skill_payload = {
+                    "schema": "PROJECT_BRAIN_EXECUTABLE_REPAIR_SKILL_DESCRIPTOR_V7",
+                    "capability_id": CAPABILITY_ID,
+                    "winner_depth": search_res["winner_depth"],
+                    "edit_kinds": [str(p.get("kind")) for p in search_res["patches"]],
+                    "patch_hashes": [str(p.get("patch_sha256")) for p in search_res["patches"]],
+                    "passed_obligation_ids": v10_eval.get("passed_obligation_ids"),
+                }
+                skill_payload["skill_id"] = "SKILL:V10:" + _sha_obj(skill_payload)[:24]
+                skill_descriptor = skill_payload
+            result = {
+                "schema": SCHEMA,
+                "capability_id": CAPABILITY_ID,
+                "status": (
+                    "PASS__V10_REPAIR_REALIZED_MEASURED_AND_POST_REPAIR_SEMANTIC_ACCEPTANCE_VERIFIED"
+                    if accepted
+                    else "OPEN__REPAIR_FOUND_BUT_POST_REPAIR_SEMANTIC_ACCEPTANCE_BLOCKED"
+                ),
+                "pass": accepted,
+                "repair_pass": True,
+                "acceptance_stop_authorized": accepted,
+                "winner_depth": search_res["winner_depth"],
+                "winner_edit_count": search_res["winner_edit_count"],
+                "trials_executed": search_res["trials_executed"],
+                "in_memory_pruned_count": search_res.get("in_memory_pruned_count", 0),
+                "realized_patches": search_res["patches"],
+                "induced_skill_descriptor": skill_descriptor,
+                "baseline_snapshot_sha256": baseline_sha,
+                "candidate_subject_snapshot_sha256": (measurement.get("subject") or {}).get("snapshot_sha256"),
+                "measurement_receipt_payload_sha256": measurement.get("receipt_payload_sha256"),
+                "v10_compilation_status": v10_compilation.get("status"),
+                "v10_evaluation_status": v10_eval.get("status"),
+                "v10_passed_obligation_ids": v10_eval.get("passed_obligation_ids"),
+                "v10_failed_obligation_ids": v10_eval.get("failed_obligation_ids"),
+                "v10_unbound_obligation_ids": v10_eval.get("unbound_obligation_ids"),
+                "union_acceptance_status": union_eval.get("status"),
+                "search_input_sha256": search_res["search_input_sha256"],
+                "acceptance_oracle_leaked_into_search": False,
+                "source_restored": True,
+                "model_dependency_count": 0,
+                "external_general_purpose_model_runtime_dependency_count": 0,
+                "incremental_spend_usd": 0,
+                "terminal_authority": False,
+            }
+
+    if args.get("output_path"):
+        out_path = (repo / _safe_rel(args["output_path"])).resolve()
+        if out_path == repo or repo not in out_path.parents:
+            raise GeneralSoftwareRepairV10Error("OUTPUT_PATH_OUTSIDE_REPO")
+        out_path.parent.mkdir(parents=True, exist_ok=True)
+        out_path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+        raw = out_path.read_bytes()
+        result["output_path"] = out_path.relative_to(repo).as_posix()
+        result["output_sha256"] = _sha_bytes(raw)
+        result["output_verified"] = True
+    return result
+
+
+# ---------------------------------------------------------------------------
+# 4. Self-Verification Suite (`evaluate`)
+# ---------------------------------------------------------------------------
+
+_EVAL_CACHE: dict[str, dict[str, Any]] = {}
+
+
+def evaluate(repo_root: str | pathlib.Path = ROOT) -> dict[str, Any]:
+    """Run deterministic V10 qualification across 3-edit valley-crossing, structural synthesis, and cross-language specs."""
+    from copy import deepcopy
+
+    self_sha = _sha_bytes(pathlib.Path(__file__).read_bytes())
+    if self_sha in _EVAL_CACHE:
+        return deepcopy(_EVAL_CACHE[self_sha])
+
+    scenarios: list[dict[str, Any]] = []
+
+    with tempfile.TemporaryDirectory(prefix="brain-v10-eval-") as td:
+        base = pathlib.Path(td)
+
+        # Scenario 1: 3-edit non-monotonic coupled valley across 3 files + post-repair method/callable/cross-language acceptance
+        s1 = base / "s1_three_edit_valley"
+        (s1 / "pkg").mkdir(parents=True)
+        (s1 / "web").mkdir(parents=True)
