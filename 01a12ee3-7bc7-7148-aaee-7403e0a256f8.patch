+    def _solve_linear_system_exact(
+        mat: list[list[Fraction]], rhs: list[Fraction]
+    ) -> list[Fraction] | None:
+        n = len(mat)
+        if not n or len(rhs) != n or any(len(r) != n for r in mat):
+            return None
+        aug = [r[:] + [y] for r, y in zip(mat, rhs)]
+        for col in range(n):
+            piv = next((r for r in range(col, n) if aug[r][col] != 0), None)
+            if piv is None:
+                return None
+            aug[col], aug[piv] = aug[piv], aug[col]
+            pv = aug[col][col]
+            for j in range(col, n + 1):
+                aug[col][j] /= pv
+            for r in range(n):
+                if r != col and aug[r][col] != 0:
+                    f = aug[r][col]
+                    for j in range(col, n + 1):
+                        aug[r][j] -= f * aug[col][j]
+        return [aug[i][n] for i in range(n)]
+
+    if domain == "RATIONAL_PADE_FUNCTION":
