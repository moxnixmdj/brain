+def analyze_raw_raster_chart(
+    image: Any,
+    *,
+    x_tick_anchors: Sequence[tuple[int, int, int]],
+    y_tick_anchors: Sequence[tuple[int, int, int]],
+    x_unit_anchor: tuple[int, int],
+    y_unit_anchor: tuple[int, int],
+    query_x: float,
+    query_x_unit: str,
+    target_y_unit: str,
+    overlap_pixel_xy: tuple[int, int] | None = None,
+    series_a_rgb: tuple[int, int, int] = (220, 30, 30),
+    series_b_rgb: tuple[int, int, int] = (30, 60, 220),
+) -> dict[str, Any]:
+    """End-to-end raw RGB chart analyzer combining scene-graph detection, 5x7 glyph decoding, alpha unmixing, and unit-converted curve query."""
+    from canonical.runtime.bound_capabilities import chart_raster_scene_graph_v1 as sg_v1
+
+    box = sg_v1.detect_plot_box(image)
+    x_ticks: list[tuple[float, float]] = []
+    for px, lx, ly in x_tick_anchors:
+        txt = decode_bitmap_text_5x7(image, lx, ly)
+        x_ticks.append((float(px), float(txt)))
+    y_ticks: list[tuple[float, float]] = []
+    for py, lx, ly in y_tick_anchors:
+        txt = decode_bitmap_text_5x7(image, lx, ly)
+        y_ticks.append((float(py), float(txt)))
+
+    x_unit = decode_bitmap_text_5x7(image, x_unit_anchor[0], x_unit_anchor[1])
+    y_unit = decode_bitmap_text_5x7(image, y_unit_anchor[0], y_unit_anchor[1])
+
+    x_cal = sg_v1.calibrate_axis(x_ticks, "INCREASING")
+    y_cal = sg_v1.calibrate_axis(y_ticks, "DECREASING")
+    ax, bx = x_cal["transformed_value_from_pixel"]
+    ay, by = y_cal["transformed_value_from_pixel"]
+
+    polylines = sg_v1.color_polylines(image, box, min_columns=8)
+    if not polylines:
+        raise ChartProfessionalSemanticsV2Error("NO_RASTER_POLYLINES_DETECTED")
+
+    # Convert primary ascending polyline from pixel space into calibrated physical (x, y) coordinates
+    primary_pts_px = polylines[0]["points"]
+    calibrated_curve = [
+        (round(ax * float(px) + bx, 6), round(ay * float(py) + by, 6))
+        for px, py in primary_pts_px
+    ]
+    unit_query = query_curve_with_unit_conversion(
+        calibrated_curve,
+        x_axis_unit=x_unit,
+        y_axis_unit=y_unit,
+        query_x=query_x,
+        query_x_unit=query_x_unit,
+        target_y_unit=target_y_unit,
+    )
+
+    overlap_info = None
+    if overlap_pixel_xy is not None:
+        ox, oy = overlap_pixel_xy
+        blended = image.getpixel((ox, oy))[:3]
+        overlap_info = demix_translucent_overlap_pixel(
+            blended_rgb=blended,
+            bg_rgb=(255, 255, 255),
+            color_a_rgb=series_a_rgb,
+            color_b_rgb=series_b_rgb,
+        )
+
+    return {
+        "pass": True,
+        "plot_box": list(box),
+        "decoded_x_unit": x_unit,
+        "decoded_y_unit": y_unit,
+        "x_axis_calibration": x_cal,
+        "y_axis_calibration": y_cal,
+        "detected_polyline_count": len(polylines),
+        "overlap_unmixing": overlap_info,
+        "converted_y": unit_query["converted_y"],
+        "target_y_unit": target_y_unit,
+    }
