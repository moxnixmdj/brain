+                u_bar = 0.25 * (u_grid[r_i - 1][c_i] + u_grid[r_i + 1][c_i] + u_grid[r_i][c_i - 1] + u_grid[r_i][c_i + 1])
+                v_bar = 0.25 * (v_grid[r_i - 1][c_i] + v_grid[r_i + 1][c_i] + v_grid[r_i][c_i - 1] + v_grid[r_i][c_i + 1])
+                num_hs = Ix_hs * u_bar + Iy_hs * v_bar + It_hs
+                u_grid[r_i][c_i] = u_bar - Ix_hs * num_hs / denom_hs
+                v_grid[r_i][c_i] = v_bar - Iy_hs * num_hs / denom_hs
+    hs_err = max(
+        math.hypot(u_grid[r_i][c_i] - 1.5, v_grid[r_i][c_i] - (-0.5))
+        for r_i in range(5)
+        for c_i in range(5)
+    )
+    c24_ok = hs_err < 1e-4
+    checks["OPTICAL_FLOW_HORN_SCHUNCK_GLOBAL_VARIATIONAL_SMOOTHNESS_EULER_LAGRANGE"] = {
+        "pass": c24_ok,
+        "center_flow_uv": [round(u_grid[2][2], 6), round(v_grid[2][2], 6)],
+        "max_variational_error": round(hs_err, 8),
+    }
+
+    # 25. Constant-Q Transform (CQT) Log-Frequency Pitch-Invariant Filterbank
+    b_oct = 12
+    f_min_cqt = 55.0  # A1 = 55 Hz
+    q_factor = 1.0 / (2.0 ** (1.0 / float(b_oct)) - 1.0)
