+def encode_wav_pcm16_mono(samples: Sequence[int], sample_rate: int = 8000) -> bytes:
+    """Serialize 16-bit signed mono PCM samples into a canonical RIFF WAVE byte stream."""
+    clamped = [max(-32768, min(32767, int(s))) for s in samples]
+    data_bytes = struct.pack(f"<{len(clamped)}h", *clamped)
+    num_channels = 1
+    bits_per_sample = 16
+    byte_rate = sample_rate * num_channels * (bits_per_sample // 8)
+    block_align = num_channels * (bits_per_sample // 8)
+    fmt_chunk = struct.pack(
+        "<4sIHHIIHH",
+        b"fmt ",
+        16,
+        1,  # PCM format
+        num_channels,
+        sample_rate,
+        byte_rate,
+        block_align,
+        bits_per_sample,
+    )
+    data_header = struct.pack("<4sI", b"data", len(data_bytes))
+    riff_size = 4 + len(fmt_chunk) + len(data_header) + len(data_bytes)
+    riff_header = struct.pack("<4sI4s", b"RIFF", riff_size, b"WAVE")
+    return riff_header + fmt_chunk + data_header + data_bytes
+
+
+def decode_wav_pcm16_mono(wav_bytes: bytes) -> dict[str, Any]:
+    """Parse a canonical RIFF WAVE PCM16 mono stream into header metadata and samples."""
+    if len(wav_bytes) < 44:
+        raise ValueError("WAV_TOO_SHORT")
+    riff, riff_size, wave = struct.unpack("<4sI4s", wav_bytes[:12])
+    if riff != b"RIFF" or wave != b"WAVE":
+        raise ValueError("INVALID_RIFF_WAVE_HEADER")
+    offset = 12
+    fmt_info: dict[str, int] = {}
+    samples: list[int] = []
+    while offset + 8 <= len(wav_bytes):
+        chunk_id, chunk_size = struct.unpack("<4sI", wav_bytes[offset : offset + 8])
+        offset += 8
+        payload = wav_bytes[offset : offset + chunk_size]
+        offset += chunk_size
+        if chunk_id == b"fmt ":
+            audio_fmt, channels, sample_rate, byte_rate, block_align, bits = struct.unpack(
+                "<HHIIHH", payload[:16]
+            )
+            fmt_info = {
+                "audio_format": int(audio_fmt),
+                "channels": int(channels),
+                "sample_rate": int(sample_rate),
+                "byte_rate": int(byte_rate),
+                "block_align": int(block_align),
+                "bits_per_sample": int(bits),
+            }
+        elif chunk_id == b"data":
+            count = len(payload) // 2
+            samples = list(struct.unpack(f"<{count}h", payload[: count * 2]))
+    return {
+        "riff_size": int(riff_size),
+        "format": fmt_info,
+        "samples": samples,
+        "sample_count": len(samples),
+    }
+
+
+def fft_radix2(x: Sequence[complex | float], inverse: bool = False) -> list[complex]:
+    """Iterative radix-2 Cooley-Tukey FFT / IFFT."""
+    n = len(x)
+    if n == 0 or (n & (n - 1)) != 0:
+        raise ValueError("FFT_LENGTH_MUST_BE_POWER_OF_TWO")
+    a = [complex(v) for v in x]
+    j = 0
+    for i in range(1, n):
+        bit = n >> 1
+        while j & bit:
+            j ^= bit
+            bit >>= 1
+        j ^= bit
+        if i < j:
+            a[i], a[j] = a[j], a[i]
+    length = 2
+    sign = 1.0 if inverse else -1.0
+    while length <= n:
+        half = length // 2
+        angle = sign * 2.0 * math.pi / float(length)
+        wlen = cmath.rect(1.0, angle)
+        for i in range(0, n, length):
+            w = 1.0 + 0.0j
+            for k in range(half):
+                u = a[i + k]
+                v = a[i + k + half] * w
+                a[i + k] = u + v
+                a[i + k + half] = u - v
+                w *= wlen
+        length <<= 1
+    if inverse:
+        return [v / float(n) for v in a]
+    return a
+
