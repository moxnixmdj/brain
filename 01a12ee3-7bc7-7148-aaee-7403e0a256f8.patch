+def _eval_quadratic_surd (z :Any )->tuple [Fraction ,Fraction ,int ]:
+ """Decode z into (r, s, D) representing r + s*sqrt(D) with square-free D > 1 or s == 0."""
+ t =z [0 ]
+ if t =="I":
+  return (Fraction (int (z [1 ]),1 ),Fraction (0 ),1 )
+ if t =="Q":
+  return (Fraction (int (z [1 ]),int (z [2 ])),Fraction (0 ),1 )
+ if t =="E":
+  name ,args =z [1 ],z [2 ]
+  if name =="Pow"and args [0 ][0 ]=="I"and args [1 ]==["Q",1 ,2 ]:
+   d_val =int (args [0 ][1 ])
+   return (Fraction (0 ),Fraction (1 ),d_val )
+  if name =="Mul":
+   r ,s ,d =Fraction (1 ),Fraction (0 ),1 
+   for a in args :
+    ra ,sa ,da =_eval_quadratic_surd (a )
+    if sa ==0 :
+     r ,s =r *ra ,s *ra 
+    elif s ==0 and r !=0 :
+     r ,s ,d =r *ra ,r *sa ,da 
+    else :
+     raise ValueError (f"Surd Mul overflow: {z!r}")
+   return (r ,s ,d )
+  if name =="Add":
+   r ,s ,d =Fraction (0 ),Fraction (0 ),1 
+   for a in args :
+    ra ,sa ,da =_eval_quadratic_surd (a )
+    r +=ra 
+    if sa !=0 :
+     if d not in (1 ,da ):
+      raise ValueError (f"Incommensurable surds: {d} vs {da}")
+     d =da 
+     s +=sa 
+   return (r ,s ,d )
+ raise ValueError (f"Unsupported surd root node: {z!r}")
