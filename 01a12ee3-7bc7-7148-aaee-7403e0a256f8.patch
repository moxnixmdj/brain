+            "dist_bf[_src_bf] = 0\n"
+            "for _ in range(_n_bf - 1):\n"
+            "    for u_b, v_b, w_b in _edges_bf:\n"
+            "        if dist_bf[u_b] < inf_bf and dist_bf[u_b] + w_b < dist_bf[v_b]:\n"
+            "            dist_bf[v_b] = dist_bf[u_b] + w_b\n"
+            "neg_cycle = 0\n"
+            "for u_b, v_b, w_b in _edges_bf:\n"
+            "    if dist_bf[u_b] < inf_bf and dist_bf[u_b] + w_b < dist_bf[v_b]:\n"
+            "        neg_cycle = 1\n"
+            "        break\n"
+            "return [neg_cycle, dist_bf]"
+        )
+        try:
+            if all(_eval_bellman_ford(a[0], a[1], a[2]) == y for a, y in samples):
+                renamed_bf_src = _alpha_rename_template_body(
+                    template_bf_src,
+                    ["_n_bf", "_edges_bf", "_src_bf"],
+                    [arg_names[0], arg_names[1], arg_names[2]],
+                )
+                out.append((renamed_bf_src, f"CEGAR_BELLMAN_FORD_NEGATIVE_CYCLE_SHORTEST_PATHS_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+    # 15t. Floyd-Warshall All-Pairs Shortest Paths (APSP) & Finite Diameter AST Synthesis (2-arg: n, edges):
+    if (
+        len(arg_names) == 2
+        and all(
+            len(a) == 2
+            and isinstance(a[0], int)
+            and isinstance(a[1], list)
+            and all(isinstance(e, (list, tuple)) and len(e) == 3 for e in a[1])
+            and isinstance(y, list)
+            and len(y) == 2
+            and isinstance(y[0], int)
+            and isinstance(y[1], int)
+            for a, y in samples
+        )
+    ):
+        def _eval_floyd_warshall(n_fw: int, edges_fw: list[Any]) -> list[int]:
+            inf_fw = 10**9
+            dist_fw = [[0 if i_f == j_f else inf_fw for j_f in range(n_fw)] for i_f in range(n_fw)]
+            for u_f, v_f, w_f in edges_fw:
+                if w_f < dist_fw[u_f][v_f]:
+                    dist_fw[u_f][v_f] = int(w_f)
+            for k_f in range(n_fw):
+                for i_f in range(n_fw):
+                    for j_f in range(n_fw):
+                        if dist_fw[i_f][k_f] + dist_fw[k_f][j_f] < dist_fw[i_f][j_f]:
+                            dist_fw[i_f][j_f] = dist_fw[i_f][k_f] + dist_fw[k_f][j_f]
+            finite = [dist_fw[i_f][j_f] for i_f in range(n_fw) for j_f in range(n_fw) if i_f != j_f and dist_fw[i_f][j_f] < inf_fw]
+            return [max(finite) if finite else 0, sum(finite)]
+
+        template_fw_src = (
+            "inf_fw = 10**9\n"
+            "dist_fw = [[0 if i_f == j_f else inf_fw for j_f in range(_n_fw)] for i_f in range(_n_fw)]\n"
+            "for u_f, v_f, w_f in _edges_fw:\n"
+            "    if w_f < dist_fw[u_f][v_f]:\n"
+            "        dist_fw[u_f][v_f] = int(w_f)\n"
+            "for k_f in range(_n_fw):\n"
+            "    for i_f in range(_n_fw):\n"
+            "        for j_f in range(_n_fw):\n"
+            "            if dist_fw[i_f][k_f] + dist_fw[k_f][j_f] < dist_fw[i_f][j_f]:\n"
+            "                dist_fw[i_f][j_f] = dist_fw[i_f][k_f] + dist_fw[k_f][j_f]\n"
+            "finite = [dist_fw[i_f][j_f] for i_f in range(_n_fw) for j_f in range(_n_fw) if i_f != j_f and dist_fw[i_f][j_f] < inf_fw]\n"
+            "return [max(finite) if finite else 0, sum(finite)]"
+        )
+        try:
+            if all(_eval_floyd_warshall(a[0], a[1]) == y for a, y in samples):
+                renamed_fw_src = _alpha_rename_template_body(
+                    template_fw_src,
+                    ["_n_fw", "_edges_fw"],
+                    [arg_names[0], arg_names[1]],
+                )
+                out.append((renamed_fw_src, f"CEGAR_FLOYD_WARSHALL_APSP_AND_TRANSITIVE_DIAMETER_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+    # 15u. Exact Bareiss / Cramer Linear System Scaled Numerator & Determinant AST Synthesis (2-arg: mat_a, vec_b):
+    if (
+        len(arg_names) == 2
+        and all(
+            len(a) == 2
+            and isinstance(a[0], list)
+            and len(a[0]) == 2
+            and all(isinstance(r, list) and len(r) == 2 for r in a[0])
+            and isinstance(a[1], list)
+            and len(a[1]) == 2
+            and isinstance(y, list)
+            and len(y) == 3
+            and all(isinstance(v, int) for v in y)
+            for a, y in samples
+        )
+    ):
+        def _eval_cramer_2x2(mat_a: list[list[int]], vec_b: list[int]) -> list[int]:
+            a00, a01 = int(mat_a[0][0]), int(mat_a[0][1])
+            a10, a11 = int(mat_a[1][0]), int(mat_a[1][1])
+            b0, b1 = int(vec_b[0]), int(vec_b[1])
+            det = a00 * a11 - a01 * a10
+            dx = b0 * a11 - a01 * b1
+            dy = a00 * b1 - b0 * a10
+            return [det, dx, dy]
+
+        template_cr_src = (
+            "a00, a01 = int(_mat_a[0][0]), int(_mat_a[0][1])\n"
+            "a10, a11 = int(_mat_a[1][0]), int(_mat_a[1][1])\n"
+            "b0, b1 = int(_vec_b[0]), int(_vec_b[1])\n"
+            "det = a00 * a11 - a01 * a10\n"
+            "dx = b0 * a11 - a01 * b1\n"
+            "dy = a00 * b1 - b0 * a10\n"
+            "return [det, dx, dy]"
+        )
+        try:
+            if all(_eval_cramer_2x2(a[0], a[1]) == y for a, y in samples):
+                renamed_cr_src = _alpha_rename_template_body(
+                    template_cr_src,
+                    ["_mat_a", "_vec_b"],
+                    [arg_names[0], arg_names[1]],
+                )
+                out.append((renamed_cr_src, f"CEGAR_RATIONAL_GAUSS_JORDAN_EXACT_DET_SOLVE_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+    # 15v. Rabin-Karp Rolling Polynomial Hash Substring Matcher AST Synthesis (2-arg: text, pattern):
+    if (
+        len(arg_names) == 2
+        and all(
+            len(a) == 2
+            and isinstance(a[0], str)
+            and isinstance(a[1], str)
+            and len(a[1]) >= 1
+            and isinstance(y, list)
+            and all(isinstance(v, int) for v in y)
+            for a, y in samples
+        )
+    ):
+        def _eval_rabin_karp(txt_rk: str, pat_rk: str) -> list[int]:
+            n_t, m_p = len(txt_rk), len(pat_rk)
+            if m_p > n_t:
+                return []
+            base_rk, mod_rk = 257, 1000000007
+            p_hash = 0
+            t_hash = 0
+            high_p = pow(base_rk, m_p - 1, mod_rk)
+            for i_r in range(m_p):
+                p_hash = (p_hash * base_rk + ord(pat_rk[i_r])) % mod_rk
+                t_hash = (t_hash * base_rk + ord(txt_rk[i_r])) % mod_rk
+            hits_rk: list[int] = []
+            for i_r in range(n_t - m_p + 1):
+                if p_hash == t_hash and txt_rk[i_r : i_r + m_p] == pat_rk:
+                    hits_rk.append(i_r)
+                if i_r < n_t - m_p:
+                    t_hash = ((t_hash - ord(txt_rk[i_r]) * high_p) * base_rk + ord(txt_rk[i_r + m_p])) % mod_rk
+            return hits_rk
+
+        template_rk_src = (
+            "n_t, m_p = len(_txt_rk), len(_pat_rk)\n"
+            "if m_p > n_t:\n"
+            "    return []\n"
+            "base_rk, mod_rk = 257, 1000000007\n"
+            "p_hash = 0\n"
+            "t_hash = 0\n"
+            "high_p = pow(base_rk, m_p - 1, mod_rk)\n"
+            "for i_r in range(m_p):\n"
+            "    p_hash = (p_hash * base_rk + ord(_pat_rk[i_r])) % mod_rk\n"
+            "    t_hash = (t_hash * base_rk + ord(_txt_rk[i_r])) % mod_rk\n"
+            "hits_rk = []\n"
+            "for i_r in range(n_t - m_p + 1):\n"
+            "    if p_hash == t_hash and _txt_rk[i_r:i_r + m_p] == _pat_rk:\n"
+            "        hits_rk.append(i_r)\n"
+            "    if i_r < n_t - m_p:\n"
+            "        t_hash = ((t_hash - ord(_txt_rk[i_r]) * high_p) * base_rk + ord(_txt_rk[i_r + m_p])) % mod_rk\n"
+            "return hits_rk"
+        )
+        try:
+            if all(_eval_rabin_karp(a[0], a[1]) == y for a, y in samples):
+                renamed_rk_src = _alpha_rename_template_body(
+                    template_rk_src,
+                    ["_txt_rk", "_pat_rk"],
+                    [arg_names[0], arg_names[1]],
+                )
+                out.append((renamed_rk_src, f"CEGAR_RABIN_KARP_ROLLING_POLYNOMIAL_HASH_MULTI_MATCH_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+    # 15w. Hierholzer Directed Eulerian Trail Reconstruction AST Synthesis (2-arg: edges, start_node):
+    if (
+        len(arg_names) == 2
+        and all(
+            len(a) == 2
+            and isinstance(a[0], list)
+            and len(a[0]) >= 1
+            and all(isinstance(e, (list, tuple)) and len(e) == 2 and all(isinstance(v, int) for v in e) for e in a[0])
+            and isinstance(a[1], int)
+            and isinstance(y, list)
+            and len(y) == len(a[0]) + 1
+            for a, y in samples
+        )
+    ):
+        def _eval_hierholzer(edges_eu: list[Any], start_eu: int) -> list[int]:
+            adj_eu: dict[int, list[int]] = {}
+            for u_e, v_e in edges_eu:
+                adj_eu.setdefault(int(u_e), []).append(int(v_e))
+            for u_k in adj_eu:
+                adj_eu[u_k].sort(reverse=True)
+            stack_eu = [int(start_eu)]
+            trail_eu: list[int] = []
+            while stack_eu:
+                cur_u = stack_eu[-1]
+                if adj_eu.get(cur_u):
+                    stack_eu.append(adj_eu[cur_u].pop())
+                else:
+                    trail_eu.append(stack_eu.pop())
+            return trail_eu[::-1]
+
+        template_eu_src = (
+            "adj_eu = {}\n"
+            "for u_e, v_e in _edges_eu:\n"
+            "    adj_eu.setdefault(int(u_e), []).append(int(v_e))\n"
+            "for u_k in adj_eu:\n"
+            "    adj_eu[u_k].sort(reverse=True)\n"
+            "stack_eu = [int(_start_eu)]\n"
+            "trail_eu = []\n"
+            "while stack_eu:\n"
+            "    cur_u = stack_eu[-1]\n"
+            "    if adj_eu.get(cur_u):\n"
+            "        stack_eu.append(adj_eu[cur_u].pop())\n"
+            "    else:\n"
+            "        trail_eu.append(stack_eu.pop())\n"
+            "return trail_eu[::-1]"
+        )
+        try:
+            if all(_eval_hierholzer(a[0], a[1]) == y for a, y in samples):
+                renamed_eu_src = _alpha_rename_template_body(
+                    template_eu_src,
+                    ["_edges_eu", "_start_eu"],
+                    [arg_names[0], arg_names[1]],
+                )
+                out.append((renamed_eu_src, f"CEGAR_EULERIAN_HIERHOLZER_DIRECTED_TRAIL_RECONSTRUCTION_BODY_{fn_name}"))
+        except Exception:
+            pass
+
+    # 16. Compositional Bottom-Up Observational-Equivalence AST Program Synthesis (Depth 1..3):
+    if not out and 1 <= len(arg_names) <= 3 and len(samples) >= 2:
+        synth_res = _synthesize_bottom_up_observational_ast(arg_names, samples, return_depth=True)
+        if synth_res is not None:
+            synth_expr, synth_depth = synth_res
+            kind_tag = (
+                f"CEGAR_DEPTH3_CONDITIONAL_BOTTOM_UP_AST_SYNTHESIS_BODY_{fn_name}"
+                if synth_depth >= 3
+                else f"CEGAR_COMPOSITIONAL_BOTTOM_UP_AST_SYNTHESIS_BODY_{fn_name}"
+            )
+            out.append((f"return {synth_expr}", kind_tag))
+
+    return out
+
