+def synthesize_multi_object_video(
+    num_frames: int = 6, width: int = 32, height: int = 32
+) -> dict[str, Any]:
+    """Synthesize a multi-frame 2D grayscale video with 2 rigid bodies moving at constant velocities."""
+    # Object 1: 4x4 bright square (intensity 200) starting at (4, 5), velocity (+2, +1)
+    # Object 2: 4x4 mid square (intensity 120) starting at (22, 6), velocity (-1, +2)
+    frames: list[list[list[float]]] = []
+    ground_truth: list[dict[str, Any]] = []
+    for t in range(num_frames):
+        grid = [[0.0 for _ in range(width)] for _ in range(height)]
+        x1, y1 = 4 + 2 * t, 5 + 1 * t
+        x2, y2 = 22 - 1 * t, 6 + 2 * t
+        for dy in range(4):
+            for dx in range(4):
+                grid[y1 + dy][x1 + dx] = 200.0
+                grid[y2 + dy][x2 + dx] = 120.0
+        frames.append(grid)
+        ground_truth.append(
+            {
+                "frame": t,
+                "obj1_top_left": (x1, y1),
+                "obj2_top_left": (x2, y2),
+            }
+        )
+    return {"frames": frames, "ground_truth": ground_truth, "width": width, "height": height}
