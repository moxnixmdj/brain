+    assert c9["pass"] is True
+    c10 = res["checks"][9]
+    assert c10["check_id"] == "RAW_RGB_RASTER_END_TO_END_SCENE_GRAPH_GLYPH_DEMIX_AND_UNIT_QUERY"
+    assert c10["pass"] is True
+    c11 = res["checks"][10]
+    assert c11["check_id"] == "AUTO_GLYPH_DISCOVERY_SCALE_INVARIANT_2X_AND_2D_GAUSSIAN_STROKE_DECONVOLUTION"
+    assert c11["pass"] is True
+    c12 = res["checks"][11]
