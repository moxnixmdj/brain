+        sel_cap = "open_world.symbolic_generalization.v1"
+    else:
+        sel_cap = cand_ids[0] if cand_ids else None
+    solved["selected_capability_id"] = sel_cap
+    solved["goal_grounding"] = {
+        "schema": grounding.get("schema"),
+        "grounded_clause_count": grounding.get("grounded_clause_count", 0),
+        "selected_capability_id": sel_cap,
+        "candidate_capability_ids": cand_ids,
+        "candidate_count": len(cand_ids),
+    }
+    if synth_result is not None:
+        pred_field_key = str(task.get("prediction_field") or "prediction")
+        sel_cand = solved.get("selected_candidate")
+        if not isinstance(sel_cand, Mapping):
+            trace_rows = (solved.get("solver_result") or {}).get("trace") or []
+            if trace_rows and isinstance(trace_rows[0], Mapping):
+                sel_cand = trace_rows[0].get("verified_output")
+                if isinstance(sel_cand, Mapping):
+                    solved["selected_candidate"] = dict(sel_cand)
+        c_hyps = locals().get("candidate_hypotheses") or []
+        if isinstance(sel_cand, Mapping) and pred_field_key in sel_cand and len(c_hyps) > 1:
+            chosen_pred = sel_cand[pred_field_key]
+            for h in c_hyps:
+                if h.get("prediction") == chosen_pred:
