+def render_bitmap_text_5x7(
+    image: Any,
+    x0: int,
+    y0: int,
+    text: str,
+    color: tuple[int, int, int] = (20, 20, 20),
+) -> None:
+    """Render deterministic 5x7 bitmap glyphs onto a PIL RGB image (6px horizontal pitch)."""
+    for idx, ch in enumerate(text):
+        rows = _GLYPH_5X7.get(ch)
+        if rows is None:
+            raise ChartProfessionalSemanticsV2Error(f"UNSUPPORTED_GLYPH:{ch}")
+        gx = x0 + idx * 6
+        for ry, row in enumerate(rows):
+            for rx, bit in enumerate(row):
+                if bit == "1":
+                    image.putpixel((gx + rx, y0 + ry), color)
