+                    "status": "PASS__MARKOWITZ_MINIMUM_VARIANCE_TWO_ASSET_PORTFOLIO_SYNTHESIZED",
+                    "inferred_witness_family": "MARKOWITZ_MINIMUM_VARIANCE_TWO_ASSET_PORTFOLIO_SYNTHESIS",
