+def evaluate_shadow_dom_slot_projection_and_composed_event_retargeting() -> dict[str, Any]:
+    """Verify Web Components Shadow DOM `<slot>` projection and composed event target retargeting."""
+    light_children = [
+        {"id": "light-title", "slot": "header", "text": "Security Telemetry"},
+        {"id": "light-action", "slot": "footer", "text": "Rotate Token"},
+        {"id": "light-body", "slot": "", "text": "Default slot payload"},
+    ]
+    shadow_slots: dict[str, list[str]] = {"header": [], "": [], "footer": []}
+    for child in light_children:
+        slot_name = child["slot"] if child["slot"] in shadow_slots else ""
+        shadow_slots[slot_name].append(child["id"])
+
+    # Composed event path from inner shadow button `#shadow-inner-btn` inside `#shadow-card` of host `#telemetry-widget`
+    composed_path = [
+        "#shadow-inner-btn",
+        "#shadow-toolbar",
+        "#shadow-root(open)",
+        "#telemetry-widget",
+        "#workspace",
+        "#app",
+        "document",
+    ]
+    # Across the shadow boundary (`#shadow-root(open)`), outer light-DOM listeners see `event.target` retargeted to `#telemetry-widget`
+    boundary_idx = composed_path.index("#shadow-root(open)")
+    retargeted_targets = {
+        node: ("#shadow-inner-btn" if idx < boundary_idx else "#telemetry-widget")
+        for idx, node in enumerate(composed_path)
+    }
+    return {
+        "assigned_slots": shadow_slots,
+        "composed_path": composed_path,
+        "inner_listener_target": retargeted_targets["#shadow-toolbar"],
+        "outer_listener_target": retargeted_targets["#workspace"],
+        "shadow_encapsulation_preserved": retargeted_targets["#workspace"] == "#telemetry-widget",
+    }
+
