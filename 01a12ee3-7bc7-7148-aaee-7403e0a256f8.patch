+def render_truetype_chart_text(
+    image: Any,
+    xy: tuple[int, int],
+    text: str,
+    *,
+    font_family: str = "DejaVuSans",
+    font_size: int = 15,
+    color: tuple[int, int, int] = (20, 20, 20),
+    tracking_px: int = 2,
+) -> dict[str, Any]:
+    """Render proportional anti-aliased TrueType text using real system/Matplotlib .ttf fonts."""
+    from PIL import ImageDraw, ImageFont
+
+    ttf_path = _resolve_truetype_font_path(font_family)
+    font = ImageFont.truetype(ttf_path, size=int(font_size))
+    dr = ImageDraw.Draw(image)
+    cx, cy = int(xy[0]), int(xy[1])
+    for ch in str(text):
+        dr.text((cx, cy), ch, fill=color, font=font)
+        bbox = font.getbbox(ch)
+        adv = max(4, (bbox[2] - bbox[0]) if bbox else int(font_size * 0.5))
+        cx += adv + max(1, int(tracking_px))
+    return {
+        "pass": True,
+        "font_family": font_family,
+        "font_size": int(font_size),
+        "rendered_text": str(text),
+        "span_x": (int(xy[0]), cx),
+    }
+
+
+def decode_truetype_proportional_glyph_strip(
+    image: Any,
+    search_box: tuple[int, int, int, int],
+    *,
+    candidate_fonts: Sequence[str] = ("DejaVuSans", "DejaVuSerif", "DejaVuSansMono"),
+    font_size: int = 15,
+) -> dict[str, Any]:
+    """Decode proportional anti-aliased TrueType chart text across multiple font families."""
+    w_img, h_img = image.size
+    x0 = max(0, int(search_box[0]))
+    y0 = max(0, int(search_box[1]))
+    x1 = min(w_img, int(search_box[2]))
+    y1 = min(h_img, int(search_box[3]))
+    if x1 <= x0 or y1 <= y0:
+        raise ChartProfessionalSemanticsV2Error("EMPTY_TRUETYPE_SEARCH_BOX")
+
+    # Segment proportional glyphs via vertical ink projection profile
+    col_ink: list[float] = []
+    for x in range(x0, x1):
+        s_col = 0.0
+        for y in range(y0, y1):
+            r, g, b = image.getpixel((x, y))[:3]
+            lum = (float(r) + float(g) + float(b)) / 3.0
+            if lum < 235.0:
+                s_col += (255.0 - lum) / 255.0
+        col_ink.append(s_col)
+
+    runs: list[tuple[int, int]] = []
+    in_run = False
+    rs = x0
+    for idx, val in enumerate(col_ink):
+        px = x0 + idx
+        if val > 0.12 and not in_run:
+            in_run = True
+            rs = px
+        elif val <= 0.12 and in_run:
+            in_run = False
+            runs.append((rs, px - 1))
+    if in_run:
+        runs.append((rs, x1 - 1))
+    if not runs:
+        raise ChartProfessionalSemanticsV2Error("NO_TRUETYPE_GLYPH_RUNS_FOUND")
+
+    glyph_boxes: list[tuple[int, int, int, int]] = []
+    for gx0, gx1 in runs:
+        ys_active: list[int] = []
+        for y in range(y0, y1):
+            for x in range(gx0, gx1 + 1):
+                r, g, b = image.getpixel((x, y))[:3]
+                if (r + g + b) / 3.0 < 235.0:
+                    ys_active.append(y)
+                    break
+        if ys_active:
+            glyph_boxes.append((gx0, min(ys_active), gx1, max(ys_active)))
+    if not glyph_boxes:
+        raise ChartProfessionalSemanticsV2Error("NO_TRUETYPE_GLYPH_BOXES")
+
+    best_overall_font = None
+    best_overall_chars: list[str] = []
+    best_overall_confs: list[float] = []
+    best_overall_mean = -1.0
+
+    for fam in candidate_fonts:
+        bank = _get_truetype_templates(fam, int(font_size))
+        fam_chars: list[str] = []
+        fam_confs: list[float] = []
+        for gx0, gy0, gx1, gy1 in glyph_boxes:
+            obs_vec, obs_norm = _extract_normalized_patch(image, gx0, gy0, gx1, gy1)
+            gw = gx1 - gx0 + 1
+            gh = gy1 - gy0 + 1
+            obs_aspect = gw / float(max(1, gh))
+            best_ch = None
+            best_sc = -1.0
+            for ch, (t_vec, t_norm, tw, th) in bank.items():
+                if obs_norm < 1e-6 or t_norm < 1e-6:
+                    continue
+                t_aspect = tw / float(max(1, th))
+                # Penalize extreme aspect-ratio mismatch (distinguishes '.' and '-' from full-height digits)
+                aspect_diff = abs(obs_aspect - t_aspect) / max(0.5, obs_aspect, t_aspect)
+                size_diff = abs(gh - th) / float(max(4, gh, th))
+                if aspect_diff > 0.65 or size_diff > 0.55:
+                    continue
+                ncc = sum(o * t for o, t in zip(obs_vec, t_vec)) / (obs_norm * t_norm)
+                l1 = 1.0 - (sum(abs(o - t) for o, t in zip(obs_vec, t_vec)) / float(len(obs_vec)))
+                sc = 0.65 * ncc + 0.35 * l1 - 0.12 * aspect_diff - 0.08 * size_diff
+                if sc > best_sc:
+                    best_sc = sc
+                    best_ch = ch
+            if best_ch is None:
+                break
+            fam_chars.append(best_ch)
+            fam_confs.append(round(best_sc, 6))
+        if len(fam_chars) == len(glyph_boxes):
+            mean_c = sum(fam_confs) / float(len(fam_confs))
+            if mean_c > best_overall_mean:
+                best_overall_mean = mean_c
+                best_overall_font = fam
+                best_overall_chars = fam_chars
+                best_overall_confs = fam_confs
+
+    if best_overall_font is None or not best_overall_confs or min(best_overall_confs) < 0.72:
+        raise ChartProfessionalSemanticsV2Error("LOW_CONFIDENCE_TRUETYPE_OCR")
+
+    return {
+        "pass": True,
+        "decoded_text": "".join(best_overall_chars),
+        "detected_font_family": best_overall_font,
+        "glyph_count": len(best_overall_chars),
+        "min_confidence": min(best_overall_confs),
+        "mean_confidence": round(best_overall_mean, 6),
+        "confidences": best_overall_confs,
+    }
+
