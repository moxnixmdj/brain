+def _to_fraction(val: int | float | str | Fraction) -> Fraction:
+    if isinstance(val, Fraction):
+        return val
+    if isinstance(val, int):
+        return Fraction(val, 1)
+    if isinstance(val, str):
+        return Fraction(val)
+    return Fraction(str(val))
