+                lam_q = Fraction(str(mm1_spec.get("arrival_rate", 3)))
+                mu_q = Fraction(str(mm1_spec.get("service_rate", 4)))
+                rho_q = lam_q / mu_q
+                mean_l = lam_q / (mu_q - lam_q)
