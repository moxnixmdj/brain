+def synthesize_and_verify_new_capability_module(
+    spec: Mapping[str, Any],
+    *,
+    repo_root: str | Path = ROOT,
+) -> dict[str, Any]:
+    """Autonomously synthesize a brand-new Python capability adapter from input-output examples,
+    verify it on held-out examples in an isolated namespace, and return its authenticated
+    capability registry descriptor.
+    """
+    from canonical.runtime.bound_capabilities.python_general_software_repair_loop_v10 import (
+        _synthesize_bottom_up_observational_ast,
+    )
+
+    cap_id = _s(spec.get("capability_id")) or "synthesized.autonomous.capability.v1"
+    fn_name = _s(spec.get("function_name")) or "compute"
+    arg_names = [str(a) for a in (spec.get("arg_names") or ["x"])]
+    train_samples = [(list(a), y) for a, y in (spec.get("train_samples") or [])]
+    holdout_samples = [(list(a), y) for a, y in (spec.get("holdout_samples") or [])]
+    requires = _items(spec.get("requires"))
+    provides = _items(spec.get("provides") or [f"fact.{cap_id}.verified"])
+
+    if len(train_samples) < 2 or not holdout_samples:
+        raise SelfImprovementError("SYNTHESIS_REQUIRES_TRAIN_AND_HOLDOUT_SAMPLES")
+
+    expr_src = _synthesize_bottom_up_observational_ast(arg_names, train_samples)
+    if expr_src is None and len(arg_names) >= 1:
+        a0 = arg_names[0]
+        predicates: list[tuple[str, Any]] = [
+            (f"{a0} >= 0", lambda args: args[0] >= 0),
+            (f"{a0} > 0", lambda args: args[0] > 0),
+            (f"{a0} % 2 == 0", lambda args: isinstance(args[0], int) and args[0] % 2 == 0),
+        ]
+        if len(arg_names) >= 2:
+            a1 = arg_names[1]
+            predicates.append((f"{a0} >= {a1}", lambda args: args[0] >= args[1]))
+        for cond_src, cond_fn in predicates:
+            pos_part = [(a, y) for a, y in train_samples if cond_fn(a)]
+            neg_part = [(a, y) for a, y in train_samples if not cond_fn(a)]
+            if pos_part and neg_part:
+                t_branch = _synthesize_bottom_up_observational_ast(arg_names, pos_part)
+                f_branch = _synthesize_bottom_up_observational_ast(arg_names, neg_part)
+                if t_branch is not None and f_branch is not None:
+                    expr_src = f"(({t_branch}) if ({cond_src}) else ({f_branch}))"
+                    break
+    if (
+        expr_src is None
+        and len(arg_names) == 1
+        and len(train_samples) >= 4
+        and all(isinstance(a[0], int) and isinstance(y, int) for a, y in train_samples)
+    ):
+        from fractions import Fraction
+        import math as _math
+
+        a0 = arg_names[0]
+        max_deg = min(len(train_samples) - 1, 12)
+        for deg_target in range(3, max_deg + 1):
+            pts_q = [(Fraction(a[0]), Fraction(y)) for a, y in train_samples[: deg_target + 1]]
+            poly_q = [Fraction(0)] * (deg_target + 1)
+            for i_p, (xi, yi) in enumerate(pts_q):
+                num_p = [Fraction(1)]
+                den_p = Fraction(1)
+                for j_p, (xj, _) in enumerate(pts_q):
+                    if i_p == j_p:
+                        continue
+                    den_p *= (xi - xj)
+                    nxt_p = [Fraction(0)] * (len(num_p) + 1)
+                    for deg_k, cf in enumerate(num_p):
+                        nxt_p[deg_k] -= cf * xj
+                        nxt_p[deg_k + 1] += cf
+                    num_p = nxt_p
+                scale = yi / den_p
+                for deg_k, cf in enumerate(num_p):
+                    poly_q[deg_k] += cf * scale
+            if all(
+                sum(poly_q[d_k] * (Fraction(a[0]) ** d_k) for d_k in range(deg_target + 1)) == Fraction(y)
+                for a, y in train_samples
+            ):
+                denom_lcm = 1
+                for cf in poly_q:
+                    denom_lcm = (denom_lcm * cf.denominator) // _math.gcd(denom_lcm, cf.denominator)
+                int_coeffs = [int(cf * denom_lcm) for cf in poly_q]
+                terms_str: list[str] = []
+                for d_k in range(deg_target, -1, -1):
+                    c_int = int_coeffs[d_k]
+                    if c_int == 0:
+                        continue
+                    if d_k == 0:
+                        terms_str.append(f"({c_int})")
+                    elif d_k == 1:
+                        terms_str.append(f"({c_int} * {a0})")
+                    else:
+                        terms_str.append(f"({c_int} * ({a0} ** {d_k}))")
+                numer_expr = " + ".join(terms_str) if terms_str else "0"
+                expr_src = f"(({numer_expr}) // {denom_lcm})" if denom_lcm > 1 else f"({numer_expr})"
+                break
+    if expr_src is None:
+        return {
+            "schema": "PROJECT_BRAIN_AUTONOMOUS_CAPABILITY_SYNTHESIS_V1",
+            "status": "FAIL_CLOSED__NO_OBSERVATIONALLY_EQUIVALENT_AST_FOUND",
+            "pass": False,
+            "capability_id": cap_id,
+        }
+
+    params_sig = ", ".join(arg_names)
+    extract_args = ", ".join(f"args['{a}']" for a in arg_names)
+    module_source = (
+        f"from __future__ import annotations\n\n"
+        f"def {fn_name}({params_sig}):\n"
+        f"    return {expr_src}\n\n"
+        f"def run(args, *_extra, **_kw):\n"
+        f"    val = {fn_name}({extract_args})\n"
+        f"    return {{'pass': True, 'status': 'PASS', 'result': val, 'capability_id': '{cap_id}'}}\n"
+    )
+    ns: dict[str, Any] = {}
+    exec(compile(module_source, f"<synthesized:{cap_id}>", "exec"), ns)
+    fn_obj = ns[fn_name]
+    run_obj = ns["run"]
+
+    train_ok = all(fn_obj(*a) == y for a, y in train_samples)
+    holdout_ok = all(fn_obj(*a) == y for a, y in holdout_samples)
+    adapter_out = run_obj({k: v for k, v in zip(arg_names, holdout_samples[0][0])})
+    adapter_ok = (
+        isinstance(adapter_out, Mapping)
+        and adapter_out.get("pass") is True
+        and adapter_out.get("result") == holdout_samples[0][1]
+    )
+    passed = bool(train_ok and holdout_ok and adapter_ok)
+    mod_sha256 = sha256(module_source.encode("utf-8")).hexdigest()
+    return {
+        "schema": "PROJECT_BRAIN_AUTONOMOUS_CAPABILITY_SYNTHESIS_V1",
+        "status": "PASS__NEW_PYTHON_CAPABILITY_SYNTHESIZED_AND_HOLDOUT_VERIFIED" if passed else "FAIL_CLOSED",
+        "pass": passed,
+        "capability_id": cap_id,
+        "function_name": fn_name,
+        "synthesized_ast_expression": expr_src,
+        "module_source": module_source,
+        "module_sha256": mod_sha256,
+        "train_verified": train_ok,
+        "holdout_verified": holdout_ok,
+        "adapter_verified": adapter_ok,
+        "registry_descriptor": {
+            "id": cap_id,
+            "requires": requires,
+            "provides": provides,
+            "module_sha256": mod_sha256,
+        },
+    }
+
