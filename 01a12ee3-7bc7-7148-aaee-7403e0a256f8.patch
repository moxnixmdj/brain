+def _monomial_ast(coeff: int, exp: int):
+    if exp == 0:
+        return _num(coeff)
+    x_pow = x if exp == 1 else Pow(x, _num(exp))
+    if coeff == 1:
+        return x_pow
+    if coeff == -1:
+        return Mul(NEG_ONE, x_pow)
+    return Mul(_num(coeff), x_pow)
