+    # Check 40: 2D Hexagonal Binning (Hexbin) Axial-Cube Coordinate Quantization & Lattice Density Conservation
+    def _point_to_hex_axial(px_h: float, py_h: float, size_h: float) -> tuple[int, int, int]:
+        qf = ((math.sqrt(3.0) / 3.0) * px_h - (1.0 / 3.0) * py_h) / size_h
+        rf = ((2.0 / 3.0) * py_h) / size_h
+        sf = -qf - rf
+        rq, rr, rs = int(round(qf)), int(round(rf)), int(round(sf))
+        dq, dr, ds = abs(rq - qf), abs(rr - rf), abs(rs - sf)
+        if dq > dr and dq > ds:
+            rq = -rr - rs
+        elif dr > ds:
+            rr = -rq - rs
+        else:
+            rs = -rq - rr
+        return (rq, rr, rs)
+
+    hex_pts = [
+        (0.0, 0.0), (2.0, 1.0), (-1.5, 1.0),     # Center hex (0, 0, 0)
+        (17.32, 0.0), (18.0, 1.0),               # Hex (1, 0, -1) for size=10 (center x = sqrt(3)*10 ~ 17.3205)
+        (8.66, 15.0),                            # Hex (0, 1, -1) for size=10 (center = (sqrt(3)/2*10, 1.5*10))
+    ]
+    hex_bins: dict[tuple[int, int, int], int] = {}
+    for hx, hy in hex_pts:
