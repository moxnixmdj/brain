+
+def decode_bitmap_text_5x7(image: Any, x0: int, y0: int, max_chars: int = 8) -> str:
+    """Decode deterministic 5x7 bitmap glyphs from a PIL RGB image without OCR/VLM models."""
+    chars: list[str] = []
+    for idx in range(max_chars):
+        gx = x0 + idx * 6
+        if gx + 5 > image.width or y0 + 7 > image.height:
+            break
+        rows: list[str] = []
+        any_ink = False
+        for ry in range(7):
+            bits: list[str] = []
+            for rx in range(5):
+                r, g, b = image.getpixel((gx + rx, y0 + ry))[:3]
+                is_ink = (0.2126 * r + 0.7152 * g + 0.0722 * b) < 160.0
+                if is_ink:
+                    any_ink = True
+                bits.append("1" if is_ink else "0")
+            rows.append("".join(bits))
+        if not any_ink:
+            break
+        pat = tuple(rows)
+        if pat not in _INVERSE_GLYPH_5X7:
+            if chars:
+                break
+            raise ChartProfessionalSemanticsV2Error("UNRECOGNIZED_5X7_GLYPH_PATTERN")
+        chars.append(_INVERSE_GLYPH_5X7[pat])
+    return "".join(chars)
+
