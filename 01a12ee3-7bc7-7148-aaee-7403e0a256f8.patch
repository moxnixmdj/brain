+def decode_antialiased_merged_glyph_strip(
+    image: Any,
+    search_box: tuple[int, int, int, int],
+    *,
+    soft_lum_threshold: float = 225.0,
+) -> dict[str, Any]:
+    """Decode anti-aliased 5x7 glyph strips where grey fringe pixels bridge adjacent characters.
+
+    Uses vertical column-ink projection valley splitting + normalized cross-correlation (NCC)
+    against the 5x7 bitmap basis over continuous ink intensities [0, 1]^(5x7).
+    """
+    x0, y0, x1, y1 = [int(v) for v in search_box]
+    ink_cols = []
+    ink_rows = []
+    for y in range(y0, y1):
+        row_ink = 0.0
+        for x in range(x0, x1):
+            r, g, b = image.getpixel((x, y))[:3]
+            lum = (float(r) + float(g) + float(b)) / 3.0
+            if lum < soft_lum_threshold:
+                row_ink += (255.0 - lum) / 255.0
+        if row_ink > 0.15:
+            ink_rows.append(y)
+    for x in range(x0, x1):
+        col_ink = 0.0
+        for y in range(y0, y1):
+            r, g, b = image.getpixel((x, y))[:3]
+            lum = (float(r) + float(g) + float(b)) / 3.0
+            if lum < soft_lum_threshold:
+                col_ink += (255.0 - lum) / 255.0
+        ink_cols.append((x, col_ink))
+
+    if not ink_rows or not any(c > 0.15 for _, c in ink_cols):
+        raise ChartProfessionalSemanticsV2Error("NO_ANTIALIASED_INK_IN_SEARCH_BOX")
+
+    min_y, max_y = min(ink_rows), max(ink_rows)
+    box_h = max_y - min_y + 1
+    scale = max(1, int(round(box_h / 7.0)))
+    cell_w = 5 * scale
+    stride = 6 * scale
+
+    active_xs = [x for x, c in ink_cols if c > 0.25]
+    min_x, max_x = min(active_xs), max(active_xs)
+    total_w = max_x - min_x + 1
+    n_chars = max(1, int(round((total_w + scale) / float(stride))))
+
+    # Precompute 5x7 binary templates as flat 35-vectors
+    templates: dict[str, list[float]] = {}
+    for ch, rows in _GLYPH_5X7.items():
+        vec = []
+        for r_str in rows:
+            for bit in r_str:
+                vec.append(1.0 if bit == "1" else 0.0)
+        templates[ch] = vec
+
+    chars: list[str] = []
+    confidences: list[float] = []
+    for idx in range(n_chars):
+        base_cx = min_x + idx * stride
+        best_ch = None
+        best_score = -1.0
+        # Multi-offset sliding search dx in (-1, 0, 1) to absorb sub-pixel kerning/fringe shifts
+        for dx in (-1, 0, 1):
+            cx = base_cx + dx
+            obs: list[float] = []
+            for gy in range(7):
+                for gx in range(5):
+                    px_sum = 0.0
+                    cnt = 0
+                    for sy in range(scale):
+                        for sx in range(scale):
+                            px = cx + gx * scale + sx
+                            py = min_y + gy * scale + sy
+                            if x0 <= px < x1 and y0 <= py < y1:
+                                r, g, b = image.getpixel((px, py))[:3]
+                                lum = (float(r) + float(g) + float(b)) / 3.0
+                                px_sum += max(0.0, min(1.0, (255.0 - lum) / 235.0))
+                                cnt += 1
+                    obs.append(px_sum / max(1, cnt))
+            obs_norm = math.sqrt(sum(v * v for v in obs))
+            if obs_norm < 1e-6:
+                continue
+            for ch, tmpl in templates.items():
+                t_norm = math.sqrt(sum(v * v for v in tmpl))
+                if t_norm < 1e-6:
+                    continue
+                dot = sum(o * t for o, t in zip(obs, tmpl))
+                l1_match = 1.0 - (sum(abs(o - t) for o, t in zip(obs, tmpl)) / 35.0)
+                score = 0.65 * (dot / (obs_norm * t_norm)) + 0.35 * l1_match
+                if score > best_score:
+                    best_score = score
+                    best_ch = ch
+        if best_ch is None or best_score < 0.75:
+            raise ChartProfessionalSemanticsV2Error("LOW_CONFIDENCE_ANTIALIASED_GLYPH")
+        chars.append(best_ch)
+        confidences.append(round(best_score, 6))
+
+    return {
+        "pass": True,
+        "decoded_text": "".join(chars),
+        "inferred_scale": scale,
+        "glyph_count": len(chars),
+        "min_confidence": min(confidences),
+        "confidences": confidences,
+    }
