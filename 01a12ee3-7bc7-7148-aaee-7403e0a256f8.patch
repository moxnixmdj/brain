+"""Tests for Coding General Software Repair Loop V10, Chartography V2, Root3 Closure, and Singularity V7."""
+from __future__ import annotations
+
+import pytest
+
+from canonical.runtime import (
+    bytes_minsrc2_pure_python_2228_solver_v1 as minsrc2_solver,
+    one_shot_frontier_singularity_v7 as singularity_v7,
+    one_shot_frontier_singularity_v8 as singularity_v8,
+    one_shot_frontier_singularity_v9 as singularity_v9,
+    open_world_symbolic_generalization_engine_v1 as ow_engine,
+    root3_complete_effect_and_namespace_closure_v1 as root3_closure,
+)
+from canonical.runtime.bound_capabilities import (
+    chart_professional_semantics_v2 as chart_v2,
+    python_general_software_repair_loop_v10 as coding_v10,
+)
+
+
+def test_coding_v10_evaluate_passes_all_scenarios():
+    res = coding_v10.evaluate()
+    assert res["pass"] is True
+    assert res["status"] == "PASS__CODING_GENERAL_SOFTWARE_REPAIR_LOOP_V10_VERIFIED"
+    assert res["scenario_count"] >= 14
+    assert res["scenario_pass_count"] == res["scenario_count"]
+    assert res["acceptance_oracle_leakage_detected"] is False
+    assert res["model_dependency_count"] == 0
+    assert res["incremental_spend_usd"] == 0.0
+    s5 = res["scenarios"][4]
+    assert s5["scenario_id"] == "CEGAR_MULTIBRANCH_SYNTHESIS_AND_IMPERATIVE_DIRECTIVE_SKILL_INDUCTION"
+    assert s5["skill_id"].startswith("SKILL:V10:")
+    assert s5["cegar_dag_winner"] == ["cegar.bilinear_interpolator", "cegar.guard_partition"]
+    s6 = res["scenarios"][5]
+    assert s6["scenario_id"] == "MULTIFILE_COORDINATED_REPAIR_COMPREHENSION_AND_V7_SKILL_RATCHET_O1_REUSE"
+    assert s6["pass"] is True
+    assert s6["reuse_authorized"] is True
+    s7 = res["scenarios"][6]
+    assert s7["scenario_id"] == "DICT_COMPREHENSION_ACCUMULATOR_AND_LIVE_UNIVERSAL_SKILL_RATCHET_V1_AUTHENTICATION"
+    assert s7["pass"] is True
+    assert s7["live_ratchet_status"] == "VERIFIED_EXECUTABLE_SKILL"
+    assert s7["reuse_authorized"] is True
+    s8 = res["scenarios"][7]
+    assert s8["scenario_id"] == "DYNAMIC_PROGRAMMING_AST_SYNTHESIS_AND_UNIVERSAL_STRUCTURED_TASK_LIVE_REUSE"
+    assert s8["pass"] is True
+    assert s8["ust_episode_reuse_authorized"] is True
+    s9 = res["scenarios"][8]
+    assert s9["scenario_id"] == "COUPLED_2D_GRID_DP_AND_GRAPH_BFS_AST_SYNTHESIS"
+    assert s9["pass"] is True
+    assert s9["winner_depth"] == 2
+    s10 = res["scenarios"][9]
+    assert s10["scenario_id"] == "COUPLED_BINARY_SEARCH_TWO_POINTER_AND_EDIT_DISTANCE_AST_SYNTHESIS"
+    assert s10["pass"] is True
+    assert s10["winner_depth"] == 2
+
+
+def test_coding_v10_compiles_extended_behavioral_and_imperative_directive_cells():
+    spec = (
+        "All declared Python unit tests must pass.\n"
+        "Calling `pkg.mod.fn` with args `[1, 2]` must return `3`.\n"
+        "Method `pkg.mod.Calc.add` with init `[10]` and args `[5]` must return `15`.\n"
+        "Return type of `pkg.mod.fn` with args `[1, 2]` must be `int`.\n"
+        "Method `Calc.add` must exist in \"pkg/mod.py\".\n"
+        "JavaScript file \"web/app.js\" must have valid syntax and export `runApp`.\n"
+        "Ensure module pkg.mod function fn returns 3 for [1, 2].\n"
+    )
+    compiled = coding_v10.compile_v10_request(spec)
+    assert compiled["pass"] is True
+    assert compiled["coverage_complete"] is True
+    assert compiled["residual_obligation_ids"] == []
+    kinds = [c["kind"] for c in compiled["cells"]]
+    assert "PYTHON_METHOD_CALL_EQUALS" in kinds
+    assert "PYTHON_CALL_RETURN_TYPE" in kinds
+    assert "PYTHON_CLASS_METHOD_EXISTS" in kinds
+    assert "JS_SYNTAX_AND_EXPORT" in kinds
+    assert "PYTHON_CALL_EQUALS" in kinds
+
+
+def test_chartography_v2_evaluate_passes_all_checks():
+    res = chart_v2.evaluate()
+    assert res["pass"] is True
+    assert res["status"] == "PASS__CHARTOGRAPHY_PROFESSIONAL_SEMANTICS_V2_VERIFIED"
+    assert res["check_count"] >= 18
+    assert res["check_pass_count"] == res["check_count"]
