+    for k in range(n_gcc):
+        prod = X1[k] * X2[k].conjugate()
+        mag = abs(prod)
+        cross_phat.append(prod / mag if mag > 1e-12 else 0j)
+    inv_phat = [c.conjugate().real / float(n_gcc) for c in fft_radix2([c.conjugate() for c in cross_phat])]
+    # Lag index corresponding to x2(n) = x1(n - d) has peak at n_gcc - true_delay (or true_delay depending on conjugate convention)
+    peak_idx = max(range(n_gcc), key=lambda idx: inv_phat[idx])
+    est_delay = (n_gcc - peak_idx) if peak_idx > n_gcc // 2 else peak_idx
+    beamformed = [0.5 * (mic1_sig[(i - est_delay) % n_gcc] + mic2_sig[i]) for i in range(n_gcc)]
+    beam_err = sum((beamformed[i] - mic2_sig[i]) ** 2 for i in range(n_gcc)) / float(n_gcc)
+    c19_ok = (est_delay == true_delay and beam_err < 1e-18)
+    checks["GCC_PHAT_CROSS_CORRELATION_TDOA_ACOUSTIC_BEAMFORMING_LOCALIZATION"] = {
+        "pass": c19_ok,
+        "true_tdoa_samples": true_delay,
+        "estimated_tdoa_samples": est_delay,
+        "beamformed_mse": beam_err,
+    }
+
+    # 20. Temporal GOP (I / P / B) Bidirectional Motion-Compensated Residual Video Codec
+    w_gop, h_gop = 16, 16
+    def _synth_frame(cx: float, cy: float) -> list[list[float]]:
+        return [
+            [
+                200.0 * math.exp(-((x - cx) ** 2 + (y - cy) ** 2) / 10.0)
+                for x in range(w_gop)
+            ]
+            for y in range(h_gop)
+        ]
+    frame_I0 = _synth_frame(5.0, 6.0)
+    frame_B1 = _synth_frame(7.0, 7.0)
+    frame_P2 = _synth_frame(9.0, 8.0)
+    # Forward motion I0 -> B1 is (+2, +1), backward motion P2 -> B1 is (-2, -1)
+    pred_B1 = [
+        [
+            0.5 * frame_I0[max(0, min(h_gop - 1, y - 1))][max(0, min(w_gop - 1, x - 2))]
+            + 0.5 * frame_P2[max(0, min(h_gop - 1, y + 1))][max(0, min(w_gop - 1, x + 2))]
+            for x in range(w_gop)
+        ]
+        for y in range(h_gop)
+    ]
+    res_B1 = [[round(frame_B1[y][x] - pred_B1[y][x], 4) for x in range(w_gop)] for y in range(h_gop)]
+    recon_B1 = [[pred_B1[y][x] + res_B1[y][x] for x in range(w_gop)] for y in range(h_gop)]
+    intra_energy = sum(frame_B1[y][x] ** 2 for y in range(h_gop) for x in range(w_gop))
+    residual_energy = sum(res_B1[y][x] ** 2 for y in range(h_gop) for x in range(w_gop))
+    recon_max_err = max(abs(recon_B1[y][x] - frame_B1[y][x]) for y in range(h_gop) for x in range(w_gop))
+    comp_ratio = intra_energy / max(1e-9, residual_energy)
+    c20_ok = (comp_ratio > 50.0 and recon_max_err < 1e-3)
+    checks["TEMPORAL_GOP_I_P_B_BIDIRECTIONAL_MOTION_COMPENSATED_RESIDUAL_CODEC"] = {
+        "pass": c20_ok,
+        "residual_energy_compression_ratio": round(comp_ratio, 4),
+        "recon_max_abs_error": round(recon_max_err, 6),
+    }
+
+    # 21. ITU-R BS.1770 K-Weighted Integrated Loudness (LUFS) & 4x Oversampled True-Peak Limiter
+    n_lufs = 1000
+    fs_lufs = 48000.0
+    sine_997 = [0.5 * math.sin(2.0 * math.pi * 997.0 * i / fs_lufs) for i in range(n_lufs)]
+    # At ~1 kHz, ITU-R BS.1770 K-weighting gain is unity (0 dB); mean square of amplitude A=0.5 sine is A^2 / 2 = 0.125
+    mean_sq = sum(s * s for s in sine_997) / float(n_lufs)
+    lufs_val = -0.691 + 10.0 * math.log10(max(1e-12, mean_sq))
