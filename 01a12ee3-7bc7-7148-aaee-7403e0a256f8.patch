+                slope_b = Fraction(str(cournot_spec.get("demand_slope", 1)))
+                mcost_c = Fraction(str(cournot_spec.get("marginal_cost", 10)))
+                n_firms = int(cournot_spec.get("firm_count", 2))
+                q_firm = (choke_a - mcost_c) / (slope_b * (n_firms + 1))
+                q_total = n_firms * q_firm
+                p_eq = choke_a - slope_b * q_total
