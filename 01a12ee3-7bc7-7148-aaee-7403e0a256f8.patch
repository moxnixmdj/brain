+        "rational_bezier_nurbs_lofted_surface_watertight_mesh": (
+            lambda nurbs_mesh, nurbs_cert, mid_pt: (
+                abs(math.hypot(mid_pt[0], mid_pt[1]) - 5.0) < 1e-9
+                and nurbs_cert["watertight_orientable_2_manifold"] is True
+                and nurbs_cert["euler_characteristic"] == 2
+                and nurbs_cert["inferred_genus"] == 0
+                and nurbs_cert["volume"] > 380.0
+            )
+        )(
+            nurbs_m := build_rational_bezier_nurbs_lofted_watertight_mesh(5.0, 3.0, 8.0, 4),
+            verify_watertight_triangulated_mesh(nurbs_m),
+            evaluate_rational_bezier_curve_3d([(5.0, 0.0, 0.0), (5.0, 5.0, 0.0), (0.0, 5.0, 0.0)], [1.0, math.sqrt(2.0) / 2.0, 1.0], 0.5),
+        ),
+        "gauss_divergence_mass_properties_centroid_and_inertia_tensor": (
+            lambda mp: (
+                abs(mp["volume"] - 192.0) < 1e-6
+                and mp["centroid"] == (0.0, 0.0, 0.0)
