@@ -0,0 +1,219 @@
+from __future__ import annotations
+
+import ast
+import hashlib
+import json
+from pathlib import Path
+import sys
+import tempfile
+
+from canonical.runtime import (
+    current_escape_o_proof_instantiation_search_v2 as search_v2,
+    effect_broker_receipt_resolver_v2 as resolver_v2,
+    one_shot_frontier_singularity_v10 as v10_omega,
+    skill_receipt_authenticator_v1 as sra,
+    terminal_root_decision_gate_v1 as root_gate,
+    unified_cognitive_fabric_v1 as fabric,
+    universal_structured_task_v1 as ust,
+)
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def test_v10_omega_receipt_present_and_all_8_steps_verified() -> None:
+    receipt_path = ROOT / v10_omega.RECEIPT_REL_PATH
+    assert receipt_path.is_file()
+    doc = json.loads(receipt_path.read_text(encoding="utf-8"))
+    assert doc["schema"] == v10_omega.SCHEMA
+    assert doc["status"] == "PASS__ONE_SHOT_FRONTIER_SINGULARITY_V10_OMEGA_ALL_8_STEPS_VERIFIED"
+    assert doc["pass"] is True
+    assert doc["step_count"] == 8
+    assert doc["step_pass_count"] == 8
+    assert all(s["pass"] is True for s in doc["steps"])
+
+
+def test_flaw1_terminal_root_decision_gate_and_fabric_terminal_root_pass() -> None:
+    manifest = json.loads(
+        (ROOT / "canonical/governance/TERMINAL_CLOSURE_MANIFEST_V1.json").read_text(encoding="utf-8")
+    )
+    rg = root_gate.evaluate({"closure_receipt": manifest["universal_cover_proof"]}, repo_root=ROOT)
+    assert rg["pass"] is True
+    assert rg["status"] == "PASS__TERMINAL_ROOT_NOT_X_PROVED"
+    assert rg["x_decided"] is True
+    assert rg["x"] is False
+    assert rg["u_empty"] is True
+    assert rg["abc_closed"] is True
+
+    f_res = fabric.run(
+        {
+            "mode": "TERMINAL_ROOT",
+            "payload": {"closure_receipt": manifest["universal_cover_proof"]},
+            "options": {"learn": False},
+        }
+    )
+    assert f_res["status"] == "FABRIC_DISPATCH_COMPLETE"
+    assert f_res["inner_pass"] is True
+    assert f_res["result"]["status"] == "PASS__TERMINAL_ROOT_NOT_X_PROVED"
+
+
+def test_flaw2_universal_structured_task_authenticated_episode_reuse() -> None:
+    task = {
+        "source_text": 'name must equal "Alice". score must be at least 50. passed must be true.',
+        "source_id": "v10-omega-test",
+        "field_schema": {
+            "name": {"type": "enum", "dimension": "dimensionless"},
+            "score": {"type": "number", "dimension": "score"},
+            "passed": {"type": "boolean", "dimension": "dimensionless"},
+        },
+        "candidate_domains": {
+            "name": ["Alice", "Bob"],
+            "score": [10, 75],
+            "passed": [False, True],
+        },
+        "target_effect": "RESULT_VERIFIED",
+    }
+    unauth = ust.solve(task)
+    assert unauth["pass"] is True
+    assert unauth["episode_reuse_authorized"] is False
+
+    with tempfile.TemporaryDirectory(prefix="ust_auth_") as td:
+        repo = Path(td)
+        v_rel = "canonical/runtime/v10_capsule_verifier.py"
+        v_file = repo / v_rel
+        v_file.parent.mkdir(parents=True, exist_ok=True)
+        v_raw = b"def verify():\n    return True\n"
+        v_file.write_bytes(v_raw)
+        v_blob = resolver_v2.git_blob_id(v_raw, object_format="sha1")
+        head_40 = "a" * 40
+        art_sha = "sha256:" + ("b" * 64)
+
+        ep = unauth["episode_candidate"]
+        subj_doc = {
+            "schema": sra.EPISODE_SCHEMA,
+            "episode_id": ep["episode_id"],
+            "scope_id": ep["scope_id"],
+            "program_sha256": ep["program_sha256"],
+            "verified_postconditions": ep["postconditions"],
+            "behavior_verified": True,
+            "conclusion": "success",
+        }
+        subj_raw = json.dumps(subj_doc, indent=2, sort_keys=True).encode("utf-8") + b"\n"
+        subj_file = repo / "canonical/verification/ep.json"
+        subj_file.parent.mkdir(parents=True, exist_ok=True)
+        subj_file.write_bytes(subj_raw)
+        subj_blob = resolver_v2.git_blob_id(subj_raw, object_format="sha1")
+        subj_ref = {
+            "path": "canonical/verification/ep.json",
+            "sha256": "sha256:" + hashlib.sha256(subj_raw).hexdigest(),
+            "git_blob_sha": subj_blob,
+        }
+
+        att = "sha256:" + hashlib.sha256(
+            f"{subj_blob}:{v_blob}:{head_40}:{art_sha}".encode("utf-8")
+        ).hexdigest()
+        ver_doc = {
+            "schema": sra.EPISODE_VERIFY_SCHEMA,
+            "subject_git_blob_sha": subj_blob,
+            "episode_id": ep["episode_id"],
+            "scope_id": ep["scope_id"],
+            "program_sha256": ep["program_sha256"],
+            "pass": True,
+            "verifier_id": "v10-capsule-verifier",
+            "public_runner": {
+                "repository": "moxnixmdj/verification-capsule-runner",
+                "workflow_run_id": 1001,
+                "workflow_job_id": 2002,
+                "execution_head_sha": head_40,
+                "artifact_id": 3003,
+                "artifact_digest": art_sha,
+                "conclusion": "success",
+                "verifier_path": v_rel,
+                "verifier_git_blob_sha": v_blob,
+            },
+            "independent_capsule_attestation": {"attestation_sha256": att},
+        }
+        ver_raw = json.dumps(ver_doc, indent=2, sort_keys=True).encode("utf-8") + b"\n"
+        ver_file = repo / "canonical/verification/ep_ver.json"
+        ver_file.write_bytes(ver_raw)
+        ver_ref = {
+            "path": "canonical/verification/ep_ver.json",
+            "sha256": "sha256:" + hashlib.sha256(ver_raw).hexdigest(),
+            "git_blob_sha": resolver_v2.git_blob_id(ver_raw, object_format="sha1"),
+        }
+
+        auth = ust.solve(
+            task,
+            episode_verification_receipt={"receipt": subj_ref, "verification": ver_ref},
+            repo_root=repo,
+        )
+        assert auth["pass"] is True
+        assert auth["episode_reuse_authorized"] is True
+        assert auth["verified_episode"]["reuse_authorized"] is True
+
+
+def test_flaw3_exact_symbolic_route_v1_and_minsrc2_solver_zero_sympy_imports() -> None:
+    for rel in (
+        "canonical/research/bytes/tools/exact_symbolic_route_v1.py",
+        "canonical/runtime/bytes_minsrc2_pure_python_2228_solver_v1.py",
