+    # 8. Temporal trajectory kinematics & horizon prediction at t=8
+    c1_t0 = seg_per_frame[0][0]["centroid"]
+    c1_t5 = seg_per_frame[5][0]["centroid"]
+    v1_est = ((c1_t5[0] - c1_t0[0]) / 5.0, (c1_t5[1] - c1_t0[1]) / 5.0)
+    pred_t8 = (c1_t0[0] + v1_est[0] * 8.0, c1_t0[1] + v1_est[1] * 8.0)
+    exact_t8 = (4.0 + 1.5 + 2.0 * 8.0, 5.0 + 1.5 + 1.0 * 8.0)
+    c8_ok = abs(pred_t8[0] - exact_t8[0]) < 1e-9 and abs(pred_t8[1] - exact_t8[1]) < 1e-9
+    checks["TEMPORAL_TRAJECTORY_KINEMATICS_AND_COLLISION_HORIZON"] = {
+        "pass": c8_ok,
+        "predicted_centroid_t8": pred_t8,
+        "exact_centroid_t8": exact_t8,
+    }
