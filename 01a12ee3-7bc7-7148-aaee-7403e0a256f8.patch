+def _dec_poly_asc (z :Any )->list [Fraction ]:
+ """Decode a MINSRC2 expression tree in variable 'x' into ascending rational coefficients."""
+ t =z [0 ]
+ if t =="I":
+  return [Fraction (int (z [1 ]),1 )]
+ if t =="Q":
+  return [Fraction (int (z [1 ]),int (z [2 ]))]
+ if t =="S"and z [1 ]=="x":
