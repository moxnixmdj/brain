+    # Verify constant Q = f_k / df_k across all 36 semitone bins and exact +12 bin shift for 2x frequency
+    q_ratios = [cqt_freqs[k] / (cqt_freqs[k + 1] - cqt_freqs[k]) for k in range(35)]
+    max_q_err = max(abs(qr - q_factor) for qr in q_ratios)
+    octave_shift_err = max(abs(cqt_freqs[k + 12] / cqt_freqs[k] - 2.0) for k in range(24))
+    c25_ok = max_q_err < 1e-12 and octave_shift_err < 1e-12
+    checks["CONSTANT_Q_TRANSFORM_CQT_LOG_FREQUENCY_PITCH_INVARIANT_HARMONIC_STACK"] = {
+        "pass": c25_ok,
+        "constant_q_factor": round(q_factor, 6),
+        "max_q_invariance_error": round(max_q_err, 14),
+        "octave_bin_shift": 12,
+    }
+
+    # 26. Bilateral Edge-Preserving Spatial-Range Gaussian Denoising Filter
+    # 1D cross-section of a sharp step edge at index 4: [10, 10, 10, 10, 100, 100, 100, 100] with deterministic oscillation
+    noisy_step = [10.0 + ((-1) ** i) * 2.0 if i < 4 else 100.0 + ((-1) ** i) * 2.0 for i in range(8)]
+    sigma_s = 1.5
+    sigma_r = 10.0
+    bilat_out: list[float] = []
+    for i in range(8):
