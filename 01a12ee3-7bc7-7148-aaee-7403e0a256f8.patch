+                    "inferred_witness_family": "COOPERATIVE_GAME_SHAPLEY_VALUE_MARGINAL_CONTRIBUTION_SYNTHESIS",
+                    "shapley_values_exact": [str(v) for v in shapley_vals],
+                    "grand_coalition_sum_exact": str(sum(shapley_vals)),
+                    "prediction": pred_shap,
+                })
+
+            # 28. Queueing-Theory M/M/c Erlang-C Markov Birth-Death Steady-State Synthesis
+            erl_spec = task.get("erlang_c_spec")
+            if isinstance(erl_spec, Mapping):
+                lam_q = Fraction(str(erl_spec.get("arrival_rate", 2)))
+                mu_q = Fraction(str(erl_spec.get("service_rate", 3)))
+                c_srv = int(erl_spec.get("servers", 1))
+                a_off = lam_q / mu_q
+                rho_q = a_off / Fraction(c_srv)
+                if rho_q < 1:
+                    sum_k = sum((a_off ** k_i) / Fraction(math.factorial(k_i)) for k_i in range(c_srv))
+                    tail_term = ((a_off ** c_srv) / Fraction(math.factorial(c_srv))) * (Fraction(1) / (Fraction(1) - rho_q))
+                    p0_erl = Fraction(1) / (sum_k + tail_term)
+                    p_wait = tail_term * p0_erl
+                    l_queue = p_wait * rho_q / (Fraction(1) - rho_q)
+                    out_mode_e = str(erl_spec.get("output") or "p_wait").upper()
+                    val_e = l_queue if "LQ" in out_mode_e or "QUEUE" in out_mode_e else p_wait
+                    pred_erl = int(val_e) if val_e.denominator == 1 else round(float(val_e), 6)
+                    candidate_hypotheses.insert(0, {
+                        "pass": True,
+                        "status": "PASS__QUEUEING_THEORY_ERLANG_C_MARKOV_BIRTH_DEATH_STEADY_STATE_SYNTHESIZED",
+                        "inferred_witness_family": "QUEUEING_THEORY_ERLANG_C_MARKOV_BIRTH_DEATH_STEADY_STATE_SYNTHESIS",
+                        "utilization_rho_exact": str(rho_q),
+                        "p_wait_exact": str(p_wait),
+                        "expected_queue_length_exact": str(l_queue),
+                        "prediction": pred_erl,
