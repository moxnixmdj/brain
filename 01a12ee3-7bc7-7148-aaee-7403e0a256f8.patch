--- /dev/null
+++ b/canonical/tests/test_terminal_kstar_end_to_end_closure_v1.py
@@ -0,0 +1,144 @@
+"""End-to-end verification tests for K*=(B,T,PI,A,R) Universal-Cover Terminal Closure (V1)."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import unittest
+
+from canonical.runtime.terminal_closure_reducer import evaluate_manifest
+from canonical.runtime.terminal_kstar_compiler_v1 import (
+    GLOBAL_OWNERSHIP_V2_RECEIPT_PATH,
+    MANIFEST_PATH,
+    RESULT_PATH,
+)
+from canonical.runtime.terminal_kstar_independent_verifier_v1 import (
+    INDEP_PATH,
+    verify_kstar_result,
+)
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+class TerminalKStarEndToEndClosureV1Tests(unittest.TestCase):
+    def test_kstar_result_and_independent_verification_pass(self) -> None:
+        result_obj = json.loads((ROOT / RESULT_PATH).read_text(encoding="utf-8"))
+        self.assertEqual(result_obj["schema"], "PROJECT_BRAIN_TERMINAL_KSTAR_RESULT_V1")
+        self.assertEqual(result_obj["outcome"], "SCOPE_COMPLETE_PROOF")
+        self.assertEqual(result_obj["proof_kind"], "GENERATOR_CLOSURE_SCOPE_COMPLETE")
+        self.assertEqual(result_obj["scope_id"], "scope://opus55/observable-trace")
+        self.assertEqual(len(result_obj["generated_basis"]), 10)
+        self.assertEqual(len(result_obj["transforms"]), 4)
+
+        indep_summary = verify_kstar_result(ROOT)
+        self.assertTrue(indep_summary["pass"], indep_summary)
+        indep_obj = json.loads((ROOT / INDEP_PATH).read_text(encoding="utf-8"))
+        self.assertEqual(indep_obj["status"], "PASS__INDEPENDENT_SCOPE_COMPLETE_KSTAR")
+        self.assertTrue(indep_obj["independent_verified"])
+        self.assertTrue(indep_obj["exact_byte_bound"])
+        self.assertTrue(indep_obj["identity_separation_verified"])
+        self.assertEqual(indep_obj["covered_family_count"], 19)
+
+    def test_protocol_v2_global_ownership_postconditions_bound_and_current(self) -> None:
+        gov_obj = json.loads((ROOT / GLOBAL_OWNERSHIP_V2_RECEIPT_PATH).read_text(encoding="utf-8"))
+        self.assertIn("INDEPENDENT_PUBLIC_RUNNER_PASS", gov_obj["status"])
+        preds = gov_obj["result"]["terminal_predicates"]
+        for key in (
+            "final_donor_deletion_cleanroom_pass",
+            "donor_deletion_protocol_v2_bound",
+            "runtime_cognition_model_independent",
+            "zero_external_model_runtime_cognition_dependencies",
+            "copied_or_rehosted_teacher_absent",
+            "runtime_dependency_inventory_complete",
+        ):
+            self.assertTrue(preds.get(key), key)
+
+    def test_terminal_closure_reducer_achieves_universal_scope_complete_cover(self) -> None:
+        manifest = json.loads((ROOT / MANIFEST_PATH).read_text(encoding="utf-8"))
+        self.assertEqual(
+            manifest["status"],
+            "TERMINAL_ACHIEVED__UNIVERSAL_SCOPE_COMPLETE_COVER_VERIFIED",
+        )
+        self.assertTrue(manifest["current_machine_verdict"]["achieved"])
+        self.assertEqual(
+            manifest["current_machine_verdict"]["proof_route"],
+            "UNIVERSAL_SCOPE_COMPLETE_COVER",
+        )
+        self.assertIn(
+            manifest["final_proof_bundle_state"]["status"],
+            {"FROZEN_AND_REDUCER_VERIFIED", "FROZEN_AND_INDEPENDENTLY_VERIFIED"},
+        )
+        verdict = evaluate_manifest(manifest, repo_root=ROOT)
+        self.assertTrue(verdict["achieved"], verdict)
+        self.assertEqual(verdict["proof_route"], "UNIVERSAL_SCOPE_COMPLETE_COVER")
+        self.assertEqual(verdict["failed_predicates"], [])
+        self.assertEqual(verdict["legacy_family_route_failed_predicates"], [])
+        self.assertEqual(verdict["closed_family_count"], 19)
+        self.assertTrue(verdict["universal_cover_route"]["pass"])
+        self.assertTrue(verdict["current_donor_authority"]["pass"])
+
+        cert_obj = json.loads(
+            (ROOT / "canonical/verification/TERMINAL_KSTAR_CERTIFICATE_20261007_V1.json").read_text(
+                encoding="utf-8"
+            )
+        )
+        self.assertEqual(cert_obj["status"], "TERMINAL_TRUE__REDUCER_ACHIEVED")
+        self.assertEqual(cert_obj["proof_route"], "UNIVERSAL_SCOPE_COMPLETE_COVER")
+        self.assertEqual(cert_obj["failed_predicates"], [])
+
+    def test_dual_route_reality_gate_projection_and_cleanroom_all_pass(self) -> None:
+        from canonical.runtime import (
+            final_terminal_cleanroom_gate_v1,
+            postwave_global_ownership_reducer_v1,
+            terminal_projection_consistency_v1,
+            terminal_reality_gate_v1,
+        )
+
+        pointer = json.loads(
+            (ROOT / "canonical/governance/CURRENT_TERMINAL_AUTHORITY.json").read_text(
+                encoding="utf-8"
+            )
+        )
+        manifest = json.loads((ROOT / MANIFEST_PATH).read_text(encoding="utf-8"))
+        matrix = json.loads(
+            (
+                ROOT
+                / "canonical/capabilities/opus55/OPUS_5_5_CAPABILITY_OWNERSHIP_MATRIX_V1.json"
+            ).read_text(encoding="utf-8")
+        )
+
+        gate = terminal_reality_gate_v1.evaluate(pointer, manifest)
+        self.assertTrue(gate["terminal_real"], gate)
+        self.assertEqual(gate["phase"], "TERMINAL")
+        self.assertEqual(gate["accepted_family_count"], 19)
+        self.assertEqual(gate["verified_owned_family_count"], 19)
+        self.assertEqual(gate["open_acceptance_family_count"], 0)
+        self.assertEqual(gate["open_ownership_or_acceptance_family_count"], 0)
+        self.assertEqual(gate["blockers"], [])
+
+        proj = terminal_projection_consistency_v1.evaluate_live()
+        self.assertTrue(proj["pass"], proj)
+        self.assertEqual(proj["acceptance_closed_families"], 19)
+        self.assertEqual(proj["acceptance_open_families"], 0)
+        self.assertEqual(proj["atomic_predicates_proved"], 38)
+        self.assertEqual(proj["atomic_predicates_unresolved"], 0)
+        self.assertTrue(proj["terminal_goal_achieved"])
+
+        postwave = postwave_global_ownership_reducer_v1.evaluate(manifest, matrix)
+        self.assertTrue(postwave["achieved"], postwave)
+        self.assertEqual(postwave["status"], "PASS")
+        self.assertEqual(postwave["errors"], [])
+
+        six_m = json.loads(
+            (
+                ROOT
+                / "canonical/governance/TERMINAL_CANDIDATE_SIX_CONJUNCT_MANIFEST_20261012_V1.json"
+            ).read_text(encoding="utf-8")
+        )
+        cleanroom = final_terminal_cleanroom_gate_v1.evaluate(six_m, repo_root=ROOT)
+        self.assertTrue(cleanroom["pass"], cleanroom)
+        self.assertTrue(cleanroom["terminal_authority"])
+        self.assertEqual(cleanroom["errors"], [])
+
+
+if __name__ == "__main__":
+    unittest.main()
