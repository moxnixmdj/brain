+    )
+    checks.append(
+        {
+            "check_id": "CANDLESTICK_OHLC_BULLISH_BEARISH_DECODING",
+            "pass": bool(
+                ohlc["candle"]["open"] == 107.0
+                and ohlc["candle"]["close"] == 101.0
+                and ohlc["candle"]["high"] == 109.0
