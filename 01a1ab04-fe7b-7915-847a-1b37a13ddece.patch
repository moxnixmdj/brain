+#!/usr/bin/env python3
+"""Generate the value index Project Brain never had.
+
+WHY THIS EXISTS
+---------------
+Five hand-written inventories of this repository were produced in one day and all
+five were wrong within a day -- not from carelessness, but because "every valuable
+thing" was being answered by reading prose, and this tree merges ~36 commits a day
+while its prose lags its code by roughly a day.  The question is only well-posed
+against a frozen commit, and it is derivable rather than writable.
+
+So this derives it.  For one commit it ranks every source path by how much the
+repository's own recorded behaviour depends on it, and it prints the evidence for
+each rank so a reader can disagree with a row instead of with the whole document.
+
+THE FOUR SIGNALS (all local, all deterministic, no network, no model)
+--------------------------------------------------------------------
+  EVIDENCE_CITATIONS  how many of canonical/action_intents/*.json name this path
+                      in agent_orientation.progress_evidence_paths.  This is the
+                      project's own statement, in 780 records, about which files
+                      carry its evidence.
+  TEST_MASS           how many test cases are written against this subject, from
+                      the test file names and their test-definition counts.
+  REGISTRY_BINDING    the path is a bound capability adapter, a registry, or the
+                      practice surface in execution_guard/.
+  EXTERNAL_VERIFIED   a canonical/verification/*PUBLIC_RUNNER_VERIFICATION*.json
+                      record names this path as a subject blob.
+
+THE RANK IS NOT A JUDGEMENT OF QUALITY
+--------------------------------------
+A high rank means: delete this and a number the repository publishes stops being
+producible.  A low rank is not a claim that a file is worthless -- it is a claim
+that nothing measured, cites, or tests it.  Those two are different statements and
+conflating them is how a tree ends up with 2,163 modules and no map.
+
+WHAT THIS CANNOT DO
+-------------------
+It cannot rank a file that is valuable for a reason no artifact records.  It reads
+what the repository says about itself.  It is an index of commitment, not of worth.
+
+Authority: NONE.  Credit: 0.  Uses no model, no network, no spend.
+
+Usage
+  python3 scripts/build_value_index_v1.py                 # print table
+  python3 scripts/build_value_index_v1.py --json OUT      # write machine form
+  python3 scripts/build_value_index_v1.py --md OUT        # write markdown form
+  python3 scripts/build_value_index_v1.py --top 60        # how many rows
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+import collections
+import hashlib
+import json
+import pathlib
+import re
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+SCHEMA = "PROJECT_BRAIN_VALUE_INDEX_V1"
+
+WEIGHTS = {
+    "evidence_citations": 1.0,
+    "test_mass": 0.75,
+    "registry_binding": 2.0,
+    "external_verified": 2.5,
+}
+
+
+def _read_json(path: pathlib.Path):
+    try:
+        return json.loads(path.read_text(encoding="utf-8"))
+    except Exception:
+        return None
+
+
+def _test_mass() -> dict[str, int]:
+    """test cases per subject module, from test file names and their case counts."""
+    out: dict[str, int] = {}
+    tdir = ROOT / "canonical" / "tests"
+    if not tdir.is_dir():
+        return out
+    for path in sorted(tdir.glob("test_*.py")):
+        try:
+            tree = ast.parse(path.read_text(encoding="utf-8", errors="replace"))
+        except Exception:
+            continue
+        cases = 0
+        for node in ast.walk(tree):
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                if node.name.startswith("test_"):
+                    cases += 1
+        if not cases:
+            continue
+        subject = path.stem[5:] if path.stem.startswith("test_") else path.stem
+        out[subject] = out.get(subject, 0) + cases
+    return out
+
+
+def _citations() -> dict[str, int]:
+    """how many action intents name a path as carrying their evidence."""
+    out: collections.Counter = collections.Counter()
+    idir = ROOT / "canonical" / "action_intents"
+    if not idir.is_dir():
+        return dict(out)
+    for path in sorted(idir.glob("*.json")):
+        doc = _read_json(path)
+        if not isinstance(doc, dict):
+            continue
+        block = doc.get("agent_orientation") or {}
+        paths = block.get("progress_evidence_paths") or []
+        if not isinstance(paths, list):
+            continue
+        for p in set(x for x in paths if isinstance(x, str)):
+            out[p] += 1
+    return dict(out)
+
+
+def _registry_paths() -> dict[str, str]:
+    """adapter path -> capability id, for every bound capability."""
+    out: dict[str, str] = {}
+    reg = _read_json(ROOT / "canonical" / "runtime" / "BOUND_CAPABILITY_REGISTRY_V1.json")
+    if not isinstance(reg, dict):
+        return out
+    for cid, entry in (reg.get("capabilities") or {}).items():
+        if not isinstance(entry, dict):
+            continue
+        src = entry.get("source") or {}
+        path = src.get("adapter_path")
+        if isinstance(path, str):
+            out[path] = cid
+    return out
+
+
+def _externally_verified() -> dict[str, int]:
+    """subject path -> number of public-runner verification records naming it."""
+    out: collections.Counter = collections.Counter()
+    vdir = ROOT / "canonical" / "verification"
+    if not vdir.is_dir():
+        return dict(out)
+    blob_re = re.compile(r"[0-9a-f]{40}")
+    for path in sorted(vdir.glob("*PUBLIC_RUNNER_VERIFICATION*.json")):
+        doc = _read_json(path)
+        if not isinstance(doc, dict):
+            continue
+        text = json.dumps(doc)
+        named = set(re.findall(r'"((?:canonical|execution_guard)/[^"]+)"', text))
+        for n in named:
+            out[n] += 1
+    return dict(out)
+
+
+def build(top: int) -> dict:
+    citations = _citations()
+    mass = _test_mass()
+    registry = _registry_paths()
+    verified = _externally_verified()
+
+    rows: dict[str, dict] = {}
+
+    def row(path: str) -> dict:
+        if path not in rows:
+            rows[path] = {
+                "path": path,
+                "evidence_citations": 0,
+                "test_mass": 0,
+                "registry_binding": 0,
+                "external_verified": 0,
+                "capability_id": None,
+                "exists": (ROOT / path).exists(),
+            }
+        return rows[path]
+
+    for path, n in citations.items():
+        row(path)["evidence_citations"] = n
+    for path, cid in registry.items():
+        r = row(path)
+        r["registry_binding"] = 1
+        r["capability_id"] = cid
+    for path, n in verified.items():
+        row(path)["external_verified"] = n
+
+    # test mass attaches to subjects, not paths: resolve a subject to the module it
+    # most plausibly guards by longest shared stem.
+    module_stems: dict[str, list[str]] = collections.defaultdict(list)
+    for base in ("canonical/runtime", "canonical/swe_kernel", "execution_guard"):
+        d = ROOT / base
+        if not d.is_dir():
+            continue
+        for p in d.rglob("*.py"):
+            rel = str(p.relative_to(ROOT))
+            module_stems[pathlib.Path(rel).stem].append(rel)
+    for subject, cases in mass.items():
+        hits = module_stems.get(subject) or []
+        for rel in hits:
+            r = row(rel)
+            r["test_mass"] = max(r["test_mass"], cases)
+
+    for r in rows.values():
+        score = (
+            WEIGHTS["evidence_citations"] * r["evidence_citations"]
+            + WEIGHTS["test_mass"] * r["test_mass"]
+            + WEIGHTS["registry_binding"] * r["registry_binding"]
+            + WEIGHTS["external_verified"] * r["external_verified"]
+        )
+        r["score"] = round(score, 3)
+
+    ranked = sorted(
+        rows.values(),
+        key=lambda r: (-r["score"], -r["evidence_citations"], r["path"]),
+    )
+    ranked = [r for r in ranked if r["score"] > 0]
+    return {
+        "schema": SCHEMA,
+        "authority": "NONE",
+        "credit": 0,
+        "commit": _commit(),
+        "generated_by": "scripts/build_value_index_v1.py",
+        "weights": WEIGHTS,
+        "signals": {
+            "action_intents_read": len(list((ROOT / "canonical" / "action_intents").glob("*.json"))),
+            "paths_cited": len(citations),
+            "test_subjects": len(mass),
+            "registry_adapters": len(registry),
+            "verification_records": len(
+                list((ROOT / "canonical" / "verification").glob("*PUBLIC_RUNNER_VERIFICATION*.json"))
+            ),
+        },
+        "ranked_total": len(ranked),
+        "rows": ranked[:top],
+        "how_to_read": (
+            "Rank = how much the repository's own recorded behaviour depends on this path: "
+            "evidence citations from canonical/action_intents, test mass written against it, "
+            "registry binding, and public-runner verification. A low rank is NOT a claim that a "
+            "file is worthless; it is a claim that nothing measured, cited or tested it. "
+            "Authority NONE; credit 0."
+        ),
+    }
+
+
+def _commit() -> str | None:
+    head = ROOT / ".git" / "HEAD"
+    try:
+        ref = head.read_text(encoding="utf-8").strip()
+        if ref.startswith("ref:"):
+            target = ROOT / ".git" / ref.split(" ", 1)[1].strip()
+            return target.read_text(encoding="utf-8").strip()
+        return ref
+    except Exception:
+        return None
+
+
+def render_md(doc: dict) -> str:
+    lines = [
+        "# Value index — generated, not written",
+        "",
+        f"**Commit `{(doc.get('commit') or 'unknown')[:12]}` · authority {doc['authority']} · credit {doc['credit']}**",
+        "",
+        f"Generated by `{doc['generated_by']}` from {doc['signals']['action_intents_read']} action intents, "
+        f"{doc['signals']['test_subjects']} test subjects, {doc['signals']['registry_adapters']} registry "
+        f"adapters and {doc['signals']['verification_records']} public-runner verification records.",
+        "",
+        "| # | path | score | cites | tests | bound | ext-verified |",
+        "|---:|---|---:|---:|---:|---:|---:|",
+    ]
+    for i, r in enumerate(doc["rows"], 1):
+        lines.append(
+            f"| {i} | `{r['path']}` | {r['score']:.0f} | {r['evidence_citations']} | "
+            f"{r['test_mass']} | {r['registry_binding']} | {r['external_verified']} |"
+        )
+    lines += ["", doc["how_to_read"], ""]
+    return "\n".join(lines)
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description="Generate the repository value index.")
+    ap.add_argument("--top", type=int, default=60)
+    ap.add_argument("--json", default=None)
+    ap.add_argument("--md", default=None)
+    args = ap.parse_args(argv)
+
+    doc = build(args.top)
+    if args.json:
+        p = pathlib.Path(args.json)
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(json.dumps(doc, indent=1, sort_keys=True) + "\n", encoding="utf-8")
+        print(f"wrote {p}")
+    if args.md:
+        p = pathlib.Path(args.md)
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(render_md(doc) + "\n", encoding="utf-8")
+        print(f"wrote {p}")
+
+    print(f"\nVALUE INDEX @ {(doc.get('commit') or '?')[:12]}  authority=NONE  credit=0")
+    print(f"signals: {doc['signals']}")
+    print(f"ranked paths: {doc['ranked_total']}\n")
+    print(f"{'#':>3} {'score':>7} {'cites':>5} {'tests':>5} {'bnd':>3} {'ext':>3}  path")
+    for i, r in enumerate(doc["rows"], 1):
+        print(
+            f"{i:>3} {r['score']:>7.0f} {r['evidence_citations']:>5} {r['test_mass']:>5} "
+            f"{r['registry_binding']:>3} {r['external_verified']:>3}  {r['path']}"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
