@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Do the four terminal contracts actually DETECT their declared mutations?
+
+pass_rule = 100_PERCENT_ON_DECLARED_FINITE_UNIVERSE_AND_ALL_MUTATIONS_DETECTED.
+A scorer that accepts a mutated answer is not a proof, however green the clean run.
+Each declared mutation is applied to the project policy's own correct answer; the
+scorer must reject it (pass=False). Detection rate is the number that matters.
+Authority NONE. Not an independent verification.
+"""
+import sys, json, copy, collections
+sys.path.insert(0, '.')
+from canonical.runtime import contract_native_proof_suites as S
+from canonical.runtime import contract_native_actual_brain_policy_v1 as P
+
+C0 = "STRUCTURED_METHOD_COMPLETE_CALCULATION_GRAPH_001"
+C1 = "TRAJECTORY_CRITICAL_FAILURE_LOCALIZATION_001"
+C2 = "PROFESSIONAL_ARTIFACT_PLAN_AND_QUALITY_JUDGMENT_001"
+C3 = "EVIDENCE_TO_AUDIENCE_SYNTHESIS_001"
+
+def muts(c, cand):
+    m = {}
+    if c == C0:
+        g = cand["graph"]
+        if len(g) > 2:
+            m["DROP_REQUIRED_EDGE"] = {"graph": g[:-1]}
+            m["BYPASS_REQUIRED_INTERMEDIATE"] = {"graph": [g[0], g[-1]]}
+        m["DELETE_REQUIREMENT_TRACE"] = {"graph": []}
+        m["ADD_TYPE_INCONSISTENT_EDGE"] = {"graph": g + [{"factor": "F0", "coefficient": "-1"}]}
+        m["FLIP_COEFFICIENT"] = {"graph": [dict(g[0], coefficient=-g[0]["coefficient"])] + g[1:]}
+    elif c == C1:
+        m["SHIFT_TO_DOWNSTREAM_SYMPTOM"] = dict(cand, cause_step=cand["cause_step"] + 1)
+        m["REMOVE_KEY_INVARIANT"] = {"cause_step": cand["cause_step"], "repair_id": cand["repair_id"], "evidence_steps": []}
+        m["SWAP_CAUSE_EFFECT"] = dict(cand, repair_id="repair_%d" % (cand["cause_step"] + 1))
+        m["DROP_REPAIR"] = {"cause_step": cand["cause_step"], "evidence_steps": cand["evidence_steps"]}
+    elif c == C2:
+        sel = cand["selected_edits"]
+        m["DROP_REQUIRED_EDGE"] = {"selected_edits": sel[:-1]}
+        m["DELETE_REQUIREMENT_TRACE"] = {"selected_edits": []}
+        m["ADD_TYPE_INCONSISTENT_EDGE"] = {"selected_edits": sel + [123]}
+        m["OVERSPEND"] = {"selected_edits": sel + sel[:1]}
+    else:
+        sc = cand["selected_claims"]
+        m["DROP_REQUIRED_EDGE"] = dict(cand, selected_claims=sc[:-1])
+        m["DELETE_REQUIREMENT_TRACE"] = dict(cand, selected_claims=[], uncertainty_claims=[], claim_provenance={})
+        m["ADD_TYPE_INCONSISTENT_EDGE"] = dict(cand, selected_claims=sc + [None])
+        m["STRIP_PROVENANCE"] = dict(cand, claim_provenance={})
+        m["REORDER_AUDIENCE"] = dict(cand, selected_claims=list(reversed(sc)))
+    return m
+
+def main():
+    seeds = int(sys.argv[1]) if len(sys.argv) > 1 else 20
+    det = collections.Counter(); tot = collections.Counter(); byname = collections.Counter()
+    examples = []
+    for c in (C0, C1, C2, C3):
+        for seed in range(seeds):
+            try:
+                case = S.generate_case(c, seed=seed, difficulty=3)
+                cand = P.solve(S.public_task(case))
+                if not S.score_case(case, cand).get("pass"):
+                    continue
+                for name, mut in muts(c, cand).items():
+                    tot[c] += 1; byname[name] += 1
+                    sc = S.score_case(case, mut)
+                    if not sc.get("pass"):
+                        det[c] += 1
+                    elif len(examples) < 6:
+                        examples.append({"contract": c, "seed": seed, "mutation": name,
+                                         "scorer_said": sc})
+            except Exception as e:
+                tot[c] += 1
+    total = sum(tot.values()); detected = sum(det.values())
+    out = {"schema": "PROJECT_BRAIN_CONTRACT_MUTATION_DETECTION_V1", "authority": "NONE",
+           "credit": 0, "independent_verification": False, "seeds": seeds,
+           "mutations_attempted": total, "mutations_detected": detected,
+           "detection_rate": round(detected / total, 4) if total else 0.0,
+           "per_contract": {c: {"attempted": tot[c], "detected": det[c],
+                                "rate": round(det[c] / tot[c], 4) if tot[c] else 0.0}
+                            for c in (C0, C1, C2, C3)},
+           "undetected_examples": examples}
+    print(json.dumps(out, indent=1))
+    json.dump(out, open("canonical/verification/CONTRACT_MUTATION_DETECTION_20261105_V1.json", "w"), indent=1)
+    print("\nwrote canonical/verification/CONTRACT_MUTATION_DETECTION_20261105_V1.json")
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/measure_contract_native_terminal_wave_v1.py b/scripts/measure_contract_native_terminal_wave_v1.py
new file mode 100644
index 00000000..4e06ef4c
--- /dev/null
+++ b/scripts/measure_contract_native_terminal_wave_v1.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Run the four behavioural proof contracts with the project's OWN policy.
+
+The contracts declare a finite universe, an oracle, mutations and a pass rule
+(canonical/governance/FOUR_UNCOVERED_BEHAVIORAL_PROOF_CONTRACTS_V1.json).
+`terminal_results_observed` is 0. This runs them and reports a rate.
+
+Not an independent verification: composite/reducer gate remains UNVERIFIED.
+"""
+import argparse, json, sys, collections
+sys.path.insert(0, '.')
+from canonical.runtime import contract_native_proof_suites as S
+from canonical.runtime import contract_native_actual_brain_policy_v1 as P
+
+CONTRACTS = [
+    "STRUCTURED_METHOD_COMPLETE_CALCULATION_GRAPH_001",
+    "TRAJECTORY_CRITICAL_FAILURE_LOCALIZATION_001",
+    "PROFESSIONAL_ARTIFACT_PLAN_AND_QUALITY_JUDGMENT_001",
+    "EVIDENCE_TO_AUDIENCE_SYNTHESIS_001",
+]
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--seeds", type=int, default=25)
+    ap.add_argument("--out", default=None)
+    a = ap.parse_args()
+    rows = []
+    tally = collections.Counter()
+    per = collections.defaultdict(lambda: [0, 0])
+    for c in CONTRACTS:
+        for seed in range(a.seeds):
+            for d in (1, 3, 5):
+                try:
+                    case = S.generate_case(c, seed=seed, difficulty=d)
+                    cand = P.solve(S.public_task(case))
+                    sc = S.score_case(case, cand)
+                    ok = bool(sc.get("pass"))
+                    rows.append({"contract": c, "seed": seed, "difficulty": d,
+                                 "pass": ok, "reasons": sc.get("reasons", [])})
+                    per[c][0] += 1; per[c][1] += int(ok)
+                    tally["pass" if ok else "fail"] += 1
+                    if not ok:
+                        for r in sc.get("reasons", []) or ["(no reason)"]:
+                            tally["reason:" + str(r)] += 1
+                except Exception as e:
+                    rows.append({"contract": c, "seed": seed, "difficulty": d,
+                                 "pass": False, "error": f"{type(e).__name__}: {e}"})
+                    per[c][0] += 1; tally["error"] += 1
+                    tally["reason:ERROR_" + type(e).__name__] += 1
+    total = tally["pass"] + tally["fail"] + tally["error"]
+    out = {
+        "schema": "PROJECT_BRAIN_CONTRACT_NATIVE_TERMINAL_WAVE_MEASUREMENT_V1",
+        "authority": "NONE", "credit": 0, "independent_verification": False,
+        "policy": "canonical/runtime/contract_native_actual_brain_policy_v1.py",
+        "cases_per_contract": a.seeds * 3,
+        "total_cases": total, "pass": tally["pass"], "fail": tally["fail"],
+        "error": tally["error"],
+        "pass_rate": round(tally["pass"] / total, 4) if total else 0.0,
+        "per_contract": {k: {"cases": v[0], "pass": v[1],
+                             "rate": round(v[1] / v[0], 4) if v[0] else 0.0}
+                         for k, v in per.items()},
+        "tally": dict(tally), "rows": rows,
+    }
+    print(json.dumps({k: v for k, v in out.items() if k != "rows"}, indent=1))
+    if a.out:
+        json.dump(out, open(a.out, "w"), indent=1)
+        print("\nwrote", a.out)
+    return 0
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/measure_unmerged_module_tests_v1.py b/scripts/measure_unmerged_module_tests_v1.py
new file mode 100644
index 00000000..77b2a653
--- /dev/null
+++ b/scripts/measure_unmerged_module_tests_v1.py
@@ -0,0 +1,130 @@
+#!/usr/bin/env python3
+"""Measure how much branch-only work in `brain` actually runs.
+
+Input: a `git clone --mirror` of moxnixmdj/brain (see --mirror).
+Method: for every branch-only module that has a matching branch-only test, extract
+the pair into an isolated tree and run the test.
+
+This is a *lower bound* on how much unmerged work is functional: a pair that fails
+on import needs other branch-only modules and is counted separately, not as broken.
+
+Usage:
+  python3 scripts/measure_unmerged_module_tests_v1.py \
+      --mirror /tmp/brain.git --out /tmp/unmerged_pairs.json [--limit N]
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+MODULE_DIR = "canonical/runtime"
+TEST_DIR = "canonical/tests"
+
+
+def git(repo: str, *args: str, **kw) -> subprocess.CompletedProcess:
+    return subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True, **kw)
+
+
+def main_files(repo: str) -> set[str]:
+    out = git(repo, "ls-tree", "-r", "--name-only", "refs/heads/main")
+    if out.returncode != 0:
+        out = git(repo, "ls-tree", "-r", "--name-only", "HEAD")
+    return {x for x in out.stdout.split("\n") if x}
+
+
+def offmain_objects(repo: str) -> dict[str, str]:
+    """path -> blob sha, for objects reachable only off main."""
+    out = git(repo, "rev-list", "--objects", "--all", "--not", "refs/heads/main")
+    sha: dict[str, str] = {}
+    for line in out.stdout.split("\n"):
+        parts = line.split(" ", 1)
+        if len(parts) == 2:
+            sha.setdefault(parts[1], parts[0])
+    return sha
+
+
+def classify(output: str) -> str:
+    if re.search(r"\d+ passed", output) and not re.search(r"\d+ (failed|error)", output):
+        return "PASS"
+    if re.search(r"\d+ error", output) and not re.search(r"\d+ passed", output):
+        return "IMPORT_ERROR"
+    if re.search(r"\d+ failed", output):
+        return "FAIL"
+    return "OTHER"
+
+
+def run_pair(repo: str, module: str, test: str, blobs: dict[str, str], py: str, timeout: int) -> dict:
+    d = tempfile.mkdtemp(prefix="pair_")
+    try:
+        for sub in ("canonical", MODULE_DIR, TEST_DIR):
+            os.makedirs(os.path.join(d, sub), exist_ok=True)
+            open(os.path.join(d, sub, "__init__.py"), "a").close()
+        for path in (module, test):
+            dest = os.path.join(d, path)
+            os.makedirs(os.path.dirname(dest), exist_ok=True)
+            body = git(repo, "cat-file", "-p", blobs[path]).stdout
+            open(dest, "w").write(body)
+        try:
+            r = subprocess.run(
+                [py, "-m", "pytest", os.path.join(d, test), "-q", "-p", "no:cacheprovider",
+                 "-o", "addopts=", "--tb=no"],
+                cwd=d, capture_output=True, text=True, timeout=timeout,
+            )
+            out = r.stdout + r.stderr
+        except subprocess.TimeoutExpired:
+            return {"module": module, "test": test, "status": "TIMEOUT"}
+        return {"module": module, "test": test, "status": classify(out), "tail": out.strip().split("\n")[-1][:80]}
+    finally:
+        shutil.rmtree(d, ignore_errors=True)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--mirror", default="/tmp/brain.git")
+    ap.add_argument("--out", default="/tmp/unmerged_pairs.json")
+    ap.add_argument("--limit", type=int, default=0)
+    ap.add_argument("--timeout", type=int, default=60)
+    a = ap.parse_args()
+
+    if not os.path.isdir(a.mirror):
+        print(f"mirror not found: {a.mirror} (git clone --mirror <url> {a.mirror})", file=sys.stderr)
+        return 2
+
+    head = main_files(a.mirror)
+    blobs = offmain_objects(a.mirror)
+    only = {p: s for p, s in blobs.items() if p not in head}
+    modules = sorted(p for p in only if p.startswith(MODULE_DIR + "/") and p.endswith(".py"))
+    tests = {os.path.basename(p)[5:-3]: p for p in only if p.startswith(TEST_DIR + "/") and p.endswith(".py")}
+    pairs = [(m, tests[os.path.basename(m)[:-3]]) for m in modules if os.path.basename(m)[:-3] in tests]
+    if a.limit:
+        pairs = pairs[: a.limit]
+    print(f"branch-only modules {len(modules)} | tests {len(tests)} | pairs {len(pairs)}", flush=True)
+
+    py = sys.executable
+    tally: dict[str, int] = {}
+    rows = []
+    t0 = time.time()
+    for i, (m, t) in enumerate(pairs, 1):
+        r = run_pair(a.mirror, m, t, only, py, a.timeout)
+        tally[r["status"]] = tally.get(r["status"], 0) + 1
+        rows.append(r)
+        if i % 100 == 0:
+            print(f"  {i}/{len(pairs)} {tally} ({time.time()-t0:.0f}s)", flush=True)
+
+    doc = {"schema": "PROJECT_BRAIN_UNMERGED_PAIR_MEASUREMENT_V1",
+           "pairs": len(pairs), "tally": tally, "seconds": round(time.time() - t0, 1), "rows": rows}
+    json.dump(doc, open(a.out, "w"), indent=1)
+    print(f"\nfinal: {tally}")
+    print(f"wrote {a.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/partition_assets_v1.py b/scripts/partition_assets_v1.py
new file mode 100644
index 00000000..b373bf7c
--- /dev/null
+++ b/scripts/partition_assets_v1.py
@@ -0,0 +1,273 @@
+#!/usr/bin/env python3
+"""Partition every tracked file at a frozen commit into exactly one class.
+
+The question "is this all of them" cannot be answered by listing valuable things --
+any such list is refutable by one more file. It CAN be answered by a partition:
+every tracked path gets exactly one class, the class counts sum to the tree total,
+and the unclassified set is reported (and must be empty or named).
+
+Value is then a *measured subset* of the partition, not a claim about it.
+
+Signals used for the "value weight" column:
+  cited   -- path appears in any action_intent progress_evidence_paths
+  ranked  -- path appears in value_index rows (score > 0)
+
+Output: counts per class, bytes per class, cited/ranked per class, and the residual.
+
+Usage: python3 scripts/partition_assets_v1.py [--json OUT] [--md OUT]
+"""
+from __future__ import annotations
+
+import argparse
+import collections
+import json
+import os
+import subprocess
+import sys
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+# Ordered rules: first match wins. Each entry is (class_name, predicate).
+# Predicates are simple path/extension tests so the partition is auditable.
+RULES = [
+    ("python-cache", lambda p: "__pycache__" in p or p.endswith(".pyc") or p.startswith(".pytest_cache/")),
+    ("venv", lambda p: "/site-packages/" in p or p.startswith((".venv/", ".brain_venv/"))),
+    ("workflow", lambda p: p.startswith(".github/workflows/")),
+    # Grounding artifacts committed at repo root under a capability id, no extension
+    # (all 1,134 B and all carrying the same payload -- see the residual note in the md).
+    ("root-capability-artifact", lambda p: "/" not in p and p.endswith(".v1")),
+    ("root-empty-probe", lambda p: "/" not in p and p.startswith("gz") and p[2:].isdigit()),
+    ("ci-meta", lambda p: p.startswith(".github/")),
+    ("governance-root", lambda p: p.startswith("governance/")),
+    ("tools", lambda p: p.startswith(("tools/", "swe_probe_"))),
+    ("dotfile-config", lambda p: "/" not in p and p.startswith(".")),
+    ("docs-root", lambda p: "/" not in p and p.endswith((".md", ".txt"))),
+    ("test", lambda p: p.startswith("canonical/tests/")),
+    ("guard", lambda p: p.startswith("execution_guard/")),
+    ("governance", lambda p: p.startswith("canonical/governance/")),
+    ("verification", lambda p: p.startswith("canonical/verification/")),
+    ("evidence", lambda p: p.startswith(("canonical/evidence/", "canonical/action_intents/"))),
+    ("astra-evidence", lambda p: p.startswith("canonical/astra_runtime/evidence/")),
+    ("astra-tmp", lambda p: p.startswith("canonical/astra_runtime/tmp/")),
+    ("state", lambda p: p.startswith(("canonical/runtime/state/", "canonical/astra_runtime/state/"))),
+    ("astra-artifacts", lambda p: p.startswith("canonical/astra_runtime/artifacts/")),
+    ("astra-runtime", lambda p: p.startswith("canonical/astra_runtime/") and p.endswith(".py")),
+    ("capabilities", lambda p: p.startswith("canonical/capabilities/")),
+    ("kernel-code", lambda p: p.startswith("canonical/swe_kernel/") and p.endswith(".py")),
+    ("runtime-code", lambda p: p.startswith("canonical/runtime/") and p.endswith(".py")),
+    ("unified-model", lambda p: p.startswith("canonical/unified_model/")),
+    ("requirements", lambda p: p.startswith("requirements/")),
+    ("scripts", lambda p: p.startswith("scripts/")),
+    ("canonical-other", lambda p: p.startswith("canonical/")),
+    ("py-other", lambda p: p.endswith(".py")),
+    ("data-other", lambda p: p.endswith((".json", ".jsonl", ".csv", ".yaml", ".yml"))),
+]
+
+
+def classify(path: str) -> str:
+    for name, pred in RULES:
+        if pred(path):
+            return name
+    return "UNCLASSIFIED"
+
+
+def tracked() -> list[str]:
+    out = subprocess.run(["git", "ls-files"], cwd=REPO, capture_output=True, text=True, check=True)
+    return [ln for ln in out.stdout.splitlines() if ln]
+
+
+def present_files() -> dict[str, str]:
+    """Every file present in the working tree, with provenance.
+
+    The tracked-only partition was exact but not complete: 178 ignored files and
+    any untracked litter are real bytes on disk that no tracked-path census sees.
+    """
+    out: dict[str, str] = {}
+    for f in tracked():
+        out[f] = "tracked"
+    for flag, prov in ((("--others", "--ignored", "--exclude-standard"), "ignored"),
+                       (("--others", "--exclude-standard"), "untracked")):
+        r = subprocess.run(["git", "ls-files", *flag, "-z"], cwd=REPO, capture_output=True, text=True)
+        for f in r.stdout.split("\0"):
+            if f:
+                out[f] = prov
+    return out
+
+
+def cited_paths() -> set[str]:
+    """Paths named in any action intent's progress evidence."""
+    hits: set[str] = set()
+    root = os.path.join(REPO, "canonical", "action_intents")
+    if not os.path.isdir(root):
+        return hits
+    for name in os.listdir(root):
+        if not name.endswith(".json"):
+            continue
+        try:
+            doc = json.load(open(os.path.join(root, name)))
+        except Exception:
+            continue
+        stack = [doc]
+        while stack:
+            node = stack.pop()
+            if isinstance(node, dict):
+                for k, v in node.items():
+                    if k in ("progress_evidence_paths", "evidence_paths") and isinstance(v, list):
+                        hits.update(x for x in v if isinstance(x, str))
+                    else:
+                        stack.append(v)
+            elif isinstance(node, list):
+                stack.extend(node)
+    return hits
+
+
+def ranked_paths() -> set[str]:
+    p = os.path.join(REPO, "canonical", "verification", "VALUE_INDEX_GENERATED_20261105_V1.json")
+    if not os.path.exists(p):
+        return set()
+    try:
+        return {r["path"] for r in json.load(open(p)).get("rows", [])}
+    except Exception:
+        return set()
+
+
+def build() -> dict:
+    pres = present_files()
+    files = sorted(pres)
+    cited = cited_paths()
+    ranked = ranked_paths()
+    classes: dict[str, dict] = collections.OrderedDict()
+    unclassified: list[str] = []
+    for f in files:
+        cls = classify(f)
+        if cls == "UNCLASSIFIED":
+            unclassified.append(f)
+        d = classes.setdefault(cls, {"files": 0, "bytes": 0, "cited": 0, "ranked": 0,
+                                     "tracked": 0, "ignored": 0, "untracked": 0, "samples": []})
+        d["files"] += 1
+        d[pres[f]] += 1
+        try:
+            d["bytes"] += os.path.getsize(os.path.join(REPO, f))
+        except OSError:
+            pass
+        if f in cited:
+            d["cited"] += 1
+        if f in ranked:
+            d["ranked"] += 1
+        if len(d["samples"]) < 3:
+            d["samples"].append(f)
+    total = sum(d["files"] for d in classes.values())
+
+    # Residual finding: identical payloads committed under different capability names.
+    import hashlib
+
+    by_md5: dict[str, list[str]] = collections.defaultdict(list)
+    for f in files:
+        if classify(f) == "root-capability-artifact":
+            try:
+                by_md5[hashlib.md5(open(os.path.join(REPO, f), "rb").read()).hexdigest()].append(f)
+            except OSError:
+                pass
+    dupes = {h: ps for h, ps in by_md5.items() if len(ps) > 1}
+    duplicate_artifacts = []
+    for h, ps in dupes.items():
+        try:
+            body = json.load(open(os.path.join(REPO, ps[0])))
+        except Exception:
+            body = {}
+        duplicate_artifacts.append({
+            "md5": h,
+            "names": sorted(ps),
+            "declared_capability_id": body.get("capability_id"),
+            "pass": (body.get("cegis") or {}).get("pass"),
+            "terminal_credit": (body.get("cegis") or {}).get("terminal_credit"),
+        })
+
+    prov = collections.Counter(pres.values())
+    return {
+        "duplicate_root_artifacts": duplicate_artifacts,
+        "present_files": len(pres),
+        "provenance": dict(prov),
+        "present_bytes": sum(d["bytes"] for d in classes.values()),
+        "schema": "PROJECT_BRAIN_ASSET_PARTITION_V1",
+        "commit": subprocess.run(["git", "rev-parse", "HEAD"], cwd=REPO, capture_output=True, text=True).stdout.strip()[:12],
+        "authority": "NONE",
+        "credit": 0,
+        "tracked_files": len(files),
+        "partition_total": total,
+        "partition_exact": total == len(files),
+        "unclassified": {"count": len(unclassified), "paths": unclassified[:40]},
+        "cited_by_any_intent": len([f for f in files if f in cited]),
+        "ranked_by_value_index": len([f for f in files if f in ranked]),
+        "classes": classes,
+    }
+
+
+def render_md(doc: dict) -> str:
+    rows = sorted(doc["classes"].items(), key=lambda kv: -kv[1]["files"])
+    L = []
+    L.append("# Asset partition — every tracked file, one class each\n")
+    L.append(f"**Commit `{doc['commit']}` · authority NONE · credit 0**\n")
+    L.append(f"Present in the working tree: **{doc.get('present_files')}** files / "
+             f"**{doc.get('present_bytes',0)/1e6:.1f} MB** — {doc.get('provenance')}\n")
+    L.append(f"Tracked files: **{doc['tracked_files']}** · partitioned (present): **{doc['partition_total']}** · "
+             f"exact: **{doc['partition_exact']}** · unclassified: **{doc['unclassified']['count']}**\n")
+    L.append(f"Cited as evidence by any action intent: **{doc['cited_by_any_intent']}** "
+             f"({doc['cited_by_any_intent']/max(1,doc['tracked_files'])*100:.1f}% of the tree)  ")
+    L.append(f"Carrying a nonzero value-index score: **{doc['ranked_by_value_index']}** "
+             f"({doc['ranked_by_value_index']/max(1,doc['tracked_files'])*100:.1f}%)\n")
+    L.append("| class | files | tracked | ignored | MB | cited | ranked |")
+    L.append("|---|---:|---:|---:|---:|---:|---:|")
+    for name, d in rows:
+        L.append(f"| `{name}` | {d['files']} | {d.get('tracked',0)} | {d.get('ignored',0)} | "
+                 f"{d['bytes']/1e6:.1f} | {d['cited']} | {d['ranked']} |")
+    L.append(f"| **total** | **{doc['partition_total']}** | "
+             f"**{sum(d['bytes'] for _,d in rows)/1e6:.1f}** | "
+             f"**{sum(d['cited'] for _,d in rows)}** | **{sum(d['ranked'] for _,d in rows)}** |")
+    if doc.get("duplicate_root_artifacts"):
+        L.append("\n## Residual finding: one receipt, seven capability names\n")
+        for d in doc["duplicate_root_artifacts"]:
+            L.append(f"**{len(d['names'])} tracked files, identical md5 `{d['md5'][:12]}`**, "
+                     f"all declaring `capability_id = {d['declared_capability_id']}`, "
+                     f"`pass = {d['pass']}`, `terminal_credit = {d['terminal_credit']}`:\n")
+            L.extend(f"- `{n}`" for n in d["names"])
+            L.append("\nEach is cited as evidence for the capability its *filename* names, while its")
+            L.append("*content* reports a failed run of a different capability. The receipt is honest;")
+            L.append("the filenames are not the receipt's subject.\n")
+    if doc["unclassified"]["count"]:
+        L.append("\n## Unclassified residual\n")
+        L.extend(f"- `{p}`" for p in doc["unclassified"]["paths"])
+    L.append("\n**Reading this table.** The partition is exhaustive by construction: the classes sum to the")
+    L.append("tracked file count, so no file is outside the answer. The `cited` and `ranked` columns are the")
+    L.append("measured part: they say which files the repository itself treats as load-bearing. Nothing in")
+    L.append("this table claims that a file is valuable — only that it exists, what it is, and whether the")
+    L.append("project ever cited it.")
+    return "\n".join(L) + "\n"
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--json")
+    ap.add_argument("--md")
+    a = ap.parse_args()
+    doc = build()
+    if a.json:
+        json.dump(doc, open(a.json, "w"), indent=1)
+        print("wrote", a.json)
+    if a.md:
+        open(a.md, "w").write(render_md(doc))
+        print("wrote", a.md)
+    print(f"\npresent={doc.get('present_files')} provenance={doc.get('provenance')} "
+          f"present_MB={doc.get('present_bytes',0)/1e6:.1f}")
+    print(f"tracked={doc['tracked_files']} partitioned={doc['partition_total']} "
+          f"exact={doc['partition_exact']} unclassified={doc['unclassified']['count']}")
+    print(f"cited={doc['cited_by_any_intent']} ranked={doc['ranked_by_value_index']}")
+    for name, d in sorted(doc["classes"].items(), key=lambda kv: -kv[1]["files"]):
+        print(f"  {d['files']:6d}  {d['bytes']/1e6:8.1f} MB  cited={d['cited']:4d}  {name}")
+    if doc["unclassified"]["count"]:
+        print("\nUNCLASSIFIED:", *doc["unclassified"]["paths"][:20], sep="\n  ")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
