__pycache__/
.guard_trusted/

# Litter written by the test suite into tracked directories.  Running
# `pytest canonical/tests` once creates ~470 of these; `git add -A` afterwards
# would commit them as if they were evidence.  (Added 2026-10-14, see
# canonical/governance/REPO_INTEGRITY_POLICY_V1.json.)  Files already tracked
# under canonical/astra_runtime/tmp/ are unaffected by this rule.
canonical/astra_runtime/tmp/
canonical/astra_runtime/evidence/GROUNDING-*
canonical/astra_runtime/evidence/TEST-BOUND-*
canonical/astra_runtime/state/LIVE_BRAIN_*
canonical/astra_runtime/state/probe-*
canonical/runtime/r3_learning_verification_receipts/
canonical/runtime/SELF_IMPROVEMENT_STATE_V1.json

# Environments this system created. Never part of the project.
.brain_venv/
.venv/

# derived cache: rebuilt from MODULE_INVOCATION_EVIDENCE_V1.json in ~80ms
canonical/runtime/state/module_bridge_index_v1.json

# Practice environments the machine downloads to work against.
# Not part of the project, and their own conftest.py is not ours to police.
canonical/astra_runtime/state/real_env/

# Heartbeat run artifacts: the receipt and the job summary are published by the
# live-brain-heartbeat workflow (upload-artifact), not versioned as source.  The
# controller checkpoints one heartbeat run leaves behind are run litter, same as
# the test-suite litter above.
heartbeat_out/
canonical/astra_runtime/state/E2E_*

# The long-horizon continuity capability writes its report into the repository
# root when it runs.  It is run litter, not source: `git add -A` must never
# commit it as if it were evidence.
LONG_HORIZON_CONTINUITY_REPORT.json
# Litter from MEASURING the door, not from the door.  A probe run writes its scratch worlds
# under canonical/astra_runtime/tmp/ (already ignored), but the controller checkpoints, the
# composer's tmp JSON and the generated smoke modules land OUTSIDE it, and `git add -A` after
# a run committed 64k lines of them as if they were evidence.  Measured 2026-10-28: 35 of 40
# files in one automatic commit were run output.
canonical/astra_runtime/state/*CONTROLLER_CHECKPOINT.json
canonical/tmp_*.json
generated_tests/
tmp/
gz[0-9]*
