+def test_cov_weighted_det_normalization_small_k():
+    rs = np.random.RandomState(1234)
+    x = rs.standard_normal((80, 4))
+    weights = np.linspace(0.5, 1.5, len(x))
+    center = weights.dot(x) / weights.sum()
+    xdm = x - center
+    crossprod = (weights * xdm.T).dot(xdm)
+    expected = crossprod / np.linalg.det(crossprod) ** (1 / x.shape[1])
+
+    cov, _ = robcov.cov_weighted(x, weights, weights_cov_denom="det")
+
+    assert_allclose(cov, expected, rtol=1e-13, atol=1e-13)
+    assert_allclose(np.linalg.slogdet(cov), (1, 0), atol=1e-12)
+
