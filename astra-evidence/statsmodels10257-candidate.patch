+def test_cov_weighted_det_normalization_large_k():
+    rs = np.random.RandomState(0)
+    x = rs.standard_normal((301, 149))
+    weights = np.ones(len(x))
+    cov, _ = robcov.cov_weighted(x, weights, weights_cov_denom="det")
+
+    assert np.isfinite(cov).all()
+    sign, logdet = np.linalg.slogdet(cov)
