FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN rm -f /etc/apt/apt.conf.d/docker-no-languages \
 && apt-get update -o Acquire::Languages=en \
 && apt-get install -y --no-install-recommends \
      apt-file \
      ca-certificates \
      curl \
      gzip \
      bzip2 \
      xz-utils \
      python3 \
      python3-xapian \
      sudo \
      zbar-tools \
 && apt-file update

WORKDIR /work
COPY . /work
RUN chmod 0755 /work/heldout003-carrier.sh

CMD ["/work/heldout003-carrier.sh"]
