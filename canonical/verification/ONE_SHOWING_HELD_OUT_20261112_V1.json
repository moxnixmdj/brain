    {
     "path": "src/bloqade/core/device/task_builder.py",
     "bytes": 13567,
     "rules": [
      "\"\"\"Incrementally assemble subtasks before finalizing them for a device.\"\"\" -> \"\"\"Canonical API for constructing workloads submitted through a device. Add kernel invocations with ``add_subtask()``, then pass the builder to ``Device.run_async()``. The builder owns the ordered programs, arguments, metadata, and shot counts; the device owns backend-specific validation and serialization. Builders are mutable and append-only. Adding the same ``ir.Method`` object more than once creates multiple subtasks that reuse one program entry. Finalization does not mutate the builder, so it may be inspected, copied, extended, dry-run, or submitted again. ``Device.task()``, ``Device.batch_task()``, and ``Device.parameter_scan()`` are deprecated task-construction APIs. New code should use ``TaskBuilder`` for single kernels, batches, and parameter scans. \"\"\"",
      "\"\"\"Return a shallow, independently editable copy of this builder.\"\"\" -> \"\"\"Return a shallow, independently editable copy of this builder. The mutable program, subtask, and name-index containers are copied, so later calls to ``add_subtask()`` affect only the copy. Existing kernel objects and subtask records are shared rather than deep-copied. Returns: TaskBuilder: Builder containing the same programs and subtasks. \"\"\""
     ],
