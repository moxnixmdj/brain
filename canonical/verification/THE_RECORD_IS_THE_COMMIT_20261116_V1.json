  "the_residual_it_closes": "the previous round's commit was one atomic step only where renameat2(RENAME_EXCHANGE) exists, and a two-rename window everywhere else",
  "the_falsifier_it_runs": "if a record-based commit cannot recover byte-exactly from a crash between two single-path renames, multi-path commits have no sound portable implementation",
  "reused_not_rebuilt": [
   "canonical/runtime/root3_typed_durable_admin_write_v1.py (write -> fsync(file) -> rename -> fsync(parent), pre-state binding)",
   "canonical/runtime/canonical_apply_transaction_v1.py (staged overlay, preimage receipts, commit eligibility)",
   "canonical/tools/the_failed_attempt_is_free_v1.py (stage, digest, remove)",
   "canonical/tools/the_check_mode_is_the_oracle_v1.py (state digest, tree removal)"
  ]
 },
 "criteria_were_declared_after_a_prototype_probe": false,
 "criterion_refinement_after_the_first_run": {
  "what_the_draft_criterion_said": "with the record, a crash at EVERY boundary recovers to the target",
  "what_the_first_run_showed": "8/9 recovered; the single exception was `before_journal`, where the record does not exist yet by construction and the tree is still the pre-state",
  "why_the_refinement_is_a_strengthening_not_a_relaxation": "it replaces one undifferentiated count with three buckets, each with its own asserted outcome, so a pre-record crash must ALSO prove the tree is untouched and that no record exists -- a draft failure would have been silent about the pre-state",
  "no_measured_boundary_was_dropped": true
 },
 "declared_acceptance_before_the_receipt_run": {
  "K1": "without a record, at least one crash boundary leaves a tree that is neither the pre-state nor the target, and there is no record to recover from",
  "K2": "with the record, every commit-crash boundary recovers to the target byte-exactly",
  "K3": "a crash inside recovery, at every step, followed by recovery again, still reaches the target byte-exactly",
  "K4": "with no crash the commit is byte-exact, leaves no record, no stage and no temp file",
  "K5": "every replace is fsync(file) -> rename -> fsync(dir), in that order, traced",
  "K6": "zero model calls, zero parameters, zero network"
 },
