 "the_law": {
  "trial_and_error_is_sound_iff_failure_is_free": true,
  "what_is_free": "an attempt that is refused, because the live tree was never touched",
  "what_is_not_free": "the commit, which is one rename: atomic where the filesystem can exchange two populated paths, a window everywhere else",
  "what_is_not_stageable": "an effect outside the tree (network, processes, absolute paths, another user's files); these ten actions are confined, which is a scope and not a proof",
  "why_this_removes_the_previous_limit": "the five actions no check mode could guard are decided by attempt at the same accuracy as the five that could, so the census of readable checks stops being the ceiling"
 },
 "concurrency_boundary": {
  "declared": "the agent owns the live path; a same-UID writer that replaces it between the check and the exchange is outside the contract",
  "evidence": "harness-evolver #124 (Sep 2026): exchange-then-validate is not a compare-and-swap, and a displaced concurrent write can be lost",
  "consequence": "the receipt does not claim cas semantics; it claims free refusal and exact undo for a workspace the agent owns"
 },
 "cost": {
  "seconds": 9.2,
  "model_calls": 0,
  "parameters_stored": 0,
  "network_calls_at_run_time": 0
 },
 "limits": [
  "ten actions, one filesystem (ext2/3 in this sandbox), one producer; the census is a count on these",
  "staging copies the tree; the amplification is measured, and a cheap copy (reflink, hardlink farm, CoW snapshot) would lower it without changing the law",
  "the exchange is not a compare-and-swap under uncooperative writers; the boundary above",
  "an effect that escapes the tree is not undoable here",
  "a refused commit leaves the stage built and verified; discarding it is the caller's step",
  "on tar_extract the commit's effect is zero entries, because extraction of this archive over this tree is idempotent (the previous round had to arm the family to make the effect visible); the attempt still decides correctly, which is the point of deciding by attempt rather than by reading the effect"
 ]
}
