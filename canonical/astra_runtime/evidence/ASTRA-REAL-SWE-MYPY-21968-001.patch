diff --git a/mypy/checkpattern.py b/mypy/checkpattern.py
index 9d02262..cfc503c 100644
--- a/mypy/checkpattern.py
+++ b/mypy/checkpattern.py
@@ -359,20 +359,24 @@ class PatternChecker(PatternVisitor[PatternType]):
             else:
                 new_type = TupleType(new_inner_types, current_type.partial_fallback)
 
-            num_always_match = sum(is_uninhabited(typ) for typ in rest_inner_types)
-            if num_always_match == len(rest_inner_types):
-                # All subpatterns always match, so we can apply negative narrowing
-                rest_type = UninhabitedType()
-            elif num_always_match == len(rest_inner_types) - 1:
-                # Exactly one subpattern may conditionally match, the rest always match.
-                # We can apply negative narrowing to this one position.
-                rest_type = TupleType(
-                    [
-                        curr if is_uninhabited(rest) else rest
-                        for curr, rest in zip(inner_types, rest_inner_types)
-                    ],
-                    current_type.partial_fallback,
-                )
+            # Partition the complement by the first subpattern that fails.
+            # This stays linear while preserving negative narrowing when
+            # multiple tuple elements are conditional.
+            rest_cases: list[Type] = []
+            prefix_can_match = True
+            for i, (matched, rest) in enumerate(zip(new_inner_types, rest_inner_types)):
+                if not prefix_can_match:
+                    break
+                if not is_uninhabited(rest):
+                    case_items = [*new_inner_types[:i], rest, *inner_types[i + 1 :]]
+                    if not any(is_uninhabited(item) for item in case_items):
+                        rest_cases.append(TupleType(case_items, current_type.partial_fallback))
+                if is_uninhabited(matched):
+                    prefix_can_match = False
+
+            rest_type = (
+                make_simplified_union(rest_cases) if rest_cases else UninhabitedType()
+            )
         elif isinstance(current_type, TupleType):
             # For variadic tuples it is too tricky to match individual items like for fixed
             # tuples, so we instead try to narrow the entire type.
