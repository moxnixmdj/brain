{
  "schema": "PROJECT_BRAIN_WHITE_BOX_CAPABILITY_CAPSULE_V2",
  "status": "SCHEMA_TEMPLATE__MANDATORY_FOR_HARVESTED_CAPABILITY_PROMOTION",
  "supersedes": [
    "canonical/governance/WHITE_BOX_CAPABILITY_CAPSULE_SCHEMA_V1.json"
  ],
  "authority": [
    "canonical/laws/FRONTIER_KNOWLEDGE_CAPABILITY_INTERNALIZATION_MISSION_LOCK_V9.md",
    "canonical/laws/CAPABILITY_ACQUISITION_ENGINE_LAW_V8.md",
    "canonical/laws/WHITE_BOX_CAPABILITY_HARVESTING_LAW_V2.md",
    "canonical/laws/RESOURCE_BOUNDED_CAPABILITY_BYTES_LAW_V1.md"
  ],
  "required_fields": [
    "capability_id",
    "residual_capability_contract",
    "frontier_bar",
    "donor",
    "license_and_provenance",
    "extraction_class",
    "brain_owned_operative_artifacts",
    "unavoidable_runtime_dependencies",
    "full_dependency_footprint",
    "causal_evidence",
    "heldout_generalization_evidence",
    "specificity_and_interference_controls",
    "donor_deletion_evidence",
    "elicitation_scan_evidence",
    "latent_vs_taught_classification",
    "minimization_evidence",
    "byte_accounting",
    "resource_bounds",
    "shared_substrate_accounting",
    "mechanism_cover_membership",
    "invocation_contract",
    "resource_requirements",
    "verifier",
    "recovery_and_fallback",
    "hashes",
    "promotion_status"
  ],
  "donor": {
    "required": [
      "identity",
      "version_or_commit",
      "weight_or_artifact_hashes",
      "inspectability_basis",
      "temporary_role"
    ],
    "temporary_role_must_equal": "CAUSAL_SOURCE_NOT_PROMOTED_RUNTIME_TARGET_CAPABILITY_PROVIDER"
  },
  "license_and_provenance": {
    "required": [
      "source",
      "license",
      "derivative_use_assessment",
      "redistribution_assessment",
      "provenance_chain"
    ],
    "fail_closed_on_unclear_rights": true
  },
  "allowed_extraction_classes": [
    "CHECKPOINT_OR_TASK_VECTOR_DELTA",
    "SPARSE_WEIGHT_DELTA",
    "LOW_RANK_ADAPTER",
    "MOE_EXPERT_OR_MODULE_SUBSET",
    "LAYER_HEAD_OR_CIRCUIT_SUBSET",
    "DISTILLED_RESIDUAL_MODEL_OR_MODULE",
    "EXPLICIT_ALGORITHM_OR_PROCEDURE",
    "COMPOSITION"
  ],
  "causal_evidence": {
    "required": [
      "donor_positive_control",
      "ablation",
      "rescue",
      "specificity"
    ],
    "ablation_and_rescue_matched_conditions_required": true,
    "correlation_only_insufficient": true
  },
  "heldout_generalization_evidence": {
    "final_examples_used_for_selection_or_tuning_forbidden": true,
    "contamination_statement_required": true
  },
  "donor_deletion_evidence": {
    "required": true,
    "rule": "PROMOTED_TARGET_CAPABILITY_MUST_REMAIN_AVAILABLE_WITH_DONOR_REMOVED_AS_TARGET_CAPABILITY_PROVIDER"
  },
  "elicitation_scan_evidence": {
    "required": true,
    "search_order": [
      "ZERO_NEW_BYTES",
      "DETERMINISTIC_CONFIGURATION_OR_ROUTER",
      "TINY_CONTROL_OR_ELICITATION_ARTIFACT",
      "SPARSE_OR_LOW_RANK_RESIDUAL",
      "COMPACT_LEARNED_MODULE",
      "LARGER_ONLY_AFTER_SMALLER_CLASSES_FAIL"
    ],
    "latent_vs_taught_is_search_signal_not_minimality_proof": true
  },
  "full_dependency_footprint": {
    "hidden_base_model_or_service_dependency_forbidden": true,
    "count_all_unavoidable_learned_and_runtime_dependencies": true
  },
  "byte_accounting": {
    "required": true,
    "components": [
      "values",
      "mask_or_indices",
      "router",
      "decoder_or_loader",
      "unavoidable_base",
      "configuration",
      "persistent_control_state"
    ],
    "separate_metrics": [
      "B_exec",
      "B_verify",
      "B_proof",
      "B_JIT"
    ],
    "shared_artifacts_count_once": true,
    "marginal_bytes_must_not_be_confused_with_terminal_shared_substrate_bytes": true
  },
  "resource_bounds": {
    "required": true,
    "dimensions": [
      "latency",
      "ram",
      "compute",
      "reliability",
      "incremental_spend"
    ]
  },
  "minimization_evidence": {
    "required": true,
    "deletion_dimensions": [
      "experts",
      "ranks",
      "layers",
      "heads",
      "precision",
      "prompt_scaffolding",
      "context_requirements",
      "auxiliary_learned_modules",
      "incidental_package_dependencies",
      "duplicated_shared_substrate"
    ],
    "first_irreducible_failure_loop_record_required_when_teaching_or_distillation_used": true,
    "stop_rule": "MINIMUM_TOTAL_DURABLE_RESOURCE_COST_SUBJECT_TO_CAPABILITY_AND_OPERATIONAL_BOUNDS"
  },
  "mechanism_cover_membership": {
    "exact_global_optimum_claim_allowed_only_over_enumerated_eligible_library": true,
    "universal_shortest_program_claim_forbidden": true
  },
  "promotion_status_values": [
    "CANDIDATE",
    "CAUSALLY_VALIDATED",
    "BRAIN_CONFIGURED_VERIFICATION_PENDING",
    "VERIFIED_OWNED_EQUAL_OR_BETTER",
    "REJECTED_OR_REOPENED"
  ],
  "no_progress_from_schema_or_capsule_creation_alone": true
}
