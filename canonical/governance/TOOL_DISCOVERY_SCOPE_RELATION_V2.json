  "formal_lemmas": [
    {
      "id": "L1_FINITE_ORDER",
      "statement": "Every eligible declared tool is placed in one deterministic total order by declared cost then tool id."
    },
    {
      "id": "L2_MONOTONE_PROBE_PROGRESS",
      "statement": "A PROBE action is emitted only for a current-epoch required capability whose evidence state is unknown for the current candidate tool; a sound probe therefore converts one unknown pair to true or false and never repeats that pair in the same epoch."
    },
    {
      "id": "L3_FALSE_ELIMINATION",
      "statement": "Any tool with a current negative receipt for any required capability is skipped and can never be selected in that stage."
    },
    {
      "id": "L4_POSITIVE_SELECTION",
      "statement": "A tool is selected only after every required capability has current positive evidence."
    },
    {
      "id": "L5_LEAST_COST_SUFFICIENCY",
      "statement": "Because tools are considered in increasing cost/id order, every cheaper predecessor has been either proved insufficient or made ineligible before the first fully proved sufficient tool is selected; selection is therefore least-cost among sufficient eligible routes."
    },
    {
      "id": "L6_FINITE_TERMINATION",
      "statement": "There are finitely many current-epoch tool/capability pairs. Each probe resolves one previously unknown pair, so after at most |eligible tools| times |required capabilities| probes the policy selects a least-cost sufficient tool or exhausts every eligible tool."
    },
    {
      "id": "L7_SOUND_ESCALATION",
      "statement": "If no sufficient eligible route exists, finite probe progress eventually gives every eligible tool at least one negative required-capability fact and the policy escalates only after the ordered tool scan is exhausted."
    },
    {
      "id": "L8_TRANSFER_AND_STALENESS",
      "statement": "Current-epoch receipts are reused across later tasks, while a public version change advances only the changed tool epoch and makes its older receipts non-current, forcing rediscovery only where evidence became stale."
    },
    {
      "id": "L9_POINTWISE_CEILING",
      "statement": "For every valid finite frozen-protocol case, least-cost sufficient route selection or sound no-route escalation is the exact terminal correctness ceiling for the declared route-selection contract; the policy reaches that ceiling without unsupported capability promotion."
    }
  ],
