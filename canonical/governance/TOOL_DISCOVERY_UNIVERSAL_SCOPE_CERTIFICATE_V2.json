    {
      "id": "L1_SCOPE_SEMANTICS",
      "statement": "The frozen family protocol accepts on tool ecosystems with hidden capability variants; the terminal binding makes tool identities/costs candidate-visible and hides the capability matrix; the registry describes unknown/changing capabilities over available tools. Therefore the current frozen protocol does not require arbitrary hidden tool-identity enumeration."
    },
    {
      "id": "L2_FINITE_PROGRESS_MEASURE",
      "statement": "For a fixed stage, the unresolved current-epoch evidence set is a finite subset of eligible-tool times required-capability pairs. Each PROBE targets one unknown pair and a sound probe removes that pair from the unresolved set."
    },
    {
      "id": "L3_TERMINATION",
      "statement": "Because the unresolved-pair measure strictly decreases on every probe, the policy terminates after at most |eligible tools| times |required capabilities| probes before SELECT or ESCALATE."
    },
    {
      "id": "L4_SUFFICIENCY",
      "statement": "The policy selects a tool only when current positive evidence exists for every required capability, so a selected route is sufficient."
    },
    {
      "id": "L5_LEAST_COST",
      "statement": "Eligible tools are processed in increasing declared cost then tool-id order; each cheaper predecessor is skipped only after current negative evidence. Therefore the first selected sufficient route is minimum declared cost among all sufficient eligible routes."
    },
    {
      "id": "L6_NO_ROUTE",
      "statement": "If no sufficient eligible route exists, every eligible tool eventually obtains a current negative required-capability fact, the scan exhausts, and the policy escalates. Sound evidence prevents a sufficient route from being falsely eliminated."
    },
    {
      "id": "L7_TRANSFER",
      "statement": "Current-epoch probe receipts persist across later tasks, so unchanged capability knowledge transfers without rediscovery."
    },
    {
      "id": "L8_STALENESS",
      "statement": "A public tool version change advances that tool epoch; old receipts no longer enter the evidence map, so stale support cannot justify selection after a change."
    },
    {
      "id": "L9_POINTWISE_TERMINAL_CEILING",
      "statement": "Inside the frozen declared-tool contract, least-cost sufficient route selection or correct no-route escalation is pointwise terminal correctness. Thus every valid finite case reaches the route-selection ceiling without relying on the 180-case sample."
    }
