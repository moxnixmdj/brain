  "inference_contract": {
    "source_repository": "vis-nlp/UniChart",
    "source_readme_path": "README.md",
    "source_readme_git_blob_sha": "96bc9ef8fbb84058a4d0e6d07d3500341bfc81ff",
    "transformers_version": "4.28.1",
    "processor": "DonutProcessor",
    "model": "VisionEncoderDecoderModel",
    "prompt_template": "<chartqa> {question} <s_answer>",
    "output_postprocess": [
      "DECODE_FIRST_GENERATED_SEQUENCE",
      "REMOVE_TOKENIZER_EOS_TOKEN",
      "REMOVE_TOKENIZER_PAD_TOKEN",
      "SPLIT_ON_<s_answer>",
      "TAKE_SUFFIX_AND_STRIP"
    ],
    "num_beams": 4,
    "use_cache": true,
    "bad_words": "TOKENIZER_UNK_TOKEN",
    "max_length": "MODEL_DECODER_MAX_POSITION_EMBEDDINGS",
    "deterministic_generation": true
  },
  "scorer": {
    "name": "CHARTQA_RELAXED_ACCURACY",
    "text_rule": "CASE_INSENSITIVE_STRIPPED_EXACT_MATCH",
    "numeric_rule": "ABS(PRED-GOLD)/ABS(GOLD)<=0.05__ZERO_GOLD_REQUIRES_EXACT_ZERO",
    "public_basis": "ChartQA reports relaxed accuracy allowing numerical error within 5 percent."
  },
  "pass_gate": {
    "minimum_fp32_relaxed_accuracy": 0.5,
    "packed_noninferiority_margin_absolute": 0.05,
    "packed_relaxed_accuracy_condition": "PACKED_ACCURACY >= FP32_ACCURACY - 0.05",
    "packed_vs_fp32_answer_agreement_minimum": 0.85,
    "byte_condition": "COMPLETE_PACKED_RUNTIME_BUNDLE <= 100000000_BYTES",
    "conjunctive": true
  },
  "anti_selection_bias": [
    "ALL_20_CASES_FROZEN_BEFORE_ANY_PACKED_MODEL_OUTPUT_IS_OBSERVED",
    "NO_CASE_DELETION_AFTER_OUTCOMES",
    "NO_PROMPT_OR_SCORER_CHANGE_AFTER_OUTCOMES",
    "FP32_AND_PACKED_SUBJECTS_USE_IDENTICAL_IMAGES_PROMPTS_DECODING_AND_SCORER",
    "NO_CHARTOGRAPHY_TERMINAL_CASES"
  ],
  "hard_nonclaims": [
