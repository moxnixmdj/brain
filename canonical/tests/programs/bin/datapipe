#!/usr/bin/env python3
"""datapipe -- a program that documents itself and also acts.

The help pages are the benchmark's published text. Execution is a small generic store, so a plan
can be judged by *what it left behind* rather than by the string it printed: every `--flag value`
pair is applied to the state, `list` filters by those pairs, and the mutating verbs append or
address an item by `--id`/`--name`/`--key`.

State lives in `$DATAPIPE_STATE` or a dotfile beside the program, so a test can
give each run a fresh file. Nothing here is a knowledge table: the store starts empty and holds
only what commands put in it.
"""
import json
import os
import sys

PAGES = {
    "": "datapipe - Data pipeline orchestrator for connecting sources, applying transformations, and routing to sinks on configurable schedules\n\nUSAGE:\n  datapipe <command> [flags]\n\nAVAILABLE COMMANDS:\n  source              Manage source\n  transform           Manage transform\n  sink                Manage sink\n  pipeline            Manage pipeline\n\nFLAGS:\n  -h, --help          Show help for a command\n\nUse \"datapipe <command> --help\" for more information.",
    "source": "Manage source\n\nUSAGE:\n  datapipe source <command> [flags]\n\nAVAILABLE COMMANDS:\n  list                List all configured data sources\n  connect             Register a new data source connection\n\nFLAGS:\n  -h, --help          Show help for a command\n\nUse \"datapipe source <command> --help\" for more information.",
    "source list": "List all configured data sources\n\nUSAGE:\n  datapipe source list [flags]\n\nFLAGS:\n  --type <enum>\tFilter by source type (values: postgres, mysql, s3, api, kafka, mongodb)\n\n  -h, --help\tShow help for this command\n\nEXAMPLES:\n  datapipe source list --type postgres",
    "source connect": "Register a new data source connection\n\nUSAGE:\n  datapipe source connect [flags]\n\nFLAGS:\n  --name <string> (required)\tSource name (unique identifier)\n  --type <enum> (required)\tSource type (values: postgres, mysql, s3, api, kafka, mongodb)\n  --config <json> (required)\tConnection configuration as JSON (e.g. {\"host\": \"db.example.com\", \"port\": 5432, \"database\": \"analytics\"})\n\n  -h, --help\tShow help for this command\n\nEXAMPLES:\n  datapipe source connect --name prod-db --type postgres --config '{\"host\": \"db.example.com\", \"port\": 5432, \"database\": \"analytics\"}'",
    "transform": "Manage transform\n\nUSAGE:\n  datapipe transform <command> [flags]\n\nAVAILABLE COMMANDS:\n  create              Create a named transformation step with SQL logic\n  run                 Execute a transformation step\n\nFLAGS:\n  -h, --help          Show help for a command\n\nUse \"datapipe transform <command> --help\" for more information.",
    "transform create": "Create a named transformation step with SQL logic\n\nUSAGE:\n  datapipe transform create [flags]\n\nFLAGS:\n  --name <string> (required)\tTransform name (unique identifier)\n  --sql <string> (required)\tSQL transformation query\n  --source <string> (required)\tSource name to read data from\n  --description <string>\tHuman-readable description of the transformation\n\n  -h, --help\tShow help for this command\n\nEXAMPLES:\n  datapipe transform create --name daily-revenue --sql 'SELECT date, SUM(amount) as revenue FROM orders GROUP BY date' --source prod-db",
    "transform run": "Execute a transformation step\n\nUSAGE:\n  datapipe transform run [flags]\n\nFLAGS:\n  --name <string> (required)\tTransform name to execute\n  --dry-run <bool>\tPreview the output without writing results\n  --limit <int>\tLimit output rows (useful for preview)\n\n  -h, --help\tShow help for this command\n\nEXAMPLES:\n  datapipe transform run --name daily-revenue --dry-run --limit 10",
    "sink": "Manage sink\n\nUSAGE:\n  datapipe sink <command> [flags]\n\nAVAILABLE COMMANDS:\n  create              Create a data sink destination\n\nFLAGS:\n  -h, --help          Show help for a command\n\nUse \"datapipe sink <command> --help\" for more information.",
    "sink create": "Create a data sink destination\n\nUSAGE:\n  datapipe sink create [flags]\n\nFLAGS:\n  --name <string> (required)\tSink name (unique identifier)\n  --type <enum> (required)\tSink type (values: s3, bigquery, warehouse, postgres, elasticsearch)\n  --config <json> (required)\tSink configuration as JSON (e.g. {\"bucket\": \"analytics-output\", \"prefix\": \"daily/\"})\n\n  -h, --help\tShow help for this command\n\nEXAMPLES:\n  datapipe sink create --name analytics-lake --type s3 --config '{\"bucket\": \"analytics-output\", \"prefix\": \"daily/\"}'",
    "pipeline": "Manage pipeline\n\nUSAGE:\n  datapipe pipeline <command> [flags]\n\nAVAILABLE COMMANDS:\n  create              Create a complete data pipeline connecting source, transforms, and sink with a schedule\n  status              Check the status and execution history of a pipeline\n\nFLAGS:\n  -h, --help          Show help for a command\n\nUse \"datapipe pipeline <command> --help\" for more information.",
    "pipeline create": "Create a complete data pipeline connecting source, transforms, and sink with a schedule\n\nUSAGE:\n  datapipe pipeline create [flags]\n\nFLAGS:\n  --name <string> (required)\tPipeline name (unique identifier)\n  --source <string> (required)\tSource name\n  --transforms <string> (required)\tComma-separated list of transform names in execution order\n  --sink <string> (required)\tSink name\n  --schedule <string> (required)\tCron expression for scheduled execution\n\n  -h, --help\tShow help for this command\n\nEXAMPLES:\n  datapipe pipeline create --name daily-etl --source prod-db --transforms daily-revenue,add-dimensions --sink analytics-lake --schedule '0 2 * * *'",
    "pipeline status": "Check the status and execution history of a pipeline\n\nUSAGE:\n  datapipe pipeline status [flags]\n\nFLAGS:\n  --name <string> (required)\tPipeline name\n\n  -h, --help\tShow help for this command\n\nEXAMPLES:\n  datapipe pipeline status --name daily-etl",
}
STATE = os.environ.get("DATAPIPE_STATE") or os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "." + "datapipe" + "-state.json")
HELP = ("--help", "-h", "help")
MUTATING = {"create", "add", "register", "connect", "send", "apply", "approve", "reject",
            "start", "route", "split", "build", "append", "silence", "transition", "update",
            "resolve", "remove", "delete", "create_issue", "create_page"}


def load():
    try:
        with open(STATE) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def save(state):
    with open(STATE, "w") as handle:
        json.dump(state, handle, indent=1, sort_keys=True)


def parse(args):
    flags, bare, index = {}, [], 0
    while index < len(args):
        word = args[index]
        if word.startswith("--"):
            name = word[2:]
            if "=" in name:
                name, _, value = name.partition("=")
                flags.setdefault(name, []).append(value)
            elif index + 1 < len(args) and not args[index + 1].startswith("--"):
                flags.setdefault(name, []).append(args[index + 1])
                index += 1
            else:
                flags.setdefault(name, []).append("")
        else:
            bare.append(word)
        index += 1
    return flags, bare


def main(argv):
    # A page is shown when help is asked for, and only then. Answering *any* invocation that
    # happens to spell a route with that route's help text makes every command a no-op, and a
    # plan could never be judged by what it left behind.
    asked_for_help = "--help" in argv or "-h" in argv or "help" in argv
    args = [a for a in argv if a not in HELP]
    if asked_for_help:
        key = " ".join(args)
        if key in PAGES:
            sys.stdout.write(PAGES[key])
            return 0
        if args and args[0] in PAGES:
            sys.stdout.write(PAGES[args[0]])
            return 0
        sys.stdout.write(PAGES.get("", ""))
        return 0
    if not args:
        sys.stdout.write(PAGES.get("", ""))
        return 0
    flags, bare = parse(args)
    # the document's own route is the longest leading run of bare words that has a page
    route = ""
    for count in range(len(bare), 0, -1):
        candidate = " ".join(bare[:count])
        if candidate in PAGES:
            route = candidate
            break
    if not route:
        sys.stdout.write(PAGES.get("", ""))
        return 0
    action = route.split()[-1]
    state = load()
    # The store belongs to the *resource*, not to the verb: `issue create` and `issue list` are
    # two ways of addressing one collection. Keying on the whole route gives every verb its own
    # list, so a create is invisible to the very list that should show it.
    resource = route.rsplit(" ", 1)[0] if " " in route else route
    store = state.setdefault(resource, [])
    if not isinstance(store, list):
        store = state[resource] = []
    wanted = [(k, v[-1]) for k, v in flags.items() if v]
    if action == "list":
        sys.stdout.write(json.dumps(
            [item for item in store if all(str(item.get(k, "")) == v for k, v in wanted)]))
        return 0
    if action in MUTATING:
        item = {k: v[-1] for k, v in flags.items() if v}
        spare = [w for w in bare[len(route.split()):] if w]
        if spare and "name" not in item:
            item["name"] = spare[0]
        address = item.get("id") or item.get("name") or item.get("key")
        if action in ("update", "remove", "delete", "resolve"):
            for existing in store:
                if address and address in (existing.get("id"), existing.get("name"),
                                           existing.get("key")):
                    if action in ("remove", "delete"):
                        store.remove(existing)
                    else:
                        existing.update({k: v for k, v in item.items()
                                         if k not in ("id", "name", "key")})
                    break
            else:
                store.append(item)
        else:
            store.append(item)
        save(state)
        sys.stdout.write(json.dumps({"ok": True, "item": item}))
        return 0
    sys.stdout.write(json.dumps(
        [item for item in store if all(str(item.get(k, "")) == v for k, v in wanted)]))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
